<!-- views/tech/map.ejs -->
<%- include('partials/header') %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>
    #map {
      height: calc(100vh - 145px);
      border-radius: 12px;
      margin-top: 10px;
      z-index: 1;
      border: 1px solid #334155;
      background: #0f172a;
    }

    .map-info {
      background: #1e293b;
      padding: 12px;
      border-radius: 12px;
      margin-bottom: 10px;
      font-size: 13px;
      border: 1px solid #334155;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    /* Tech Stats */
    .tech-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 10px;
    }

    .tsc {
      background: #1e293b;
      border: 1px solid #334155;
      padding: 10px;
      border-radius: 10px;
      text-align: center;
    }

    .tsc .val {
      display: block;
      font-size: 16px;
      font-weight: 700;
      color: #f8fafc;
    }

    .tsc .lbl {
      display: block;
      font-size: 9px;
      color: #94a3b8;
      text-transform: uppercase;
      font-weight: 600;
      margin-top: 2px;
    }

    .tsc-w {
      border-bottom: 3px solid #f59e0b;
    }

    .tsc-s {
      border-bottom: 3px solid #10b981;
    }

    .tsc-d {
      border-bottom: 3px solid #ef4444;
    }

    /* Tech Legend Grid */
    .legend-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 10px;
    }

    .lc {
      background: #1e293b;
      border: 1px solid #334155;
      padding: 8px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .lc i {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 2px solid white;
      box-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
    }

    .lc span {
      font-size: 11px;
      font-weight: 700;
      color: #f1f5f9;
    }

    /* Custom Leaflet DivIcon Styling */
    .custom-div-icon {
      background: none !important;
      border: none !important;
    }

    /* Modern Zero-Watermark Dark Mode Map Tiles */
    .leaflet-tile-dark {
      filter: invert(100%) hue-rotate(180deg) brightness(92%) contrast(96%) !important;
    }

    /* ODC Marker Styling */
    .marker-odc-box {
      background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
      border: 2px solid #ffffff;
      box-shadow: 0 0 14px rgba(167, 139, 250, 0.8), 0 4px 10px rgba(0, 0, 0, 0.4);
      border-radius: 9px;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 15px;
      position: relative;
    }

    .marker-odc-tag {
      position: absolute;
      bottom: -7px;
      background: #4c1d95;
      color: #ede9fe;
      font-size: 7.5px;
      font-weight: 900;
      padding: 1px 4px;
      border-radius: 4px;
      border: 1px solid #c4b5fd;
      white-space: nowrap;
      line-height: 1;
      letter-spacing: 0.5px;
    }

    /* ODP Marker Styling */
    .marker-odp-box {
      background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
      border: 2px solid #ffffff;
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.8), 0 4px 10px rgba(0, 0, 0, 0.4);
      border-radius: 8px;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 13px;
      position: relative;
    }

    .marker-odp-tag {
      position: absolute;
      bottom: -7px;
      background: #78350f;
      color: #fef3c7;
      font-size: 7.5px;
      font-weight: 900;
      padding: 1px 4px;
      border-radius: 4px;
      border: 1px solid #fde68a;
      white-space: nowrap;
      line-height: 1;
      letter-spacing: 0.5px;
    }

    /* Tech Modern Customer Pins */
    .cust-pin-wrapper {
      position: relative;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cust-pin-pulse {
      position: absolute;
      top: -3px;
      left: -3px;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      pointer-events: none;
      animation: pulse-ring 2.2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }

    .pulse-active {
      border: 2px solid rgba(56, 189, 248, 0.7);
    }

    .pulse-free {
      border: 2px solid rgba(52, 211, 153, 0.7);
    }

    .pulse-suspended {
      border: 2px solid rgba(248, 113, 113, 0.7);
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.6);
        opacity: 1;
      }

      80%,
      100% {
        transform: scale(1.4);
        opacity: 0;
      }
    }

    .cust-pin {
      width: 26px;
      height: 26px;
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #ffffff;
      position: relative;
    }

    .cust-pin i {
      transform: rotate(45deg);
      font-size: 13px;
      color: #ffffff;
    }

    .cust-pin-active {
      background: linear-gradient(135deg, #38bdf8 0%, #1d4ed8 100%);
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.7);
    }

    .cust-pin-free {
      background: linear-gradient(135deg, #34d399 0%, #047857 100%);
      box-shadow: 0 0 10px rgba(52, 211, 153, 0.7);
    }

    .cust-pin-suspended {
      background: linear-gradient(135deg, #f87171 0%, #b91c1c 100%);
      box-shadow: 0 0 10px rgba(248, 113, 113, 0.7);
    }

    .popup-dark {
      color: #1e293b;
    }

    .popup-dark h6 {
      margin: 0 0 5px 0;
      border-bottom: 1px solid #ddd;
      padding-bottom: 5px;
      font-weight: bold;
    }

    .btn-wa {
      background: #25d366;
      color: white;
      border: none;
      padding: 5px 10px;
      border-radius: 5px;
      text-decoration: none;
      display: inline-block;
      margin-top: 8px;
      font-size: 12px;
    }

    /* Flowing line animation */
    @keyframes flow {
      from {
        stroke-dashoffset: 20;
      }

      to {
        stroke-dashoffset: 0;
      }
    }

    .flowing-line {
      animation: flow 1s linear infinite;
    }

    /* Custom Cable Hover Tooltip */
    .leaflet-tooltip.custom-cable-tooltip {
      background: rgba(15, 23, 42, 0.94) !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
      border: 1px solid rgba(56, 189, 248, 0.35) !important;
      border-radius: 12px !important;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(56, 189, 248, 0.2) !important;
      padding: 0 !important;
      color: #f8fafc !important;
      pointer-events: none !important;
      z-index: 1000 !important;
    }

    .leaflet-tooltip-top.custom-cable-tooltip:before {
      border-top-color: rgba(15, 23, 42, 0.94) !important;
    }
    .leaflet-tooltip-bottom.custom-cable-tooltip:before {
      border-bottom-color: rgba(15, 23, 42, 0.94) !important;
    }
    .leaflet-tooltip-left.custom-cable-tooltip:before {
      border-left-color: rgba(15, 23, 42, 0.94) !important;
    }
    .leaflet-tooltip-right.custom-cable-tooltip:before {
      border-right-color: rgba(15, 23, 42, 0.94) !important;
    }

    .cable-tooltip-card {
      padding: 10px 14px;
      min-width: 230px;
      max-width: 330px;
      font-family: inherit;
      font-size: 12px;
      line-height: 1.4;
    }

    .cable-tooltip-card .ct-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .cable-tooltip-card .ct-title {
      font-weight: 800;
      font-size: 12px;
      color: #f8fafc;
      flex: 1;
    }

    .cable-tooltip-card .ct-icon-cust {
      color: #38bdf8;
      font-size: 14px;
    }

    .cable-tooltip-card .ct-icon-feeder {
      color: #a78bfa;
      font-size: 14px;
    }

    .cable-tooltip-card .ct-badge-status {
      font-size: 10px;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 999px;
      text-transform: uppercase;
    }

    .ct-status-active {
      background: rgba(16, 185, 129, 0.2);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .ct-status-free {
      background: rgba(56, 189, 248, 0.2);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.4);
    }

    .ct-status-suspended {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.4);
    }

    .cable-tooltip-card .ct-badge-pon {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 6px;
      background: rgba(167, 139, 250, 0.2);
      color: #c4b5fd;
      border: 1px solid rgba(167, 139, 250, 0.35);
    }

    .cable-tooltip-card .ct-nodes {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 8px;
    }

    .cable-tooltip-card .ct-node-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .cable-tooltip-card .ct-label {
      color: #94a3b8;
      font-size: 11px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .cable-tooltip-card .ct-val {
      color: #f1f5f9;
      font-weight: 700;
      font-size: 11.5px;
      text-align: right;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 170px;
    }

    .cable-tooltip-card .ct-distance-box {
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(99, 102, 241, 0.15));
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 8px;
      padding: 6px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 4px;
    }

    .cable-tooltip-card .ct-dist-label {
      font-size: 11px;
      font-weight: 700;
      color: #93c5fd;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .cable-tooltip-card .ct-dist-val {
      font-size: 13px;
      font-weight: 800;
      color: #38bdf8;
      letter-spacing: 0.3px;
    }

    .cable-tooltip-card .ct-extra {
      font-size: 10.5px;
      color: #94a3b8;
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* Status Optical Badges */
    .ct-status-optimal {
      background: rgba(16, 185, 129, 0.2);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.4);
    }
    .ct-status-normal {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.4);
    }
    .ct-status-warning {
      background: rgba(249, 115, 22, 0.2);
      color: #fb923c;
      border: 1px solid rgba(249, 115, 22, 0.4);
    }
    .ct-status-critical {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.4);
    }
    .ct-status-unknown {
      background: rgba(100, 116, 139, 0.2);
      color: #94a3b8;
      border: 1px solid rgba(100, 116, 139, 0.4);
    }

    .cable-tooltip-card .ct-optical-box {
      margin-top: 8px;
      padding: 8px 10px;
      border-radius: 8px;
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid rgba(56, 189, 248, 0.25);
    }
    .cable-tooltip-card .ct-opt-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      margin-bottom: 3px;
    }
    .cable-tooltip-card .ct-opt-lbl {
      color: #94a3b8;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .cable-tooltip-card .ct-opt-val {
      font-weight: 800;
      font-size: 11.5px;
    }

    /* Floating Optical Legend Card */
    .optical-legend-card {
      position: absolute;
      bottom: 25px;
      right: 15px;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(56, 189, 248, 0.35);
      border-radius: 12px;
      padding: 10px 14px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      font-size: 11.5px;
      color: #f1f5f9;
      min-width: 220px;
      display: none;
    }
    .optical-legend-card.show {
      display: block;
    }
    .olc-title {
      font-weight: 800;
      font-size: 12px;
      color: #38bdf8;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
      padding-bottom: 4px;
      border-bottom: 1px solid rgba(148, 163, 184, 0.2);
    }
    .olc-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 4px;
      font-size: 11px;
    }
    .olc-label {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #cbd5e1;
    }
    .olc-line {
      width: 14px;
      height: 4px;
      border-radius: 2px;
      flex-shrink: 0;
    }
    .olc-range {
      font-size: 10px;
      color: #94a3b8;
      font-weight: 700;
    }

    /* Modal Optical Calculator Styling */
    .calc-topo-chain {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(56, 189, 248, 0.2);
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 14px;
      overflow-x: auto;
      gap: 6px;
    }
    .topo-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      min-width: 60px;
    }
    .topo-node-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      margin-bottom: 3px;
    }
    .topo-node-name {
      font-size: 10px;
      font-weight: 800;
      color: #f1f5f9;
      white-space: nowrap;
    }
    .topo-node-sub {
      font-size: 8.5px;
      color: #94a3b8;
    }
    .topo-arrow {
      color: #64748b;
      font-size: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 40px;
    }
    .topo-arrow-loss {
      font-size: 8px;
      color: #38bdf8;
      font-weight: 700;
    }
    .calc-slider-box {
      margin-bottom: 10px;
    }
    .calc-slider-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      margin-bottom: 3px;
      color: #cbd5e1;
    }
    .calc-slider-val {
      font-weight: 800;
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 6px;
      padding: 1px 6px;
      font-size: 10.5px;
    }
    .calc-result-card {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.8), rgba(30, 41, 59, 0.8));
      border: 1px solid rgba(148, 163, 184, 0.25);
      border-radius: 12px;
      padding: 14px;
      height: 100%;
    }

    /* ─── MASS OUTAGE & FIBER CUT STYLING ─── */
    @keyframes fiberCutPulse {
      0% {
        stroke-opacity: 1;
        stroke-width: 8;
        filter: drop-shadow(0 0 6px #ef4444);
      }
      50% {
        stroke-opacity: 0.35;
        stroke-width: 5;
        filter: drop-shadow(0 0 2px #ef4444);
      }
      100% {
        stroke-opacity: 1;
        stroke-width: 8;
        filter: drop-shadow(0 0 6px #ef4444);
      }
    }

    .cable-fiber-cut {
      stroke: #ef4444 !important;
      stroke-dasharray: 8, 4;
      animation: fiberCutPulse 1.2s ease-in-out infinite;
    }

    @keyframes markerCutPulseRing {
      0% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.9), 0 0 15px rgba(239, 68, 68, 0.8);
        transform: scale(1);
      }
      70% {
        box-shadow: 0 0 0 15px rgba(239, 68, 68, 0), 0 0 25px rgba(239, 68, 68, 0.5);
        transform: scale(1.1);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0), 0 0 15px rgba(239, 68, 68, 0.8);
        transform: scale(1);
      }
    }

    .marker-cut-pulse {
      border: 2px solid #ffffff !important;
      background: #dc2626 !important;
      animation: markerCutPulseRing 1.5s infinite !important;
      z-index: 9999 !important;
    }

    .mass-outage-banner {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      width: 94%;
      max-width: 760px;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 2px solid #ef4444;
      border-radius: 12px;
      box-shadow: 0 15px 35px rgba(239, 68, 68, 0.35), 0 0 20px rgba(239, 68, 68, 0.2);
      padding: 10px 14px;
      display: none;
      animation: slideDownBanner 0.35s ease-out;
    }

    .mass-outage-banner.show {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    @keyframes slideDownBanner {
      from {
        top: -60px;
        opacity: 0;
      }
      to {
        top: 10px;
        opacity: 1;
      }
    }
  </style>

  <% const odcList=odps.filter(o=> o.type === 'ODC');
    const odpList = odps.filter(o => !o.type || o.type === 'ODP');
    const isFreeCust = (c) => (c.status && String(c.status).toLowerCase() === 'free') || (c.package_name &&
    String(c.package_name).toLowerCase().includes('free')) || (c.package_price !== undefined && c.package_price !== null
    && Number(c.package_price) === 0 && c.package_name);
    const freeCount = customers.filter(isFreeCust).length;
    const activeCount = customers.filter(c => c.status === 'active' && !isFreeCust(c)).length;
    const suspendedCount = customers.filter(c => c.status !== 'active' && !isFreeCust(c)).length;
    %>

    <div class="tech-stats" style="grid-template-columns: repeat(5, 1fr);">
      <div class="tsc" style="border-bottom: 3px solid #a78bfa;">
        <span class="val">
          <%= odcList.length %>
        </span>
        <span class="lbl">ODC</span>
      </div>
      <div class="tsc tsc-w">
        <span class="val">
          <%= odpList.length %>
        </span>
        <span class="lbl">ODP</span>
      </div>
      <div class="tsc" style="border-bottom: 3px solid #3b82f6;">
        <span class="val">
          <%= activeCount %>
        </span>
        <span class="lbl">Berbayar</span>
      </div>
      <div class="tsc tsc-s">
        <span class="val">
          <%= freeCount %>
        </span>
        <span class="lbl">Free</span>
      </div>
      <div class="tsc tsc-d">
        <span class="val">
          <%= suspendedCount %>
        </span>
        <span class="lbl">Isolir</span>
      </div>
    </div>

    <div class="legend-grid" style="grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));">
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px;">
        <input type="checkbox" id="toggle-odc" checked onchange="toggleLayers()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #a78bfa;"></i>
        <span>ODC</span>
      </label>
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px;">
        <input type="checkbox" id="toggle-odp" checked onchange="toggleLayers()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #f59e0b;"></i>
        <span>ODP</span>
      </label>
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px;">
        <input type="checkbox" id="toggle-active" checked onchange="toggleLayers()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #38bdf8;"></i>
        <span>Aktif</span>
      </label>
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px;">
        <input type="checkbox" id="toggle-free" checked onchange="toggleLayers()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #34d399;"></i>
        <span>Free</span>
      </label>
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px;">
        <input type="checkbox" id="toggle-suspended" checked onchange="toggleLayers()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #f87171;"></i>
        <span>Isolir</span>
      </label>
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px;"
        title="Tiket Gangguan Aktif">
        <input type="checkbox" id="toggle-tickets" checked onchange="toggleLayers()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #ef4444; border-radius: 0; transform: rotate(45deg);"></i>
        <span>Gangguan</span>
      </label>
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px; background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.4);"
        title="Mode Kualitas Redaman Optik">
        <input type="checkbox" id="toggle-optical-mode" onchange="toggleOpticalMode()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #10b981; box-shadow: 0 0 6px #10b981;"></i>
        <span style="color:#10b981;">Redaman</span>
      </label>
      <label class="lc" style="cursor:pointer; user-select:none; margin-bottom:0; padding: 6px; background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.5);"
        title="Deteksi Putus Kabel Otomatis">
        <input type="checkbox" id="toggle-fiber-cut" checked onchange="toggleFiberCutLayer()"
          style="width:14px;height:14px;cursor:pointer">
        <i style="background: #ef4444; box-shadow: 0 0 6px #ef4444;"></i>
        <span style="color:#ef4444; font-weight:800;">
          Putus Kabel <span id="fiberCutBadgeCount" class="badge bg-danger ms-1" style="display:none; font-size:9px; padding:2px 5px;">0</span>
        </span>
      </label>
    </div>

    <div class="map-info">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span><i class="bi bi-info-circle me-1"></i> Mode: <b>Satelit (Navigasi)</b></span>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-sm" onclick="openOpticalCalculatorModal()"
            style="border-radius:8px; font-size:11.5px; font-weight:700; background:linear-gradient(135deg, #10b981 0%, #059669 100%); color:#fff; border:none; padding:4px 10px; box-shadow:0 2px 8px rgba(16, 185, 129, 0.3);">
            <i class="bi bi-calculator-fill me-1"></i> Kalkulator Redaman
          </button>
          <span class="badge bg-primary">GPS Ready</span>
        </div>
      </div>
    </div>

    <div style="position: relative;">
      <!-- Floating Emergency Mass Outage Banner -->
      <div id="massOutageBanner" class="mass-outage-banner">
        <div style="display:flex; align-items:center; gap:10px; flex:1; min-width:240px;">
          <div style="width:36px; height:36px; border-radius:8px; background:rgba(239,68,68,0.2); border:1px solid #ef4444; display:flex; align-items:center; justify-content:center; color:#ef4444; font-size:18px; flex-shrink:0;">
            <i class="bi bi-exclamation-octagon-fill"></i>
          </div>
          <div>
            <div style="font-weight:800; font-size:12.5px; color:#fee2e2; display:flex; align-items:center; gap:6px;">
              <span id="mobTitle">Indikasi Putus Kabel Terdeteksi!</span>
              <span id="mobBadge" class="badge bg-danger" style="font-size:9.5px; padding:2px 6px;">CRITICAL</span>
            </div>
            <div id="mobDesc" style="font-size:11px; color:#fca5a5; margin-top:2px;">
              Mendeteksi anomali transmisi optik...
            </div>
          </div>
        </div>
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; flex-shrink:0;">
          <button type="button" class="btn btn-sm btn-outline-light" onclick="focusCurrentIncident()" style="border-radius:6px; font-weight:700; font-size:11px; padding:3px 9px;">
            <i class="bi bi-geo-alt-fill me-1"></i>Fokus
          </button>
          <button type="button" class="btn btn-sm btn-info" onclick="openCurrentIncidentModal()" style="border-radius:6px; font-weight:700; font-size:11px; padding:3px 9px; color:#0f172a;">
            <i class="bi bi-info-circle-fill me-1"></i>Rincian
          </button>
          <button type="button" class="btn btn-sm btn-danger" onclick="createCurrentIncidentTicket()" style="border-radius:6px; font-weight:700; font-size:11px; padding:3px 9px;">
            <i class="bi bi-ticket-detailed-fill me-1"></i>Tiket
          </button>
          <button type="button" class="btn btn-sm btn-success" onclick="broadcastCurrentIncidentWa()" style="border-radius:6px; font-weight:700; font-size:11px; padding:3px 9px;">
            <i class="bi bi-whatsapp me-1"></i>WA
          </button>
        </div>
      </div>

      <div id="map"></div>

      <!-- Floating Optical Mode Legend Card -->
      <div id="opticalLegendCard" class="optical-legend-card">
        <div class="olc-title">
          <span><i class="bi bi-activity me-1"></i> Kualitas Optik</span>
          <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-size: 9.5px;">Dual-ACS</span>
        </div>
        <div class="olc-item">
          <div class="olc-label">
            <div class="olc-line" style="background: #10b981; box-shadow: 0 0 6px #10b981;"></div>
            <span>Optimal</span>
          </div>
          <span class="olc-range">-15 s/d -22.9 dBm</span>
        </div>
        <div class="olc-item">
          <div class="olc-label">
            <div class="olc-line" style="background: #f59e0b; box-shadow: 0 0 6px #f59e0b;"></div>
            <span>Standar</span>
          </div>
          <span class="olc-range">-23 s/d -26.9 dBm</span>
        </div>
        <div class="olc-item">
          <div class="olc-label">
            <div class="olc-line" style="background: #f97316; box-shadow: 0 0 6px #f97316;"></div>
            <span>Warning</span>
          </div>
          <span class="olc-range">-27 s/d -28.9 dBm</span>
        </div>
        <div class="olc-item">
          <div class="olc-label">
            <div class="olc-line" style="background: #ef4444; box-shadow: 0 0 6px #ef4444;"></div>
            <span>Kritis</span>
          </div>
          <span class="olc-range">&lt; -29 dBm / Overload</span>
        </div>
        <div class="olc-item">
          <div class="olc-label">
            <div class="olc-line" style="background: #64748b;"></div>
            <span>Offline</span>
          </div>
          <span class="olc-range">Unmonitored</span>
        </div>
      </div>
    </div>

    <!-- Modal Kalkulator & Diagnosa Redaman Optik (Teknisi) -->
    <div class="modal fade" id="opticalCalculatorModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="background: #0f172a; border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 16px; color: #f8fafc; box-shadow: 0 20px 50px rgba(0,0,0,0.7);">
          <div class="modal-header" style="border-bottom: 1px solid rgba(148, 163, 184, 0.2); padding: 14px 20px;">
            <div class="d-flex align-items-center gap-2">
              <div style="width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-size:16px;">
                <i class="bi bi-calculator-fill"></i>
              </div>
              <div>
                <h6 class="modal-title fw-bold text-white mb-0" style="font-size: 15px;">Kalkulator & Diagnosa Redaman Optik</h6>
                <div style="font-size: 11px; color: #94a3b8;">Simulasi Link Budget GPON & Verifikasi RX Power Dual-ACS Lapangan</div>
              </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" style="padding: 16px 20px;">
            <!-- Header Pemilihan Pelanggan -->
            <div class="row g-2 mb-3 align-items-center">
              <div class="col-md-7">
                <label style="font-size: 11px; font-weight: 700; color: #94a3b8; margin-bottom: 4px; display:block;">Pilih Pelanggan untuk Diagnosa Aktual:</label>
                <select id="calc-customer-select" class="form-select form-select-sm" onchange="onSelectCalcCustomer(this.value)" style="background: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 8px; font-size: 12px;">
                  <option value="">-- Simulasi Kustom (Bebas / Manual) --</option>
                  <% if (customers && customers.length > 0) { %>
                    <% customers.forEach(c => { %>
                      <option value="<%= c.id %>"><%= c.name %> [<%= c.pppoe_username || 'No PPPoE' %>] - ODP: <%= c.odp_name || '-' %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div class="col-md-5 text-md-end mt-2 mt-md-0">
                <button type="button" class="btn btn-sm btn-outline-info" onclick="refreshOpticalLive()" style="font-size: 11.5px; border-radius: 8px;">
                  <i class="bi bi-arrow-clockwise me-1"></i> Refresh Dual-ACS
                </button>
              </div>
            </div>

            <!-- Customer Meta Info Card (Jika pelanggan dipilih) -->
            <div id="calc-customer-meta" style="display: none; background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; font-size: 11.5px;">
              <div class="row g-2">
                <div class="col-sm-4">
                  <span class="text-muted d-block">Pelanggan:</span>
                  <strong id="ccm-name" class="text-white">-</strong>
                </div>
                <div class="col-sm-4">
                  <span class="text-muted d-block">ODP Terkoneksi:</span>
                  <strong id="ccm-odp" class="text-info">-</strong>
                </div>
                <div class="col-sm-4">
                  <span class="text-muted d-block">Total Jarak Kabel:</span>
                  <strong id="ccm-dist" class="text-warning">-</strong>
                </div>
              </div>
            </div>

            <!-- Visual Topologi Chain -->
            <div class="calc-topo-chain">
              <div class="topo-node">
                <div class="topo-node-icon" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4);"><i class="bi bi-hdd-stack-fill"></i></div>
                <div class="topo-node-name">SFP OLT</div>
                <div class="topo-node-sub" id="topo-tx-display">+3.50 dBm</div>
              </div>
              <div class="topo-arrow">
                <span class="topo-arrow-loss" id="topo-feeder-loss">-0.35 dB</span>
                <i class="bi bi-arrow-right"></i>
                <span style="font-size: 8px; color: #94a3b8;">Feeder</span>
              </div>
              <div class="topo-node">
                <div class="topo-node-icon" style="background: rgba(167, 139, 250, 0.2); color: #c4b5fd; border: 1px solid rgba(167, 139, 250, 0.4);"><i class="bi bi-hdd-rack-fill"></i></div>
                <div class="topo-node-name">ODC Splitter</div>
                <div class="topo-node-sub" id="topo-odc-ratio">1:4 (7.2 dB)</div>
              </div>
              <div class="topo-arrow">
                <span class="topo-arrow-loss" id="topo-dist-loss">-0.18 dB</span>
                <i class="bi bi-arrow-right"></i>
                <span style="font-size: 8px; color: #94a3b8;">Distribusi</span>
              </div>
              <div class="topo-node">
                <div class="topo-node-icon" style="background: rgba(245, 158, 11, 0.2); color: #fde68a; border: 1px solid rgba(245, 158, 11, 0.4);"><i class="bi bi-box-seam-fill"></i></div>
                <div class="topo-node-name">ODP Splitter</div>
                <div class="topo-node-sub" id="topo-odp-ratio">1:8 (10.5 dB)</div>
              </div>
              <div class="topo-arrow">
                <span class="topo-arrow-loss" id="topo-drop-loss">-0.05 dB</span>
                <i class="bi bi-arrow-right"></i>
                <span style="font-size: 8px; color: #94a3b8;">Drop Cable</span>
              </div>
              <div class="topo-node">
                <div class="topo-node-icon" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4);"><i class="bi bi-router-fill"></i></div>
                <div class="topo-node-name">ONT Pelanggan</div>
                <div class="topo-node-sub" id="topo-rx-display">-16.50 dBm</div>
              </div>
            </div>

            <!-- Sliders & Result Grid -->
            <div class="row g-3">
              <div class="col-lg-6">
                <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 12px; padding: 14px;">
                  <h6 style="color: #38bdf8; font-weight: 800; font-size: 12px; margin-bottom: 12px; display:flex; align-items:center; gap:6px;">
                    <i class="bi bi-sliders2"></i> Parameter Link Budget Optik
                  </h6>

                  <div class="calc-slider-box">
                    <div class="calc-slider-head">
                      <span>Panjang Drop Cable (Pelanggan ↔ ODP):</span>
                      <span class="calc-slider-val" id="val-drop-dist">150 meter</span>
                    </div>
                    <input type="range" class="form-range" id="input-drop-dist" min="10" max="2500" step="10" value="150" oninput="onOpticalParamChange()">
                  </div>

                  <div class="calc-slider-box">
                    <div class="calc-slider-head">
                      <span>Jarak Distribusi (ODP ↔ ODC):</span>
                      <span class="calc-slider-val" id="val-dist-dist">500 meter</span>
                    </div>
                    <input type="range" class="form-range" id="input-dist-dist" min="0" max="8000" step="50" value="500" oninput="onOpticalParamChange()">
                  </div>

                  <div class="calc-slider-box">
                    <div class="calc-slider-head">
                      <span>Jarak Feeder (ODC ↔ NOC):</span>
                      <span class="calc-slider-val" id="val-feeder-dist">1000 meter</span>
                    </div>
                    <input type="range" class="form-range" id="input-feeder-dist" min="0" max="15000" step="100" value="1000" oninput="onOpticalParamChange()">
                  </div>

                  <div class="calc-slider-box">
                    <div class="calc-slider-head">
                      <span>Tx Power SFP OLT:</span>
                      <span class="calc-slider-val" id="val-tx-power">+3.50 dBm</span>
                    </div>
                    <input type="range" class="form-range" id="input-tx-power" min="1.0" max="7.0" step="0.25" value="3.5" oninput="onOpticalParamChange()">
                  </div>

                  <div class="row g-2 mb-2">
                    <div class="col-6">
                      <label style="font-size: 10.5px; font-weight: 700; color: #cbd5e1; margin-bottom: 3px; display:block;">Splitter ODC (L1):</label>
                      <select id="input-odc-ratio" class="form-select form-select-sm" onchange="onOpticalParamChange()" style="background:#1e293b; color:#fff; font-size: 11px; border-radius: 6px; border:1px solid #334155;">
                        <option value="none">Direct / Tanpa (0 dB)</option>
                        <option value="1:2">Splitter 1:2 (3.7 dB)</option>
                        <option value="1:4" selected>Splitter 1:4 (7.2 dB)</option>
                        <option value="1:8">Splitter 1:8 (10.5 dB)</option>
                        <option value="1:16">Splitter 1:16 (13.8 dB)</option>
                      </select>
                    </div>
                    <div class="col-6">
                      <label style="font-size: 10.5px; font-weight: 700; color: #cbd5e1; margin-bottom: 3px; display:block;">Splitter ODP (L2):</label>
                      <select id="input-odp-ratio" class="form-select form-select-sm" onchange="onOpticalParamChange()" style="background:#1e293b; color:#fff; font-size: 11px; border-radius: 6px; border:1px solid #334155;">
                        <option value="none">Direct / Tanpa (0 dB)</option>
                        <option value="1:4">Splitter 1:4 (7.2 dB)</option>
                        <option value="1:8" selected>Splitter 1:8 (10.5 dB)</option>
                        <option value="1:16">Splitter 1:16 (13.8 dB)</option>
                        <option value="1:32">Splitter 1:32 (17.1 dB)</option>
                      </select>
                    </div>
                  </div>

                  <div class="row g-2">
                    <div class="col-6">
                      <div class="calc-slider-box mb-0">
                        <div class="calc-slider-head">
                          <span>Koef. Fiber:</span>
                          <span class="calc-slider-val" id="val-attenuation">0.35 dB/km</span>
                        </div>
                        <input type="range" class="form-range" id="input-attenuation" min="0.25" max="0.45" step="0.01" value="0.35" oninput="onOpticalParamChange()">
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="calc-slider-box mb-0">
                        <div class="calc-slider-head">
                          <span>Loss Konektor:</span>
                          <span class="calc-slider-val" id="val-connector">1.50 dB</span>
                        </div>
                        <input type="range" class="form-range" id="input-connector" min="0.5" max="3.0" step="0.25" value="1.5" oninput="onOpticalParamChange()">
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-6">
                <div class="calc-result-card">
                  <h6 style="color: #34d399; font-weight: 800; font-size: 12px; margin-bottom: 10px; display:flex; align-items:center; justify-content:space-between;">
                    <span><i class="bi bi-graph-up me-1"></i> Hasil Link Budget & Diagnosa</span>
                    <span id="res-badge-status" class="badge ct-status-optimal" style="font-size: 10.5px;">Optimal / Prima</span>
                  </h6>

                  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px;">
                    <div style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 8px; padding: 8px; text-align: center;">
                      <div style="font-size: 9.5px; color: #94a3b8; text-transform: uppercase; font-weight: 700;">Est. Teoretis</div>
                      <div id="res-est-rx" style="font-size: 14.5px; font-weight: 900; color: #38bdf8; margin-top: 2px;">-16.45 dBm</div>
                    </div>
                    <div style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 8px; text-align: center;">
                      <div style="font-size: 9.5px; color: #94a3b8; text-transform: uppercase; font-weight: 700;">Aktual Dual-ACS</div>
                      <div id="res-act-rx" style="font-size: 14.5px; font-weight: 900; color: #34d399; margin-top: 2px;">-18.20 dBm</div>
                    </div>
                    <div style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 8px; text-align: center;">
                      <div style="font-size: 9.5px; color: #94a3b8; text-transform: uppercase; font-weight: 700;">Deviasi (Δ)</div>
                      <div id="res-delta-rx" style="font-size: 14.5px; font-weight: 900; color: #f59e0b; margin-top: 2px;">1.75 dB</div>
                    </div>
                  </div>

                  <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 8px; padding: 8px 12px; margin-bottom: 12px; font-size: 11px;">
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Total Jarak Kabel:</span>
                      <strong id="res-breakdown-cable-dist" class="text-white">1.65 km (1.650 m)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Redaman Kabel Fiber:</span>
                      <strong id="res-breakdown-cable-loss" class="text-info">0.58 dB</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Redaman Splitter (ODC+ODP):</span>
                      <strong id="res-breakdown-splitter-loss" class="text-warning">17.70 dB</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Loss Konektor & Splicing:</span>
                      <strong id="res-breakdown-conn-loss" class="text-white">1.50 dB</strong>
                    </div>
                    <div class="d-flex justify-content-between pt-1 border-top border-secondary">
                      <span class="fw-bold text-white">Total Loss:</span>
                      <strong id="res-breakdown-total-loss" class="text-danger">19.78 dB</strong>
                    </div>
                  </div>

                  <div id="res-diagnosis-box" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); border-radius: 8px; padding: 10px; margin-bottom: 8px;">
                    <div style="font-weight: 800; font-size: 11.5px; color: #34d399; margin-bottom: 3px; display:flex; align-items:center; gap:5px;">
                      <i class="bi bi-shield-check" id="res-diag-icon"></i> <span id="res-diag-title">Diagnosa Sistem</span>
                    </div>
                    <div id="res-diag-desc" style="font-size: 11px; color: #e2e8f0; line-height: 1.35; margin-bottom: 4px;">
                      Redaman optik sangat ideal, transmisi GPON berkinerja prima.
                    </div>
                    <div id="res-diag-rec" style="font-size: 10.5px; color: #94a3b8; font-style: italic;">
                      <i class="bi bi-tools me-1"></i> Rekomendasi: Koneksi optik stabil.
                    </div>
                  </div>

                  <div id="res-acs-source-box" style="font-size: 10px; color: #94a3b8; display:flex; justify-content:space-between; align-items:center;">
                    <span><i class="bi bi-hdd-network me-1"></i> Sumber: <b id="res-acs-source" class="text-white">Built-in ACS</b></span>
                    <span>Update: <b id="res-acs-time" class="text-white">-</b></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer" style="border-top: 1px solid rgba(148, 163, 184, 0.2); padding: 10px 20px;">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetOpticalSimulation()">
              <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Parameter
            </button>
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Tutup</button>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL RINCIAN GANGGUAN MASSAL (MASS OUTAGE / FIBER CUT) TEKNISI -->
    <div class="modal fade" id="massOutageModal" tabindex="-1" aria-hidden="true" style="z-index: 10050;">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="background: #0f172a; border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 16px; box-shadow: 0 25px 50px rgba(0,0,0,0.8), 0 0 25px rgba(239, 68, 68, 0.25); color: #f8fafc;">
          <div class="modal-header" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.25) 0%, rgba(185, 28, 28, 0.15) 100%); border-bottom: 1px solid rgba(239, 68, 68, 0.3); padding: 14px 18px;">
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
              <div style="display:flex; align-items:center; gap:10px;">
                <div style="width: 36px; height: 36px; border-radius: 8px; background: #ef4444; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 0 12px rgba(239,68,68,0.6);">
                  <i class="bi bi-radioactive"></i>
                </div>
                <div>
                  <h5 id="mom-title" style="margin: 0; font-size: 15px; font-weight: 800; color: #fee2e2;">Rincian Deteksi Putus Kabel</h5>
                  <div id="mom-subtitle" style="font-size: 11px; color: #fca5a5; margin-top: 1px;">Analisis Root-Cause Topologi GPON</div>
                </div>
              </div>
              <span id="mom-severity-badge" class="badge bg-danger" style="font-size: 10.5px; padding: 4px 10px;">CRITICAL</span>
            </div>
          </div>
          <div class="modal-body" style="padding: 16px; max-height: calc(85vh - 150px); overflow-y: auto;">
            <!-- Top Grid Stats Insiden -->
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px;">
              <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 10px; padding: 10px; text-align: center;">
                <div style="font-size: 10px; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Segmen</div>
                <div id="mom-level" style="font-size: 12.5px; font-weight: 800; color: #f8fafc; margin-top: 3px;">Distribusi</div>
              </div>
              <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 10px; padding: 10px; text-align: center;">
                <div style="font-size: 10px; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Target</div>
                <div id="mom-target" style="font-size: 12.5px; font-weight: 800; color: #38bdf8; margin-top: 3px;">ODP-01</div>
              </div>
              <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 10px; padding: 10px; text-align: center;">
                <div style="font-size: 10px; color: #94a3b8; font-weight: 700; text-transform: uppercase;">OLT / Port</div>
                <div id="mom-olt-pon" style="font-size: 12.5px; font-weight: 800; color: #a78bfa; margin-top: 3px;">OLT-01 (PON 1)</div>
              </div>
              <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 10px; padding: 10px; text-align: center;">
                <div style="font-size: 10px; color: #fca5a5; font-weight: 700; text-transform: uppercase;">Padam</div>
                <div id="mom-impact" style="font-size: 12.5px; font-weight: 900; color: #ef4444; margin-top: 3px;">5 / 5 (100%)</div>
              </div>
            </div>

            <!-- Panduan Lapangan -->
            <div style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 10px; padding: 12px; margin-bottom: 14px;">
              <div style="font-weight: 800; font-size: 12px; color: #f87171; display:flex; align-items:center; gap:5px; margin-bottom: 4px;">
                <i class="bi bi-tools"></i> <span>Panduan Pemeriksaan Fisik</span>
              </div>
              <div id="mom-instruction" style="font-size: 11.5px; color: #cbd5e1; line-height: 1.45;">
                Segera telusuri jalur kabel antara Node Induk dan Node Target. Siapkan fusion splicer dan lakukan pengukuran OTDR dari titik ODC untuk mengetahui lokasi putus core secara presisi.
              </div>
            </div>

            <!-- Daftar Pelanggan Terputus -->
            <div style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 10px; padding: 12px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
                <span style="font-weight: 800; font-size: 12px; color: #f8fafc;">
                  <i class="bi bi-people-fill me-1 text-danger"></i> Pelanggan Terputus (<span id="mom-cust-count">0</span>)
                </span>
                <span class="badge bg-secondary" style="font-size: 9.5px;">Indikasi LOS</span>
              </div>
              <div style="max-height: 200px; overflow-y: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 11.5px;">
                  <thead>
                    <tr style="border-bottom: 1px solid rgba(148, 163, 184, 0.2); text-align: left; color: #94a3b8;">
                      <th style="padding: 5px 6px;">No</th>
                      <th style="padding: 5px 6px;">Nama</th>
                      <th style="padding: 5px 6px;">Status</th>
                    </tr>
                  </thead>
                  <tbody id="mom-cust-table-body">
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="modal-footer" style="border-top: 1px solid rgba(148, 163, 184, 0.2); padding: 10px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;">
            <button type="button" class="btn btn-outline-light btn-sm" onclick="focusCurrentIncident(); bootstrap.Modal.getInstance(document.getElementById('massOutageModal')).hide();">
              <i class="bi bi-geo-alt-fill me-1"></i> Fokus
            </button>
            <div style="display:flex; gap:6px; flex-wrap:wrap;">
              <button type="button" class="btn btn-danger btn-sm" onclick="createCurrentIncidentTicket()">
                <i class="bi bi-ticket-detailed-fill me-1"></i> Buat Tiket
              </button>
              <button type="button" class="btn btn-success btn-sm" onclick="broadcastCurrentIncidentWa()">
                <i class="bi bi-whatsapp me-1"></i> Siarkan WA
              </button>
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Tutup</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script id="settings-data" type="application/json"><%- JSON.stringify(settings) %></script>
    <script id="customers-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
    <script id="odps-data" type="application/json"><%- JSON.stringify(odps).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
    <script id="tickets-data" type="application/json"><%- JSON.stringify(tickets || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
    <script id="optical-data" type="application/json"><%- JSON.stringify(typeof opticalData !== 'undefined' && opticalData ? opticalData : { summary: {}, customers: {} }).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
    <script>
      const appSettings = JSON.parse(document.getElementById('settings-data').textContent || '{}');
      let customers = JSON.parse(document.getElementById('customers-data').textContent || '[]');
      let odps = JSON.parse(document.getElementById('odps-data').textContent || '[]');
      let tickets = JSON.parse(document.getElementById('tickets-data').textContent || '[]');
      let opticalData = JSON.parse(document.getElementById('optical-data').textContent || '{}');

      let isOpticalModeActive = false;
      const customerDropPolylines = [];
      const customerMarkerObjects = [];

      const officeCoords = {
        lat: parseFloat(appSettings.office_lat) || -6.200000,
        lng: parseFloat(appSettings.office_lng) || 106.816666
      };

      // Initialize Map
      const map = L.map('map').setView([officeCoords.lat, officeCoords.lng], 13);

      // Layers
      const darkLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
        className: 'leaflet-tile-dark',
        attribution: '© Google Maps (Dark)'
      });

      const googleHybrid = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
        attribution: '© Google Satellite'
      });

      const googleStreets = L.tileLayer('https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
        attribution: '© Google Streets'
      });

      const activeTheme = (document.documentElement.getAttribute('data-theme') || localStorage.getItem('theme') || 'dark');
      if (activeTheme === 'dark') {
        darkLayer.addTo(map);
      } else {
        googleHybrid.addTo(map);
      }

      const baseMaps = {
        "Mode Gelap (Dark Mode)": darkLayer,
        "Satelit (Hybrid)": googleHybrid,
        "Peta Jalan (Google Streets)": googleStreets
      };

      L.control.layers(baseMaps).addTo(map);

      // Layer Groups for ODC, ODP, and Customers
      const odcGroup = L.layerGroup().addTo(map);
      const odpGroup = L.layerGroup().addTo(map);
      const activeCustGroup = L.layerGroup().addTo(map);
      const freeCustGroup = L.layerGroup().addTo(map);
      const suspendedCustGroup = L.layerGroup().addTo(map);
      const ticketGroup = L.layerGroup().addTo(map);

      // Add Ticket Markers
      tickets.forEach(ticket => {
        if (ticket.lat && ticket.lng) {
          const tLat = parseFloat(ticket.lat);
          const tLng = parseFloat(ticket.lng);

          const marker = L.marker([tLat, tLng], {
            icon: L.divIcon({
              html: '<i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 22px; text-shadow: -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff, 1px 1px 0 #fff;"></i>',
              className: 'custom-div-icon',
              iconSize: [22, 22],
              iconAnchor: [11, 11]
            })
          }).addTo(ticketGroup);

          marker.bindPopup(`
        <div class="popup-dark">
          <h6 style="color: #ef4444; border-bottom: 1px solid #ef4444;"><i class="bi bi-exclamation-triangle-fill me-1"></i>${ticket.category}</h6>
          <div style="font-size:11px">
            <b>Target:</b> ${ticket.target_name || '-'}<br>
            <b>Kendala:</b> <span class="text-danger">${ticket.subject}</span><br>
            <b>Pesan:</b> ${ticket.message}<br>
            <b>Status:</b> <span class="badge bg-warning text-dark">${ticket.status}</span>
          </div>
          <a href="https://www.google.com/maps/dir/?api=1&destination=${tLat},${tLng}" target="_blank" class="btn btn-wa w-100 text-center mt-2" style="background:#ef4444">
            <i class="bi bi-signpost-2"></i> Petunjuk Arah
          </a>
        </div>
      `);
        }
      });

      // Mapping Object ODP/ODC
      const odpMap = {};
      const odpMarkers = {};

      function escapeHtml(str) {
        if (!str && str !== 0) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function getLatLngObject(point) {
        if (!point) return null;
        if (typeof point.lat !== 'undefined' && typeof point.lng !== 'undefined') {
          const lat = parseFloat(point.lat);
          const lng = parseFloat(point.lng);
          return (Number.isFinite(lat) && Number.isFinite(lng)) ? L.latLng(lat, lng) : null;
        }
        if (Array.isArray(point) && point.length >= 2) {
          const lat = parseFloat(point[0]);
          const lng = parseFloat(point[1]);
          return (Number.isFinite(lat) && Number.isFinite(lng)) ? L.latLng(lat, lng) : null;
        }
        return null;
      }

      function calculateCableDistance(path) {
        if (!Array.isArray(path) || path.length < 2) return 0;
        let totalMeters = 0;
        for (let i = 0; i < path.length - 1; i++) {
          const p1 = getLatLngObject(path[i]);
          const p2 = getLatLngObject(path[i + 1]);
          if (p1 && p2) {
            totalMeters += p1.distanceTo(p2);
          }
        }
        return totalMeters;
      }

      function formatCableDistance(meters) {
        if (!Number.isFinite(meters) || meters <= 0) return '0 meter';
        if (meters >= 1000) {
          const km = (meters / 1000).toFixed(2).replace('.', ',');
          const m = Math.round(meters).toLocaleString('id-ID');
          return `${km} km (${m} m)`;
        }
        return `${Math.round(meters).toLocaleString('id-ID')} meter`;
      }

      // Add ODP & ODC Markers
      odps.forEach(odp => {
        odpMap[odp.id] = odp;
        if (odp.lat && odp.lng) {
          const odpLat = parseFloat(odp.lat);
          const odpLng = parseFloat(odp.lng);
          odpMarkers[odp.id] = [odpLat, odpLng];

          const isOdc = odp.type === 'ODC';
          const targetGroup = isOdc ? odcGroup : odpGroup;

          const iconHtml = isOdc
            ? `<div class="marker-odc-box" title="${odp.name} (ODC)"><i class="bi bi-hdd-rack-fill"></i><span class="marker-odc-tag">ODC</span></div>`
            : `<div class="marker-odp-box" title="${odp.name} (ODP)"><i class="bi bi-box-seam-fill"></i><span class="marker-odp-tag">ODP</span></div>`;

          const marker = L.marker([odpLat, odpLng], {
            icon: L.divIcon({
              html: iconHtml,
              className: 'custom-div-icon',
              iconSize: isOdc ? [30, 30] : [26, 26],
              iconAnchor: isOdc ? [15, 15] : [13, 13]
            })
          }).addTo(targetGroup);

          const nodeLabel = isOdc ? 'ODC Cabinet' : 'ODP Box';
          marker.bindPopup(`
        <div class="popup-dark">
          <div class="d-flex align-items-center justify-content-between mb-1">
            <h6>${odp.name}</h6>
            <span class="badge ${isOdc ? 'bg-purple' : 'bg-warning'}" style="font-size:10px; ${isOdc ? 'background:#7c3aed;' : ''}">${nodeLabel}</span>
          </div>
          <div style="font-size:11px">
            <b>OLT:</b> ${odp.olt_name || '-'}<br>
            <b>Port:</b> ${odp.pon_port || '-'}<br>
            <b>Kapasitas:</b> ${odp.port_capacity || (isOdc ? 48 : 16)} Port<br>
            <b>Ket:</b> ${odp.description || '-'}
          </div>
          <a href="https://www.google.com/maps/dir/?api=1&destination=${odp.lat},${odp.lng}" target="_blank" class="btn btn-wa w-100 text-center mt-2" style="background:#3b82f6">
            <i class="bi bi-signpost-2"></i> Petunjuk Arah
          </a>
        </div>
      `);
        }
      });

      const ponColors = [
        '#f59e0b', '#10b981', '#3b82f6', '#ec4899', '#8b5cf6', '#ef4444',
        '#06b6d4', '#f97316', '#14b8a6', '#a855f7', '#6366f1', '#84cc16'
      ];

      const ponColorMap = {};
      let colorIdx = 0;
      odps.forEach(odp => {
        if (odp.olt_id && odp.pon_port && odp.pon_port.trim() !== '') {
          const key = `${odp.olt_id}_${odp.pon_port.trim()}`;
          if (!ponColorMap[key]) {
            ponColorMap[key] = ponColors[colorIdx % ponColors.length];
            colorIdx++;
          }
        }
      });

      // Add Office Marker
      L.marker([officeCoords.lat, officeCoords.lng], {
        icon: L.divIcon({
          html: '<i class="bi bi-building-fill text-primary" style="font-size: 24px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));"></i>',
          className: 'custom-div-icon',
          iconSize: [24, 24],
          iconAnchor: [12, 12]
        })
      }).addTo(map).bindPopup(`
    <div class="popup-dark">
      <h6>Kantor Pusat / NOC</h6>
      <div>Lokasi pusat server & distribusi fiber optik.</div>
    </div>
  `);

      // Draw lines for Feeder / Distribution Cables
      odps.forEach(odp => {
        if (odp.lat && odp.lng) {
          let pathCoords;
          const isOdc = odp.type === 'ODC';
          const nodeGroup = isOdc ? odcGroup : odpGroup;
          const isUplink = !!(odp.parent_odp_id && odpMarkers[odp.parent_odp_id]);

          if (isUplink) {
            const parentCoords = odpMarkers[odp.parent_odp_id];
            pathCoords = [
              [parseFloat(odp.lat), parseFloat(odp.lng)],
              parentCoords
            ];
          } else {
            pathCoords = [
              [parseFloat(odp.lat), parseFloat(odp.lng)],
              [officeCoords.lat, officeCoords.lng]
            ];
          }

          let ponColor = isOdc ? '#a78bfa' : '#94a3b8';
          if (odp.olt_id && odp.pon_port && odp.pon_port.trim() !== '') {
            const key = `${odp.olt_id}_${odp.pon_port.trim()}`;
            ponColor = ponColorMap[key] || (isOdc ? '#a78bfa' : '#94a3b8');
          }

          if (odp.cable_path) {
            try {
              const parsed = JSON.parse(odp.cable_path);
              if (Array.isArray(parsed) && parsed.length >= 2) {
                const cleaned = parsed
                  .filter(p => Array.isArray(p) && p.length >= 2)
                  .map(p => [parseFloat(p[0]), parseFloat(p[1])])
                  .filter(p => Number.isFinite(p[0]) && Number.isFinite(p[1]));
                if (cleaned.length >= 2) pathCoords = cleaned;
              }
            } catch (e) { }
          }

          const cableDistanceMeters = calculateCableDistance(pathCoords);
          const formattedDist = formatCableDistance(cableDistanceMeters);
          const parentOdpObj = odp.parent_odp_id ? odpMap[odp.parent_odp_id] : null;
          const parentType = parentOdpObj ? (parentOdpObj.type || 'ODP') : (isUplink ? 'ODC/ODP' : 'NOC');
          const parentName = parentOdpObj ? parentOdpObj.name : (odp.parent_name || 'Kantor Pusat / NOC');
          const childType = odp.type || 'ODP';

          const tooltipHtml = `
            <div class="cable-tooltip-card">
              <div class="ct-header">
                <i class="bi bi-diagram-3-fill ct-icon-feeder"></i>
                <span class="ct-title">${isUplink ? `Jalur Distribusi (${parentType} ↔ ${childType})` : `Jalur Feeder (NOC ↔ ${childType})`}</span>
                <span class="ct-badge-pon"><i class="bi bi-hdd-network"></i> ${escapeHtml(odp.pon_port ? 'PON ' + odp.pon_port : 'Direct')}</span>
              </div>
              <div class="ct-nodes">
                <div class="ct-node-row">
                  <span class="ct-label"><i class="bi bi-${isUplink ? (parentType === 'ODC' ? 'hdd-rack-fill' : 'box-seam-fill') : 'building-fill'}"></i> Asal:</span>
                  <strong class="ct-val">${escapeHtml(parentName)}</strong>
                </div>
                <div class="ct-node-row">
                  <span class="ct-label"><i class="bi bi-${childType === 'ODC' ? 'hdd-rack-fill' : 'box-seam-fill'}"></i> Tujuan:</span>
                  <strong class="ct-val">${escapeHtml(odp.name)} (${childType})</strong>
                </div>
              </div>
              <div class="ct-distance-box">
                <div class="ct-dist-label"><i class="bi bi-rulers"></i> Panjang Jalur Kabel:</div>
                <div class="ct-dist-val">${formattedDist}</div>
              </div>
              ${odp.olt_name ? `<div class="ct-extra"><i class="bi bi-router"></i> OLT: ${escapeHtml(odp.olt_name)}</div>` : ''}
            </div>
          `;

          const polyline = L.polyline(pathCoords, {
            color: ponColor,
            weight: isOdc ? 5 : 4,
            opacity: 0.9,
            className: 'odp-cable-line'
          }).addTo(nodeGroup);

          polyline.bindTooltip(tooltipHtml, {
            sticky: true,
            direction: 'top',
            offset: [0, -10],
            className: 'custom-cable-tooltip'
          });

          const defaultWeight = isOdc ? 5 : 4;
          polyline.on('mouseover', function () {
            this.setStyle({
              weight: isOdc ? 8 : 7,
              opacity: 1
            });
            if (this.bringToFront) this.bringToFront();
          });

          polyline.on('mouseout', function () {
            this.setStyle({
              weight: defaultWeight,
              opacity: 0.9
            });
          });
        }
      });

      // Add Customer Markers & Drop Cables
      customers.forEach(cust => {
        if (cust.lat && cust.lng) {
          const is_free = (cust.status && String(cust.status).toLowerCase() === 'free') ||
            (cust.package_name && String(cust.package_name).toLowerCase().includes('free')) ||
            (cust.package_price !== undefined && cust.package_price !== null && Number(cust.package_price) === 0 && cust.package_name);
          const is_active = cust.status === 'active' || is_free;

          let iconClass = 'cust-pin-suspended';
          let pulseClass = 'pulse-suspended';
          let custIcon = 'bi-house-x-fill';
          let cableColor = '#f87171';
          let targetGroup = suspendedCustGroup;

          if (is_free) {
            iconClass = 'cust-pin-free';
            pulseClass = 'pulse-free';
            custIcon = 'bi-gift-fill';
            cableColor = '#34d399';
            targetGroup = freeCustGroup;
          } else if (is_active) {
            iconClass = 'cust-pin-active';
            pulseClass = 'pulse-active';
            custIcon = 'bi-house-check-fill';
            cableColor = '#38bdf8';
            targetGroup = activeCustGroup;
          }

          const custLat = parseFloat(cust.lat);
          const custLng = parseFloat(cust.lng);

          const optInfo = opticalData && opticalData.customers ? opticalData.customers[cust.id] : null;
          const optColor = optInfo && optInfo.evaluation ? optInfo.evaluation.color : '#94a3b8';
          const optStatusLabel = optInfo && optInfo.evaluation ? optInfo.evaluation.label : 'Belum Termonitor';
          const optBadgeClass = optInfo && optInfo.evaluation ? optInfo.evaluation.badgeClass : 'ct-status-unknown';
          const rxEstStr = optInfo && optInfo.budget ? optInfo.budget.estimatedRxPowerDbm + ' dBm' : '-';
          const rxActStr = optInfo && optInfo.acs && optInfo.acs.rxPower !== null ? optInfo.acs.rxPower + ' dBm' : (optInfo && optInfo.acs && optInfo.acs.isOnline ? 'Online (N/A)' : 'Offline / -');
          const deltaStr = optInfo && optInfo.evaluation && optInfo.evaluation.deltaDbm !== null ? optInfo.evaluation.deltaDbm + ' dB' : '-';

          // Draw line to ODP if connected
          if (cust.odp_id && odpMarkers[cust.odp_id]) {
            let pathCoords = [
              [custLat, custLng],
              odpMarkers[cust.odp_id]
            ];

            if (cust.cable_path) {
              try {
                const parsed = JSON.parse(cust.cable_path);
                if (Array.isArray(parsed) && parsed.length >= 2) {
                  const cleaned = parsed
                    .filter(p => Array.isArray(p) && p.length >= 2)
                    .map(p => [parseFloat(p[0]), parseFloat(p[1])])
                    .filter(p => Number.isFinite(p[0]) && Number.isFinite(p[1]));
                  if (cleaned.length >= 2) pathCoords = cleaned;
                }
              } catch (e) { }
            }

            const targetOdp = odpMap[cust.odp_id];
            const odpName = targetOdp ? targetOdp.name : (cust.odp_name || 'ODP');
            const odpType = (targetOdp && targetOdp.type === 'ODC') ? 'ODC' : 'ODP';
            const cableDistanceMeters = calculateCableDistance(pathCoords);
            const formattedDist = formatCableDistance(cableDistanceMeters);

            const tooltipHtml = `
              <div class="cable-tooltip-card">
                <div class="ct-header">
                  <i class="bi bi-bezier2 ct-icon-cust"></i>
                  <span class="ct-title">Drop Cable Pelanggan</span>
                  <span class="ct-badge-status ${is_free ? 'ct-status-free' : (is_active ? 'ct-status-active' : 'ct-status-suspended')}">
                    ${is_free ? 'Free' : (is_active ? 'Aktif' : 'Isolir')}
                  </span>
                </div>
                <div class="ct-nodes">
                  <div class="ct-node-row">
                    <span class="ct-label"><i class="bi bi-${odpType === 'ODC' ? 'hdd-rack-fill' : 'box-seam-fill'}"></i> ${odpType}:</span>
                    <strong class="ct-val">${escapeHtml(odpName)}</strong>
                  </div>
                  <div class="ct-node-row">
                    <span class="ct-label"><i class="bi bi-person-fill"></i> Pelanggan:</span>
                    <strong class="ct-val">${escapeHtml(cust.name)}</strong>
                  </div>
                </div>
                <div class="ct-distance-box">
                  <div class="ct-dist-label"><i class="bi bi-rulers"></i> Panjang Jalur Kabel:</div>
                  <div class="ct-dist-val">${formattedDist}</div>
                </div>

                <!-- Bagian Redaman Optik Link Budget & Dual-ACS -->
                <div class="ct-optical-box">
                  <div class="ct-opt-row" style="margin-bottom: 2px;">
                    <span class="ct-opt-lbl"><i class="bi bi-activity" style="color:${optColor};"></i> Status Optik:</span>
                    <span class="badge ${optBadgeClass}" style="font-size:10px; padding:2px 6px;">${optStatusLabel}</span>
                  </div>
                  <div class="ct-opt-row">
                    <span class="ct-opt-lbl"><i class="bi bi-calculator"></i> Est. Link Budget:</span>
                    <strong class="ct-opt-val" style="color:#38bdf8;">${rxEstStr}</strong>
                  </div>
                  <div class="ct-opt-row">
                    <span class="ct-opt-lbl"><i class="bi bi-reception-4"></i> RX Aktual Dual-ACS:</span>
                    <strong class="ct-opt-val" style="color:${optColor};">${rxActStr}</strong>
                  </div>
                  <div class="ct-opt-row">
                    <span class="ct-opt-lbl"><i class="bi bi-arrow-left-right"></i> Deviasi (Δ):</span>
                    <strong class="ct-opt-val" style="color:${deltaStr !== '-' && parseFloat(deltaStr) > 4 ? '#f87171' : '#cbd5e1'};">${deltaStr}</strong>
                  </div>
                </div>

                <div style="margin-top: 6px; text-align: center;">
                  <button type="button" class="btn btn-sm" onclick="openOpticalCalculatorModal(${cust.id})" style="width: 100%; font-size: 10.5px; padding: 4px 8px; border-radius: 6px; background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35);">
                    <i class="bi bi-calculator-fill me-1"></i> Buka Simulasi Redaman
                  </button>
                </div>
                ${cust.package_name ? `<div class="ct-extra"><i class="bi bi-speedometer2"></i> Paket: ${escapeHtml(cust.package_name)}</div>` : ''}
              </div>
            `;

            const polyline = L.polyline(pathCoords, {
              color: cableColor,
              weight: 3,
              opacity: 0.85,
              dashArray: '10, 10',
              className: 'flowing-line'
            }).addTo(targetGroup);

            customerDropPolylines.push({
              polyline,
              customerId: cust.id,
              defaultColor: cableColor,
              opticalColor: optColor
            });

            polyline.bindTooltip(tooltipHtml, {
              sticky: true,
              direction: 'top',
              offset: [0, -10],
              className: 'custom-cable-tooltip'
            });

            polyline.on('mouseover', function () {
              this.setStyle({
                weight: 6,
                opacity: 1
              });
              if (this.bringToFront) this.bringToFront();
            });

            polyline.on('mouseout', function () {
              this.setStyle({
                weight: isOpticalModeActive ? 4 : 3,
                opacity: 0.85
              });
            });
          }

          const markerHtml = `
        <div class="cust-pin-wrapper" title="${cust.name}">
          <div class="cust-pin-pulse ${pulseClass}"></div>
          <div class="cust-pin ${iconClass}">
            <i class="bi ${custIcon}"></i>
          </div>
        </div>
      `;

          const marker = L.marker([custLat, custLng], {
            icon: L.divIcon({
              html: markerHtml,
              className: 'custom-div-icon',
              iconSize: [28, 28],
              iconAnchor: [14, 14]
            })
          }).addTo(targetGroup);

          customerMarkerObjects.push({
            marker,
            customerId: cust.id,
            defaultHtml: markerHtml,
            opticalColor: optColor
          });

          function normalizePhone(phone) {
            const raw = String(phone || '').trim();
            const digits = raw.replace(/\D/g, '');
            if (!digits) return '';
            if (digits.startsWith('62')) return digits;
            if (digits.startsWith('0')) return `62${digits.slice(1)}`;
            if (digits.length >= 9) return `62${digits}`;
            return digits;
          }
          const normalizedPhone = normalizePhone(cust.phone);
          const waLink = normalizedPhone ? `https://wa.me/${normalizedPhone}?text=${encodeURIComponent('Halo ' + String(cust.name || '').trim())}` : '#';

          marker.bindPopup(`
        <div class="popup-dark">
          <h6>${cust.name}</h6>
          <div style="font-size:11px">
            <b>Alamat:</b> ${cust.address}<br>
            <b>Paket:</b> ${cust.package_name || '-'}<br>
            <b>Status:</b> ${cust.status}<br>
            <b>Redaman Optik:</b> <strong style="color:${optColor}">${rxActStr}</strong> (Est: ${rxEstStr})
          </div>
          <div class="d-flex gap-1 mt-2">
            <button onclick="openOpticalCalculatorModal(${cust.id})" class="btn btn-sm btn-outline-success flex-grow-1 text-center" style="font-size:11px; padding:4px 6px;">
              <i class="bi bi-calculator-fill"></i> Redaman
            </button>
            <a href="${waLink}" target="_blank" class="btn btn-wa flex-grow-1 text-center" style="font-size:11px; padding:4px 6px;">
              <i class="bi bi-whatsapp"></i> Chat
            </a>
            <a href="https://www.google.com/maps/dir/?api=1&destination=${cust.lat},${cust.lng}" target="_blank" class="btn btn-wa flex-grow-1 text-center" style="background:#3b82f6; font-size:11px; padding:4px 6px;">
              <i class="bi bi-geo-alt"></i> Rute
            </a>
          </div>
        </div>
      `);
        }
      });

      // Geolocation for Tech
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(position => {
          const myLat = position.coords.latitude;
          const myLng = position.coords.longitude;

          L.marker([myLat, myLng], {
            icon: L.divIcon({
              html: '<i class="bi bi-person-circle text-white" style="font-size:24px; text-shadow: 0 0 10px #3b82f6"></i>',
              className: 'custom-div-icon',
              iconSize: [24, 24],
              iconAnchor: [12, 12]
            })
          }).addTo(map).bindPopup("<div class='popup-dark text-center'><b>Posisi Anda</b></div>");
        });
      }

      // Auto zoom
      const group = L.featureGroup(Object.values(map._layers).filter(l => l instanceof L.Marker || l instanceof L.CircleMarker));
      if (group.getLayers().length > 0) {
        map.fitBounds(group.getBounds().pad(0.1));
      }

      window.toggleLayers = function () {
        const showOdc = document.getElementById('toggle-odc') ? document.getElementById('toggle-odc').checked : true;
        const showOdp = document.getElementById('toggle-odp') ? document.getElementById('toggle-odp').checked : true;
        const showActive = document.getElementById('toggle-active') ? document.getElementById('toggle-active').checked : true;
        const showFree = document.getElementById('toggle-free') ? document.getElementById('toggle-free').checked : true;
        const showSuspended = document.getElementById('toggle-suspended') ? document.getElementById('toggle-suspended').checked : true;
        const showTickets = document.getElementById('toggle-tickets') ? document.getElementById('toggle-tickets').checked : true;

        if (showOdc) {
          if (!map.hasLayer(odcGroup)) map.addLayer(odcGroup);
          localStorage.setItem('map_show_odc', 'true');
        } else {
          if (map.hasLayer(odcGroup)) map.removeLayer(odcGroup);
          localStorage.setItem('map_show_odc', 'false');
        }

        if (showOdp) {
          if (!map.hasLayer(odpGroup)) map.addLayer(odpGroup);
          localStorage.setItem('map_show_odp', 'true');
        } else {
          if (map.hasLayer(odpGroup)) map.removeLayer(odpGroup);
          localStorage.setItem('map_show_odp', 'false');
        }

        if (showActive) {
          if (!map.hasLayer(activeCustGroup)) map.addLayer(activeCustGroup);
          localStorage.setItem('map_show_active', 'true');
        } else {
          if (map.hasLayer(activeCustGroup)) map.removeLayer(activeCustGroup);
          localStorage.setItem('map_show_active', 'false');
        }

        if (showFree) {
          if (!map.hasLayer(freeCustGroup)) map.addLayer(freeCustGroup);
          localStorage.setItem('map_show_free', 'true');
        } else {
          if (map.hasLayer(freeCustGroup)) map.removeLayer(freeCustGroup);
          localStorage.setItem('map_show_free', 'false');
        }

        if (showSuspended) {
          if (!map.hasLayer(suspendedCustGroup)) map.addLayer(suspendedCustGroup);
          localStorage.setItem('map_show_suspended', 'true');
        } else {
          if (map.hasLayer(suspendedCustGroup)) map.removeLayer(suspendedCustGroup);
          localStorage.setItem('map_show_suspended', 'false');
        }

        if (showTickets) {
          if (!map.hasLayer(ticketGroup)) map.addLayer(ticketGroup);
          localStorage.setItem('map_show_tickets', 'true');
        } else {
          if (map.hasLayer(ticketGroup)) map.removeLayer(ticketGroup);
          localStorage.setItem('map_show_tickets', 'false');
        }
      };

      // Toggle Mode Redaman Optik (Heatmap kualitas kabel & marker)
      window.toggleOpticalMode = function () {
        const checkEl = document.getElementById('toggle-optical-mode');
        isOpticalModeActive = checkEl ? checkEl.checked : false;

        const legendCard = document.getElementById('opticalLegendCard');
        if (legendCard) {
          if (isOpticalModeActive) {
            legendCard.classList.add('show');
          } else {
            legendCard.classList.remove('show');
          }
        }

        customerDropPolylines.forEach(item => {
          if (item && item.polyline) {
            if (isOpticalModeActive) {
              item.polyline.setStyle({
                color: item.opticalColor || '#94a3b8',
                weight: 4,
                dashArray: null
              });
            } else {
              item.polyline.setStyle({
                color: item.defaultColor,
                weight: 3,
                dashArray: '10, 10'
              });
            }
          }
        });

        customerMarkerObjects.forEach(item => {
          if (item && item.marker) {
            if (isOpticalModeActive) {
              const glowHtml = `
                <div class="cust-pin-wrapper">
                  <div class="cust-pin-pulse" style="background:${item.opticalColor}; opacity:0.6;"></div>
                  <div class="cust-pin" style="background:${item.opticalColor}; border:2px solid #ffffff; box-shadow: 0 0 14px ${item.opticalColor}; color:#ffffff;">
                    <i class="bi bi-activity"></i>
                  </div>
                </div>
              `;
              item.marker.setIcon(L.divIcon({
                html: glowHtml,
                className: 'custom-div-icon',
                iconSize: [28, 28],
                iconAnchor: [14, 14]
              }));
            } else {
              item.marker.setIcon(L.divIcon({
                html: item.defaultHtml,
                className: 'custom-div-icon',
                iconSize: [28, 28],
                iconAnchor: [14, 14]
              }));
            }
          }
        });
      };

      function getSplitterLossClient(ratio) {
        const map = {
          '1:1': 0.0, 'none': 0.0, 'direct': 0.0,
          '1:2': 3.7, '1:4': 7.2, '1:8': 10.5,
          '1:16': 13.8, '1:32': 17.1, '1:64': 20.5
        };
        return map[ratio] !== undefined ? map[ratio] : 0.0;
      }

      window.openOpticalCalculatorModal = function (customerId) {
        const select = document.getElementById('calc-customer-select');
        if (select) {
          if (customerId) {
            select.value = String(customerId);
          } else if (!select.value && customers.length > 0) {
            select.value = String(customers[0].id);
          }
          onSelectCalcCustomer(select.value);
        }

        const modalEl = document.getElementById('opticalCalculatorModal');
        if (modalEl && typeof bootstrap !== 'undefined') {
          const bsModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
          bsModal.show();
        } else if (modalEl) {
          modalEl.classList.add('show');
          modalEl.style.display = 'block';
        }
      };

      window.onSelectCalcCustomer = function (customerId) {
        const metaBox = document.getElementById('calc-customer-meta');
        if (!customerId) {
          if (metaBox) metaBox.style.display = 'none';
          runOpticalSimulation();
          return;
        }

        const optCust = opticalData && opticalData.customers ? opticalData.customers[customerId] : null;
        const custObj = customers.find(c => String(c.id) === String(customerId));

        if (metaBox) {
          metaBox.style.display = 'block';
          document.getElementById('ccm-name').textContent = custObj ? custObj.name : '-';
          document.getElementById('ccm-odp').textContent = optCust ? optCust.odpName : (custObj && custObj.odp_name ? custObj.odp_name : '-');
          const totalMeters = optCust && optCust.budget ? optCust.budget.totalCableDistanceMeters : 0;
          document.getElementById('ccm-dist').textContent = formatCableDistance(totalMeters);
        }

        if (optCust && optCust.budget) {
          document.getElementById('input-drop-dist').value = optCust.budget.dropDistanceMeters || 150;
          document.getElementById('input-dist-dist').value = optCust.budget.distributionDistanceMeters || 500;
          document.getElementById('input-feeder-dist').value = optCust.budget.feederDistanceMeters || 1000;
          document.getElementById('input-tx-power').value = optCust.budget.txPowerDbm || 3.5;
          document.getElementById('input-odc-ratio').value = optCust.budget.odcSplitRatio || '1:4';
          document.getElementById('input-odp-ratio').value = optCust.budget.odpSplitRatio || '1:8';
          document.getElementById('input-attenuation').value = 0.35;
          document.getElementById('input-connector').value = 1.5;
        }

        runOpticalSimulation();
      };

      window.onOpticalParamChange = function () {
        runOpticalSimulation();
      };

      window.runOpticalSimulation = function () {
        const dropDist = parseFloat(document.getElementById('input-drop-dist').value) || 0;
        const distDist = parseFloat(document.getElementById('input-dist-dist').value) || 0;
        const feederDist = parseFloat(document.getElementById('input-feeder-dist').value) || 0;
        const txPower = parseFloat(document.getElementById('input-tx-power').value) || 3.5;
        const odcRatio = document.getElementById('input-odc-ratio').value || '1:4';
        const odpRatio = document.getElementById('input-odp-ratio').value || '1:8';
        const attenuation = parseFloat(document.getElementById('input-attenuation').value) || 0.35;
        const connectorLoss = parseFloat(document.getElementById('input-connector').value) || 1.5;

        document.getElementById('val-drop-dist').textContent = `${Math.round(dropDist)} meter`;
        document.getElementById('val-dist-dist').textContent = `${Math.round(distDist)} meter`;
        document.getElementById('val-feeder-dist').textContent = `${Math.round(feederDist)} meter`;
        document.getElementById('val-tx-power').textContent = `${txPower >= 0 ? '+' : ''}${txPower.toFixed(2)} dBm`;
        document.getElementById('val-attenuation').textContent = `${attenuation.toFixed(2)} dB/km`;
        document.getElementById('val-connector').textContent = `${connectorLoss.toFixed(2)} dB`;

        const feederLoss = (feederDist / 1000) * attenuation;
        const distLoss = (distDist / 1000) * attenuation;
        const dropLoss = (dropDist / 1000) * attenuation;
        const totalCableDist = feederDist + distDist + dropDist;
        const totalCableLoss = feederLoss + distLoss + dropLoss;

        const odcLoss = getSplitterLossClient(odcRatio);
        const odpLoss = getSplitterLossClient(odpRatio);
        const totalSplitterLoss = odcLoss + odpLoss;

        const totalLoss = totalCableLoss + totalSplitterLoss + connectorLoss;
        const estRx = txPower - totalLoss;

        document.getElementById('topo-tx-display').textContent = `${txPower >= 0 ? '+' : ''}${txPower.toFixed(2)} dBm`;
        document.getElementById('topo-feeder-loss').textContent = `-${feederLoss.toFixed(2)} dB`;
        document.getElementById('topo-odc-ratio').textContent = `${odcRatio} (${odcLoss.toFixed(1)} dB)`;
        document.getElementById('topo-dist-loss').textContent = `-${distLoss.toFixed(2)} dB`;
        document.getElementById('topo-odp-ratio').textContent = `${odpRatio} (${odpLoss.toFixed(1)} dB)`;
        document.getElementById('topo-drop-loss').textContent = `-${dropLoss.toFixed(2)} dB`;
        document.getElementById('topo-rx-display').textContent = `${estRx.toFixed(2)} dBm`;

        document.getElementById('res-breakdown-cable-dist').textContent = `${(totalCableDist / 1000).toFixed(2)} km (${Math.round(totalCableDist).toLocaleString('id-ID')} m)`;
        document.getElementById('res-breakdown-cable-loss').textContent = `${totalCableLoss.toFixed(2)} dB`;
        document.getElementById('res-breakdown-splitter-loss').textContent = `${totalSplitterLoss.toFixed(2)} dB`;
        document.getElementById('res-breakdown-conn-loss').textContent = `${connectorLoss.toFixed(2)} dB`;
        document.getElementById('res-breakdown-total-loss').textContent = `${totalLoss.toFixed(2)} dB`;
        document.getElementById('res-est-rx').textContent = `${estRx.toFixed(2)} dBm`;

        const custId = document.getElementById('calc-customer-select').value;
        const optCust = (custId && opticalData && opticalData.customers) ? opticalData.customers[custId] : null;

        let actRx = null;
        let acsSource = 'Built-in ACS';
        let acsTime = '-';

        if (optCust && optCust.acs) {
          actRx = optCust.acs.rxPower;
          acsSource = optCust.acs.acsSource || 'Dual-ACS';
          acsTime = optCust.acs.lastInform ? new Date(optCust.acs.lastInform).toLocaleTimeString('id-ID') : '-';
        }

        const resActEl = document.getElementById('res-act-rx');
        const resDeltaEl = document.getElementById('res-delta-rx');
        const resBadge = document.getElementById('res-badge-status');
        const diagBox = document.getElementById('res-diagnosis-box');
        const diagIcon = document.getElementById('res-diag-icon');
        const diagTitle = document.getElementById('res-diag-title');
        const diagDesc = document.getElementById('res-diag-desc');
        const diagRec = document.getElementById('res-diag-rec');

        document.getElementById('res-acs-source').textContent = acsSource;
        document.getElementById('res-acs-time').textContent = acsTime;

        if (actRx !== null && Number.isFinite(actRx)) {
          resActEl.textContent = `${actRx.toFixed(2)} dBm`;
          const delta = Math.abs(actRx - estRx);
          resDeltaEl.textContent = `${delta.toFixed(2)} dB`;

          let statusLabel = 'Optimal / Prima';
          let statusBadgeClass = 'ct-status-optimal';
          let boxBorder = 'rgba(16, 185, 129, 0.4)';
          let boxBg = 'rgba(16, 185, 129, 0.12)';
          let iconClass = 'bi-shield-check';
          let descText = 'Redaman optik sangat ideal, transmisi GPON berkinerja prima.';
          let recText = 'Rekomendasi: Koneksi optik stabil. Tidak memerlukan tindakan pemeliharaan.';

          if (actRx > -8.0) {
            statusLabel = 'Sinyal Overload';
            statusBadgeClass = 'ct-status-critical';
            boxBorder = 'rgba(236, 72, 153, 0.4)';
            boxBg = 'rgba(236, 72, 153, 0.12)';
            iconClass = 'bi-exclamation-octagon-fill';
            descText = 'Sinyal optik terlalu kuat (> -8 dBm). Berisiko merusak receiver ONT.';
            recText = 'Rekomendasi: Pasang optical attenuator atau naikkan rasio splitter ODP.';
          } else if (actRx < -29.0) {
            statusLabel = 'Kritis / Redaman Buruk';
            statusBadgeClass = 'ct-status-critical';
            boxBorder = 'rgba(239, 68, 68, 0.4)';
            boxBg = 'rgba(239, 68, 68, 0.12)';
            iconClass = 'bi-slash-circle-fill';
            descText = 'Sinyal di bawah sensitivitas minimum receiver ONT (< -29 dBm). Rawan gangguan disconnect.';
            recText = 'Rekomendasi: Periksa tekukan kabel drop (macro-bending), bersihkan konektor SC/APC, atau uji redaman dengan OPM.';
          } else if (actRx < -27.0) {
            statusLabel = 'Peringatan / Sinyal Rendah';
            statusBadgeClass = 'ct-status-warning';
            boxBorder = 'rgba(249, 115, 22, 0.4)';
            boxBg = 'rgba(249, 115, 22, 0.12)';
            iconClass = 'bi-exclamation-triangle-fill';
            descText = 'Sinyal mendekati ambang batas putus (-27 s/d -28.9 dBm).';
            recText = 'Rekomendasi: Inspeksi jalur kabel dan pastikan adapter ODP tertancap rapat.';
          } else if (actRx < -23.0) {
            statusLabel = 'Standar / Wajar';
            statusBadgeClass = 'ct-status-normal';
            boxBorder = 'rgba(245, 158, 11, 0.4)';
            boxBg = 'rgba(245, 158, 11, 0.12)';
            iconClass = 'bi-info-circle-fill';
            descText = 'Kualitas sinyal dalam batas operasional wajar FTTH GPON.';
            recText = 'Rekomendasi: Link aman dan dapat diandalkan.';
          }

          if (delta > 4.5) {
            descText += ` Perhatian: Deviasi tinggi (${delta.toFixed(2)} dB di bawah estimasi). Kemungkinan besar terdapat lekukan tajam kabel atau sambungan kotor.`;
          }

          resBadge.textContent = statusLabel;
          resBadge.className = `badge ${statusBadgeClass}`;
          diagBox.style.borderColor = boxBorder;
          diagBox.style.background = boxBg;
          diagIcon.className = `bi ${iconClass}`;
          diagTitle.textContent = statusLabel;
          diagDesc.textContent = descText;
          diagRec.innerHTML = `<i class="bi bi-tools me-1"></i> ${recText}`;
        } else {
          resActEl.textContent = 'Belum Ada';
          resDeltaEl.textContent = '-';
          resBadge.textContent = 'Estimasi Teoretis Saja';
          resBadge.className = 'badge ct-status-unknown';
          diagBox.style.borderColor = 'rgba(56, 189, 248, 0.3)';
          diagBox.style.background = 'rgba(56, 189, 248, 0.08)';
          diagIcon.className = 'bi bi-info-circle';
          diagTitle.textContent = 'Simulasi Desain Link Budget';
          diagDesc.textContent = `Berdasarkan parameter topologi kabel, estimasi daya terima pada ONT adalah ${estRx.toFixed(2)} dBm.`;
          diagRec.innerHTML = '<i class="bi bi-broadcast me-1"></i> Hubungkan ONT ke Dual-ACS untuk mendapatkan verifikasi redaman aktual secara real-time.';
        }
      };

      window.resetOpticalSimulation = function () {
        document.getElementById('input-drop-dist').value = 150;
        document.getElementById('input-dist-dist').value = 500;
        document.getElementById('input-feeder-dist').value = 1000;
        document.getElementById('input-tx-power').value = 3.5;
        document.getElementById('input-odc-ratio').value = '1:4';
        document.getElementById('input-odp-ratio').value = '1:8';
        document.getElementById('input-attenuation').value = 0.35;
        document.getElementById('input-connector').value = 1.5;
        runOpticalSimulation();
      };

      window.refreshOpticalLive = async function () {
        try {
          const res = await fetch('/tech/api/optical-budget/live');
          const json = await res.json();
          if (json.ok && json.data) {
            opticalData = json.data;
            runOpticalSimulation();
            if (isOpticalModeActive) {
              toggleOpticalMode();
            }
          }
        } catch (err) {
          console.error("Gagal refresh live optical data:", err);
        }
      };

      // ═════════════════════════════════════════════════════════════════════════
      // MASS OUTAGE & FIBER CUT AUTO-DETECTION ENGINE (TEKNISI LAPANGAN)
      // ═════════════════════════════════════════════════════════════════════════
      let fiberCutIncidents = [];
      let fiberCutLayerGroup = L.layerGroup().addTo(map);
      let currentIncident = null;
      let isFiberCutLayerVisible = true;

      window.toggleFiberCutLayer = function () {
        const chk = document.getElementById('toggle-fiber-cut');
        isFiberCutLayerVisible = chk ? chk.checked : true;
        if (!map) return;
        if (isFiberCutLayerVisible) {
          if (!map.hasLayer(fiberCutLayerGroup)) map.addLayer(fiberCutLayerGroup);
        } else {
          if (map.hasLayer(fiberCutLayerGroup)) map.removeLayer(fiberCutLayerGroup);
        }
      };

      async function pollFiberCutDetection() {
        try {
          const res = await fetch('/tech/api/fiber-cuts/detect');
          const data = await res.json();
          if (data && data.ok) {
            renderFiberCutData(data);
          }
        } catch (err) {
          console.error('[TechMap FiberCut] Error fetching detection:', err);
        }
      }

      function renderFiberCutData(result) {
        fiberCutIncidents = result.incidents || [];
        fiberCutLayerGroup.clearLayers();

        const badgeCount = document.getElementById('fiberCutBadgeCount');
        const banner = document.getElementById('massOutageBanner');

        if (badgeCount) {
          if (fiberCutIncidents.length > 0) {
            badgeCount.textContent = fiberCutIncidents.length;
            badgeCount.style.display = 'inline-block';
          } else {
            badgeCount.style.display = 'none';
          }
        }

        if (fiberCutIncidents.length > 0) {
          currentIncident = fiberCutIncidents[0];
          if (banner) {
            banner.classList.add('show');
            const mobTitle = document.getElementById('mobTitle');
            const mobBadge = document.getElementById('mobBadge');
            const mobDesc = document.getElementById('mobDesc');

            if (mobTitle) mobTitle.textContent = currentIncident.title;
            if (mobBadge) mobBadge.textContent = currentIncident.severity || 'CRITICAL';
            if (mobDesc) {
              const segText = currentIncident.level || 'Jalur Distribusi';
              const offCount = currentIncident.offlineCount || 0;
              const offRatio = currentIncident.offlineRatio || currentIncident.offlineChildOdpRatio || 0;
              mobDesc.textContent = `${segText}: ${offCount} Pelanggan Terputus (${offRatio}%). Segera inspeksi jalur ${currentIncident.parentNodeName} ↔ ${currentIncident.targetNodeName}.`;
            }
          }
        } else {
          currentIncident = null;
          if (banner) banner.classList.remove('show');
        }

        // Gambar visualisasi polyline & marker berdenyut
        fiberCutIncidents.forEach((inc) => {
          if (Array.isArray(inc.cableCoords) && inc.cableCoords.length >= 2) {
            const cutLine = L.polyline(inc.cableCoords, {
              color: '#ef4444',
              weight: 7,
              opacity: 0.95,
              className: 'cable-fiber-cut',
              lineCap: 'round',
              lineJoin: 'round'
            });

            cutLine.bindTooltip(`
              <div style="font-family:sans-serif; padding:4px 6px;">
                <div style="font-weight:900; color:#ef4444; font-size:11.5px; display:flex; align-items:center; gap:4px;">
                  <i class="bi bi-exclamation-octagon-fill"></i> PUTUS KABEL (${inc.severity})
                </div>
                <div style="font-size:11px; color:#f8fafc; font-weight:700; margin-top:2px;">
                  ${inc.title}
                </div>
                <div style="font-size:10.5px; color:#cbd5e1; margin-top:2px;">
                  Padam: <b style="color:#f87171;">${inc.offlineCount}/${inc.totalCustomers} (${inc.offlineRatio || inc.offlineChildOdpRatio}%)</b><br>
                  Tap untuk rincian
                </div>
              </div>
            `, { sticky: true, className: 'custom-cable-tooltip' });

            cutLine.on('click', () => {
              openMassOutageModal(inc.incidentId);
            });

            fiberCutLayerGroup.addLayer(cutLine);
          }

          if (inc.centroid) {
            const pulseIcon = L.divIcon({
              className: 'custom-div-icon',
              html: `<div class="marker-cut-pulse" style="width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:11px;"><i class="bi bi-x-octagon-fill"></i></div>`,
              iconSize: [24, 24],
              iconAnchor: [12, 12]
            });
            const pulseMarker = L.marker(inc.centroid, { icon: pulseIcon });
            pulseMarker.on('click', () => {
              openMassOutageModal(inc.incidentId);
            });
            fiberCutLayerGroup.addLayer(pulseMarker);
          }
        });

        if (!isFiberCutLayerVisible && map.hasLayer(fiberCutLayerGroup)) {
          map.removeLayer(fiberCutLayerGroup);
        }
      }

      window.focusCurrentIncident = function () {
        if (!currentIncident) return;
        window.focusIncidentCable(currentIncident.incidentId);
      };

      window.focusIncidentCable = function (incidentId) {
        const inc = fiberCutIncidents.find(i => i.incidentId === incidentId);
        if (!inc || !map) return;

        if (Array.isArray(inc.cableCoords) && inc.cableCoords.length >= 2) {
          const bounds = L.latLngBounds(inc.cableCoords);
          map.fitBounds(bounds, { padding: [60, 60], maxZoom: 18, animate: true, duration: 1.2 });
        } else if (inc.centroid) {
          map.flyTo(inc.centroid, 17, { duration: 1.2 });
        }
      };

      window.openCurrentIncidentModal = function () {
        if (!currentIncident) return;
        window.openMassOutageModal(currentIncident.incidentId);
      };

      window.openMassOutageModal = function (incidentId) {
        const inc = fiberCutIncidents.find(i => i.incidentId === incidentId);
        if (!inc) return;
        currentIncident = inc;

        document.getElementById('mom-title').textContent = inc.title;
        document.getElementById('mom-subtitle').textContent = `Insiden: ${inc.incidentId} • Terdeteksi: ${new Date(inc.detectedAt).toLocaleTimeString('id-ID')}`;
        document.getElementById('mom-severity-badge').textContent = inc.severity;
        document.getElementById('mom-level').textContent = inc.level;
        document.getElementById('mom-target').textContent = `${inc.targetNodeName} (${inc.targetNodeType})`;
        document.getElementById('mom-olt-pon').textContent = `${inc.oltName} (Port: ${inc.ponPort})`;
        document.getElementById('mom-impact').textContent = `${inc.offlineCount} / ${inc.totalCustomers} (${inc.offlineRatio || inc.offlineChildOdpRatio}%)`;

        const instEl = document.getElementById('mom-instruction');
        if (instEl) {
          instEl.innerHTML = `Telusuri jalur fisik antara <b>${inc.parentNodeName}</b> dan <b>${inc.targetNodeName}</b>. Siapkan fusion splicer dan lakukan pengukuran OTDR dari titik ${inc.parentNodeName} untuk melacak lokasi core putus.`;
        }

        const tbody = document.getElementById('mom-cust-table-body');
        const countSpan = document.getElementById('mom-cust-count');
        if (tbody) {
          tbody.innerHTML = '';
          const custs = inc.affectedCustomers || [];
          if (countSpan) countSpan.textContent = custs.length;

          if (custs.length === 0) {
            tbody.innerHTML = `<tr><td colspan="3" style="text-align:center; padding:10px; color:#94a3b8;">Tidak ada pelanggan langsung terdaftar.</td></tr>`;
          } else {
            custs.forEach((c, idx) => {
              const tr = document.createElement('tr');
              tr.style.borderBottom = '1px solid rgba(148, 163, 184, 0.1)';
              tr.innerHTML = `
                <td style="padding: 5px 6px; color:#94a3b8;">${idx + 1}</td>
                <td style="padding: 5px 6px; font-weight:700; color:#f8fafc;">${c.name}</td>
                <td style="padding: 5px 6px;"><span class="badge bg-danger" style="font-size:9.5px;">${c.reason || 'Offline'}</span></td>
              `;
              tbody.appendChild(tr);
            });
          }
        }

        const modalEl = document.getElementById('massOutageModal');
        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
          bootstrap.Modal.getOrCreateInstance(modalEl).show();
        } else {
          modalEl.style.display = 'block';
        }
      };

      window.createCurrentIncidentTicket = async function () {
        if (!currentIncident) return;
        await triggerAutoTicket(currentIncident.incidentId);
      };

      async function triggerAutoTicket(incidentId) {
        try {
          const res = await fetch('/tech/api/fiber-cuts/create-ticket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ incidentId })
          });
          const json = await res.json();
          if (json.ok && json.result) {
            alert(json.result.message || 'Tiket berhasil dibuat!');
            if (json.result.ticketId) {
              window.location.reload();
            }
          } else {
            alert('Gagal membuat tiket: ' + (json.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Error memproses tiket: ' + err.message);
        }
      }

      window.broadcastCurrentIncidentWa = async function () {
        if (!currentIncident) return;
        await triggerBroadcastWa(currentIncident.incidentId);
      };

      async function triggerBroadcastWa(incidentId) {
        if (!confirm('Kirim siaran WhatsApp darurat ke tim teknisi & admin?')) return;
        try {
          const res = await fetch('/tech/api/fiber-cuts/notify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ incidentId })
          });
          const json = await res.json();
          if (json.ok) {
            alert(json.message || 'Notifikasi darurat berhasil dikirim!');
          } else {
            alert('Gagal mengirim WhatsApp: ' + (json.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Error broadcast: ' + err.message);
        }
      }

      // Mulai polling deteksi otomatis
      document.addEventListener('DOMContentLoaded', () => {
        pollFiberCutDetection();
        setInterval(pollFiberCutDetection, 30000);
      });

      // Load preferences
      const prefOdc = localStorage.getItem('map_show_odc') !== 'false';
      const prefOdp = localStorage.getItem('map_show_odp') !== 'false';
      const prefActive = localStorage.getItem('map_show_active') !== 'false';
      const prefFree = localStorage.getItem('map_show_free') !== 'false';
      const prefSuspended = localStorage.getItem('map_show_suspended') !== 'false';
      const prefTickets = localStorage.getItem('map_show_tickets') !== 'false';

      if (document.getElementById('toggle-odc')) document.getElementById('toggle-odc').checked = prefOdc;
      if (document.getElementById('toggle-odp')) document.getElementById('toggle-odp').checked = prefOdp;
      if (document.getElementById('toggle-active')) document.getElementById('toggle-active').checked = prefActive;
      if (document.getElementById('toggle-free')) document.getElementById('toggle-free').checked = prefFree;
      if (document.getElementById('toggle-suspended')) document.getElementById('toggle-suspended').checked = prefSuspended;
      if (document.getElementById('toggle-tickets')) document.getElementById('toggle-tickets').checked = prefTickets;

      if (!prefOdc) map.removeLayer(odcGroup);
      if (!prefOdp) map.removeLayer(odpGroup);
      if (!prefActive) map.removeLayer(activeCustGroup);
      if (!prefFree) map.removeLayer(freeCustGroup);
      if (!prefSuspended) map.removeLayer(suspendedCustGroup);
      if (!prefTickets) map.removeLayer(ticketGroup);

      // Auto zoom to markers if exist
      const allBoundsCoords = [];
      if (Array.isArray(odps)) {
        odps.forEach(o => {
          if (o.lat && o.lng && !isNaN(parseFloat(o.lat)) && !isNaN(parseFloat(o.lng))) {
            allBoundsCoords.push([parseFloat(o.lat), parseFloat(o.lng)]);
          }
        });
      }
      if (Array.isArray(customers)) {
        customers.forEach(c => {
          if (c.lat && c.lng && !isNaN(parseFloat(c.lat)) && !isNaN(parseFloat(c.lng))) {
            allBoundsCoords.push([parseFloat(c.lat), parseFloat(c.lng)]);
          }
        });
      }
      if (allBoundsCoords.length > 0) {
        map.fitBounds(L.latLngBounds(allBoundsCoords).pad(0.08));
      }

      // Fix for blank map on load
      setTimeout(() => {
        map.invalidateSize();
      }, 500);
    </script>

    <%- include('partials/bottom_nav') %>