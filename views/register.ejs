<!DOCTYPE html>
<html lang="id" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pendaftaran Pelanggan Baru | <%= settings.company_header %></title>
  
  <script>
    (function() {
      const savedTheme = localStorage.getItem('customer_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- CSS & Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0b0f19">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="icon" href="/img/logo.png">
  
  <style>
    :root {
      --bg-dark: #0b0f19;
      --card-bg: rgba(17, 24, 39, 0.75);
      --card-border: rgba(255, 255, 255, 0.08);
      --input-bg: rgba(15, 23, 42, 0.65);
      --input-border: rgba(255, 255, 255, 0.12);
      --hero-bg: linear-gradient(145deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.95) 100%);
      --hero-title-gradient: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
      --feature-icon-bg: rgba(99, 102, 241, 0.12);
      --feature-icon-border: rgba(99, 102, 241, 0.3);
      --feature-icon-color: #818cf8;
      --primary-gradient: linear-gradient(135deg, #6366f1 0%, #3b82f6 100%);
      --accent-glow: rgba(99, 102, 241, 0.25);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-heading: #f1f5f9;
      --pkg-card-bg: rgba(15, 23, 42, 0.5);
      --pkg-card-hover: rgba(30, 41, 59, 0.5);
      --modal-bg: #0f172a;
      --modal-border: rgba(255, 255, 255, 0.12);
      --modal-text: #f8fafc;
      --toggle-bg: rgba(30, 41, 59, 0.7);
      --toggle-border: rgba(255, 255, 255, 0.15);
      --toggle-text: #e2e8f0;
    }

    [data-theme="light"] {
      --bg-dark: #f1f5f9;
      --card-bg: rgba(255, 255, 255, 0.92);
      --card-border: rgba(203, 213, 225, 0.8);
      --input-bg: rgba(248, 250, 252, 0.9);
      --input-border: rgba(203, 213, 225, 0.9);
      --hero-bg: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
      --hero-title-gradient: linear-gradient(135deg, #0f172a 0%, #334155 100%);
      --feature-icon-bg: rgba(99, 102, 241, 0.08);
      --feature-icon-border: rgba(99, 102, 241, 0.2);
      --feature-icon-color: #4f46e5;
      --accent-glow: rgba(99, 102, 241, 0.15);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --text-heading: #1e293b;
      --pkg-card-bg: rgba(248, 250, 252, 0.8);
      --pkg-card-hover: rgba(241, 245, 249, 1);
      --modal-bg: #ffffff;
      --modal-border: rgba(226, 232, 240, 0.8);
      --modal-text: #0f172a;
      --toggle-bg: rgba(255, 255, 255, 0.9);
      --toggle-border: rgba(203, 213, 225, 0.9);
      --toggle-text: #0f172a;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(at 10% 15%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
        radial-gradient(at 90% 85%, rgba(59, 130, 246, 0.12) 0px, transparent 50%),
        radial-gradient(at 50% 50%, rgba(16, 185, 129, 0.06) 0px, transparent 60%);
      background-attachment: fixed;
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      margin: 0;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Floating Theme Switcher */
    .theme-toggle-wrapper {
      position: absolute;
      top: 24px;
      right: 24px;
      z-index: 100;
    }

    .btn-theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 20px;
      background: var(--toggle-bg);
      border: 1px solid var(--toggle-border);
      color: var(--toggle-text);
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      transition: all 0.25s ease;
    }

    .btn-theme-toggle:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
    }

    .main-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 16px 40px;
      position: relative;
    }

    .reg-container {
      width: 100%;
      max-width: 1080px;
    }

    .glass-card {
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.3), 0 0 40px rgba(99, 102, 241, 0.08);
      overflow: hidden;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    /* Hero Section (Left) */
    .hero-side {
      background: var(--hero-bg);
      border-right: 1px solid var(--card-border);
      padding: 48px 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      transition: background 0.3s ease;
    }

    .hero-side::before {
      content: '';
      position: absolute;
      top: -100px;
      left: -100px;
      width: 250px;
      height: 250px;
      background: rgba(99, 102, 241, 0.18);
      filter: blur(80px);
      border-radius: 50%;
      pointer-events: none;
    }

    .brand-logo-badge {
      background: #ffffff;
      padding: 10px 22px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
      width: fit-content;
      margin-bottom: 28px;
    }

    .brand-logo-badge img {
      height: 38px;
      width: auto;
      object-fit: contain;
    }

    .hero-title {
      font-weight: 800;
      font-size: 2rem;
      line-height: 1.25;
      background: var(--hero-title-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 16px;
    }

    .hero-subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 32px;
    }

    .feature-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-bottom: 40px;
    }

    .feature-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .feature-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: var(--feature-icon-bg);
      border: 1px solid var(--feature-icon-border);
      color: var(--feature-icon-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .feature-text h6 {
      font-weight: 700;
      font-size: 0.95rem;
      margin: 0 0 2px 0;
      color: var(--text-heading);
    }

    .feature-text p {
      font-size: 0.825rem;
      color: var(--text-muted);
      margin: 0;
      line-height: 1.4;
    }

    .trust-badge {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border-radius: 16px;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      font-size: 0.85rem;
      color: var(--text-main);
    }

    /* Form Side (Right) */
    .form-side {
      padding: 48px 40px;
    }

    .form-header-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 20px;
      background: rgba(99, 102, 241, 0.12);
      border: 1px solid rgba(99, 102, 241, 0.25);
      color: #6366f1;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    .form-title {
      font-weight: 800;
      font-size: 1.6rem;
      color: var(--text-main);
      margin-bottom: 24px;
    }

    /* Custom Form Fields */
    .field-group {
      margin-bottom: 20px;
    }

    .field-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--text-main);
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .badge-optional {
      font-size: 0.7rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 10px;
      background: rgba(148, 163, 184, 0.15);
      color: var(--text-muted);
    }

    .input-wrapper {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 1.1rem;
      transition: color 0.3s ease;
      pointer-events: none;
    }

    .textarea-icon {
      top: 18px;
      transform: none;
    }

    .form-control-custom, .form-select-custom {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: 14px;
      padding: 13px 16px 13px 46px;
      color: var(--text-main);
      font-size: 0.925rem;
      font-family: inherit;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .form-control-custom::placeholder {
      color: var(--text-muted);
      opacity: 0.7;
    }

    .form-control-custom:focus, .form-select-custom:focus {
      outline: none;
      background: var(--input-bg);
      border-color: #6366f1;
      box-shadow: 0 0 0 4px var(--accent-glow);
    }

    .form-control-custom:focus ~ .input-icon,
    .form-select-custom:focus ~ .input-icon {
      color: #6366f1;
    }

    .field-hint {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 6px;
    }

    /* Interactive Package Cards */
    .package-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
      margin-bottom: 8px;
    }

    .package-card {
      background: var(--pkg-card-bg);
      border: 1.5px solid var(--input-border);
      border-radius: 16px;
      padding: 16px;
      cursor: pointer;
      transition: all 0.25s ease;
      position: relative;
    }

    .package-card:hover {
      border-color: rgba(99, 102, 241, 0.4);
      background: var(--pkg-card-hover);
      transform: translateY(-2px);
    }

    .package-card.selected {
      border-color: #6366f1;
      background: rgba(99, 102, 241, 0.12);
      box-shadow: 0 0 20px rgba(99, 102, 241, 0.25);
    }

    .package-card .check-indicator {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: 2px solid var(--text-muted);
      position: absolute;
      top: 14px;
      right: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      color: transparent;
      transition: all 0.2s ease;
    }

    .package-card.selected .check-indicator {
      background: #6366f1;
      border-color: #6366f1;
      color: #ffffff;
    }

    .package-card-name {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text-main);
      margin-bottom: 6px;
      padding-right: 24px;
    }

    .package-card-price {
      font-weight: 800;
      font-size: 1.05rem;
      color: #10b981;
    }

    .package-card-price span {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-muted);
    }

    .package-card-speed {
      font-size: 0.75rem;
      color: #6366f1;
      font-weight: 600;
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* Map / GPS Section */
    .location-actions {
      display: flex;
      gap: 12px;
    }

    .btn-loc {
      flex: 1;
      padding: 11px 14px;
      border-radius: 12px;
      border: 1px solid var(--input-border);
      background: var(--input-bg);
      color: var(--text-main);
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-loc:hover {
      background: var(--pkg-card-hover);
      border-color: #6366f1;
      color: var(--text-main);
    }

    .coord-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.25);
      color: #10b981;
      font-size: 0.75rem;
      font-weight: 600;
      margin-top: 10px;
    }

    /* Submit Button */
    .btn-submit-custom {
      width: 100%;
      background: var(--primary-gradient);
      border: none;
      border-radius: 14px;
      padding: 16px;
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
      box-shadow: 0 10px 25px rgba(99, 102, 241, 0.35);
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 10px;
    }

    .btn-submit-custom:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 35px rgba(99, 102, 241, 0.5);
      color: #ffffff;
    }

    /* Alerts */
    .alert-custom {
      border-radius: 14px;
      padding: 16px 20px;
      font-size: 0.9rem;
      margin-bottom: 24px;
    }

    .alert-custom-danger {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
    }

    .alert-custom-success {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #10b981;
    }

    /* Footer Navigation */
    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 0.8rem;
      margin-top: 24px;
    }

    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #6366f1;
    }

    #picker-map {
      height: 380px;
      width: 100%;
      border-radius: 14px;
    }

    @media (max-width: 991px) {
      .theme-toggle-wrapper {
        top: 16px;
        right: 16px;
      }

      .hero-side {
        padding: 36px 28px;
        border-right: none;
        border-bottom: 1px solid var(--card-border);
      }

      .form-side {
        padding: 36px 28px;
      }
    }

    @media (max-width: 576px) {
      .main-wrapper {
        padding: 60px 10px 20px;
      }

      .hero-side, .form-side {
        padding: 24px 18px;
      }

      .hero-title {
        font-size: 1.5rem;
      }

      .package-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <!-- Theme Switcher Button -->
  <div class="theme-toggle-wrapper">
    <button type="button" class="btn-theme-toggle" id="themeToggleBtn" onclick="toggleTheme()" title="Ubah Mode Tampilan (Dark/Light)">
      <i class="bi bi-sun-fill text-warning d-none" id="themeIconSun"></i>
      <i class="bi bi-moon-stars-fill text-primary" id="themeIconMoon"></i>
      <span id="themeToggleText">Mode Terang</span>
    </button>
  </div>

  <div class="main-wrapper">
    <div class="reg-container">
      <div class="glass-card">
        <div class="row g-0">
          
          <!-- Hero Section (Left) -->
          <div class="col-lg-5 hero-side">
            <div>
              <div class="brand-logo-badge">
                <img src="/img/logo.png" alt="Logo" onerror="this.style.display='none'">
                <span class="fw-bold ms-2 text-dark" style="font-size: 0.95rem;"><%= settings.company_header %></span>
              </div>
              
              <h1 class="hero-title">Internet Cepat, Tanpa Batasan Kuota.</h1>
              <p class="hero-subtitle">
                Bergabunglah bersama kami dan nikmati koneksi internet fiber optik berkecepatan tinggi dengan harga terbaik & pelayanan responsif.
              </p>

              <div class="feature-list">
                <div class="feature-item">
                  <div class="feature-icon"><i class="bi bi-rocket-takeoff-fill"></i></div>
                  <div class="feature-text">
                    <h6>Koneksi Fiber Optik Stabil</h6>
                    <p>Layanan internet berkecepatan tinggi tanpa hambatan untuk rumah & bisnis.</p>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                  <div class="feature-text">
                    <h6>Bebas FUP / Tanpa Kuota</h6>
                    <p>Internet sepuasnya 24 jam non-stop tanpa takut penurunan kecepatan.</p>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="feature-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
                  <div class="feature-text">
                    <h6>Harga Flat & Transparan</h6>
                    <p>Tarif langganan bulanan tetap tanpa biaya tersembunyi atau kenaikan mendadak.</p>
                  </div>
                </div>

                <div class="feature-item">
                  <div class="feature-icon"><i class="bi bi-headset"></i></div>
                  <div class="feature-text">
                    <h6>Dukungan Bantuan 24/7</h6>
                    <p>Tim teknisi siaga melayani koordinasi survei dan penanganan kendala.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="trust-badge">
              <i class="bi bi-patch-check-fill text-primary fs-5"></i>
              <div>
                <strong style="color: var(--text-heading);">Proses Cepat & Transparan</strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Tim akan menghubungi Anda via WhatsApp setelah pendaftaran.</div>
              </div>
            </div>
          </div>

          <!-- Form Section (Right) -->
          <div class="col-lg-7 form-side">
            <div class="form-header-badge">
              <i class="bi bi-pencil-square me-1"></i> Form Pendaftaran Pelanggan
            </div>
            <h2 class="form-title">Isi Data Diri Anda</h2>

            <% if (error) { %>
              <div class="alert-custom alert-custom-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
              </div>
            <% } %>

            <% if (success) { %>
              <div class="alert-custom alert-custom-success text-center">
                <i class="bi bi-check-circle-fill fs-2 d-block mb-2 text-success"></i>
                <strong class="d-block fs-5 mb-2"><%= success %></strong>
                <p class="mb-3 opacity-90" style="font-size: 0.85rem;">Tim support kami akan segera memproses data pendaftaran dan menghubungi nomor WhatsApp Anda.</p>
                <a href="/customer/login" class="btn btn-sm btn-outline-success px-4 py-2" style="border-radius:10px;">
                  <i class="bi bi-box-arrow-in-right me-1"></i> Masuk ke Portal Pelanggan
                </a>
              </div>
            <% } else { %>
              <form method="POST" action="/customer/register" id="regForm">
                
                <!-- Nama Lengkap -->
                <div class="field-group">
                  <label class="field-label">
                    <span><i class="bi bi-person me-1"></i> Nama Lengkap</span>
                  </label>
                  <div class="input-wrapper">
                    <input type="text" class="form-control-custom" name="name" placeholder="Contoh: Budi Santoso" required autofocus>
                    <i class="bi bi-person-fill input-icon"></i>
                  </div>
                </div>

                <!-- NIK / No. SIM (Opsional) -->
                <div class="field-group">
                  <label class="field-label">
                    <span><i class="bi bi-card-heading me-1"></i> NIK / No. SIM</span>
                    <span class="badge-optional">Opsional</span>
                  </label>
                  <div class="input-wrapper">
                    <input type="text" class="form-control-custom" name="nik_sim" placeholder="Contoh: 3201xxxxxxxxxxxx (Tidak Wajib)">
                    <i class="bi bi-card-heading input-icon"></i>
                  </div>
                </div>

                <!-- No WhatsApp -->
                <div class="field-group">
                  <label class="field-label">
                    <span><i class="bi bi-whatsapp me-1"></i> Nomor WhatsApp Aktif</span>
                  </label>
                  <div class="input-wrapper">
                    <input type="tel" class="form-control-custom" name="phone" placeholder="Contoh: 081234567890" required>
                    <i class="bi bi-whatsapp input-icon"></i>
                  </div>
                </div>

                <!-- Email -->
                <div class="field-group">
                  <label class="field-label">
                    <span><i class="bi bi-envelope me-1"></i> Alamat Email</span>
                    <span class="badge-optional">Opsional</span>
                  </label>
                  <div class="input-wrapper">
                    <input type="email" class="form-control-custom" name="email" placeholder="Contoh: budi@gmail.com">
                    <i class="bi bi-envelope-fill input-icon"></i>
                  </div>
                  <div class="field-hint">Email akan digunakan untuk pengiriman tagihan & bukti pembayaran resmi secara otomatis.</div>
                </div>

                <!-- Alamat Pemasangan -->
                <div class="field-group">
                  <label class="field-label">
                    <span><i class="bi bi-geo-alt me-1"></i> Alamat Pemasangan</span>
                  </label>
                  <div class="input-wrapper">
                    <textarea class="form-control-custom" name="address" rows="2" placeholder="Sertakan Nama Jalan, No. Rumah, RT/RW, Desa & Kecamatan..." required style="resize: none;"></textarea>
                    <i class="bi bi-geo-alt-fill input-icon textarea-icon"></i>
                  </div>
                </div>

                <!-- Lokasi di Peta / GPS -->
                <div class="field-group">
                  <label class="field-label">
                    <span><i class="bi bi-pin-map me-1"></i> Lokasi Presisi Pemasangan</span>
                    <span class="badge-optional">Opsional</span>
                  </label>
                  <div class="location-actions">
                    <button type="button" class="btn-loc" onclick="openPicker()">
                      <i class="bi bi-geo-alt-fill text-primary"></i> Pilih di Peta
                    </button>
                    <button type="button" class="btn-loc" onclick="getLocation()">
                      <i class="bi bi-crosshair text-info"></i> Ambil GPS
                    </button>
                  </div>
                  <input type="hidden" name="lat" id="reg_lat">
                  <input type="hidden" name="lng" id="reg_lng">
                  <div id="coordBadge" class="coord-badge" style="display: none;">
                    <i class="bi bi-check-circle-fill"></i> <span id="coordText">Lokasi terpilih</span>
                  </div>
                </div>

                <!-- Choice Package Cards -->
                <div class="field-group mb-4">
                  <label class="field-label">
                    <span><i class="bi bi-box-seam me-1"></i> Pilih Paket Layanan</span>
                  </label>
                  
                  <!-- Fallback Select element for backend 100% compatibility -->
                  <select class="form-select-custom d-none" name="package_id" id="package_select" required>
                    <option value="" disabled selected>Pilih salah satu paket...</option>
                    <% packages.forEach(function(pkg) { %>
                      <option value="<%= pkg.id %>"><%= pkg.name %> - Rp <%= pkg.price.toLocaleString('id-ID') %>/bulan</option>
                    <% }) %>
                  </select>

                  <div class="package-grid">
                    <% packages.forEach(function(pkg, index) { %>
                      <div class="package-card" onclick="selectPackage('<%= pkg.id %>', this)">
                        <div class="check-indicator"><i class="bi bi-check-lg"></i></div>
                        <div class="package-card-name"><%= pkg.name %></div>
                        <div class="package-card-price">
                          Rp <%= pkg.price.toLocaleString('id-ID') %><span>/bln</span>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <button type="submit" class="btn-submit-custom" id="btnSubmit">
                  <i class="bi bi-send-fill me-1"></i> Kirim Pendaftaran Baru
                </button>
              </form>
            <% } %>

            <div class="footer-links">
              <div>Sudah memiliki akun? <a href="/customer/login" class="fw-bold text-primary">Login Pelanggan</a></div>
              <div class="w-100 text-center text-muted" style="font-size: 0.75rem; margin-top: 10px;">
                &copy; <%= new Date().getFullYear() %> <%= settings.company_header %>. Seluruh hak cipta dilindungi.
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Picker Map -->
  <div class="modal fade" id="mapPickerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content" style="border-radius: 20px; overflow:hidden; background: var(--modal-bg); border: 1px solid var(--modal-border); color: var(--modal-text);">
        <div class="modal-header border-0 px-4 pt-4 pb-2" style="border-bottom: 1px solid var(--card-border) !important;">
          <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Tentukan Titik Lokasi Pemasangan</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" id="modalCloseBtn"></button>
        </div>
        <div class="modal-body p-4">
          <div id="picker-map"></div>
          <div class="text-muted mt-3" style="font-size: 0.8rem;">
            <i class="bi bi-info-circle me-1"></i> Geser penanda pin atau klik pada lokasi spesifik tempat tinggal Anda di peta.
          </div>
        </div>
        <div class="modal-footer border-0 px-4 pb-4 pt-0">
          <button type="button" class="btn btn-primary px-4 py-2" style="border-radius: 12px; font-weight: 600;" data-bs-dismiss="modal">
            <i class="bi bi-check-lg me-1"></i> Simpan Lokasi Ini
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function updateThemeUI(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('customer_theme', theme);
      const sunIcon = document.getElementById('themeIconSun');
      const moonIcon = document.getElementById('themeIconMoon');
      const textEl = document.getElementById('themeToggleText');
      const closeBtn = document.getElementById('modalCloseBtn');

      if (theme === 'light') {
        if (sunIcon) sunIcon.classList.remove('d-none');
        if (moonIcon) moonIcon.classList.add('d-none');
        if (textEl) textEl.innerText = 'Mode Gelap';
        if (closeBtn) closeBtn.classList.remove('btn-close-white');
      } else {
        if (sunIcon) sunIcon.classList.add('d-none');
        if (moonIcon) moonIcon.classList.remove('d-none');
        if (textEl) textEl.innerText = 'Mode Terang';
        if (closeBtn) closeBtn.classList.add('btn-close-white');
      }
    }

    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
      updateThemeUI(nextTheme);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const savedTheme = localStorage.getItem('customer_theme') || 'dark';
      updateThemeUI(savedTheme);
    });
  </script>

  <script>
    const officeLat = Number('<%= settings.office_lat || "" %>') || -6.200000;
    const officeLng = Number('<%= settings.office_lng || "" %>') || 106.816666;
    let pickerMap, pickerMarker, pickerModal;

    function selectPackage(pkgId, el) {
      document.getElementById('package_select').value = pkgId;
      document.querySelectorAll('.package-card').forEach(card => card.classList.remove('selected'));
      if (el) el.classList.add('selected');
    }

    function setCoords(lat, lng) {
      const latStr = Number(lat).toFixed(8);
      const lngStr = Number(lng).toFixed(8);
      document.getElementById('reg_lat').value = latStr;
      document.getElementById('reg_lng').value = lngStr;
      
      const coordBadge = document.getElementById('coordBadge');
      const coordText = document.getElementById('coordText');
      if (coordBadge && coordText) {
        coordBadge.style.display = 'inline-flex';
        coordText.innerText = `Titik Lokasi Terpilih (Lat: ${latStr}, Lng: ${lngStr})`;
      }
    }

    function openPicker() {
      pickerModal = pickerModal || new bootstrap.Modal(document.getElementById('mapPickerModal'));
      pickerModal.show();

      const latVal = parseFloat(document.getElementById('reg_lat').value) || officeLat;
      const lngVal = parseFloat(document.getElementById('reg_lng').value) || officeLng;

      setTimeout(() => {
        if (!pickerMap) {
          pickerMap = L.map('picker-map').setView([latVal, lngVal], 16);
          L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
            maxZoom: 20,
            subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
          }).addTo(pickerMap);

          pickerMarker = L.marker([latVal, lngVal], { draggable: true }).addTo(pickerMap);
          pickerMarker.on('dragend', () => {
            const p = pickerMarker.getLatLng();
            setCoords(p.lat, p.lng);
          });
          pickerMap.on('click', (e) => {
            pickerMarker.setLatLng(e.latlng);
            setCoords(e.latlng.lat, e.latlng.lng);
          });
        } else {
          pickerMap.setView([latVal, lngVal], 16);
          pickerMarker.setLatLng([latVal, lngVal]);
          pickerMap.invalidateSize();
        }
      }, 250);
    }

    function getLocation() {
      if (!navigator.geolocation) return alert('GPS tidak didukung di perangkat ini.');
      navigator.geolocation.getCurrentPosition((pos) => {
        setCoords(pos.coords.latitude, pos.coords.longitude);
      }, (err) => {
        alert('Gagal mengambil lokasi GPS: ' + (err.message || err));
      }, { enableHighAccuracy: true, timeout: 8000 });
    }

    // Submit handler with loading state
    const regForm = document.getElementById('regForm');
    if (regForm) {
      regForm.addEventListener('submit', function() {
        const btn = document.getElementById('btnSubmit');
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Memproses Pendaftaran...`;
        }
      });
    }
  </script>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      });
    }
  </script>
</body>
</html>
