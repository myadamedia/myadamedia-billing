<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Isolir &amp; CNA Push Pop-Up | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    /* ── Multi-Theme Adaptive Scoped Styling ── */
    .portal-banner {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 22px 24px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .portal-title {
      font-size: 20px;
      font-weight: 800;
      color: var(--text);
      margin: 0 0 6px 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .portal-sub {
      color: var(--muted);
      font-size: 13px;
      margin: 0;
      line-height: 1.5;
    }
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .pill-active {
      background: var(--sdim);
      color: var(--success);
      border: 1px solid var(--success);
    }
    .pill-inactive {
      background: var(--ddim);
      color: var(--danger);
      border: 1px solid var(--danger);
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: currentColor;
      display: inline-block;
      box-shadow: 0 0 8px currentColor;
    }

    /* ── Tab Navigation ── */
    .tab-bar {
      display: flex;
      gap: 8px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 20px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: thin;
    }
    .tab-btn {
      background: transparent;
      border: 1px solid transparent;
      border-bottom: none;
      color: var(--muted);
      padding: 11px 18px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 10px 10px 0 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .tab-btn:hover {
      color: var(--text);
      background: var(--pdim);
    }
    .tab-btn.active {
      color: var(--primary);
      background: var(--bg2);
      border-color: var(--border);
      border-bottom: 2px solid var(--primary);
    }
    .tab-content-panel {
      display: none;
    }
    .tab-content-panel.active {
      display: block;
      animation: fadeIn 0.25s ease;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── Switch & Form Enhancements ── */
    .switch-card {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      transition: border-color 0.2s ease;
    }
    .switch-card:hover {
      border-color: var(--primary);
    }
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 46px;
      height: 24px;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: var(--border);
      transition: .3s;
      border-radius: 24px;
      border: 1px solid var(--border);
    }
    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 3px;
      bottom: 3px;
      background-color: #ffffff;
      transition: .3s;
      border-radius: 50%;
    }
    .toggle-switch input:checked + .toggle-slider {
      background-color: var(--primary);
    }
    .toggle-switch input:checked + .toggle-slider:before {
      transform: translateX(22px);
    }
    .switch-label-title {
      font-weight: 700;
      font-size: 14px;
      color: var(--text);
      margin-bottom: 3px;
      display: block;
      cursor: pointer;
    }
    .switch-label-desc {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.4;
    }

    /* ── Code Box & Terminal ── */
    .code-terminal {
      background: #090d16;
      border: 1px solid var(--border);
      border-radius: 12px;
      position: relative;
      overflow: hidden;
      margin-top: 14px;
    }
    .code-terminal-hd {
      background: #111827;
      padding: 10px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .code-terminal-title {
      font-size: 12px;
      font-weight: 600;
      color: #94a3b8;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .code-terminal pre {
      margin: 0;
      padding: 16px;
      color: #38bdf8;
      font-family: 'Fira Code', 'Courier New', monospace;
      font-size: 12.5px;
      line-height: 1.6;
      max-height: 380px;
      overflow-y: auto;
      white-space: pre-wrap;
      word-break: break-all;
    }

    /* ── CNA Simulator Cards ── */
    .probe-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 14px;
      margin-top: 14px;
    }
    .probe-card {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
      transition: all 0.2s ease;
    }
    .probe-card:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }
    .probe-path {
      font-family: monospace;
      font-size: 12px;
      background: var(--bg2);
      color: var(--primary);
      border: 1px solid var(--border);
      padding: 4px 8px;
      border-radius: 6px;
      word-break: break-all;
    }
    .probe-os {
      font-size: 11px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ── Form Inputs ── */
    .form-group-custom {
      margin-bottom: 18px;
    }
    .form-group-custom label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 4px;
      letter-spacing: 0.3px;
    }
    .form-group-custom .hint-text {
      font-size: 11.5px;
      color: var(--muted);
      margin-bottom: 6px;
      line-height: 1.4;
    }

    /* ── Toast notification ── */
    #copyToast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--success);
      color: #ffffff;
      padding: 10px 20px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      display: none;
      align-items: center;
      gap: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      z-index: 9999;
      animation: fadeIn .2s;
    }
  </style>
</head>
<body>

<%- include('partials/sidebar', { activePage: 'isolated_portal', company }) %>

<div class="mw">
  <!-- Topbar Standard -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-shield-slash-fill" style="color:var(--primary)"></i>
      <span>Portal Isolir &amp; CNA Push Pop-Up</span>
    </div>
    <div class="tb-right">
      <span class="adm-badge">
        <i class="bi bi-broadcast"></i> <%= config.cna_push_enabled ? 'CNA Push Aktif' : 'CNA Nonaktif' %>
      </span>
      <a href="/isolated" target="_blank" class="btn btn-g btn-sm">
        <i class="bi bi-eye"></i> Preview /isolated
      </a>
      <a href="/admin/logout" class="btn btn-g btn-sm">
        <i class="bi bi-box-arrow-left"></i> Logout
      </a>
    </div>
  </div>

  <div class="page">
    
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type === 'error' ? 'd' : 's' %>">
        <i class="bi bi-<%= msg.type === 'error' ? 'exclamation-circle' : 'check-circle' %>"></i>
        <span><%= msg.text %></span>
      </div>
    <% } %>

    <!-- Header Banner -->
    <div class="portal-banner">
      <div>
        <div class="portal-title">
          <i class="bi bi-shield-slash-fill" style="color: var(--primary);"></i>
          <span>Portal Isolir &amp; CNA Push Pop-Up</span>
          <span class="status-pill <%= config.enabled ? 'pill-active' : 'pill-inactive' %>">
            <span class="pulse-dot"></span>
            <%= config.enabled ? 'PORTAL AKTIF' : 'PORTAL NONAKTIF' %>
          </span>
        </div>
        <p class="portal-sub">
          Otomatisasi pengalihan isolir pelanggan suspended dan push pop-up otomatis pada koneksi Wi-Fi (Android, iOS, Windows).
        </p>
      </div>
      <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <form action="/admin/isolated-portal/sync" method="POST" style="display: inline;" onsubmit="return confirm('Sinkronkan seluruh pelanggan jatuh tempo yang belum lunas ke status isolir & MikroTik sekarang?')">
          <button type="submit" class="btn btn-p btn-sm">
            <i class="bi bi-arrow-repeat"></i> Sinkronkan Isolir Sekarang
          </button>
        </form>
        <a href="/isolated" target="_blank" class="btn btn-g btn-sm">
          <i class="bi bi-box-arrow-up-right"></i> Buka Halaman /isolated
        </a>
      </div>
    </div>

    <!-- Stat Grid Overview -->
    <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 20px;">
      <div class="sc <%= config.cna_push_enabled ? 's' : 'd' %>">
        <i class="bi bi-broadcast sc-icon"></i>
        <div class="sc-label">Status CNA Push Pop-Up</div>
        <div class="sc-val <%= config.cna_push_enabled ? 'text-success' : 'text-danger' %>" style="font-size: 20px;">
          <%= config.cna_push_enabled ? 'Aktif' : 'Non-Aktif' %>
        </div>
        <div class="sc-sub">Deteksi Probe OS</div>
      </div>

      <div class="sc d">
        <i class="bi bi-people-fill sc-icon"></i>
        <div class="sc-label">Pelanggan Terisolir</div>
        <div class="sc-val"><%= suspendedCustomers.length %></div>
        <div class="sc-sub">Akun berstatus suspended</div>
      </div>

      <div class="sc w">
        <i class="bi bi-shield-check sc-icon"></i>
        <div class="sc-label">Walled Garden Domain</div>
        <div class="sc-val"><%= config.walled_garden_domains.length %></div>
        <div class="sc-sub">Domain Whitelist Bypass</div>
      </div>

      <div class="sc i">
        <i class="bi bi-hdd-network sc-icon"></i>
        <div class="sc-label">Target Router MikroTik</div>
        <div class="sc-val"><%= routers.length %></div>
        <div class="sc-sub">Router Terdaftar di Billing</div>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="tab-bar">
      <button class="tab-btn active" onclick="switchTab('tab-config', this)">
        <i class="bi bi-sliders"></i> Pengaturan Engine
      </button>
      <button class="tab-btn" onclick="switchTab('tab-mikrotik', this)">
        <i class="bi bi-terminal"></i> Script MikroTik NAT
      </button>
      <button class="tab-btn" onclick="switchTab('tab-tester', this)">
        <i class="bi bi-phone-vibrate"></i> Uji CNA Push Pop-Up
      </button>
      <button class="tab-btn" onclick="switchTab('tab-customers', this)">
        <i class="bi bi-person-x"></i> Daftar Pelanggan Isolir (<%= suspendedCustomers.length %>)
      </button>
    </div>

    <!-- TAB 1: Pengaturan Engine -->
    <div id="tab-config" class="tab-content-panel active">
      <div class="card">
        <div class="card-hd">
          <h6><i class="bi bi-gear-fill"></i> Konfigurasi Utama Portal Isolir</h6>
        </div>
        <div class="card-bd">
          <form action="/admin/isolated-portal/settings" method="POST">
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-bottom: 22px;">
              
              <!-- Switch 1: Enabled -->
              <div class="switch-card">
                <label class="toggle-switch">
                  <input type="checkbox" name="enabled" value="true" <%= config.enabled ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <div>
                  <label class="switch-label-title">Aktifkan Portal Isolir</label>
                  <div class="switch-label-desc">Mengalihkan lalu lintas internet pelanggan berstatus suspended ke halaman informasi tagihan.</div>
                </div>
              </div>

              <!-- Switch 2: CNA Push Pop-up -->
              <div class="switch-card">
                <label class="toggle-switch">
                  <input type="checkbox" name="cna_push_enabled" value="true" <%= config.cna_push_enabled ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <div>
                  <label class="switch-label-title">Aktifkan Auto Push Pop-Up (CNA)</label>
                  <div class="switch-label-desc">Mendorong OS (Android, iOS, Windows) untuk otomatis memunculkan pop-up jendela isolir begitu terkoneksi Wi-Fi.</div>
                </div>
              </div>

            </div>

            <div class="form-row mb16">
              <div class="form-group-custom">
                <label>Judul Utama Halaman Isolir</label>
                <div class="hint-text">Judul yang ditampilkan pada pop-up isolir pelanggan.</div>
                <input type="text" name="custom_title" class="fc" value="<%= config.custom_title %>" required>
              </div>

              <div class="form-group-custom">
                <label>Format Pesan Konfirmasi WA Admin</label>
                <div class="hint-text">Template pesan saat pelanggan menekan tombol WhatsApp.</div>
                <input type="text" name="custom_wa_message" class="fc" value="<%= config.custom_wa_message %>" required>
              </div>
            </div>

            <div class="form-group-custom">
              <label>Deskripsi / Penjelasan Isolir</label>
              <div class="hint-text">Pesan informasi tagihan yang dibaca oleh pelanggan ketika terisolir.</div>
              <textarea name="custom_message" rows="3" class="fc" required><%= config.custom_message %></textarea>
            </div>

            <div class="form-group-custom">
              <label>Walled Garden Whitelist Domains (1 domain per baris)</label>
              <div class="hint-text">Domain di bawah ini tetap dapat diakses oleh pelanggan terisolir agar dapat melakukan pembayaran QRIS/Midtrans/Tripay/Xendit langsung dari pop-up.</div>
              <textarea name="walled_garden_domains" rows="6" class="fc" style="font-family: monospace; font-size: 13px;"><%= config.walled_garden_domains.join('\n') %></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 20px;">
              <button type="submit" class="btn btn-p">
                <i class="bi bi-save"></i> Simpan Konfigurasi
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- TAB 2: Script MikroTik NAT -->
    <div id="tab-mikrotik" class="tab-content-panel">
      <div class="card">
        <div class="card-hd">
          <h6><i class="bi bi-terminal-fill"></i> Script Terminal MikroTik (DST-NAT, Hairpin &amp; Walled Garden)</h6>
          <button class="btn btn-p btn-sm" onclick="copyScript()">
            <i class="bi bi-clipboard"></i> Salin Script
          </button>
        </div>
        <div class="card-bd">
          <p class="portal-sub" style="margin-bottom: 16px;">
            Konfigurasikan alamat IP dan port server billing Anda, lalu salin script di bawah ini ke <strong>Terminal RouterOS MikroTik</strong>:
          </p>

          <div style="display: grid; grid-template-columns: 2fr 1fr auto; gap: 12px; margin-bottom: 16px; background: var(--bg); padding: 14px; border-radius: 12px; border: 1px solid var(--border); align-items: flex-end;">
            <div class="form-group" style="margin: 0;">
              <label class="fl">IP Server Billing (Target NAT MikroTik):</label>
              <input type="text" id="scriptBillingIp" class="fc" value="<%= billingHost %>" placeholder="Contoh: 192.168.1.100 atau 172.99.12.2" oninput="regenerateScript()">
            </div>
            <div class="form-group" style="margin: 0;">
              <label class="fl">Port Web Server:</label>
              <input type="number" id="scriptBillingPort" class="fc" value="<%= billingPort %>" placeholder="Contoh: 3001 atau 80" oninput="regenerateScript()">
            </div>
            <div>
              <button type="button" class="btn btn-g" onclick="regenerateScript()" style="height: 38px;">
                <i class="bi bi-arrow-repeat"></i> Update Script
              </button>
            </div>
          </div>

          <div class="code-terminal">
            <div class="code-terminal-hd">
              <div class="code-terminal-title">
                <i class="bi bi-cpu"></i> RouterOS CLI Command Script
              </div>
              <button class="btn btn-g btn-sm" onclick="copyScript()">
                <i class="bi bi-copy"></i> Copy
              </button>
            </div>
            <pre id="scriptContent"><%= mikrotikScript %></pre>
          </div>

          <div style="margin-top: 18px; padding: 14px 16px; background: var(--pdim); border: 1px solid var(--primary); border-radius: 10px;">
            <h6 style="color: var(--primary); font-weight: 700; font-size: 13px; margin: 0 0 8px 0;">
              <i class="bi bi-info-circle-fill"></i> Arsitektur &amp; Prinsip Kerja Pengalihan MikroTik:
            </h6>
            <ol style="margin: 0; padding-left: 20px; font-size: 12.5px; color: var(--muted); line-height: 1.6;">
              <li>Pelanggan berstatus <code style="color:var(--primary);">suspended</code> didaftarkan ke address-list <code style="color:var(--primary);">LIST_ISOLIR</code>.</li>
              <li>Rule <strong>DST-NAT Port 80</strong> membelokkan seluruh request HTTP dari <code style="color:var(--primary);">LIST_ISOLIR</code> ke IP Server Billing target.</li>
              <li>Rule <strong>Hairpin SRC-NAT (Masquerade)</strong> memastikan koneksi balik (*SYN-ACK*) selalu melewati MikroTik dan tidak putus karena *asymmetric routing* saat klien &amp; server berada di segmen jaringan lokal yang sama.</li>
              <li>Server Billing langsung merespons request probe OS (iOS, Android, Windows) dengan <strong>HTTP 200 OK</strong> dan tampilan portal isolir secara langsung (*Direct CNA Trigger*).</li>
              <li>Sistem operasi secara otomatis mendeteksi Captive Network dan <strong>membuka pop-up jendela isolir di layar HP pelanggan</strong>!</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: Uji CNA Push Pop-Up -->
    <div id="tab-tester" class="tab-content-panel">
      <div class="card">
        <div class="card-hd">
          <h6><i class="bi bi-phone-vibrate-fill"></i> Simulator Interaktif Captive Network Assistant (CNA)</h6>
        </div>
        <div class="card-bd">
          <p class="portal-sub">
            Pengujian simulasi respon server terhadap request probe otomatis yang biasa dikirim oleh Operating System perangkat saat terkoneksi ke Wi-Fi.
          </p>

          <div class="probe-grid">
            <% cnaProbes.forEach(probe => { %>
              <div class="probe-card">
                <div>
                  <div class="probe-path"><%= probe %></div>
                  <div class="probe-os" style="margin-top: 8px;">
                    <% if (probe.includes('apple') || probe.includes('hotspot')) { %>
                      <i class="bi bi-apple"></i> iOS / iPadOS / macOS
                    <% } else if (probe.includes('204') || probe.includes('google')) { %>
                      <i class="bi bi-android2" style="color: var(--success);"></i> Android / ChromeOS
                    <% } else if (probe.includes('msft') || probe.includes('ncsi') || probe.includes('connecttest')) { %>
                      <i class="bi bi-windows" style="color: var(--info);"></i> Windows 10 / 11
                    <% } else { %>
                      <i class="bi bi-globe" style="color: var(--warning);"></i> Browser Probes
                    <% } %>
                  </div>
                </div>
                <button class="btn btn-g btn-sm" onclick="testProbe('<%= probe %>')">
                  <i class="bi bi-play-fill"></i> Uji Probe
                </button>
              </div>
            <% }) %>
          </div>

          <div id="testResultBox" style="margin-top: 20px; display: none; background: #090d16; border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 12px; padding: 16px;">
            <div style="font-size: 13px; font-weight: 700; color: #4ade80; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
              <i class="bi bi-check2-circle"></i> Hasil Respon Simulator CNA:
            </div>
            <pre id="testResultText" style="margin: 0; color: #38bdf8; font-family: monospace; font-size: 12px; line-height: 1.5;"></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: Pelanggan Terisolir -->
    <div id="tab-customers" class="tab-content-panel">
      <div class="card">
        <div class="card-hd" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <h6><i class="bi bi-people-fill"></i> Daftar Pelanggan Berstatus Terisolir / Suspended (<%= suspendedCustomers.length %>)</h6>
          <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <form action="/admin/isolated-portal/sync" method="POST" style="display: inline;" onsubmit="return confirm('Sinkronkan seluruh pelanggan jatuh tempo yang belum lunas ke status isolir sekarang?')">
              <button type="submit" class="btn btn-p btn-sm">
                <i class="bi bi-arrow-repeat"></i> Sinkronkan Pelanggan Jatuh Tempo
              </button>
            </form>
            <a href="/admin/customers?status=suspended" class="btn btn-g btn-sm">
              <i class="bi bi-box-arrow-up-right"></i> Buka di Menu Pelanggan
            </a>
          </div>
        </div>

        <% if (suspendedCustomers.length > 0) { %>
          <div style="padding: 14px 18px; border-bottom: 1px solid var(--border); background: var(--bg2);">
            <div style="position: relative; max-width: 380px;">
              <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted);"></i>
              <input type="text" class="fc" id="searchSuspended" placeholder="Cari nama, PPPoE username, atau no telepon..." onkeyup="filterSuspendedTable()" style="padding-left: 36px;">
            </div>
          </div>
        <% } %>

        <div class="card-bd" style="padding: 0;">
          <% if (suspendedCustomers.length === 0) { %>
            <div style="text-align: center; padding: 48px 20px; color: var(--muted);">
              <i class="bi bi-check-circle" style="font-size: 36px; color: var(--success); display: block; margin-bottom: 10px;"></i>
              <div>Tidak ada pelanggan yang berstatus terisolir / suspended saat ini.</div>
              <div style="font-size: 12px; margin-top: 6px;">Klik tombol <strong>"Sinkronkan Pelanggan Jatuh Tempo"</strong> di atas jika ada pelanggan yang melewati batas waktu pembayaran.</div>
            </div>
          <% } else { %>
            <div class="tbl-wrap">
              <table class="dtbl" id="tableSuspended">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>ID &amp; Nama Pelanggan</th>
                    <th>No. Telepon / WA</th>
                    <th>PPPoE / Username</th>
                    <th>Paket Internet</th>
                    <th>Tagihan Belum Bayar</th>
                    <th>Tgl Jatuh Tempo</th>
                    <th class="num">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  <% suspendedCustomers.forEach((c, idx) => { %>
                    <tr class="cust-row">
                      <td><%= idx + 1 %></td>
                      <td>
                        <div style="font-size: 11px; color: var(--muted); font-family: monospace;">MDE-<%= String(c.id).padStart(4, '0') %></div>
                        <strong style="color: var(--text);"><%= c.name %></strong>
                        <% if (c.router_name) { %>
                          <div style="font-size: 10.5px; color: var(--muted);"><i class="bi bi-router"></i> <%= c.router_name %></div>
                        <% } %>
                      </td>
                      <td>
                        <% if (c.phone) { %>
                          <a href="https://wa.me/<%= c.phone.replace(/\D/g, '') %>" target="_blank" style="color: var(--success); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                            <i class="bi bi-whatsapp"></i> <%= c.phone %>
                          </a>
                        <% } else { %>
                          <span style="color: var(--muted);">-</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bm font-monospace"><%= c.pppoe_username || '-' %></span>
                      </td>
                      <td>
                        <div><%= c.package_name || '-' %></div>
                        <% if (c.package_price) { %>
                          <div style="font-size: 11px; color: var(--muted);">Rp <%= Number(c.package_price).toLocaleString('id-ID') %></div>
                        <% } %>
                      </td>
                      <td>
                        <% if (Number(c.unpaid_count) > 0) { %>
                          <span class="badge bd" style="font-size: 11px;">
                            Rp <%= Number(c.unpaid_total).toLocaleString('id-ID') %> (<%= c.unpaid_count %> bln)
                          </span>
                        <% } else { %>
                          <span class="badge bs" style="font-size: 11px;">Lunas</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bw" style="font-size: 11px;">
                          Tgl <%= c.isolate_day || c.isolir_date || c.due_date || 10 %>
                        </span>
                      </td>
                      <td class="num">
                        <div style="display: inline-flex; gap: 6px; align-items: center;">
                          <!-- Form Unisolate -->
                          <form action="/admin/isolated-portal/unisolate/<%= c.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Aktifkan kembali layanan internet untuk pelanggan <%= c.name %>?')">
                            <button type="submit" class="btn btn-g btn-sm" title="Aktifkan Kembali (Unisolate)" style="color: var(--success);">
                              <i class="bi bi-check2-circle"></i> Aktifkan
                            </button>
                          </form>

                          <!-- Form Re-sync / Isolate -->
                          <form action="/admin/isolated-portal/isolate/<%= c.id %>" method="POST" style="display: inline;" title="Sinkronkan Ulang ke Router MikroTik">
                            <button type="submit" class="btn btn-g btn-sm" title="Isolir Ulang & Sync Router">
                              <i class="bi bi-arrow-repeat"></i>
                            </button>
                          </form>

                          <% if (c.phone) { %>
                            <a href="https://wa.me/<%= c.phone.replace(/\D/g, '') %>?text=<%= encodeURIComponent('Halo ' + c.name + ', layanan internet Anda saat ini terisolir karena tagihan sebesar Rp ' + Number(c.unpaid_total || c.package_price || 0).toLocaleString('id-ID') + ' belum diselesaikan. Mohon lakukan pembayaran melalui portal pelanggan untuk mengaktifkan kembali.') %>" target="_blank" class="btn btn-g btn-sm" title="Kirim Pesan Isolir WA">
                              <i class="bi bi-whatsapp" style="color: var(--success);"></i>
                            </a>
                          <% } %>
                          
                          <a href="/admin/customers?search=<%= encodeURIComponent(c.name) %>" class="btn btn-p btn-sm" title="Lihat Profil Pelanggan">
                            <i class="bi bi-search"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</div>

<div id="copyToast">
  <i class="bi bi-check2-circle"></i> Script MikroTik berhasil disalin ke clipboard!
</div>

<script>
  function switchTab(tabId, btn) {
    document.querySelectorAll('.tab-content-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    
    const panel = document.getElementById(tabId);
    if (panel) panel.classList.add('active');
    if (btn) btn.classList.add('active');
  }

  function copyScript() {
    const el = document.getElementById('scriptContent');
    if (!el) return;
    const content = el.innerText;
    navigator.clipboard.writeText(content).then(() => {
      showToast();
    }).catch(() => {
      // Fallback copy
      const ta = document.createElement('textarea');
      ta.value = content;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast();
    });
  }

  function showToast() {
    const toast = document.getElementById('copyToast');
    if (!toast) return;
    toast.style.display = 'flex';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 3000);
  }

  async function testProbe(path) {
    const box = document.getElementById('testResultBox');
    const text = document.getElementById('testResultText');
    if (!box || !text) return;

    text.innerText = 'Menguji probe ' + path + '...';
    box.style.display = 'block';

    try {
      const res = await fetch('/admin/isolated-portal/test-cna', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ probePath: path })
      });
      const data = await res.json();
      text.innerText = JSON.stringify(data, null, 2);
    } catch (err) {
      text.innerText = 'Error: ' + err.message;
    }
  }

  async function regenerateScript() {
    const ipInput = document.getElementById('scriptBillingIp');
    const portInput = document.getElementById('scriptBillingPort');
    const pre = document.getElementById('scriptContent');
    if (!ipInput || !portInput || !pre) return;

    const host = ipInput.value.trim() || '192.168.1.100';
    const port = Number(portInput.value.trim() || 3001);

    try {
      const res = await fetch('/admin/isolated-portal/generate-script', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ billingHost: host, billingPort: port })
      });
      const data = await res.json();
      if (data.success && data.script) {
        pre.innerText = data.script;
      }
    } catch (e) {
      console.warn('Gagal regenerate script:', e);
    }
  }

  function filterSuspendedTable() {
    const input = document.getElementById('searchSuspended');
    if (!input) return;
    const filter = input.value.toLowerCase().trim();
    const rows = document.querySelectorAll('#tableSuspended tbody .cust-row');
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(filter) ? '' : 'none';
    });
  }
</script>

</body>
</html>
