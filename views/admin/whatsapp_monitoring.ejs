<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    .wa-tabs { display: flex; gap: 10px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
    .wa-tab { padding: 8px 14px; border-radius: 8px; cursor: pointer; color: var(--muted); transition: all 0.2s; font-weight: 700; text-decoration: none; }
    .wa-tab:hover { background: rgba(255,255,255,0.06); color: var(--text); }
    .wa-tab.active { background: var(--primary); color: white; }
    .monitoring-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 768px) {
      .monitoring-grid { grid-template-columns: 1fr; }
    }
    .switch { position: relative; display: inline-block; width: 50px; height: 26px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #475569; transition: .4s; border-radius: 34px; }
    .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; }
    input:checked + .slider { background-color: var(--primary); }
    input:checked + .slider:before { transform: translateX(24px); }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'whatsapp_monitoring', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-bell"></i> <%= title %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <% const waTab = 'monitoring'; %>
    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <div class="wa-tabs">
      <a href="/admin/whatsapp" class="wa-tab <%= waTab==='status' ? 'active' : '' %>"><i class="bi bi-phone"></i> Status</a>
      <a href="/admin/whatsapp/broadcast" class="wa-tab <%= waTab==='broadcast' ? 'active' : '' %>"><i class="bi bi-megaphone"></i> Broadcast & Pengingat</a>
      <a href="/admin/whatsapp/templates" class="wa-tab <%= waTab==='templates' ? 'active' : '' %>"><i class="bi bi-chat-left-quote"></i> Template Pesan</a>
      <a href="/admin/whatsapp/monitoring" class="wa-tab <%= waTab==='monitoring' ? 'active' : '' %>"><i class="bi bi-bell"></i> Monitoring Alert</a>
    </div>

    <form method="POST" action="/admin/whatsapp/monitoring">
      <div class="card mb16">
        <div class="card-hd">
          <h6><i class="bi bi-bell-fill"></i> Pengaturan Notifikasi Alert Monitoring WhatsApp</h6>
        </div>
        <div class="card-bd monitoring-grid">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; background: rgba(255,255,255,0.03); padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
              <div>
                <strong style="display: block; font-size: 14px;">Alert Redaman Tinggi (RX Power)</strong>
                <span style="font-size: 11px; color: var(--muted);">Kirim notifikasi ketika ONU memiliki redaman buruk</span>
              </div>
              <label class="switch">
                <input type="checkbox" name="monitoring_rx_power_alert_enabled_cb" value="1" <%= settings.monitoring_rx_power_alert_enabled ? 'checked' : '' %> onchange="document.getElementById('rx_power_enabled_val').value = this.checked ? 'true' : 'false'">
                <span class="slider"></span>
              </label>
              <input type="hidden" name="monitoring_rx_power_alert_enabled" id="rx_power_enabled_val" value="<%= settings.monitoring_rx_power_alert_enabled ? 'true' : 'false' %>">
            </div>

            <div class="fg">
              <label class="fl">Batas Redaman Buruk (Threshold dBm)</label>
              <input type="number" step="0.1" class="fc" name="monitoring_rx_power_threshold" value="<%= settings.monitoring_rx_power_threshold %>" required style="width: 100%;">
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                <i class="bi bi-info-circle"></i> Standar redaman buruk adalah <b>-27</b> dBm ke bawah (semakin negatif semakin redam).
              </div>
            </div>
          </div>

          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; background: rgba(255,255,255,0.03); padding: 12px; border-radius: 8px; border: 1px solid var(--border);">
              <div>
                <strong style="display: block; font-size: 14px;">Alert Perangkat Offline</strong>
                <span style="font-size: 11px; color: var(--muted);">Kirim notifikasi ketika ONU mati atau terputus</span>
              </div>
              <label class="switch">
                <input type="checkbox" name="monitoring_offline_alert_enabled_cb" value="1" <%= settings.monitoring_offline_alert_enabled ? 'checked' : '' %> onchange="document.getElementById('offline_enabled_val').value = this.checked ? 'true' : 'false'">
                <span class="slider"></span>
              </label>
              <input type="hidden" name="monitoring_offline_alert_enabled" id="offline_enabled_val" value="<%= settings.monitoring_offline_alert_enabled ? 'true' : 'false' %>">
            </div>

            <div class="fg">
              <label class="fl">Batas Waktu Perangkat Offline (Threshold Jam)</label>
              <input type="number" class="fc" name="monitoring_offline_threshold_hours" value="<%= settings.monitoring_offline_threshold_hours %>" required style="width: 100%;">
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                <i class="bi bi-info-circle"></i> Kirim alert jika ONU tidak merespon / tidak inform melebihi <b>24</b> jam.
              </div>
            </div>
          </div>
        </div>
        <div class="card-bd" style="border-top: 1px solid var(--border); background: var(--bg2); display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan Pengaturan</button>
        </div>
      </div>
    </form>
  </div>
</div>
</body>
</html>
