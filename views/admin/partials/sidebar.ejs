        <a href="/admin/sidebar-settings" class="btn btn-g" style="width:100%;display:flex;align-items:center;justify-content:center;gap:8px" onclick="hideLockedMenuNotice()">
          <i class="bi bi-layout-sidebar-inset"></i> Buka Pengaturan Sidebar
        </a>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:10px;padding:0 20px 20px 20px">
      <button type="button" class="btn btn-p" onclick="hideLockedMenuNotice()">
        <i class="bi bi-check2-circle"></i> Mengerti
      </button>
    </div>
  </div>
</div>

<script>
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    if (sb) sb.classList.toggle('open');
    if (ov) ov.classList.toggle('show');
  }

  function showLockedMenuNotice(message) {
    const modal = document.getElementById('lockedMenuModal');
    const messageBox = document.getElementById('lockedMenuModalMessage');
    if (messageBox) {
      messageBox.textContent = message || 'Menu ini sedang terkunci.';
    }
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    return false;
  }

  function hideLockedMenuNotice() {
    const modal = document.getElementById('lockedMenuModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  function toggleThemeMenu(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('themeMenu');
    if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
  }

  function setTheme(theme) {
    document.documentElement.classList.remove('theme-light', 'theme-ocean', 'theme-forest');
    if (theme !== 'dark') {
      document.documentElement.classList.add('theme-' + theme);
    }
    try {
      localStorage.setItem('app-theme', theme);
      document.cookie = "app-theme=" + theme + "; path=/; max-age=31536000";
    } catch (e) {
      console.warn('Failed to save theme:', e);
    }
    const menu = document.getElementById('themeMenu');
    if (menu) menu.style.display = 'none';
  }

  function toggleMoneyVisibility(e) {
    if (e) e.stopPropagation();
    const isHidden = document.documentElement.classList.toggle('hide-money');
    try {
      localStorage.setItem('hide-money', isHidden ? 'true' : 'false');
    } catch (e) {}
    updateMoneyToggleIcon(isHidden);
  }

  function updateMoneyToggleIcon(isHidden) {
    const icon = document.getElementById('moneyToggleIcon');
    if (icon) {
      if (isHidden) {
        icon.className = 'bi bi-eye-slash-fill';
        icon.style.color = '#ef4444';
      } else {
        icon.className = 'bi bi-eye';
        icon.style.color = '';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const isHidden = document.documentElement.classList.contains('hide-money');
    updateMoneyToggleIcon(isHidden);
  });

  function toggleSubMenu(e, key) {
    if (e) e.preventDefault();
    const sub = document.getElementById('sub-menu-' + key);
    const chevron = document.getElementById('chevron-' + key);
    if (sub) {
      const isHidden = sub.style.display === 'none';
      sub.style.display = isHidden ? 'block' : 'none';
      if (chevron) {
        chevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
      }
    }
  }

  document.addEventListener('click', function() {
    const menu = document.getElementById('themeMenu');
    if (menu && menu.style.display === 'block') {
      menu.style.display = 'none';
    }
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') hideLockedMenuNotice();
  });
</script>

