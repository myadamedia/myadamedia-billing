<script>
  (function() {
    try {
      let savedTheme = localStorage.getItem('app-theme');
      if (!savedTheme) {
        const matches = document.cookie.match(/app-theme=([^;]+)/);
        if (matches) savedTheme = matches[1];
      }
      savedTheme = savedTheme || 'dark';
      if (savedTheme !== 'dark') {
        document.documentElement.classList.add('theme-' + savedTheme);
      }

      const hideMoney = localStorage.getItem('hide-money') === 'true';
      if (hideMoney) {
        document.documentElement.classList.add('hide-money');
      }
    } catch (e) {
      console.warn('Theme initialization failed:', e);
    }
  })();
</script>

<style>
