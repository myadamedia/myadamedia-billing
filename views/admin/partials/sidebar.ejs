    </div>
  </div>
</div>

<script>
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    sb.classList.toggle('open');
    ov.classList.toggle('show');
  }

  function showLockedMenuNotice(message) {
    const modal = document.getElementById('lockedMenuModal');
    const messageBox = document.getElementById('lockedMenuModalMessage');
    if (messageBox) {
      messageBox.textContent = message || 'Menu ini sedang terkunci.';
    }
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    return false;
  }

  function hideLockedMenuNotice() {
    const modal = document.getElementById('lockedMenuModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  function toggleThemeMenu(e) {
    e.stopPropagation();
    const menu = document.getElementById('themeMenu');
    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
  }

  function setTheme(theme) {
    document.documentElement.classList.remove('theme-light', 'theme-ocean', 'theme-forest');
    if (theme !== 'dark') {
      document.documentElement.classList.add('theme-' + theme);
    }
    try {
      localStorage.setItem('app-theme', theme);
      document.cookie = "app-theme=" + theme + "; path=/; max-age=31536000";
    } catch (e) {
      console.warn('Failed to save theme:', e);
    }
    const menu = document.getElementById('themeMenu');
    if (menu) menu.style.display = 'none';
  }

  function toggleMoneyVisibility(e) {
    if (e) e.stopPropagation();
    const isHidden = document.documentElement.classList.toggle('hide-money');
    try {
      localStorage.setItem('hide-money', isHidden ? 'true' : 'false');
    } catch (e) {}
    updateMoneyToggleIcon(isHidden);
  }

  function updateMoneyToggleIcon(isHidden) {
    const icon = document.getElementById('moneyToggleIcon');
    if (icon) {
      if (isHidden) {
        icon.className = 'bi bi-eye-slash-fill';
        icon.style.color = '#ef4444';
      } else {
        icon.className = 'bi bi-eye';
        icon.style.color = '';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const isHidden = document.documentElement.classList.contains('hide-money');
    updateMoneyToggleIcon(isHidden);
  });

  document.addEventListener('click', function() {
    const menu = document.getElementById('themeMenu');
    if (menu && menu.style.display === 'block') {
      menu.style.display = 'none';
    }
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') hideLockedMenuNotice();
  });
</script>

