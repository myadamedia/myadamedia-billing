<script>
  function isDesktop() {
    return window.innerWidth >= 992;
  }

  function toggleSidebar(forceState) {
    if (isDesktop()) {
      const isCurrentlyCollapsed = document.documentElement.classList.contains('sidebar-collapsed');
      const newState = (typeof forceState === 'boolean') ? forceState : !isCurrentlyCollapsed;
      if (newState) {
        document.documentElement.classList.add('sidebar-collapsed');
        try {
          localStorage.setItem('admin_sidebar_collapsed', 'true');
          document.cookie = "admin_sidebar_collapsed=true; path=/; max-age=31536000";
        } catch (e) {}
      } else {
        document.documentElement.classList.remove('sidebar-collapsed');
        try {
          localStorage.setItem('admin_sidebar_collapsed', 'false');
          document.cookie = "admin_sidebar_collapsed=false; path=/; max-age=31536000";
        } catch (e) {}
      }
      updateCollapseButtonUI(newState);
      hideFloatingTooltip();
    } else {
      // Mobile / Tablet drawer mode
      const sb = document.getElementById('sidebar');
      const ov = document.getElementById('sidebarOverlay');
      if (sb) sb.classList.toggle('open');
      if (ov) ov.classList.toggle('show');
      // Di mobile/drawer, selalu gunakan teks penuh
      document.documentElement.classList.remove('sidebar-collapsed');
    }
  }

  function updateCollapseButtonUI(isCollapsed) {
    const textEl = document.getElementById('sbCollapseText');
    const iconEl = document.getElementById('sbCollapseIcon');
    const brandIconEl = document.getElementById('sbBrandToggleIcon');
    const btnEl = document.getElementById('sbCollapseBtn');
    if (textEl) {
      textEl.textContent = isCollapsed ? 'Perluas Sidebar' : 'Minimize Sidebar';
    }
    if (iconEl) {
      iconEl.className = isCollapsed ? 'bi bi-layout-sidebar-inset-reverse' : 'bi bi-layout-sidebar-inset';
    }
    if (brandIconEl) {
      brandIconEl.className = isCollapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
    }
    if (btnEl) {
      btnEl.setAttribute('title', isCollapsed ? 'Perluas Sidebar' : 'Minimize Sidebar');
      btnEl.setAttribute('data-tooltip', isCollapsed ? 'Perluas Sidebar' : 'Minimize Sidebar');
    }
  }

  // Floating Tooltip untuk Sidebar Minimized (Icon-only)
  const sbTooltip = document.getElementById('sbFloatingTooltip');

  function showFloatingTooltip(e, text, isLocked) {
    if (!isDesktop() || !document.documentElement.classList.contains('sidebar-collapsed')) return;
    if (!sbTooltip || !text) return;

    let content = text;
    if (isLocked) {
      content = '<i class="bi bi-lock-fill" style="color:#f59e0b"></i> ' + text + ' <span style="font-size:10px;opacity:0.75">(Terkunci)</span>';
    }
    sbTooltip.innerHTML = content;

    const target = e.currentTarget || e.target;
    const rect = target.getBoundingClientRect();
    const tooltipTop = rect.top + (rect.height / 2);
    const tooltipLeft = rect.right + 12;

    sbTooltip.style.top = tooltipTop + 'px';
    sbTooltip.style.left = tooltipLeft + 'px';
    sbTooltip.classList.add('show');
  }

  function hideFloatingTooltip() {
    if (sbTooltip) {
      sbTooltip.classList.remove('show');
    }
  }

  function initSidebarTooltips() {
    document.querySelectorAll('.sb-nav-link').forEach(link => {
      link.addEventListener('mouseenter', (e) => {
        const text = link.getAttribute('data-tooltip') || link.getAttribute('title');
        const isLocked = link.querySelector('.badge-lock') !== null || (link.getAttribute('onclick') && link.getAttribute('onclick').includes('showLockedMenuNotice'));
        showFloatingTooltip(e, text, isLocked);
      });
      link.addEventListener('mouseleave', hideFloatingTooltip);
      link.addEventListener('click', () => {
        hideFloatingTooltip();
        // Pada mobile, tutup drawer setelah menu diklik
        if (!isDesktop()) {
          const sb = document.getElementById('sidebar');
          const ov = document.getElementById('sidebarOverlay');
          if (sb) sb.classList.remove('open');
          if (ov) ov.classList.remove('show');
        }
      });
    });
  }

  function showLockedMenuNotice(message) {
    const modal = document.getElementById('lockedMenuModal');
    const messageBox = document.getElementById('lockedMenuModalMessage');
    if (messageBox) {
      messageBox.textContent = message || 'Menu ini sedang terkunci.';
    }
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    return false;
  }

  function hideLockedMenuNotice() {
    const modal = document.getElementById('lockedMenuModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  function toggleThemeMenu(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('themeMenu');
    if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
  }

  function setTheme(theme) {
    document.documentElement.classList.remove('theme-light', 'theme-ocean', 'theme-forest');
    if (theme !== 'dark') {
      document.documentElement.classList.add('theme-' + theme);
    }
    try {
      localStorage.setItem('app-theme', theme);
      document.cookie = "app-theme=" + theme + "; path=/; max-age=31536000";
    } catch (e) {
      console.warn('Failed to save theme:', e);
    }
    const menu = document.getElementById('themeMenu');
    if (menu) menu.style.display = 'none';
  }

  function toggleMoneyVisibility(e) {
    if (e) e.stopPropagation();
    const isHidden = document.documentElement.classList.toggle('hide-money');
    try {
      localStorage.setItem('hide-money', isHidden ? 'true' : 'false');
    } catch (e) {}
    updateMoneyToggleIcon(isHidden);
  }

  function updateMoneyToggleIcon(isHidden) {
    const icon = document.getElementById('moneyToggleIcon');
    if (icon) {
      if (isHidden) {
        icon.className = 'bi bi-eye-slash-fill';
        icon.style.color = '#ef4444';
      } else {
        icon.className = 'bi bi-eye';
        icon.style.color = '';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    initSidebarTooltips();
    const isHidden = document.documentElement.classList.contains('hide-money');
    updateMoneyToggleIcon(isHidden);

    const isCollapsed = document.documentElement.classList.contains('sidebar-collapsed');
    updateCollapseButtonUI(isCollapsed);

    // Reset scroll posisi sidebar ke paling atas agar logo tidak terdorong
    const sb = document.getElementById('sidebar');
    if (sb) sb.scrollTop = 0;
  });

  window.addEventListener('resize', function() {
    if (!isDesktop()) {
      hideFloatingTooltip();
    } else {
      const isCollapsed = localStorage.getItem('admin_sidebar_collapsed') === 'true';
      if (isCollapsed) {
        document.documentElement.classList.add('sidebar-collapsed');
      }
      updateCollapseButtonUI(isCollapsed);
    }
  });

  function toggleSubMenu(e, key) {
    if (e) e.preventDefault();
    const sub = document.getElementById('sub-menu-' + key);
    const chevron = document.getElementById('chevron-' + key);
    if (sub) {
      const isHidden = sub.style.display === 'none';
      sub.style.display = isHidden ? 'block' : 'none';
      if (chevron) {
        chevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
      }
    }
  }

  document.addEventListener('click', function() {
    const menu = document.getElementById('themeMenu');
    if (menu && menu.style.display === 'block') {
      menu.style.display = 'none';
    }
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') hideLockedMenuNotice();
  });
</script>

<!-- Bottom Navigation (Mobile Only) -->
<nav class="bottom-nav" id="bottomNav">
  <% (sidebarBottomNavItems || []).slice(0, 4).forEach((item) => { %>
    <a
      href="<%= item.hrefResolved %>"
      class="bn-item <%= (item.activePages || []).includes(activePage) ? 'active' : '' %>"
      <% if (item.locked) { %>
        onclick='return showLockedMenuNotice(<%- JSON.stringify(item.lockedMessage) %>)'
      <% } %>
    >
      <i class="<%= item.icon %>"></i>
      <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
    </a>
  <% }) %>
  <button class="bn-item" onclick="toggleSidebar()">
    <i class="bi bi-grid-3x3-gap"></i>
    <span><%= t('common.menu', 'Menu') %></span>
  </button>
</nav>

<%- include('../../partials/pwa_install', { hasBottomNav: true }) %>
<script>
  (function() {
    if (!document.querySelector('link[rel="manifest"]')) {
      const link = document.createElement('link');
      link.rel = 'manifest';
      link.href = '/admin/manifest.webmanifest';
      document.head.appendChild(link);
    }
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/admin/' }).catch(() => {});
      });
    }
  })();
</script>
