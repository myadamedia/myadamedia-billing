<script>
  (function() {
    try {
      let savedTheme = localStorage.getItem('app-theme');
      if (!savedTheme) {
        const matches = document.cookie.match(/app-theme=([^;]+)/);
        if (matches) savedTheme = matches[1];
      }
      savedTheme = savedTheme || 'dark';
      if (savedTheme !== 'dark') {
        document.documentElement.classList.add('theme-' + savedTheme);
      }

      const hideMoney = localStorage.getItem('hide-money') === 'true';
      if (hideMoney) {
        document.documentElement.classList.add('hide-money');
      }

      // Inisialisasi status minimized sidebar sebelum render pertama (Zero-FOUC)
      let savedSidebarCollapsed = localStorage.getItem('admin_sidebar_collapsed');
      if (savedSidebarCollapsed === null) {
        const matchesSb = document.cookie.match(/admin_sidebar_collapsed=([^;]+)/);
        if (matchesSb) savedSidebarCollapsed = matchesSb[1];
      }
      if (savedSidebarCollapsed === 'true' && window.innerWidth >= 992) {
        document.documentElement.classList.add('sidebar-collapsed');
      }
    } catch (e) {
      console.warn('Theme/Sidebar initialization failed:', e);
    }
  })();
</script>

