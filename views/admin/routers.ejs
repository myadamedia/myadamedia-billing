<script id="routers-data" type="application/json"><%- JSON.stringify(routers) %></script>
<script>
const routersData = JSON.parse(document.getElementById('routers-data').textContent);
const I18N = {
  testConfirm: "<%= t('admin.routers.confirm.test', 'Test koneksi ke router ini?') %>",
  systemError: "<%= t('admin.routers.js.system_error', 'Terjadi kesalahan sistem.') %>"
};

let activeRouterId = null;
let activeRouterName = '';
let currentInterfacesData = [];
let ifaceAutoRefreshInterval = null;

// Live Traffic Popup Chart state
let liveChart = null;
let trafficStreamTimer = null;
let trafficStreamActive = false;
let currentMonitoringIfaceName = '';
let trafficPollingIntervalMs = 2000;
const MAX_CHART_POINTS = 25;

function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}

function editRouter(idx) {
  const r = routersData[idx];
  document.getElementById('editForm').action = '/admin/routers/' + r.id + '/update';
  document.getElementById('e_name').value = r.name;
  document.getElementById('e_host').value = r.host;
  document.getElementById('e_port').value = r.port;
  document.getElementById('e_user').value = r.user;
  document.getElementById('e_active').value = r.is_active;
  document.getElementById('e_desc').value = r.description || '';
  openModal('editModal');
}

async function testConn(id) {
  if(!confirm(I18N.testConfirm)) return;
  try {
    const res = await fetch('/admin/api/routers/' + id + '/test');
    const data = await res.json();
    alert(data.success ? '✅ ' + data.message : '❌ ' + data.error);
  } catch (e) { alert(I18N.systemError); }
}

async function setupFirewall(id) {
  if(!confirm('Setup otomatis Firewall Isolir di MikroTik? Ini akan menambahkan Address List dan Rule NAT/Filter.')) return;
  try {
    const res = await fetch('/admin/api/routers/' + id + '/setup-firewall', { method: 'POST' });
    const data = await res.json();
    alert(data.success ? '✅ ' + data.message : '❌ ' + data.error);
  } catch (e) { alert(I18N.systemError); }
}

async function openIsolirScriptModal() {
  const ta = document.getElementById('isolir-script-body');
  const meta = document.getElementById('isolir-script-meta');
  ta.value = '<%= t('common.loading', 'Memuat...') %>';
  meta.textContent = '';
  openModal('isolirScriptModal');
  try {
    const res = await fetch('/admin/api/isolir-portal-script');
    const data = await res.json();
    if (!data.success) throw new Error(data.error || 'Gagal');
    ta.value = data.script || '';
    meta.textContent = (data.appUrl ? ('app_url: ' + data.appUrl + ' | ') : '') + 'IP: ' + (data.billingIp || '-') + ' | NAT → HTTP:' + (data.httpNatPort ?? '-') + ' HTTPS:' + (data.httpsNatPort ?? '-');
  } catch (e) {
    ta.value = '';
    meta.textContent = e.message || 'Error';
  }
}

function copyIsolirScript() {
  const ta = document.getElementById('isolir-script-body');
  if (!ta || !ta.value) return;
  ta.select();
  document.execCommand('copy');
  alert('<%= t('admin.routers.isolir_script_copied', 'Script disalin ke clipboard.') %>');
}

// ─── ROUTER DETAIL & MONITORING INTERFACE LOGIC ───
function showRouterDetail(id, name) {
  activeRouterId = id;
  activeRouterName = name;
  document.getElementById('detail-router-title').textContent = 'Detail Router: ' + name;
  
  // Reset UI
  document.getElementById('detail-cpu-load').textContent = '-';
  document.getElementById('detail-cpu-freq').textContent = '-';
  document.getElementById('detail-memory').textContent = '-';
  document.getElementById('detail-memory-percent').textContent = '-';
  document.getElementById('detail-hdd').textContent = '-';
  document.getElementById('detail-hdd-percent').textContent = '-';
  document.getElementById('detail-uptime').textContent = '-';
  document.getElementById('detail-board-name').textContent = '-';

  switchDetailTab('interfaces');
  openModal('routerDetailModal');

  loadRouterDetails(id);
  loadRouterInterfaces(id);
}

function closeRouterDetailModal() {
  stopIfaceAutoRefresh();
  closeModal('routerDetailModal');
}

function switchDetailTab(tabName) {
  const tabIfaces = document.getElementById('subtab-ifaces');
  const tabSpecs = document.getElementById('subtab-specs');
  const contentIfaces = document.getElementById('detail-tab-interfaces');
  const contentSpecs = document.getElementById('detail-tab-specs');

  if (tabName === 'interfaces') {
    tabIfaces.classList.add('active');
    tabSpecs.classList.remove('active');
    contentIfaces.style.display = 'block';
    contentSpecs.style.display = 'none';
  } else {
    tabSpecs.classList.add('active');
    tabIfaces.classList.remove('active');
    contentSpecs.style.display = 'block';
    contentIfaces.style.display = 'none';
  }
}

async function loadRouterDetails(routerId) {
  try {
    const res = await fetch('/admin/api/routers/' + routerId + '/details');
    const data = await res.json();
    if (data.success && data.details) {
      const d = data.details;
      document.getElementById('detail-cpu-load').textContent = (d.cpuLoad !== undefined ? d.cpuLoad + '%' : '-');
      document.getElementById('detail-cpu-freq').textContent = d.cpuFrequency + (d.cpuCount ? ' (' + d.cpuCount + ' Cores)' : '');
      document.getElementById('detail-memory').textContent = d.freeMemory + ' / ' + d.totalMemory;
      document.getElementById('detail-memory-percent').textContent = (100 - parseFloat(d.memoryUsagePercent || 0)).toFixed(1) + '% Free (' + d.memoryUsagePercent + '% Used)';
      document.getElementById('detail-hdd').textContent = d.freeHdd + ' / ' + d.totalHdd;
      document.getElementById('detail-hdd-percent').textContent = d.hddUsagePercent + '% Used';
      document.getElementById('detail-uptime').textContent = d.uptime || '-';
      document.getElementById('detail-board-name').textContent = (d.boardName || d.model || '-') + ' (v' + (d.version || '-') + ')';

      // Specs Tab Populating
      document.getElementById('spec-identity').textContent = d.identity || '-';
      document.getElementById('spec-model').textContent = d.model || d.boardName || '-';
      document.getElementById('spec-version').textContent = d.version || '-';
      document.getElementById('spec-arch').textContent = d.architectureName || '-';
      document.getElementById('spec-cpu-model').textContent = d.cpuModel || '-';
      document.getElementById('spec-cpu-count').textContent = d.cpuCount + ' Cores @ ' + d.cpuFrequency;
      document.getElementById('spec-total-ram').textContent = d.totalMemory;
      document.getElementById('spec-free-ram').textContent = d.freeMemory;
      document.getElementById('spec-total-hdd').textContent = d.totalHdd;
      document.getElementById('spec-free-hdd').textContent = d.freeHdd;
      document.getElementById('spec-serial').textContent = d.serialNumber || '-';
      document.getElementById('spec-build-time').textContent = d.buildTime || '-';
    }
  } catch (e) {
    console.error('Error loading router details:', e);
  }
}

async function loadRouterInterfaces(routerId, silent = false) {
  const tbody = document.getElementById('iface-table-body');
  if (!silent) {
    tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted" style="padding:24px"><i class="bi bi-arrow-clockwise spin"></i> Memuat daftar interface...</td></tr>';
  }
  
  try {
    const res = await fetch('/admin/api/routers/' + routerId + '/interfaces');
    const data = await res.json();
    if (data.success && Array.isArray(data.interfaces)) {
      currentInterfacesData = data.interfaces;
      document.getElementById('iface-count-badge').textContent = currentInterfacesData.length;
      renderInterfacesTable(currentInterfacesData);
    } else {
      tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted" style="padding:24px">Gagal memuat interface: ' + (data.error || 'Unknown error') + '</td></tr>';
    }
  } catch (e) {
    console.error('Error loading interfaces:', e);
    tbody.innerHTML = '<tr><td colspan="10" class="text-center text-danger" style="padding:24px">Gagal terhubung ke router. Pastikan service API MikroTik aktif.</td></tr>';
  }
}

function escapeHtml(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function escapeJs(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replace(/\\/g, '\\\\')
    .replace(/'/g, "\\'")
    .replace(/"/g, '\\"');
}

function renderInterfacesTable(list) {
  const tbody = document.getElementById('iface-table-body');
  if (!list || list.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted" style="padding:24px">Tidak ada interface ditemukan</td></tr>';
    return;
  }

  let html = '';
  list.forEach((iface, idx) => {
    let statusBadge = '';
    if (iface.disabled) {
      statusBadge = '<span class="badge bm">Disabled</span>';
    } else if (iface.running) {
      statusBadge = '<span class="badge bs"><i class="bi bi-link-45deg"></i> Running</span>';
    } else {
      statusBadge = '<span class="badge bw">Link Down</span>';
    }

    const safeNameHtml = escapeHtml(iface.name);
    const safeNameJs = escapeJs(iface.name);
    const safeCommentHtml = escapeHtml(iface.comment);
    const safeTypeHtml = escapeHtml(iface.type);
    const safeMacHtml = escapeHtml(iface.macAddress);
    const safeIdJs = escapeJs(iface.id);

    let typeBadge = `<span class="badge" style="background:rgba(255,255,255,0.08);color:var(--text);">${safeTypeHtml}</span>`;
    
    html += `<tr class="iface-row-hover" onclick="openInterfaceTrafficModal('${safeNameJs}')" title="Klik untuk membuka Live Traffic Realtime Popup">
      <td class="text-muted text-center" onclick="event.stopPropagation();">${idx + 1}</td>
      <td>
        <strong style="color:var(--text); display:flex; align-items:center; gap:6px;">
          <i class="bi bi-ethernet text-primary"></i> ${safeNameHtml}
        </strong>
        ${iface.comment ? `<div style="font-size:11px; color:var(--muted); font-style:italic;">${safeCommentHtml}</div>` : ''}
      </td>
      <td>${typeBadge}</td>
      <td>${statusBadge}</td>
      <td><code style="font-size:11px; color:var(--text);">${safeMacHtml}</code></td>
      <td style="font-size:12px;">${escapeHtml(iface.mtu)}</td>
      <td style="font-size:12px;">${escapeHtml(iface.rxBytesFormatted)} <div style="font-size:10px; color:var(--muted);">${(iface.rxPacket || 0).toLocaleString()} pkts</div></td>
      <td style="font-size:12px;">${escapeHtml(iface.txBytesFormatted)} <div style="font-size:10px; color:var(--muted);">${(iface.txPacket || 0).toLocaleString()} pkts</div></td>
      <td style="text-align:center;">
        <button type="button" class="btn-live-traffic" onclick="event.stopPropagation(); openInterfaceTrafficModal('${safeNameJs}');" title="Klik untuk Grafik Live Traffic Realtime">
          <i class="bi bi-graph-up-arrow"></i> Live Trafik
        </button>
      </td>
      <td style="text-align:center;" onclick="event.stopPropagation();">
        <button type="button" class="btn btn-${iface.disabled ? 's' : 'd'} btn-icon btn-sm" title="${iface.disabled ? 'Aktifkan Interface' : 'Nonaktifkan Interface'}" onclick="toggleIface('${safeIdJs}', ${iface.disabled})">
          <i class="bi bi-${iface.disabled ? 'check-circle' : 'power'}"></i>
        </button>
      </td>
    </tr>`;
  });
  tbody.innerHTML = html;
}

function filterInterfacesTable() {
  const searchVal = document.getElementById('iface-search-input').value.toLowerCase().trim();
  const typeFilter = document.getElementById('iface-type-filter').value.toLowerCase().trim();

  const filtered = currentInterfacesData.filter(iface => {
    const matchSearch = (iface.name && iface.name.toLowerCase().includes(searchVal)) || 
                        (iface.comment && iface.comment.toLowerCase().includes(searchVal)) || 
                        (iface.macAddress && iface.macAddress.toLowerCase().includes(searchVal));
    
    let matchType = !typeFilter;
    if (typeFilter) {
      const ifaceType = (iface.type || '').toLowerCase();
      if (typeFilter === 'pppoe') {
        matchType = ifaceType.includes('pppoe') || ifaceType.includes('ppp');
      } else {
        matchType = ifaceType.includes(typeFilter);
      }
    }
    return matchSearch && matchType;
  });

  renderInterfacesTable(filtered);
}

function toggleIfaceAutoRefresh() {
  if (ifaceAutoRefreshInterval) {
    stopIfaceAutoRefresh();
  } else {
    startIfaceAutoRefresh();
  }
}

function startIfaceAutoRefresh() {
  stopIfaceAutoRefresh();
  document.getElementById('iface-refresh-btn').style.background = 'rgba(34,197,94,0.3)';
  document.getElementById('iface-refresh-text').textContent = 'Auto Refresh Active (3s)';
  
  ifaceAutoRefreshInterval = setInterval(() => {
    if (activeRouterId) {
      loadRouterInterfaces(activeRouterId, true);
      loadRouterDetails(activeRouterId);
    }
  }, 3000);
}

function stopIfaceAutoRefresh() {
  if (ifaceAutoRefreshInterval) {
    clearInterval(ifaceAutoRefreshInterval);
    ifaceAutoRefreshInterval = null;
  }
  const btn = document.getElementById('iface-refresh-btn');
  if (btn) {
    btn.style.background = 'rgba(255,255,255,0.06)';
    document.getElementById('iface-refresh-text').textContent = 'Auto Refresh (3s)';
  }
}

function reloadCurrentDetailTab() {
  if (activeRouterId) {
    loadRouterDetails(activeRouterId);
    loadRouterInterfaces(activeRouterId);
  }
}

async function toggleIface(ifaceId, currentDisabled) {
  const actionText = currentDisabled ? 'mengaktifkan' : 'menonaktifkan';
  if (!confirm(`Yakin ingin ${actionText} interface ini?`)) return;

  try {
    const res = await fetch(`/admin/api/routers/${activeRouterId}/interfaces/${encodeURIComponent(ifaceId)}/toggle`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ disabled: !currentDisabled })
    });
    const data = await res.json();
    if (data.success) {
      alert(`✅ ${data.message || 'Berhasil'}`);
      loadRouterInterfaces(activeRouterId);
    } else {
      alert(`❌ Gagal: ${data.error}`);
    }
  } catch (e) {
    alert('❌ Terjadi kesalahan sistem');
  }
}

// ─── LIVE TRAFFIC REALTIME POPUP LOGIC ───
function openInterfaceTrafficModal(ifaceName) {
  currentMonitoringIfaceName = ifaceName;
  const iface = currentInterfacesData.find(i => i.name === ifaceName) || {};

  document.getElementById('traffic-iface-name').textContent = ifaceName;
  document.getElementById('traffic-iface-type').textContent = iface.type || '-';
  document.getElementById('traffic-iface-mac').textContent = iface.macAddress || '-';
  document.getElementById('traffic-iface-mtu').textContent = iface.mtu || '-';
  document.getElementById('traffic-iface-status').innerHTML = iface.disabled ? '<span class="badge bm">Disabled</span>' : (iface.running ? '<span class="badge bs">Running</span>' : '<span class="badge bw">Link Down</span>');
  document.getElementById('traffic-rx-total').textContent = iface.rxBytesFormatted || '-';
  document.getElementById('traffic-tx-total').textContent = iface.txBytesFormatted || '-';

  document.getElementById('traffic-rx-rate').textContent = '0.00 Mbps';
  document.getElementById('traffic-tx-rate').textContent = '0.00 Mbps';

  initLiveTrafficChart();
  openModal('interfaceTrafficModal');
  startTrafficStream();
}

function closeInterfaceTrafficModal() {
  stopTrafficStream();
  if (liveChart) {
    liveChart.destroy();
    liveChart = null;
  }
  closeModal('interfaceTrafficModal');
}

function initLiveTrafficChart() {
  const ctx = document.getElementById('liveTrafficChartCanvas').getContext('2d');
  if (liveChart) {
    liveChart.destroy();
  }

  const initialLabels = Array(15).fill('');
  const initialRxData = Array(15).fill(0);
  const initialTxData = Array(15).fill(0);

  liveChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: initialLabels,
      datasets: [
        {
          label: 'Download (Rx Rate - Mbps)',
          data: initialRxData,
          borderColor: '#22c55e',
          backgroundColor: 'rgba(34, 197, 94, 0.15)',
          fill: true,
          tension: 0.4,
          borderWidth: 2,
          pointRadius: 2,
          pointHoverRadius: 5
        },
        {
          label: 'Upload (Tx Rate - Mbps)',
          data: initialTxData,
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59, 130, 246, 0.15)',
          fill: true,
          tension: 0.4,
          borderWidth: 2,
          pointRadius: 2,
          pointHoverRadius: 5
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 300 },
      scales: {
        x: {
          grid: { color: 'rgba(255, 255, 255, 0.05)' },
          ticks: { color: 'rgba(255, 255, 255, 0.5)', font: { size: 10 } }
        },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(255, 255, 255, 0.08)' },
          ticks: {
            color: 'rgba(255, 255, 255, 0.7)',
            font: { size: 11 },
            callback: function(val) { return val + ' Mbps'; }
          }
        }
      },
      plugins: {
        legend: {
          labels: { color: '#ffffff', font: { size: 12, weight: 'bold' } }
        },
        tooltip: {
          mode: 'index',
          intersect: false,
          callbacks: {
            label: function(context) {
              return context.dataset.label + ': ' + context.parsed.y.toFixed(2) + ' Mbps';
            }
          }
        }
      }
    }
  });
}

function startTrafficStream() {
  stopTrafficStream();
  trafficStreamActive = true;
  document.getElementById('traffic-play-pause-btn').innerHTML = '<i class="bi bi-pause-fill"></i> Pause';
  document.getElementById('traffic-chart-status').innerHTML = '<i class="bi bi-circle-fill text-success spin" style="font-size:8px;"></i> Streaming Live...';

  fetchTrafficPoint();
  trafficStreamTimer = setInterval(fetchTrafficPoint, trafficPollingIntervalMs);
}

function stopTrafficStream() {
  trafficStreamActive = false;
  if (trafficStreamTimer) {
    clearInterval(trafficStreamTimer);
    trafficStreamTimer = null;
  }
  const btn = document.getElementById('traffic-play-pause-btn');
  if (btn) btn.innerHTML = '<i class="bi bi-play-fill"></i> Resume';
  const status = document.getElementById('traffic-chart-status');
  if (status) status.innerHTML = '<i class="bi bi-circle-fill text-warning" style="font-size:8px;"></i> Paused';
}

function toggleTrafficStream() {
  if (trafficStreamActive) {
    stopTrafficStream();
  } else {
    startTrafficStream();
  }
}

function changeTrafficInterval() {
  const val = Number(document.getElementById('traffic-interval-select').value) || 2000;
  trafficPollingIntervalMs = val;
  if (trafficStreamActive) {
    startTrafficStream();
  }
}

async function fetchTrafficPoint() {
  if (!activeRouterId || !currentMonitoringIfaceName) return;

  try {
    const res = await fetch(`/admin/api/routers/${activeRouterId}/interfaces/${encodeURIComponent(currentMonitoringIfaceName)}/traffic`);
    const data = await res.json();
    if (data.success && data.traffic) {
      const t = data.traffic;
      const rxBps = Number(t.rxBitsPerSecond || t['rx-bits-per-second'] || t.rx || 0);
      const txBps = Number(t.txBitsPerSecond || t['tx-bits-per-second'] || t.tx || 0);
      const rxMbps = parseFloat((rxBps / 1000000).toFixed(2));
      const txMbps = parseFloat((txBps / 1000000).toFixed(2));

      document.getElementById('traffic-rx-rate').textContent = rxMbps.toFixed(2) + ' Mbps';
      document.getElementById('traffic-tx-rate').textContent = txMbps.toFixed(2) + ' Mbps';
      document.getElementById('traffic-rx-packets').textContent = t.rxPacketsPerSecond.toLocaleString() + ' pkts/s';
      document.getElementById('traffic-tx-packets').textContent = t.txPacketsPerSecond.toLocaleString() + ' pkts/s';

      if (liveChart) {
        const timeLabel = new Date().toLocaleTimeString('id-ID', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
        
        liveChart.data.labels.push(timeLabel);
        liveChart.data.datasets[0].data.push(rxMbps);
        liveChart.data.datasets[1].data.push(txMbps);

        if (liveChart.data.labels.length > MAX_CHART_POINTS) {
          liveChart.data.labels.shift();
          liveChart.data.datasets[0].data.shift();
          liveChart.data.datasets[1].data.shift();
        }

        liveChart.update('none');
      }
    }
  } catch (e) {
    console.error('Error fetching traffic stream point:', e);
  }
}
</script>
</body>
</html>
