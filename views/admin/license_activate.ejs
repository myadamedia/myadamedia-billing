<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Aktivasi Lisensi' %> - <%= (typeof settings !== 'undefined' && settings && settings.company_header) ? settings.company_header : (typeof company !== 'undefined' ? company : 'Billing System') %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0f172a;
      --card-bg: rgba(30, 41, 59, 0.85);
      --border-color: rgba(255, 255, 255, 0.1);
      --accent-color: #3b82f6;
      --accent-hover: #2563eb;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(139, 92, 246, 0.15) 0px, transparent 50%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-main);
      padding: 20px;
    }
    .activation-card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      max-width: 650px;
      width: 100%;
      padding: 40px;
    }
    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 50px;
      color: #60a5fa;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 20px;
    }
    .machine-box {
      background: rgba(15, 23, 42, 0.6);
      border: 1px dashed rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .machine-id-text {
      font-family: monospace;
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #38bdf8;
    }
    .btn-copy {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      padding: 6px 14px;
      font-size: 0.85rem;
      transition: all 0.2s ease;
    }
    .btn-copy:hover {
      background: rgba(255, 255, 255, 0.2);
      color: #fff;
    }
    .form-control-custom {
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      color: #fff;
      padding: 14px;
      font-family: monospace;
      font-size: 0.9rem;
    }
    .form-control-custom:focus {
      background: rgba(15, 23, 42, 0.9);
      border-color: #3b82f6;
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25);
      color: #fff;
    }
    .btn-activate {
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      color: white;
      border: none;
      border-radius: 12px;
      padding: 14px 28px;
      font-weight: 600;
      font-size: 1rem;
      width: 100%;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
    }
    .btn-activate:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6);
      color: white;
    }
    .status-badge-active {
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid rgba(34, 197, 94, 0.4);
      color: #4ade80;
      border-radius: 12px;
      padding: 16px;
    }
  </style>
</head>
<body>
  <div class="activation-card">
    <div class="text-center">
      <div class="brand-badge">
        <i class="bi bi-shield-check">
        SYSTEM SECURITY
      </div>
      <h3 class="fw-bold mb-2">Aktivasi Lisensi Aplikasi</h3>
      <p class="text-secondary small mb-4">Aplikasi ini membutuhkan lisensi resmi seumur hidup (Lifetime License) agar dapat digunakan di server Anda.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div><%= error %></div>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="status-badge-active mb-4 text-center">
        <i class="bi bi-patch-check-fill fs-2 d-block mb-2"></i>
        <h5 class="fw-bold mb-1">Aplikasi Teraktivasi!</h5>
        <p class="mb-2 small"><%= success %></p>
        <div class="mt-3">
          <a href="/admin" class="btn btn-sm btn-success px-4 py-2 rounded-pill fw-semibold">
            <i class="bi bi-speedometer2 me-1"></i> Masuk ke Dashboard Admin
          </a>
        </div>
      </div>
    <% } else if (licenseStatus && licenseStatus.valid) { %>
      <div class="status-badge-active mb-4 text-center">
        <i class="bi bi-shield-lock-fill fs-2 d-block mb-2 text-success"></i>
        <h5 class="fw-bold mb-1">Lisensi Seumur Hidup (Lifetime) Aktif</h5>
        <p class="mb-1 text-light">Perusahaan: <strong><%= licenseStatus.companyName %></strong></p>
        <p class="mb-3 text-secondary small">Hardware Machine ID: <code><%= licenseStatus.machineId %></code></p>
        <a href="/admin" class="btn btn-primary rounded-pill px-4">Lanjut ke Dashboard</a>
      </div>
    <% } else { %>
      <div class="mb-4">
        <label class="form-label text-secondary small fw-semibold">1. Hardware Machine ID Server Ini:</label>
        <div class="machine-box">
          <div>
            <div class="machine-id-text" id="machineIdText"><%= machineId %></div>
            <div class="text-secondary" style="font-size: 0.75rem;">Berikan Machine ID ini kepada penyedia lisensi BroLinks Anda.</div>
          </div>
          <button type="button" class="btn btn-copy" onclick="copyMachineId()">
            <i class="bi bi-clipboard me-1" id="copyIcon"></i> Salin
          </button>
        </div>
      </div>

      <form action="/admin/license/activate" method="POST">
        <div class="mb-4">
          <label for="licenseKey" class="form-label text-secondary small fw-semibold">2. Masukkan License Key Resmi:</label>
          <textarea 
            name="licenseKey" 
            id="licenseKey" 
            rows="5" 
            class="form-control form-control-custom" 
            placeholder="Tempelkan (Paste) License Key yang Anda dapatkan dari Vendor BroLinks di sini..." 
            required></textarea>
        </div>

        <button type="submit" class="btn btn-activate">
          <i class="bi bi-key-fill me-2"></i> Aktifkan Lisensi Sekarang
        </button>
      </form>
    <% } %>

    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center text-secondary style="font-size: 0.8rem;">
      Need assistance? Hubungi dukungan teknis penyedia sistem Anda.
    </div>
  </div>

  <script>
    function copyMachineId() {
      const text = document.getElementById('machineIdText').innerText;
      navigator.clipboard.writeText(text).then(() => {
        const icon = document.getElementById('copyIcon');
        icon.className = 'bi bi-check-lg text-success';
        alert('Machine ID berhasil disalin ke clipboard!');
        setTimeout(() => {
          icon.className = 'bi bi-clipboard';
        }, 2000);
      });
    }
  </script>
</body>
</html>
