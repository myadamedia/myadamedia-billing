<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Manajemen RADIUS NAS | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    .hero-banner {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(16, 185, 129, 0.12) 50%, rgba(56, 189, 248, 0.15) 100%);
      border: 1px solid rgba(99, 102, 241, 0.25);
      border-radius: 20px;
      padding: 24px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }
    .hero-banner::after {
      content: '';
      position: absolute;
      top: -50%; right: -10%;
      width: 250px; height: 250px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-title {
      font-size: 20px; font-weight: 800; color: var(--text);
      display: flex; align-items: center; gap: 10px; margin-bottom: 6px;
    }
    .hero-subtitle {
      font-size: 13px; color: var(--muted); max-width: 680px; line-height: 1.5;
    }
    .code-box {
      background: #0f172a; color: #38bdf8; padding: 16px; border-radius: 12px; font-family: 'Fira Code', monospace, sans-serif; font-size: 13px;
      border: 1px solid rgba(56, 189, 248, 0.3); white-space: pre-wrap; word-break: break-all; margin-top: 12px; line-height: 1.6;
      box-shadow: inset 0 2px 6px rgba(0,0,0,0.4);
    }
    .search-box-wrap {
      position: relative; min-width: 240px;
    }
    .search-box-wrap i {
      position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted);
    }
    .search-box-wrap input {
      padding-left: 36px; border-radius: 12px; font-size: 13px; background: var(--bg3); border: 1px solid var(--border); color: var(--text);
    }
  </style>
</head>
<body>
<%- include('../partials/sidebar', { activePage: 'radius_nas' }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-shield-check" style="color:var(--primary);"></i>
      <span>Manajemen Router NAS (RADIUS Client)</span>
    </div>
    <div class="tb-right">
      <a href="/admin/radius/sessions" class="btn btn-g btn-sm" style="border-radius:12px; font-weight:700;">
        <i class="bi bi-person-check-fill text-success me-1"></i> Sesi RADIUS
      </a>
    </div>
  </div>

  <div class="page">

    <% if (msg) { %>
      <div class="alert <%= msg.type === 'error' ? 'd' : 's' %>" style="margin-bottom: 20px; border-radius: 12px;"><%= msg.text %></div>
    <% } %>

    <!-- RADIUS TAB NAVIGATION -->
    <div style="display: flex; gap: 8px; margin-bottom: 20px; background: var(--bg2); padding: 6px; border-radius: 14px; border: 1px solid var(--border); width: fit-content;">
      <a href="/admin/radius" style="display: flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 10px; font-size: 13px; font-weight: 700; text-decoration: none; background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); color: #ffffff; box-shadow: 0 4px 12px rgba(79,70,229,0.3);">
        <i class="bi bi-shield-check"></i> Router NAS (RADIUS Client)
      </a>
      <a href="/admin/radius/sessions" style="display: flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 10px; font-size: 13px; font-weight: 600; text-decoration: none; color: var(--muted); transition: 0.2s;">
        <i class="bi bi-person-check-fill"></i> Sesi RADIUS Aktif & Traffic Realtime
      </a>
    </div>

    <!-- HERO WELCOME BANNER -->
    <div class="hero-banner">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
          <div class="hero-title">
            <i class="bi bi-router-fill" style="color: var(--primary); font-size: 24px;"></i>
            Router NAS (RADIUS Client)
            <span class="adm-badge" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3); color: #10b981;">
              <i class="bi bi-check-circle-fill"></i> Centralized Auth
            </span>
          </div>
          <p class="hero-subtitle">
            Kelola daftar RouterOS client yang terhubung dengan RADIUS Server Billing. Setiap router NAS berkomunikasi secara terenkripsi menggunakan Secret Key.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button class="btn btn-p btn-sm" onclick="openAddModal()" style="border-radius: 12px; font-weight: 700; padding: 10px 18px;">
            <i class="bi bi-plus-lg me-1"></i> Tambah NAS Router
          </button>
        </div>
      </div>
    </div>

    <!-- STAT CARDS GRID -->
    <div class="stat-grid" style="margin-bottom: 22px;">
      <div class="sc p">
        <i class="bi bi-hdd-network sc-icon"></i>
        <div class="sc-label">Total NAS Router</div>
        <div class="sc-val"><%= nasList.length %></div>
        <div class="sc-sub">Router terdaftar</div>
      </div>
      <div class="sc s">
        <i class="bi bi-check-circle-fill sc-icon" style="color: #10b981;"></i>
        <div class="sc-label">NAS Status Aktif</div>
        <div class="sc-val"><%= nasList.filter(n => n.is_active).length %></div>
        <div class="sc-sub">Siap diautentikasi</div>
      </div>
      <div class="sc i">
        <i class="bi bi-shield-lock-fill sc-icon" style="color: #38bdf8;"></i>
        <div class="sc-label">Port Authentication</div>
        <div class="sc-val" style="font-size: 20px;">UDP 1812</div>
        <div class="sc-sub">Access-Request Port</div>
      </div>
      <div class="sc w">
        <i class="bi bi-activity sc-icon" style="color: #f59e0b;"></i>
        <div class="sc-label">Port Accounting</div>
        <div class="sc-val" style="font-size: 20px;">UDP 1813</div>
        <div class="sc-sub">Acct-Status Port</div>
      </div>
    </div>

    <!-- MAIN TABLE CARD -->
    <div class="card">
      <div class="card-hd" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <h6><i class="bi bi-list-task"></i> Daftar NAS Router Terdaftar (<%= nasList.length %>)</h6>
        <div style="display:flex; gap:10px; align-items:center;">
          <div class="search-box-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="searchNasInput" class="fc" placeholder="Cari IP / Nama Router..." onkeyup="filterNasTable()">
          </div>
          <button class="btn btn-p btn-sm" onclick="openAddModal()">
            <i class="bi bi-plus-lg me-1"></i> Tambah NAS
          </button>
        </div>
      </div>

      <div class="card-bd" style="padding:0;">
        <div class="tbl-wrap" style="overflow-x:auto;">
          <table class="tbl" id="nasTable" style="width:100%; border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:1px solid var(--border); background:var(--bg3); text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">
                <th style="padding:14px 18px;">Nama / Shortname</th>
                <th style="padding:14px 18px;">IP NAS (Host)</th>
                <th style="padding:14px 18px;">Shared Secret</th>
                <th style="padding:14px 18px;">Port RADIUS</th>
                <th style="padding:14px 18px;">Router MikroTik</th>
                <th style="padding:14px 18px;">Status</th>
                <th style="padding:14px 18px; text-align: right;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (!nasList || nasList.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center text-muted" style="padding: 32px 18px;">
                    <i class="bi bi-info-circle" style="font-size: 28px; display:block; margin-bottom: 8px; color:var(--primary);"></i>
                    Belum ada Router NAS yang terdaftar. Klik <strong>Tambah NAS Router</strong> untuk mendaftarkan MikroTik.
                  </td>
                </tr>
              <% } else { %>
                <% nasList.forEach(nas => { %>
                  <tr class="nas-row-item" style="border-bottom:1px solid var(--border); transition: background 0.2s;">
                    <td style="padding:14px 18px;">
                      <div style="font-weight:700; font-size:14px; color:var(--text); display:flex; align-items:center; gap:8px;">
                        <i class="bi bi-hdd-network" style="color:var(--primary);"></i>
                        <span class="nas-shortname-text"><%= nas.shortname %></span>
                      </div>
                      <% if (nas.description) { %>
                        <div style="font-size:12px; color:var(--muted); margin-top:2px;"><%= nas.description %></div>
                      <% } %>
                    </td>
                    <td style="padding:14px 18px;">
                      <code class="nas-ip-text" style="font-size:13px; font-weight:600; padding:3px 8px; background:rgba(255,255,255,0.06); border-radius:6px; color:#38bdf8;"><%= nas.nasname %></code>
                    </td>
                    <td style="padding:14px 18px;">
                      <div style="display:flex; align-items:center; gap:6px;">
                        <span class="text-muted" style="letter-spacing: 2px; font-family:monospace;">••••••••</span>
                        <button type="button" class="btn btn-g btn-sm" style="padding:2px 6px; font-size:11px;" onclick="alert('Secret: <%= nas.secret %>')" title="Lihat Secret">
                          <i class="bi bi-eye"></i>
                        </button>
                      </div>
                    </td>
                    <td style="padding:14px 18px;"><span class="badge" style="background:var(--bg3); color:var(--text); font-weight:600;"><%= nas.ports %></span></td>
                    <td style="padding:14px 18px;">
                      <% if (nas.router_name) { %>
                        <span class="badge bg-s" style="padding:4px 10px; border-radius:6px; font-size:11px; background:rgba(99,102,241,0.15); color:#818cf8; font-weight:600;"><i class="bi bi-router me-1"></i> <%= nas.router_name %></span>
                      <% } else { %>
                        <span class="text-muted" style="font-size:12px;">-</span>
                      <% } %>
                    </td>
                    <td style="padding:14px 18px;">
                      <% if (nas.is_active) { %>
                        <span class="badge bg-s" style="padding:4px 10px; border-radius:6px; font-size:11px; background:rgba(16,185,129,0.15); color:var(--success); font-weight:700;"><i class="bi bi-check-circle me-1"></i> Aktif</span>
                      <% } else { %>
                        <span class="badge bg-d" style="padding:4px 10px; border-radius:6px; font-size:11px; background:rgba(239,68,68,0.15); color:var(--danger); font-weight:700;"><i class="bi bi-dash-circle me-1"></i> Non-Aktif</span>
                      <% } %>
                    </td>
                    <td style="padding:14px 18px; text-align: right;">
                      <div style="display:flex; justify-content:flex-end; gap:6px; align-items:center;">
                        <button class="btn btn-g btn-sm" style="border-radius:8px; font-weight:600; font-size:12px;" onclick="showScriptModal('<%= nas.shortname %>', '<%= nas.nasname %>', '<%= nas.secret %>')">
                          <i class="bi bi-terminal-fill me-1" style="color:var(--info)"></i> Script
                        </button>
                        <button class="btn btn-g btn-sm" style="border-radius:8px; font-weight:600; font-size:12px;" onclick="openEditModal(<%= JSON.stringify(nas) %>)">
                          <i class="bi bi-pencil-square me-1"></i> Edit
                        </button>
                        <form action="/admin/radius/nas/<%= nas.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Yakin hapus NAS ini?')">
                          <button type="submit" class="btn btn-d btn-sm" style="border-radius:8px; padding:4px 8px;" title="Hapus NAS"><i class="bi bi-trash"></i></button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- MODAL TAMBAH / EDIT NAS -->
<div class="mo" id="nasModal">
  <div class="mb" style="max-width: 560px;">
    <form id="nasForm" action="/admin/radius/nas" method="POST">
      <div class="mh">
        <span class="mt" id="modalTitle"><i class="bi bi-plus-circle"></i> Tambah Router NAS</span>
        <button type="button" class="mc" onclick="closeModal('nasModal')">&times;</button>
      </div>
      <div class="mbody" style="padding: 20px;">
        <div class="fg" style="margin-bottom: 16px;">
          <label class="fl">IP Address NAS Router *</label>
          <input type="text" name="nasname" id="f-nasname" class="fc" placeholder="Contoh: 192.168.88.1 atau 0.0.0.0 (Wildcard)" required>
          <div class="fh" style="font-size: 11px; color: var(--muted); margin-top: 4px;">Masukkan IP MikroTik yang akan berkomunikasi dengan RADIUS Billing.</div>
        </div>
        <div class="fg" style="margin-bottom: 16px;">
          <label class="fl">Nama Alias / Shortname *</label>
          <input type="text" name="shortname" id="f-shortname" class="fc" placeholder="Contoh: Router-Utama-Mikrotik" required>
        </div>
        <div class="fg" style="margin-bottom: 16px;">
          <label class="fl">Shared Secret Key *</label>
          <input type="text" name="secret" id="f-secret" class="fc" placeholder="Sandi rahasia RADIUS" required>
          <div class="fh" style="font-size: 11px; color: var(--muted); margin-top: 4px;">Diisi manual dan harus sama persis dengan yang dikonfigurasi di RouterOS RADIUS Client.</div>
        </div>
        <div class="fg" style="margin-bottom: 16px;">
          <label class="fl">Hubungkan ke Router MikroTik</label>
          <select name="router_id" id="f-router_id" class="fc" style="cursor:pointer;">
            <option value="">-- Pilih Router MikroTik (Opsional) --</option>
            <% (routers || []).forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="fg" style="margin-bottom: 16px;">
          <label class="fl">Keterangan</label>
          <input type="text" name="description" id="f-description" class="fc" placeholder="Lokasi / Catatan tambahan">
        </div>
        <div class="fg" id="statusFieldGroup" style="display: none; margin-bottom: 16px;">
          <label class="fl">Status NAS</label>
          <select name="is_active" id="f-is_active" class="fc" style="cursor:pointer;">
            <option value="1">Aktif</option>
            <option value="0">Non-Aktif</option>
          </select>
        </div>
      </div>
      <div class="mf" style="display:flex; justify-content:flex-end; gap:10px; padding:16px 20px; border-top:1px solid var(--border);">
        <button type="button" class="btn btn-g" onclick="closeModal('nasModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-save me-1"></i> Simpan NAS</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL SCRIPT TERMINAL MIKROTIK -->
<div class="mo" id="scriptModal">
  <div class="mb" style="max-width: 650px;">
    <div class="mh">
      <span class="mt"><i class="bi bi-terminal-fill text-info me-2"></i> Script Setup RouterOS RADIUS Client</span>
      <button type="button" class="mc" onclick="closeModal('scriptModal')">&times;</button>
    </div>
    <div class="mbody" style="padding: 20px;">
      <p style="font-size: 13px; color: var(--muted); margin-bottom: 10px;">
        Buka <strong>New Terminal</strong> di MikroTik Winbox/SSH, lalu salin dan tempel perintah berikut:
      </p>
      
      <div class="code-box" id="scriptCodeText">
/radius add service=ppp,hotspot address=127.0.0.1 secret="secret" authentication-port=1812 accounting-port=1813 timeout=3s;
/ppp aaa set use-radius=yes;
/ip hotspot profile set [find] use-radius=yes;
      </div>
    </div>
    <div class="mf" style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px; border-top:1px solid var(--border);">
      <span id="copySuccessMsg" style="display:none; font-size:12px; color:var(--success); font-weight:700;">
        <i class="bi bi-check-circle-fill me-1"></i> Script disalin ke clipboard!
      </span>
      <div style="display:flex; gap:10px; margin-left:auto;">
        <button type="button" class="btn btn-p" onclick="copyScriptCode()"><i class="bi bi-clipboard me-1"></i> Salin Script</button>
        <button type="button" class="btn btn-g" onclick="closeModal('scriptModal')">Tutup</button>
      </div>
    </div>
  </div>
</div>

<script>
function openModal(id) { document.getElementById(id)?.classList.add('show'); }
function closeModal(id) { document.getElementById(id)?.classList.remove('show'); }

function openAddModal() {
  document.getElementById('modalTitle').innerHTML = '<i class="bi bi-plus-circle me-1"></i> Tambah Router NAS';
  document.getElementById('nasForm').action = '/admin/radius/nas';
  document.getElementById('f-nasname').value = '';
  document.getElementById('f-shortname').value = '';
  document.getElementById('f-secret').value = '';
  document.getElementById('f-router_id').value = '';
  document.getElementById('f-description').value = '';
  document.getElementById('statusFieldGroup').style.display = 'none';
  openModal('nasModal');
}

function openEditModal(nas) {
  document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil-square me-1"></i> Edit Router NAS';
  document.getElementById('nasForm').action = '/admin/radius/nas/' + nas.id + '/update';
  document.getElementById('f-nasname').value = nas.nasname || '';
  document.getElementById('f-shortname').value = nas.shortname || '';
  document.getElementById('f-secret').value = nas.secret || '';
  document.getElementById('f-router_id').value = nas.router_id || '';
  document.getElementById('f-description').value = nas.description || '';
  document.getElementById('f-is_active').value = nas.is_active ? '1' : '0';
  document.getElementById('statusFieldGroup').style.display = 'block';
  openModal('nasModal');
}

function showScriptModal(shortname, nasname, secret) {
  const host = window.location.hostname || 'IP_SERVER_BILLING';
  const script = `/radius add service=ppp,hotspot address=${host} secret="${secret}" authentication-port=1812 accounting-port=1813 timeout=3s comment="MyAdamedia RADIUS Server";\n/ppp aaa set use-radius=yes;\n/ip hotspot profile set [find] use-radius=yes;`;
  document.getElementById('scriptCodeText').innerText = script;
  document.getElementById('copySuccessMsg').style.display = 'none';
  openModal('scriptModal');
}

function copyScriptCode() {
  const text = document.getElementById('scriptCodeText').innerText;
  navigator.clipboard.writeText(text).then(() => {
    const msg = document.getElementById('copySuccessMsg');
    if (msg) { msg.style.display = 'inline-flex'; setTimeout(() => { msg.style.display = 'none'; }, 3000); }
  });
}

function filterNasTable() {
  const query = (document.getElementById('searchNasInput').value || '').toLowerCase().trim();
  const rows = document.querySelectorAll('.nas-row-item');
  rows.forEach(r => {
    const text = r.innerText.toLowerCase();
    r.style.display = text.includes(query) ? '' : 'none';
  });
}
</script>

</body>
</html>
