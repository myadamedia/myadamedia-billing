<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sesi Active RADIUS | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
</head>
<body>
<%- include('../partials/sidebar', { activePage: 'radius_sessions' }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-person-check-fill text-success"></i>
      <span>Monitoring Sesi Aktif RADIUS</span>
    </div>
  </div>

  <div class="page">

    <% if (msg) { %>
      <div class="alert <%= msg.type === 'error' ? 'd' : 's' %>"><%= msg.text %></div>
    <% } %>

    <div class="card">
      <div class="card-hd" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <h6>
          <i class="bi bi-person-check-fill" style="color:#10b981;"></i> Pengguna Terhubung Real-time 
          <span class="badge bs" id="sessionCount" style="margin-left: 6px;"><%= (activeSessions || []).length %></span>
        </h6>
        <div>
          <button class="btn btn-g btn-sm" onclick="fetchLiveSessions()">
            <i class="bi bi-arrow-clockwise"></i> Refresh Data
          </button>
        </div>
      </div>

      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>Username</th>
              <th>IP Address</th>
              <th>MAC Address (Calling-ID)</th>
              <th>NAS Router</th>
              <th>Waktu Mulai</th>
              <th>Upload / Download</th>
              <th style="text-align: right;">Aksi (CoA)</th>
            </tr>
          </thead>
          <tbody id="sessionTableBody">
            <% if (!activeSessions || activeSessions.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center text-muted" style="padding: 24px;">
                  <i class="bi bi-wifi-off fs-3 d-block mb-2"></i>
                  Belum ada sesi pelanggan PPPoE / Hotspot yang terhubung via RADIUS saat ini.
                </td>
              </tr>
            <% } else { %>
              <% activeSessions.forEach(s => { %>
                <tr>
                  <td>
                    <strong><%= s.username %></strong>
                    <span class="badge bs" style="margin-left: 4px;">Online</span>
                  </td>
                  <td><code><%= s.framedipaddress || '-' %></code></td>
                  <td><small class="text-muted"><%= s.callingstationid || '-' %></small></td>
                  <td><code><%= s.nasipaddress %></code></td>
                  <td><small><%= new Date(s.acctstarttime).toLocaleString('id-ID') %></small></td>
                  <td>
                    <span style="color: #34d399;"><i class="bi bi-arrow-up"></i> <%= (s.acctinputoctets / 1048576).toFixed(2) %> MB</span> /
                    <span style="color: #60a5fa;"><i class="bi bi-arrow-down"></i> <%= (s.acctoutputoctets / 1048576).toFixed(2) %> MB</span>
                  </td>
                  <td style="text-align: right;">
                    <form action="/admin/radius/sessions/<%= encodeURIComponent(s.username) %>/disconnect" method="POST" style="display: inline-block;" onsubmit="return confirm('Disconnect/Kick user <%= s.username %>?')">
                      <button type="submit" class="btn btn-d btn-sm">
                        <i class="bi bi-power"></i> Kick (CoA)
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script>
async function fetchLiveSessions() {
  try {
    const res = await fetch('/admin/radius/api/sessions');
    const data = await res.json();
    if (!data.success) return;

    document.getElementById('sessionCount').innerText = data.sessions.length;
    const tbody = document.getElementById('sessionTableBody');

    if (data.sessions.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" class="text-center text-muted" style="padding: 24px;">
            <i class="bi bi-wifi-off fs-3 d-block mb-2"></i>
            Belum ada sesi pelanggan PPPoE / Hotspot yang terhubung via RADIUS saat ini.
          </td>
        </tr>`;
      return;
    }

    tbody.innerHTML = data.sessions.map(s => {
      const upMb = (s.acctinputoctets / 1048576).toFixed(2);
      const downMb = (s.acctoutputoctets / 1048576).toFixed(2);
      const startTime = new Date(s.acctstarttime).toLocaleString('id-ID');
      return `
        <tr>
          <td><strong>${s.username}</strong> <span class="badge bs" style="margin-left: 4px;">Online</span></td>
          <td><code>${s.framedipaddress || '-'}</code></td>
          <td><small class="text-muted">${s.callingstationid || '-'}</small></td>
          <td><code>${s.nasipaddress}</code></td>
          <td><small>${startTime}</small></td>
          <td>
            <span style="color: #34d399;"><i class="bi bi-arrow-up"></i> ${upMb} MB</span> /
            <span style="color: #60a5fa;"><i class="bi bi-arrow-down"></i> ${downMb} MB</span>
          </td>
          <td style="text-align: right;">
            <form action="/admin/radius/sessions/${encodeURIComponent(s.username)}/disconnect" method="POST" style="display: inline-block;" onsubmit="return confirm('Disconnect/Kick user ${s.username}?')">
              <button type="submit" class="btn btn-d btn-sm"><i class="bi bi-power"></i> Kick (CoA)</button>
            </form>
          </td>
        </tr>`;
    }).join('');
  } catch (err) {
    console.error('Failed to fetch live sessions:', err);
  }
}

setInterval(fetchLiveSessions, 10000);
</script>

</body>
</html>
