<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sesi Active RADIUS | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    /* Styling Presisi Live Bandwidth Monitoring Component */
    .live-monitoring-card {
      background: var(--bg2, #1e293b);
      border: 1px solid var(--border, #334155);
      border-radius: 14px;
      padding: 16px 20px;
      margin-bottom: 20px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
    }
    .live-monitoring-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .live-monitoring-title {
      font-size: 13px;
      font-weight: 800;
      color: var(--text, #f8fafc);
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 8px;
      text-transform: uppercase;
    }
    .badge-live-pulse {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 800;
      color: #10b981;
      letter-spacing: 1px;
    }
    .badge-live-pulse .dot {
      width: 8px;
      height: 8px;
      background-color: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 8px #10b981;
      animation: pulseLive 1.5s infinite ease-in-out;
    }
    @keyframes pulseLive {
      0% { transform: scale(0.95); opacity: 0.7; }
      50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 12px #10b981; }
      100% { transform: scale(0.95); opacity: 0.7; }
    }

    .traffic-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    @media (max-width: 768px) {
      .traffic-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }
    }

    .traffic-block {
      border-radius: 10px;
      padding: 16px 20px;
      text-align: center;
      transition: all 0.2s ease-in-out;
    }
    .traffic-block.download {
      background: rgba(16, 185, 129, 0.04);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .traffic-block.download:hover {
      border-color: #10b981;
      box-shadow: 0 0 16px rgba(16, 185, 129, 0.15);
    }
    .traffic-block.upload {
      background: rgba(59, 130, 246, 0.04);
      border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .traffic-block.upload:hover {
      border-color: #3b82f6;
      box-shadow: 0 0 16px rgba(59, 130, 246, 0.15);
    }

    .traffic-label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
      text-transform: uppercase;
    }
    .traffic-block.download .traffic-label { color: #10b981; }
    .traffic-block.upload .traffic-label { color: #3b82f6; }

    .traffic-speed {
      font-size: 28px;
      font-weight: 900;
      line-height: 1.15;
      margin-bottom: 4px;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .traffic-block.download .traffic-speed { color: #10b981; }
    .traffic-block.upload .traffic-speed { color: #60a5fa; }

    .traffic-total {
      font-size: 12px;
      font-weight: 600;
      color: #94a3b8;
    }

    /* Interactive Username Link & Modal Styling */
    .user-detail-link {
      color: #38bdf8;
      text-decoration: none;
      font-weight: 700;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
    }
    .user-detail-link:hover {
      color: #7dd3fc;
      text-decoration: underline;
    }

    /* Custom Modal Overlay & Box Styling */
    .mo {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .mo.show, .mo.open {
      display: flex !important;
    }
    .mo .mb {
      background: var(--bg2, #1e293b);
      border: 1px solid var(--border, #334155);
      border-radius: 16px;
      width: 100%;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .mo .mh {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border, #334155);
    }
    .mo .mt {
      font-size: 16px;
      font-weight: 700;
      color: var(--text, #f8fafc);
      margin: 0;
    }
    .mo .mc {
      background: none;
      border: none;
      color: var(--muted, #94a3b8);
      font-size: 24px;
      cursor: pointer;
      line-height: 1;
      padding: 0;
    }
    .mo .mc:hover {
      color: var(--text, #f8fafc);
    }
  </style>
</head>
<body>
<%- include('../partials/sidebar', { activePage: 'radius_sessions' }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-person-check-fill text-success"></i>
      <span>Monitoring Sesi Aktif RADIUS</span>
    </div>
  </div>

  <div class="page">

    <% if (msg) { %>
      <div class="alert <%= msg.type === 'error' ? 'd' : 's' %>"><%= msg.text %></div>
    <% } %>

    <%
      function fmtBytes(b) {
        const val = Number(b || 0);
        if (val <= 0) return '0.00 MB';
        if (val >= 1099511627776) return (val / 1099511627776).toFixed(2) + ' TB';
        if (val >= 1073741824) return (val / 1073741824).toFixed(2) + ' GB';
        if (val >= 1048576) return (val / 1048576).toFixed(2) + ' MB';
        return (val / 1024).toFixed(2) + ' KB';
      }

      function fmtSpeed(bps) {
        const rate = Number(bps || 0);
        if (rate <= 0 || !isFinite(rate)) return '0.00 bps';
        if (rate >= 1000000000) return (rate / 1000000000).toFixed(2) + ' Gbps';
        if (rate >= 1000000) return (rate / 1000000).toFixed(2) + ' Mbps';
        if (rate >= 1000) return (rate / 1000).toFixed(2) + ' Kbps';
        return rate.toFixed(0) + ' bps';
      }

      const safeRxOctets = (typeof totalOutputOctets !== 'undefined') ? totalOutputOctets : ((typeof locals !== 'undefined' && typeof locals.totalOutputOctets !== 'undefined') ? locals.totalOutputOctets : 0);
      const safeTxOctets = (typeof totalInputOctets !== 'undefined') ? totalInputOctets : ((typeof locals !== 'undefined' && typeof locals.totalInputOctets !== 'undefined') ? locals.totalInputOctets : 0);
    %>

    <!-- Widget Live Bandwidth Monitoring (Presisi Gambar UI) -->
    <div class="live-monitoring-card">
      <div class="live-monitoring-header">
        <div class="live-monitoring-title">
          <i class="bi bi-speedometer2" style="color:#6366f1"></i> LIVE BANDWIDTH MONITORING
        </div>
        <div class="badge-live-pulse">
          <span class="dot"></span> <i class="bi bi-broadcast"></i> LIVE
        </div>
      </div>
      <div class="traffic-grid">
        <!-- DOWNLOAD (RX SPEED) -->
        <div class="traffic-block download">
          <div class="traffic-label">DOWNLOAD (RX SPEED)</div>
          <div class="traffic-speed" id="liveRxSpeed">0.00 Mbps</div>
          <div class="traffic-total" id="liveRxTotal">Total: <%= fmtBytes(safeRxOctets) %></div>
        </div>

        <!-- UPLOAD (TX SPEED) -->
        <div class="traffic-block upload">
          <div class="traffic-label">UPLOAD (TX SPEED)</div>
          <div class="traffic-speed" id="liveTxSpeed">0.00 Mbps</div>
          <div class="traffic-total" id="liveTxTotal">Total: <%= fmtBytes(safeTxOctets) %></div>
        </div>
      </div>
    </div>

    <!-- Card Tabel Pengguna Terhubung Real-time -->
    <div class="card">
      <div class="card-hd" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <h6>
          <i class="bi bi-person-check-fill" style="color:#10b981;"></i> Pengguna Terhubung Real-time 
          <span class="badge bs" id="sessionCount" style="margin-left: 6px;"><%= (activeSessions || []).length %></span>
        </h6>
        <div>
          <button class="btn btn-g btn-sm" onclick="fetchLiveSessions()">
            <i class="bi bi-arrow-clockwise"></i> Refresh Data
          </button>
        </div>
      </div>

      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>Username</th>
              <th>IP Address</th>
              <th>MAC Address (Calling-ID)</th>
              <th>NAS Router</th>
              <th>Waktu Mulai</th>
              <th>Upload / Download</th>
              <th style="text-align: right;">Aksi (CoA)</th>
            </tr>
          </thead>
          <tbody id="sessionTableBody">
            <% if (!activeSessions || activeSessions.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center text-muted" style="padding: 24px;">
                  <i class="bi bi-wifi-off fs-3 d-block mb-2"></i>
                  Belum ada sesi pelanggan PPPoE / Hotspot yang terhubung via RADIUS saat ini.
                </td>
              </tr>
            <% } else { %>
              <% activeSessions.forEach(s => { %>
                <%
                  const upMb = (s.acctinputoctets / 1048576).toFixed(2);
                  const downMb = (s.acctoutputoctets / 1048576).toFixed(2);
                %>
                <tr>
                  <td>
                    <a href="javascript:void(0)" onclick="showCustomerDetail('<%= s.username %>')" class="user-detail-link" title="Klik untuk lihat detail pelanggan">
                      <i class="bi bi-person-badge text-info me-1"></i><strong><%= s.username %></strong>
                    </a>
                    <span class="badge bs" style="margin-left: 4px;">Online</span>
                  </td>
                  <td><code><%= s.framedipaddress || '-' %></code></td>
                  <td><small class="text-muted"><%= s.callingstationid || '-' %></small></td>
                  <td><code><%= s.nasipaddress %></code></td>
                  <td><small><%= new Date(s.acctstarttime).toLocaleString('id-ID') %></small></td>
                  <td>
                    <div style="font-weight: 700;">
                      <span style="color: #34d399;" title="Upload Speed & Total Volume">
                        <i class="bi bi-arrow-up"></i> 0.00 bps <small class="text-muted">(<%= upMb %> MB)</small>
                      </span>
                      <span class="text-muted mx-1">/</span>
                      <span style="color: #60a5fa;" title="Download Speed & Total Volume">
                        <i class="bi bi-arrow-down"></i> 0.00 bps <small class="text-muted">(<%= downMb %> MB)</small>
                      </span>
                    </div>
                  </td>
                  <td style="text-align: right;">
                    <form action="/admin/radius/sessions/<%= encodeURIComponent(s.username) %>/disconnect" method="POST" style="display: inline-block;" onsubmit="return confirm('Disconnect/Kick user <%= s.username %>?')">
                      <button type="submit" class="btn btn-d btn-sm">
                        <i class="bi bi-power"></i> Kick (CoA)
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<!-- Modal Popup Detail Pelanggan RADIUS -->
<div class="mo" id="customerDetailModal" onclick="if(event.target===this)closeModal('customerDetailModal')">
  <div class="mb" style="max-width: 580px; width: 92%;">
    <div class="mh">
      <h5 class="mt" id="cdModalTitle"><i class="bi bi-person-badge text-primary me-2"></i> Detail Pelanggan RADIUS</h5>
      <button class="mc" onclick="closeModal('customerDetailModal')">&times;</button>
    </div>
    <div class="mbody" id="cdModalBody" style="padding: 20px;">
      <div class="text-center p-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Memuat data pelanggan...</p>
      </div>
    </div>
    <div class="mf" style="display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; padding: 16px 20px; border-top: 1px solid var(--border, #334155);" id="cdModalFooter">
      <button class="btn btn-g btn-sm" onclick="closeModal('customerDetailModal')">Tutup</button>
    </div>
  </div>
</div>

<script>
// Map username -> { lastRx, lastTx, lastTime, rxBps, txBps }
const userRateMap = {};
let activeSessionsData = [];

function openModal(id) {
  const m = document.getElementById(id);
  if (m) {
    m.classList.add('show');
    m.style.display = 'flex';
  }
}

function closeModal(id) {
  const m = document.getElementById(id);
  if (m) {
    m.classList.remove('show');
    m.style.display = 'none';
  }
}

function escapeHtml(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function formatBytes(bytes) {
  const b = Number(bytes || 0);
  if (b <= 0) return '0.00 MB';
  const tb = 1099511627776;
  const gb = 1073741824;
  const mb = 1048576;
  const kb = 1024;

  if (b >= tb) return (b / tb).toFixed(2) + ' TB';
  if (b >= gb) return (b / gb).toFixed(2) + ' GB';
  if (b >= mb) return (b / mb).toFixed(2) + ' MB';
  return (b / kb).toFixed(2) + ' KB';
}

function formatSpeed(bps) {
  const rate = Number(bps || 0);
  if (rate <= 0 || !isFinite(rate)) return '0.00 bps';
  if (rate >= 1000000000) return (rate / 1000000000).toFixed(2) + ' Gbps';
  if (rate >= 1000000) return (rate / 1000000).toFixed(2) + ' Mbps';
  if (rate >= 1000) return (rate / 1000).toFixed(2) + ' Kbps';
  return rate.toFixed(0) + ' bps';
}

async function showCustomerDetail(username) {
  openModal('customerDetailModal');
  const modalBody = document.getElementById('cdModalBody');
  const modalFooter = document.getElementById('cdModalFooter');

  modalBody.innerHTML = `
    <div class="text-center p-4">
      <div class="spinner-border text-primary" role="status"></div>
      <p class="mt-2 text-muted">Memuat profil pelanggan <strong>${escapeHtml(username)}</strong>...</p>
    </div>`;

  modalFooter.innerHTML = `<button class="btn btn-g btn-sm" onclick="closeModal('customerDetailModal')">Tutup</button>`;

  try {
    const res = await fetch(`/admin/radius/api/customer-detail?username=${encodeURIComponent(username)}`);
    const data = await res.json();

    if (!data.success) {
      modalBody.innerHTML = `<div class="alert alert-danger">${escapeHtml(data.error || 'Gagal memuat data pelanggan')}</div>`;
      return;
    }

    if (!data.found) {
      modalBody.innerHTML = `
        <div class="text-center p-3">
          <i class="bi bi-person-exclamation text-warning display-4 d-block mb-2"></i>
          <h6 class="fw-bold text-white mb-2">Pelanggan Belum Terdaftar di Billing</h6>
          <p class="text-muted small">${escapeHtml(data.message)}</p>
          <div class="bg-dark p-3 rounded text-start mt-3 small">
            <div><strong>Username RADIUS:</strong> <code>${escapeHtml(username)}</code></div>
            <div><strong>Status Koneksi:</strong> <span class="badge bs">Online</span></div>
            ${data.activeSession ? `
              <div><strong>IP Address:</strong> <code>${escapeHtml(data.activeSession.framedipaddress || '-')}</code></div>
              <div><strong>MAC Address:</strong> <code>${escapeHtml(data.activeSession.callingstationid || '-')}</code></div>
              <div><strong>NAS Router:</strong> <code>${escapeHtml(data.activeSession.nasipaddress || '-')}</code></div>
            ` : ''}
          </div>
        </div>`;

      modalFooter.innerHTML = `
        <button class="btn btn-g btn-sm" onclick="closeModal('customerDetailModal')">Tutup</button>
        <a href="/admin/customers/new?username=${encodeURIComponent(username)}" class="btn btn-p btn-sm"><i class="bi bi-person-plus-fill"></i> Tambah Pelanggan Baru</a>`;
      return;
    }

    const c = data.customer;
    const s = data.activeSession;
    const statusBadge = c.status === 'active' 
      ? '<span class="badge bs">Aktif</span>' 
      : '<span class="badge bd">Isolir/Suspended</span>';

    const unpaidBadge = c.unpaid_count > 0 
      ? `<span class="badge bd">Ada ${c.unpaid_count} Tagihan Belum Lunas (Rp ${Number(c.total_unpaid_amount).toLocaleString('id-ID')})</span>` 
      : `<span class="badge bs"><i class="bi bi-check-circle-fill me-1"></i> Tidak Ada Tunggakan</span>`;

    const cleanPhone = String(c.phone || '').replace(/[^0-9]/g, '');
    const waUrl = cleanPhone ? `https://wa.me/${cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone}` : '#';

    modalBody.innerHTML = `
      <div class="customer-profile-card">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid var(--border,#334155); padding-bottom:12px; margin-bottom:14px;">
          <div>
            <h5 style="margin:0; font-weight:800; color:#f8fafc;">${escapeHtml(c.name)}</h5>
            <small class="text-muted">ID Pelanggan: #${c.id} • ${escapeHtml(c.connection_type)}</small>
          </div>
          <div>${statusBadge}</div>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <div style="background:var(--bg3,#0f172a); padding:10px 12px; border-radius:8px;">
              <small style="color:#94a3b8; font-size:11px; font-weight:700; text-transform:uppercase;">Paket Langganan</small>
              <div style="font-weight:700; color:#38bdf8; font-size:14px;">${escapeHtml(c.package_name)}</div>
              <small class="text-muted">Rp ${Number(c.package_price).toLocaleString('id-ID')} / bulan</small>
            </div>
          </div>

          <div class="col-md-6">
            <div style="background:var(--bg3,#0f172a); padding:10px 12px; border-radius:8px;">
              <small style="color:#94a3b8; font-size:11px; font-weight:700; text-transform:uppercase;">Status Tagihan</small>
              <div>${unpaidBadge}</div>
              <small class="text-muted">Jatuh Tempo: Tgl ${c.isolate_day} tiap bulan</small>
            </div>
          </div>

          <div class="col-12">
            <div style="background:var(--bg3,#0f172a); padding:12px; border-radius:8px;">
              <div class="row g-2 small">
                <div class="col-sm-6"><strong><i class="bi bi-telephone me-1"></i> Telepon / WA:</strong> ${escapeHtml(c.phone)}</div>
                <div class="col-sm-6"><strong><i class="bi bi-geo-alt me-1"></i> Alamat:</strong> ${escapeHtml(c.address)}</div>
                <div class="col-sm-6"><strong><i class="bi bi-person-badge me-1"></i> Username PPPoE/Hotspot:</strong> <code>${escapeHtml(c.pppoe_username !== '-' ? c.pppoe_username : c.hotspot_username)}</code></div>
                <div class="col-sm-6"><strong><i class="bi bi-calendar-check me-1"></i> Tanggal Pasang:</strong> ${escapeHtml(c.install_date)}</div>
              </div>
            </div>
          </div>

          ${s ? `
            <div class="col-12">
              <div style="background:rgba(16,185,129,0.06); border:1px solid rgba(16,185,129,0.25); padding:12px; border-radius:8px;">
                <div style="font-size:12px; font-weight:800; color:#10b981; margin-bottom:6px;"><i class="bi bi-broadcast me-1"></i> SESI ONLINE REAL-TIME</div>
                <div class="row g-2 small">
                  <div class="col-sm-6"><strong>IP Address:</strong> <code>${escapeHtml(s.framedipaddress || '-')}</code></div>
                  <div class="col-sm-6"><strong>MAC Address:</strong> <code>${escapeHtml(s.callingstationid || '-')}</code></div>
                  <div class="col-sm-6"><strong>NAS Router IP:</strong> <code>${escapeHtml(s.nasipaddress || '-')}</code></div>
                  <div class="col-sm-6"><strong>Upload / Download:</strong> 
                    <span style="color:#34d399;"><i class="bi bi-arrow-up"></i> ${(s.acctinputoctets / 1048576).toFixed(2)} MB</span> / 
                    <span style="color:#60a5fa;"><i class="bi bi-arrow-down"></i> ${(s.acctoutputoctets / 1048576).toFixed(2)} MB</span>
                  </div>
                </div>
              </div>
            </div>
          ` : ''}
        </div>
      </div>`;

    modalFooter.innerHTML = `
      <button class="btn btn-g btn-sm" onclick="closeModal('customerDetailModal')">Tutup</button>
      <div style="display:flex; gap:6px;">
        ${cleanPhone ? `<a href="${waUrl}" target="_blank" class="btn btn-s btn-sm"><i class="bi bi-whatsapp"></i> Chat WhatsApp</a>` : ''}
        <a href="/admin/customers?search=${encodeURIComponent(c.name)}" class="btn btn-p btn-sm"><i class="bi bi-person-bounding-box"></i> Lihat Detail Pelanggan</a>
      </div>`;

  } catch (err) {
    console.error('Failed to load customer detail:', err);
    modalBody.innerHTML = `<div class="alert alert-danger">Gagal menghubungi server untuk detail pelanggan.</div>`;
  }
}

let serverLiveRxBps = 0;
let serverLiveTxBps = 0;

async function fetchLiveSessions() {
  try {
    const res = await fetch('/admin/radius/api/sessions');
    const data = await res.json();
    if (!data.success) return;

    activeSessionsData = data.sessions || [];
    serverLiveRxBps = Number(data.totalLiveRxBps || 0);
    serverLiveTxBps = Number(data.totalLiveTxBps || 0);

    renderUI();
  } catch (err) {
    console.error('Failed to fetch live sessions:', err);
  }
}

function renderUI() {
  // 1. Calculate Global Volume Totals & Set Live Speed from Server
  let totalRxBytes = 0;
  let totalTxBytes = 0;

  activeSessionsData.forEach(s => {
    totalRxBytes += Number(s.acctoutputoctets || 0);
    totalTxBytes += Number(s.acctinputoctets || 0);
  });

  // Top Card Live Bandwidth Speed & Totals
  document.getElementById('liveRxSpeed').innerText = formatSpeed(serverLiveRxBps);
  document.getElementById('liveTxSpeed').innerText = formatSpeed(serverLiveTxBps);
  document.getElementById('liveRxTotal').innerText = 'Total: ' + formatBytes(totalRxBytes);
  document.getElementById('liveTxTotal').innerText = 'Total: ' + formatBytes(totalTxBytes);

  // 2. Session Count & Table Body
  document.getElementById('sessionCount').innerText = activeSessionsData.length;
  const tbody = document.getElementById('sessionTableBody');

  if (activeSessionsData.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="7" class="text-center text-muted" style="padding: 24px;">
          <i class="bi bi-wifi-off fs-3 d-block mb-2"></i>
          Belum ada sesi pelanggan PPPoE / Hotspot yang terhubung via RADIUS saat ini.
        </td>
      </tr>`;
    return;
  }

  tbody.innerHTML = activeSessionsData.map(s => {
    const safeUsername = escapeHtml(s.username);
    const safeIp = escapeHtml(s.framedipaddress || '-');
    const safeMac = escapeHtml(s.callingstationid || '-');
    const safeNasIp = escapeHtml(s.nasipaddress || '-');
    const upMb = (Number(s.acctinputoctets || 0) / 1048576).toFixed(2);
    const downMb = (Number(s.acctoutputoctets || 0) / 1048576).toFixed(2);
    const startTime = new Date(s.acctstarttime).toLocaleString('id-ID');

    const rxSpeedStr = formatSpeed(s.rxBps || 0);
    const txSpeedStr = formatSpeed(s.txBps || 0);

    return `
      <tr>
        <td>
          <a href="javascript:void(0)" onclick="showCustomerDetail('${safeUsername}')" class="user-detail-link" title="Klik untuk lihat detail pelanggan">
            <i class="bi bi-person-badge text-info me-1"></i><strong>${safeUsername}</strong>
          </a>
          <span class="badge bs" style="margin-left: 4px;">Online</span>
        </td>
        <td><code>${safeIp}</code></td>
        <td><small class="text-muted">${safeMac}</small></td>
        <td><code>${safeNasIp}</code></td>
        <td><small>${startTime}</small></td>
        <td>
          <div style="font-weight: 700;">
            <span style="color: #34d399;" title="Upload Real-time Speed & Volume">
              <i class="bi bi-arrow-up"></i> ${txSpeedStr} <small class="text-muted">(${upMb} MB)</small>
            </span>
            <span class="text-muted mx-1">/</span>
            <span style="color: #60a5fa;" title="Download Real-time Speed & Volume">
              <i class="bi bi-arrow-down"></i> ${rxSpeedStr} <small class="text-muted">(${downMb} MB)</small>
            </span>
          </div>
        </td>
        <td style="text-align: right;">
          <form action="/admin/radius/sessions/${encodeURIComponent(s.username)}/disconnect" method="POST" style="display: inline-block;" onsubmit="return confirm('Disconnect/Kick user ${s.username}?')">
            <button type="submit" class="btn btn-d btn-sm"><i class="bi bi-power"></i> Kick (CoA)</button>
          </form>
        </td>
      </tr>`;
  }).join('');
}

// Auto-Polling Interval ke Backend RADIUS API setiap 3 Detik
setInterval(fetchLiveSessions, 3000);
fetchLiveSessions();
</script>
</body>
</html>
