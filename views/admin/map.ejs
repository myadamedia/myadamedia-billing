  window.handleNodeTypeChange = function(mode) {
    if (mode === 'add') {
      const typeSelect = document.getElementById('new_node_type');
      const capInput = document.getElementById('new_port_capacity');
      if (typeSelect && capInput) {
        if (typeSelect.value === 'ODC' && (capInput.value === '16' || !capInput.value)) capInput.value = 48;
        if (typeSelect.value === 'ODP' && capInput.value === '48') capInput.value = 16;
      }
    } else if (mode === 'edit') {
      const typeSelect = document.getElementById('e_odp_type');
      const capInput = document.getElementById('e_odp_port_capacity');
      if (typeSelect && capInput) {
        if (typeSelect.value === 'ODC' && (capInput.value === '16' || !capInput.value)) capInput.value = 48;
        if (typeSelect.value === 'ODP' && capInput.value === '48') capInput.value = 16;
      }
    }
  };

  function editOdp(odp) {
    document.getElementById('editOdpForm').action = '/admin/odps/' + odp.id + '/update';
    if (document.getElementById('e_odp_type')) {
      document.getElementById('e_odp_type').value = odp.type || 'ODP';
    }
    document.getElementById('e_odp_name').value = odp.name;
    document.getElementById('e_odp_olt_id').value = odp.olt_id || '';
    document.getElementById('e_odp_pon_port').value = odp.pon_port || '';
    document.getElementById('e_odp_port_capacity').value = odp.port_capacity || (odp.type === 'ODC' ? 48 : 16);
    
    const parentSelect = document.getElementById('e_odp_parent_id');
    parentSelect.value = odp.parent_odp_id || '';
    Array.from(parentSelect.options).forEach(opt => {
      if (opt.value === String(odp.id)) {
        opt.disabled = true;
        opt.style.display = 'none';
      } else {
        opt.disabled = false;
        opt.style.display = '';
      }
    });

    document.getElementById('e_odp_lat').value = odp.lat;
    document.getElementById('e_odp_lng').value = odp.lng;
    document.getElementById('e_odp_description').value = odp.description;
    openModal('editOdpModal');
    initEditPickerMap(odp.lat, odp.lng);
  }

  function editOdpById(id) {
    const n = Number(id);
    if (!Number.isFinite(n) || !odps || !Array.isArray(odps)) return;
    const found = odps.find(o => Number(o.id) === n);
    if (!found) return;
    editOdp(found);
