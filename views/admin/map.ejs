<script id="settings-data" type="application/json"><%- JSON.stringify(settings) %></script>
<script id="customers-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="odps-data" type="application/json"><%- JSON.stringify(odps).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script>
  const I18N = {
    layerOsm: "<%= t('admin.map.layers.osm', 'OpenStreetMap') %>",
    layerHybrid: "<%= t('admin.map.layers.hybrid', 'Satelit (Hybrid)') %>",
    layerDark: "<%= t('admin.map.layers.dark', 'Dark Mode (CartoDB)') %>",
    popupDescription: "<%= t('admin.map.popup.description', 'Deskripsi') %>",
    popupLocation: "<%= t('admin.map.popup.location', 'Lokasi') %>",
    popupEdit: "<%= t('common.edit', 'Edit') %>",
    popupStatus: "<%= t('admin.map.popup.status', 'Status') %>",
    popupPackage: "<%= t('admin.map.popup.package', 'Paket') %>",
    popupAddress: "<%= t('admin.map.popup.address', 'Alamat') %>",
    viewDetails: "<%= t('admin.map.popup.view_details', 'Lihat Detail') %>",
    statusActive: "<%= t('admin.map.status.active', 'Aktif') %>",
    statusSuspended: "<%= t('admin.map.status.suspended', 'Isolir') %>"
  };

  const appSettings = JSON.parse(document.getElementById('settings-data').textContent);
  const officeCoords = {
    lat: parseFloat(appSettings.office_lat) || -6.200000,
    lng: parseFloat(appSettings.office_lng) || 106.816666
  };

  // Initialize Map
  const map = L.map('map', {
    editable: true
  }).setView([officeCoords.lat, officeCoords.lng], 13);

  let currentEditingPolyline = null;
  let currentEditingCustomer = null;
  let currentEditingOdp = null;

  // Layers
  const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '© OpenStreetMap'
  });

  const googleHybrid = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
    maxZoom: 20,
    subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
    attribution: '© Google Satellite'
  });

  const darkLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    maxZoom: 19,
    subdomains: 'abcd',
    attribution: '© CARTO'
  });

  // Activate Dark Mode map by default if theme is dark
  const currentTheme = (document.documentElement.getAttribute('data-theme') || localStorage.getItem('theme') || 'dark');
  if (currentTheme === 'dark') {
    darkLayer.addTo(map);
  } else {
    googleHybrid.addTo(map);
  }

  const baseMaps = {
    [I18N.layerDark]: darkLayer,
    [I18N.layerHybrid]: googleHybrid,
    [I18N.layerOsm]: osm
  };

  L.control.layers(baseMaps).addTo(map);

  // Layer Groups for ODC, ODP, and Customers
  const odcGroup = L.layerGroup().addTo(map);
  const odpGroup = L.layerGroup().addTo(map);
  const activeCustGroup = L.layerGroup().addTo(map);
  const freeCustGroup = L.layerGroup().addTo(map);
  const suspendedCustGroup = L.layerGroup().addTo(map);
  const odpMarkerObjects = {};

  let customers = [];
  let odps = [];
  try {
    customers = JSON.parse(document.getElementById('customers-data').textContent || '[]');
    odps = JSON.parse(document.getElementById('odps-data').textContent || '[]');
  } catch (e) {
    console.error("Data mapping error:", e);
  }

  // Add ODP & ODC Markers
  const odpMarkers = {}; // Store ODP/ODC coordinates for line mapping
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      odpMarkers[odp.id] = [parseFloat(odp.lat), parseFloat(odp.lng)];
      const isOdc = odp.type === 'ODC';
      const targetLayerGroup = isOdc ? odcGroup : odpGroup;

      const iconHtml = isOdc
        ? `<div class="marker-odc-box" title="${odp.name} (ODC)"><i class="bi bi-hdd-rack-fill"></i><span class="marker-odc-tag">ODC</span></div>`
        : `<div class="marker-odp-box" title="${odp.name} (ODP)"><i class="bi bi-box-seam-fill"></i><span class="marker-odp-tag">ODP</span></div>`;

      const marker = L.marker([odp.lat, odp.lng], {
        icon: L.divIcon({
          html: iconHtml,
          className: 'custom-div-icon',
          iconSize: isOdc ? [32, 32] : [28, 28],
          iconAnchor: isOdc ? [16, 16] : [14, 14]
        })
      }).addTo(targetLayerGroup);

      odpMarkerObjects[odp.id] = marker;
      
      const nodeBadge = isOdc
        ? `<span class="badge" style="background:rgba(167, 139, 250, 0.2); color:#a78bfa; border:1px solid rgba(167, 139, 250, 0.4); font-size:10px;"><i class="bi bi-hdd-rack-fill me-1"></i>ODC Cabinet</span>`
        : `<span class="badge" style="background:rgba(245, 158, 11, 0.2); color:#f59e0b; border:1px solid rgba(245, 158, 11, 0.4); font-size:10px;"><i class="bi bi-box-seam-fill me-1"></i>ODP Box</span>`;

      marker.bindPopup(`
        <div class="popup-content">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 style="margin:0;">${odp.name}</h6>
            ${nodeBadge}
          </div>
          <div><strong>OLT:</strong> ${odp.olt_name || '-'}</div>
          <div><strong>PON Port:</strong> ${odp.pon_port || '-'}</div>
          <div><strong>Kapasitas Port:</strong> ${odp.port_capacity || (isOdc ? 48 : 16)} Port</div>
          <div><strong>${I18N.popupDescription}:</strong> ${odp.description || '-'}</div>
          <div><strong>${I18N.popupLocation}:</strong> ${odp.lat}, ${odp.lng}</div>
          <div class="popup-actions">
            <button class="btn btn-sm btn-p" onclick="startOdpCableDrawing(${odp.id}, ${odp.lat}, ${odp.lng}, ${odp.parent_odp_id || 'null'})"><i class="bi bi-pencil-fill me-1"></i>Gambar Jalur</button>
            <button class="btn btn-sm btn-g" onclick='editOdp(${JSON.stringify(odp)})'>${I18N.popupEdit}</button>
          </div>
        </div>
      `);
    }
  });

  const ponColors = [
    '#f59e0b', // Amber/Yellow
    '#10b981', // Emerald/Green
    '#3b82f6', // Blue
    '#ec4899', // Pink
    '#8b5cf6', // Violet/Purple
    '#ef4444', // Red
    '#06b6d4', // Cyan
    '#f97316', // Orange
    '#14b8a6', // Teal
    '#a855f7', // Purple
    '#6366f1', // Indigo
    '#84cc16'  // Lime
  ];
  
  // Build a distinct color mapping for each PON group (olt_id + pon_port)
  const ponColorMap = {};
  let colorIdx = 0;
  odps.forEach(odp => {
    if (odp.olt_id && odp.pon_port && odp.pon_port.trim() !== '') {
      const key = `${odp.olt_id}_${odp.pon_port.trim()}`;
      if (!ponColorMap[key]) {
        ponColorMap[key] = ponColors[colorIdx % ponColors.length];
        colorIdx++;
      }
    }
  });

  // Add Office Marker
  L.marker([officeCoords.lat, officeCoords.lng], {
    icon: L.divIcon({
      html: '<i class="bi bi-building-fill text-primary" style="font-size: 24px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));"></i>',
      className: 'custom-div-icon',
      iconSize: [24, 24],
      iconAnchor: [12, 12]
    })
  }).addTo(map).bindPopup(`
    <div class="popup-content">
      <h6>Kantor Pusat / NOC</h6>
      <div>Lokasi pusat server & distribusi fiber optik.</div>
    </div>
  `);

  // Draw lines from child ODP to parent ODP/ODC based on parent_odp_id, or connect to Office if root
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      let pathCoords;
      let lineLabel;
      const isOdc = odp.type === 'ODC';
      const nodeGroup = isOdc ? odcGroup : odpGroup;
      
      if (odp.parent_odp_id && odpMarkers[odp.parent_odp_id]) {
        const parentCoords = odpMarkers[odp.parent_odp_id];
        pathCoords = [
          [parseFloat(odp.lat), parseFloat(odp.lng)],
          parentCoords
        ];
        lineLabel = `Kabel Uplink ${odp.type || 'ODP'}: ${odp.name} ↔ ${odp.parent_name || 'Uplink'} (PON: ${odp.pon_port || '-'})`;
      } else {
        pathCoords = [
          [parseFloat(odp.lat), parseFloat(odp.lng)],
          [officeCoords.lat, officeCoords.lng]
        ];
        lineLabel = `Kabel Feeder Principal: Kantor Pusat ↔ ${odp.name} (PON: ${odp.pon_port || '-'})`;
      }
      
      // Determine line color from the ODP's PON port
      let ponColor = isOdc ? '#a78bfa' : '#94a3b8';
      if (odp.olt_id && odp.pon_port && odp.pon_port.trim() !== '') {
        const key = `${odp.olt_id}_${odp.pon_port.trim()}`;
        ponColor = ponColorMap[key] || (isOdc ? '#a78bfa' : '#94a3b8');
      }

      if (odp.cable_path) {
        try {
          const parsed = JSON.parse(odp.cable_path);
          if (Array.isArray(parsed) && parsed.length >= 2) {
            pathCoords = parsed;
          }
        } catch(e) {}
      }

      L.polyline(pathCoords, {
        color: ponColor,
        weight: isOdc ? 5 : 4,
        opacity: 0.9,
        className: 'odp-cable-line'
      }).addTo(nodeGroup).bindTooltip(lineLabel, { sticky: true });
    }
  });

  // Add Customer Markers - Ultra Modern Glassmorphic Pin
