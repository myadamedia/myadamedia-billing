      function runOpticalSimulation() {
        const dropDist = parseFloat(document.getElementById('input-drop-dist').value) || 0;
        const distDist = parseFloat(document.getElementById('input-dist-dist').value) || 0;
        const feederDist = parseFloat(document.getElementById('input-feeder-dist').value) || 0;
        const txPower = parseFloat(document.getElementById('input-tx-power').value) || 3.5;
        const odcRatio = document.getElementById('input-odc-ratio').value || '1:4';
        const odpRatio = document.getElementById('input-odp-ratio').value || '1:8';
        const attenuation = parseFloat(document.getElementById('input-attenuation').value) || 0.35;
        const connectorLoss = parseFloat(document.getElementById('input-connector').value) || 1.5;

        // Update Slider Display Badges
        document.getElementById('val-drop-dist').textContent = `${Math.round(dropDist)} meter`;
        document.getElementById('val-dist-dist').textContent = `${Math.round(distDist)} meter`;
        document.getElementById('val-feeder-dist').textContent = `${Math.round(feederDist)} meter`;
        document.getElementById('val-tx-power').textContent = `${txPower >= 0 ? '+' : ''}${txPower.toFixed(2)} dBm`;
        document.getElementById('val-attenuation').textContent = `${attenuation.toFixed(2)} dB/km`;
        document.getElementById('val-connector').textContent = `${connectorLoss.toFixed(2)} dB`;

        // Calculations
        const feederLoss = (feederDist / 1000) * attenuation;
        const distLoss = (distDist / 1000) * attenuation;
        const dropLoss = (dropDist / 1000) * attenuation;
        const totalCableDist = feederDist + distDist + dropDist;
        const totalCableLoss = feederLoss + distLoss + dropLoss;

        const odcLoss = getSplitterLossClient(odcRatio);
        const odpLoss = getSplitterLossClient(odpRatio);
        const totalSplitterLoss = odcLoss + odpLoss;

        const totalLoss = totalCableLoss + totalSplitterLoss + connectorLoss;
        const estRx = txPower - totalLoss;

        // Update Topo Chain
        document.getElementById('topo-tx-display').textContent = `${txPower >= 0 ? '+' : ''}${txPower.toFixed(2)} dBm`;
        document.getElementById('topo-feeder-loss').textContent = `-${feederLoss.toFixed(2)} dB`;
        document.getElementById('topo-odc-ratio').textContent = `${odcRatio} (${odcLoss.toFixed(1)} dB)`;
        document.getElementById('topo-dist-loss').textContent = `-${distLoss.toFixed(2)} dB`;
        document.getElementById('topo-odp-ratio').textContent = `${odpRatio} (${odpLoss.toFixed(1)} dB)`;
        document.getElementById('topo-drop-loss').textContent = `-${dropLoss.toFixed(2)} dB`;
        document.getElementById('topo-rx-display').textContent = `${estRx.toFixed(2)} dBm`;

        // Update Breakdown Card
        document.getElementById('res-breakdown-cable-dist').textContent = `${(totalCableDist / 1000).toFixed(2)} km (${Math.round(totalCableDist).toLocaleString('id-ID')} m)`;
        document.getElementById('res-breakdown-cable-loss').textContent = `${totalCableLoss.toFixed(2)} dB`;
        document.getElementById('res-breakdown-splitter-loss').textContent = `${totalSplitterLoss.toFixed(2)} dB`;
        document.getElementById('res-breakdown-conn-loss').textContent = `${connectorLoss.toFixed(2)} dB`;
        document.getElementById('res-breakdown-total-loss').textContent = `${totalLoss.toFixed(2)} dB`;
        document.getElementById('res-est-rx').textContent = `${estRx.toFixed(2)} dBm`;

        // Check Selected Customer Actual Data
        const custId = document.getElementById('calc-customer-select').value;
        const optCust = (custId && opticalData && opticalData.customers) ? opticalData.customers[custId] : null;

        let actRx = null;
        let acsSource = 'Built-in ACS';
        let acsTime = '-';

        if (optCust && optCust.acs) {
          actRx = optCust.acs.rxPower;
          acsSource = optCust.acs.acsSource || 'Dual-ACS';
          acsTime = optCust.acs.lastInform ? new Date(optCust.acs.lastInform).toLocaleTimeString('id-ID') : '-';
        }

        const resActEl = document.getElementById('res-act-rx');
        const resDeltaEl = document.getElementById('res-delta-rx');
        const resBadge = document.getElementById('res-badge-status');
        const diagBox = document.getElementById('res-diagnosis-box');
        const diagIcon = document.getElementById('res-diag-icon');
        const diagTitle = document.getElementById('res-diag-title');
        const diagDesc = document.getElementById('res-diag-desc');
        const diagRec = document.getElementById('res-diag-rec');

        document.getElementById('res-acs-source').textContent = acsSource;
        document.getElementById('res-acs-time').textContent = acsTime;

        if (actRx !== null && Number.isFinite(actRx)) {
          resActEl.textContent = `${actRx.toFixed(2)} dBm`;
          const delta = Math.abs(actRx - estRx);
          resDeltaEl.textContent = `${delta.toFixed(2)} dB`;

          // Evaluate Status
          let statusLabel = 'Optimal / Prima';
          let statusBadgeClass = 'ct-status-optimal';
          let boxBorder = 'rgba(16, 185, 129, 0.4)';
          let boxBg = 'rgba(16, 185, 129, 0.12)';
          let iconClass = 'bi-shield-check';
          let descText = 'Redaman optik sangat ideal, transmisi GPON berkinerja prima.';
          let recText = 'Rekomendasi: Koneksi optik stabil. Tidak memerlukan tindakan pemeliharaan.';

          if (actRx > -8.0) {
            statusLabel = 'Sinyal Overload';
            statusBadgeClass = 'ct-status-critical';
            boxBorder = 'rgba(236, 72, 153, 0.4)';
            boxBg = 'rgba(236, 72, 153, 0.12)';
            iconClass = 'bi-exclamation-octagon-fill';
            descText = 'Sinyal optik terlalu kuat (> -8 dBm). Berisiko merusak receiver ONT.';
            recText = 'Rekomendasi: Pasang optical attenuator atau naikkan rasio splitter ODP.';
          } else if (actRx < -29.0) {
            statusLabel = 'Kritis / Redaman Buruk';
            statusBadgeClass = 'ct-status-critical';
            boxBorder = 'rgba(239, 68, 68, 0.4)';
            boxBg = 'rgba(239, 68, 68, 0.12)';
            iconClass = 'bi-slash-circle-fill';
            descText = 'Sinyal di bawah sensitivitas minimum receiver ONT (< -29 dBm). Rawan gangguan disconnect.';
            recText = 'Rekomendasi: Periksa tekukan kabel drop (macro-bending), bersihkan konektor SC/APC, atau uji redaman dengan OPM.';
          } else if (actRx < -27.0) {
            statusLabel = 'Peringatan / Sinyal Rendah';
            statusBadgeClass = 'ct-status-warning';
            boxBorder = 'rgba(249, 115, 22, 0.4)';
            boxBg = 'rgba(249, 115, 22, 0.12)';
            iconClass = 'bi-exclamation-triangle-fill';
            descText = 'Sinyal mendekati ambang batas putus (-27 s/d -28.9 dBm).';
            recText = 'Rekomendasi: Inspeksi jalur kabel dan pastikan adapter ODP tertancap rapat.';
          } else if (actRx < -23.0) {
            statusLabel = 'Standar / Wajar';
            statusBadgeClass = 'ct-status-normal';
            boxBorder = 'rgba(245, 158, 11, 0.4)';
            boxBg = 'rgba(245, 158, 11, 0.12)';
            iconClass = 'bi-info-circle-fill';
            descText = 'Kualitas sinyal dalam batas operasional wajar FTTH GPON.';
            recText = 'Rekomendasi: Link aman dan dapat diandalkan.';
          }

          if (delta > 4.5) {
            descText += ` Perhatian: Deviasi tinggi (${delta.toFixed(2)} dB di bawah estimasi). Kemungkinan besar terdapat lekukan tajam kabel atau sambungan fusion kotor.`;
          }

          resBadge.textContent = statusLabel;
          resBadge.className = `badge ${statusBadgeClass}`;
          diagBox.style.borderColor = boxBorder;
          diagBox.style.background = boxBg;
          diagIcon.className = `bi ${iconClass}`;
          diagTitle.textContent = statusLabel;
          diagDesc.textContent = descText;
          diagRec.innerHTML = `<i class="bi bi-tools me-1"></i> ${recText}`;
        } else {
          resActEl.textContent = 'Belum Ada';
          resDeltaEl.textContent = '-';
          resBadge.textContent = 'Estimasi Teoretis Saja';
          resBadge.className = 'badge ct-status-unknown';
          diagBox.style.borderColor = 'rgba(56, 189, 248, 0.3)';
          diagBox.style.background = 'rgba(56, 189, 248, 0.08)';
          diagIcon.className = 'bi bi-info-circle';
          diagTitle.textContent = 'Simulasi Desain Link Budget';
          diagDesc.textContent = `Berdasarkan parameter topologi kabel, estimasi daya terima pada ONT adalah ${estRx.toFixed(2)} dBm.`;
          diagRec.innerHTML = '<i class="bi bi-broadcast me-1"></i> Hubungkan ONT ke Dual-ACS untuk mendapatkan verifikasi redaman aktual secara real-time.';
        }
      }

      function resetOpticalSimulation() {
        document.getElementById('input-drop-dist').value = 150;
        document.getElementById('input-dist-dist').value = 500;
        document.getElementById('input-feeder-dist').value = 1000;
        document.getElementById('input-tx-power').value = 3.5;
        document.getElementById('input-odc-ratio').value = '1:4';
        document.getElementById('input-odp-ratio').value = '1:8';
        document.getElementById('input-attenuation').value = 0.35;
        document.getElementById('input-connector').value = 1.5;
        runOpticalSimulation();
      }

      async function refreshOpticalLive() {
        try {
          const res = await fetch('/admin/api/optical-budget/live');
          const json = await res.json();
          if (json.ok && json.data) {
            opticalData = json.data;
            runOpticalSimulation();
            if (isOpticalModeActive) {
              toggleOpticalMode();
            }
          }
        } catch (err) {
          console.error("Gagal refresh live optical data:", err);
        }
      }

      // ═════════════════════════════════════════════════════════════════════════
      // MASS OUTAGE & FIBER CUT AUTO-DETECTION ENGINE
      // ═════════════════════════════════════════════════════════════════════════
      let fiberCutIncidents = [];
      let fiberCutLayerGroup = L.layerGroup();
      let currentIncident = null;
      let isFiberCutLayerVisible = true;

      // Pastikan layer ditambahkan ke peta setelah map terinisialisasi
      if (typeof map !== 'undefined' && map) {
        fiberCutLayerGroup.addTo(map);
      } else {
        setTimeout(() => {
          if (typeof map !== 'undefined' && map) fiberCutLayerGroup.addTo(map);
        }, 500);
      }

      function toggleFiberCutLayer() {
        const chk = document.getElementById('toggle-fiber-cut');
        isFiberCutLayerVisible = chk ? chk.checked : true;
        if (typeof map === 'undefined' || !map) return;
        if (isFiberCutLayerVisible) {
          if (!map.hasLayer(fiberCutLayerGroup)) map.addLayer(fiberCutLayerGroup);
        } else {
          if (map.hasLayer(fiberCutLayerGroup)) map.removeLayer(fiberCutLayerGroup);
        }
      }

      async function pollFiberCutDetection() {
        try {
          const res = await fetch('/admin/api/fiber-cuts/detect');
          const data = await res.json();
          if (data && data.ok) {
            renderFiberCutData(data);
          }
        } catch (err) {
          console.error('[FiberCutDetection] Gagal fetch data deteksi:', err);
        }
      }

      function renderFiberCutData(result) {
        fiberCutIncidents = result.incidents || [];
        fiberCutLayerGroup.clearLayers();

        const badgeCount = document.getElementById('fiberCutBadgeCount');
        const banner = document.getElementById('massOutageBanner');

        if (badgeCount) {
          if (fiberCutIncidents.length > 0) {
            badgeCount.textContent = fiberCutIncidents.length;
            badgeCount.style.display = 'inline-block';
          } else {
            badgeCount.style.display = 'none';
          }
        }

        if (fiberCutIncidents.length > 0) {
          currentIncident = fiberCutIncidents[0]; // Set incident paling kritis
          if (banner) {
            banner.classList.add('show');
            const mobTitle = document.getElementById('mobTitle');
            const mobBadge = document.getElementById('mobBadge');
            const mobDesc = document.getElementById('mobDesc');

            if (mobTitle) mobTitle.textContent = currentIncident.title;
            if (mobBadge) mobBadge.textContent = currentIncident.severity || 'CRITICAL';
            if (mobDesc) {
              const segText = currentIncident.level || 'Jalur Distribusi';
              const offCount = currentIncident.offlineCount || 0;
              const offRatio = currentIncident.offlineRatio || currentIncident.offlineChildOdpRatio || 0;
              mobDesc.textContent = `${segText}: ${offCount} Pelanggan Terputus (${offRatio}% padam). Segera periksa jalur ${currentIncident.parentNodeName} ↔ ${currentIncident.targetNodeName}.`;
            }
          }
        } else {
          currentIncident = null;
          if (banner) banner.classList.remove('show');
        }

        // Gambar visualisasi polyline & marker berdenyut untuk setiap insiden
        fiberCutIncidents.forEach((inc) => {
          if (Array.isArray(inc.cableCoords) && inc.cableCoords.length >= 2) {
            const cutLine = L.polyline(inc.cableCoords, {
              color: '#ef4444',
              weight: 8,
              opacity: 0.95,
              className: 'cable-fiber-cut',
              lineCap: 'round',
              lineJoin: 'round'
            });

            cutLine.bindTooltip(`
              <div style="font-family:sans-serif; padding:4px 6px;">
                <div style="font-weight:900; color:#ef4444; font-size:12px; display:flex; align-items:center; gap:5px;">
                  <i class="bi bi-exclamation-octagon-fill"></i> INDIKASI PUTUS KABEL (${inc.severity})
                </div>
                <div style="font-size:11.5px; color:#f8fafc; font-weight:700; margin-top:2px;">
                  ${inc.title}
                </div>
                <div style="font-size:11px; color:#cbd5e1; margin-top:3px;">
                  • Jalur: <b>${inc.parentNodeName} ↔ ${inc.targetNodeName}</b><br>
                  • Pelanggan Padam: <b style="color:#f87171;">${inc.offlineCount} / ${inc.totalCustomers} (${inc.offlineRatio || inc.offlineChildOdpRatio}%)</b><br>
                  • Klik untuk membuka rincian & buat tiket
                </div>
              </div>
            `, { sticky: true, className: 'custom-cable-tooltip' });

            cutLine.on('click', () => {
              openMassOutageModal(inc.incidentId);
            });

            fiberCutLayerGroup.addLayer(cutLine);
          }

          // Cincin denyut pada titik target
          if (inc.centroid) {
            const pulseIcon = L.divIcon({
              className: 'custom-div-icon',
              html: `<div class="marker-cut-pulse" style="width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:12px;"><i class="bi bi-x-octagon-fill"></i></div>`,
              iconSize: [26, 26],
              iconAnchor: [13, 13]
            });
            const pulseMarker = L.marker(inc.centroid, { icon: pulseIcon });
            pulseMarker.on('click', () => {
              openMassOutageModal(inc.incidentId);
            });
            fiberCutLayerGroup.addLayer(pulseMarker);
          }
        });

        if (typeof map !== 'undefined' && map && !isFiberCutLayerVisible && map.hasLayer(fiberCutLayerGroup)) {
          map.removeLayer(fiberCutLayerGroup);
        }
      }

      function focusCurrentIncident() {
        if (!currentIncident) return;
        focusIncidentCable(currentIncident.incidentId);
      }

      function focusIncidentCable(incidentId) {
        const inc = fiberCutIncidents.find(i => i.incidentId === incidentId);
        if (!inc || typeof map === 'undefined' || !map) return;

        if (Array.isArray(inc.cableCoords) && inc.cableCoords.length >= 2) {
          const bounds = L.latLngBounds(inc.cableCoords);
          map.fitBounds(bounds, { padding: [80, 80], maxZoom: 18, animate: true, duration: 1.2 });
        } else if (inc.centroid) {
          map.flyTo(inc.centroid, 17, { duration: 1.2 });
        }
      }

      function openCurrentIncidentModal() {
        if (!currentIncident) return;
        openMassOutageModal(currentIncident.incidentId);
      }

      function openMassOutageModal(incidentId) {
        const inc = fiberCutIncidents.find(i => i.incidentId === incidentId);
        if (!inc) return;
        currentIncident = inc;

        document.getElementById('mom-title').textContent = inc.title;
        document.getElementById('mom-subtitle').textContent = `Insiden ID: ${inc.incidentId} • Terdeteksi: ${new Date(inc.detectedAt).toLocaleTimeString('id-ID')}`;
        document.getElementById('mom-severity-badge').textContent = inc.severity;
        document.getElementById('mom-level').textContent = inc.level;
        document.getElementById('mom-target').textContent = `${inc.targetNodeName} (${inc.targetNodeType})`;
        document.getElementById('mom-olt-pon').textContent = `${inc.oltName} (Port: ${inc.ponPort})`;
        document.getElementById('mom-impact').textContent = `${inc.offlineCount} / ${inc.totalCustomers} (${inc.offlineRatio || inc.offlineChildOdpRatio}%)`;

        const instEl = document.getElementById('mom-instruction');
        if (instEl) {
          instEl.innerHTML = `Segera telusuri jalur fisik antara <b>${inc.parentNodeName}</b> dan <b>${inc.targetNodeName}</b>. Siapkan fusion splicer dan lakukan pengukuran OTDR dari titik ${inc.parentNodeName} untuk mengetahui lokasi putus core secara presisi.`;
        }

        const tbody = document.getElementById('mom-cust-table-body');
        const countSpan = document.getElementById('mom-cust-count');
        if (tbody) {
          tbody.innerHTML = '';
          const custs = inc.affectedCustomers || [];
          if (countSpan) countSpan.textContent = custs.length;

          if (custs.length === 0) {
            tbody.innerHTML = `<tr><td colspan="3" style="text-align:center; padding:12px; color:#94a3b8;">Tidak ada pelanggan langsung terdaftar di ODP ini.</td></tr>`;
          } else {
            custs.forEach((c, idx) => {
              const tr = document.createElement('tr');
              tr.style.borderBottom = '1px solid rgba(148, 163, 184, 0.1)';
              tr.innerHTML = `
                <td style="padding: 6px 8px; color:#94a3b8;">${idx + 1}</td>
                <td style="padding: 6px 8px; font-weight:700; color:#f8fafc;">${c.name}</td>
                <td style="padding: 6px 8px;"><span class="badge bg-danger" style="font-size:10px;">${c.reason || 'Offline'}</span></td>
              `;
              tbody.appendChild(tr);
            });
          }
        }

        openModal('massOutageModal');
      }

      async function createCurrentIncidentTicket() {
        if (!currentIncident) return;
        await triggerAutoTicket(currentIncident.incidentId);
      }

      async function triggerAutoTicket(incidentId) {
        try {
          const res = await fetch('/admin/api/fiber-cuts/create-ticket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ incidentId })
          });
          const json = await res.json();
          if (json.ok && json.result) {
            alert(json.result.message || 'Tiket berhasil dibuat!');
            if (json.result.ticketId) {
              window.open(`/admin/tickets/${json.result.ticketId}`, '_blank');
            }
          } else {
            alert('Gagal membuat tiket: ' + (json.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Error memproses tiket: ' + err.message);
        }
      }

      async function broadcastCurrentIncidentWa() {
        if (!currentIncident) return;
        await triggerBroadcastWa(currentIncident.incidentId);
      }

      async function triggerBroadcastWa(incidentId) {
        if (!confirm('Apakah Anda yakin ingin menyiarkan peringatan darurat Fiber Cut ini ke WhatsApp Admin dan Teknisi?')) {
          return;
        }
        try {
          const res = await fetch('/admin/api/fiber-cuts/notify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ incidentId })
          });
          const json = await res.json();
          if (json.ok) {
            alert(json.message || 'Notifikasi darurat berhasil dikirim!');
          } else {
            alert('Gagal mengirim WhatsApp: ' + (json.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Error kirim broadcast: ' + err.message);
        }
      }

      // Mulai polling deteksi otomatis
      document.addEventListener('DOMContentLoaded', () => {
        pollFiberCutDetection();
        setInterval(pollFiberCutDetection, 30000); // Polling tiap 30 detik
      });
    </script>
</body>

</html>