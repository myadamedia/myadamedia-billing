  window.toggleLayers = function() {
    const showOdc = document.getElementById('toggle-odc') ? document.getElementById('toggle-odc').checked : true;
    const showOdp = document.getElementById('toggle-odp') ? document.getElementById('toggle-odp').checked : true;
    const showActive = document.getElementById('toggle-active') ? document.getElementById('toggle-active').checked : true;
    const showFree = document.getElementById('toggle-free') ? document.getElementById('toggle-free').checked : true;
    const showSuspended = document.getElementById('toggle-suspended') ? document.getElementById('toggle-suspended').checked : true;

    if (showOdc) {
      if (!map.hasLayer(odcGroup)) map.addLayer(odcGroup);
      localStorage.setItem('map_show_odc', 'true');
    } else {
      if (map.hasLayer(odcGroup)) map.removeLayer(odcGroup);
      localStorage.setItem('map_show_odc', 'false');
    }

    if (showOdp) {
      if (!map.hasLayer(odpGroup)) map.addLayer(odpGroup);
      localStorage.setItem('map_show_odp', 'true');
    } else {
      if (map.hasLayer(odpGroup)) map.removeLayer(odpGroup);
      localStorage.setItem('map_show_odp', 'false');
    }

    if (showActive) {
      if (!map.hasLayer(activeCustGroup)) map.addLayer(activeCustGroup);
      localStorage.setItem('map_show_active', 'true');
    } else {
      if (map.hasLayer(activeCustGroup)) map.removeLayer(activeCustGroup);
