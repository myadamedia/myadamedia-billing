<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.finance_report', 'Laporan Keuangan') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'reports', company }) %>
<%
const mnsNames = (lang === 'en')
  ? ['January','February','March','April','May','June','July','August','September','October','November','December']
  : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
%>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-bar-chart-line"></i> <%= t('admin.nav.finance_report', 'Laporan Keuangan') %></div>
    <div class="tb-right" style="display:flex;gap:8px;align-items:center">
      <select class="fs" id="monthSelect" style="width:120px" onchange="window.location='/admin/reports?year='+document.getElementById('yearSelect').value+'&month='+this.value">
        <option value="all" <%= !filterMonth?'selected':'' %>>Semua Bulan</option>
        <% mnsNames.forEach((mName, idx) => { %>
        <option value="<%= idx + 1 %>" <%= filterMonth == (idx + 1)?'selected':'' %>><%= mName %></option>
        <% }) %>
      </select>
      <select class="fs" id="yearSelect" style="width:90px" onchange="window.location='/admin/reports?year='+this.value+'&month='+document.getElementById('monthSelect').value">
        <% for(let y=new Date().getFullYear(); y>=2023; y--){ %>
        <option value="<%= y %>" <%= filterYear==y?'selected':'' %>><%= y %></option>
        <% } %>
      </select>
      <a href="/admin/reports/export-csv?year=<%= filterYear %>&month=<%= filterMonth || 'all' %>" class="btn btn-g btn-sm" title="Export Excel (CSV)"><i class="bi bi-file-earmark-excel" style="color:#10b981"></i> Excel</a>
      <a href="/admin/reports/print?year=<%= filterYear %>&month=<%= filterMonth || 'all' %>" target="_blank" class="btn btn-g btn-sm" title="Print PDF"><i class="bi bi-printer" style="color:#3b82f6"></i> Print</a>
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <!-- HERO BANNER -->
    <div class="card mb-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); border: 1px solid rgba(99,102,241,0.5); border-radius: 20px; padding: 24px; position: relative; overflow: hidden; margin-bottom: 24px; box-shadow: 0 12px 36px rgba(79,70,229,0.25);">
      <div style="position: absolute; right: -20px; bottom: -25px; font-size: 160px; color: rgba(255,255,255,0.08); pointer-events: none;">
        <i class="bi bi-graph-up-arrow"></i>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; position: relative; z-index: 1;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.35); color: #ffffff; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px;">
            <i class="bi bi-bar-chart-line-fill"></i> REKAPITULASI LAPORAN KEUANGAN
          </div>
          <h2 style="font-size: 24px; font-weight: 800; color: #ffffff; margin: 0 0 6px 0; letter-spacing: -0.5px;">
            Laporan Pendapatan, Arus Kas & Laba Rugi
          </h2>
          <p style="font-size: 13px; color: rgba(255,255,255,0.92); margin: 0; max-width: 650px; line-height: 1.5; font-weight: 500;">
            Pantau ringkasan omzet bulanan/tahunan, metode pembayaran (Tunai, QRIS, Transfer, Kolektor), serta ekspor laporan neraca ke Excel & PDF.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/admin/reports/export-csv?year=<%= filterYear %>&month=<%= filterMonth || 'all' %>" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #ffffff; color: #4f46e5; border: none; box-shadow: 0 6px 20px rgba(0,0,0,0.15);">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel
          </a>
          <a href="/admin/reports/print?year=<%= filterYear %>&month=<%= filterMonth || 'all' %>" target="_blank" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #10b981; color: #ffffff; border: none; box-shadow: 0 6px 20px rgba(16,185,129,0.4);">
            <i class="bi bi-printer-fill me-1"></i> Cetak PDF
          </a>
        </div>
      </div>
    </div>

    <!-- Big Stats -->
    <div class="stat-grid" style="grid-template-columns:repeat(4,1fr)">
      <div class="sc s"><i class="bi bi-cash-stack sc-icon"></i>
        <div class="sc-label">
          <% if (filterMonth) { %>
            <%= t('admin.reports.total_revenue_month', 'Total Pendapatan') %> <%= mnsNames[filterMonth - 1] %> <%= filterYear %>
          <% } else { %>
            <%= t('admin.reports.total_revenue_year', 'Total Pendapatan') %> <%= filterYear %>
          <% } %>
        </div>
        <div class="sc-val money-value" style="font-size:20px">Rp <%= totalRevenue.toLocaleString('id-ID') %></div>
      </div>
      <div class="sc p"><i class="bi bi-receipt sc-icon"></i>
        <div class="sc-label"><%= t('admin.reports.this_month', 'Bulan Ini') %></div>
        <div class="sc-val money-value" style="font-size:20px">Rp <%= thisMonth.toLocaleString('id-ID') %></div>
      </div>
      <div class="sc d"><i class="bi bi-hourglass sc-icon"></i>
        <div class="sc-label">
          <%= t('admin.reports.pending_receivable', 'Piutang Belum Bayar') %>
          <% if (filterMonth) { %>
            <%= mnsNames[filterMonth - 1] %> <%= filterYear %>
          <% } else { %>
            <%= filterYear %>
          <% } %>
        </div>
        <div class="sc-val money-value" style="font-size:20px">Rp <%= pendingAmount.toLocaleString('id-ID') %></div>
      </div>
      <div class="sc w"><i class="bi bi-people sc-icon"></i>
        <div class="sc-label"><%= t('admin.reports.active_customers_total', 'Total Pelanggan Aktif') %></div>
        <div class="sc-val"><%= activeCustomers %></div>
      </div>
    </div>

    <div class="stat-grid" style="grid-template-columns:repeat(3,1fr);margin-top:14px">
      <div class="sc p"><i class="bi bi-cash-stack sc-icon"></i>
        <div class="sc-label">
          Total Pemasukan (Kas Masuk)
          <% if (filterMonth) { %>
            <%= mnsNames[filterMonth - 1] %> <%= filterYear %>
          <% } else { %>
            <%= filterYear %>
          <% } %>
        </div>
        <div class="sc-val money-value" style="font-size:20px">Rp <%= (cashInSelected || 0).toLocaleString('id-ID') %></div>
        <div class="sc-sub" style="font-size:11px">
          <% if (filterMonth) { %>
            Tahun ini: <span class="money-value">Rp <%= (cashInYear || 0).toLocaleString('id-ID') %></span>
          <% } else { %>
            Bulan ini: <span class="money-value">Rp <%= (cashInThisMonth || 0).toLocaleString('id-ID') %></span>
          <% } %>
          <br><span style="color:var(--muted)">(Tagihan + Agent + Lainnya)</span>
        </div>
      </div>
      <div class="sc d"><i class="bi bi-wallet2 sc-icon"></i>
        <div class="sc-label">
          Total Pengeluaran (Kas Keluar)
          <% if (filterMonth) { %>
            <%= mnsNames[filterMonth - 1] %> <%= filterYear %>
          <% } else { %>
            <%= filterYear %>
          <% } %>
        </div>
        <div class="sc-val money-value" style="font-size:20px">-Rp <%= (expensesSelected || 0).toLocaleString('id-ID') %></div>
        <div class="sc-sub">
          <% if (filterMonth) { %>
            Tahun ini: <span class="money-value">Rp <%= (expensesYear || 0).toLocaleString('id-ID') %></span>
          <% } else { %>
            Bulan ini: <span class="money-value">Rp <%= (expensesMonth || 0).toLocaleString('id-ID') %></span>
          <% } %>
        </div>
      </div>
      <div class="sc s" style="background:rgba(16,185,129,0.15);border-color:rgba(16,185,129,0.3)"><i class="bi bi-piggy-bank-fill sc-icon" style="color:#10b981"></i>
        <div class="sc-label" style="color:#10b981">
          Laba Bersih (Net Profit)
          <% if (filterMonth) { %>
            <%= mnsNames[filterMonth - 1] %> <%= filterYear %>
          <% } else { %>
            <%= filterYear %>
          <% } %>
        </div>
        <div class="sc-val money-value" style="font-size:24px;color:#10b981">Rp <%= (netProfitSelected || 0).toLocaleString('id-ID') %></div>
        <div class="sc-sub" style="color:#10b981">
          <% if (filterMonth) { %>
            Tahun ini: <span class="money-value">Rp <%= (netProfitYear || 0).toLocaleString('id-ID') %></span>
          <% } else { %>
            Bulan ini: <span class="money-value">Rp <%= (netProfitMonth || 0).toLocaleString('id-ID') %></span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Chart & Monthly Table -->
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:18px">

      <!-- Bar Chart -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-bar-chart"></i> <%= t('admin.reports.monthly_revenue', 'Pendapatan Bulanan') %> <%= filterYear %></h6></div>
        <div class="card-bd">
          <canvas id="revenueChart" height="220"></canvas>
        </div>
      </div>

      <!-- Top Unpaid & Expenses Breakdown -->
      <div style="display:flex;flex-direction:column;gap:18px">
        <div class="card" style="flex:1">
          <div class="card-hd">
            <h6>
              <i class="bi bi-exclamation-triangle"></i> 
              <%= t('admin.reports.top_unpaid', 'Piutang Tertinggi') %>
              <% if (filterMonth) { %>
                - <%= mnsNames[filterMonth - 1] %> <%= filterYear %>
              <% } %>
            </h6>
          </div>
          <div class="card-bd" style="padding:0">
            <% if (topUnpaid.length===0) { %>
              <div class="text-center text-muted" style="padding:24px;font-size:13px"><%= t('admin.reports.all_paid', 'Semua pelanggan sudah lunas') %></div>
            <% } %>
            <% topUnpaid.slice(0,3).forEach(u=>{ %>
            <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
              <div>
                <div style="font-size:13px;font-weight:600"><%= u.name %></div>
                <div style="font-size:11px;color:var(--muted)"><%= u.phone %></div>
              </div>
              <span class="badge bd money-value">Rp <%= u.total_unpaid.toLocaleString('id-ID') %></span>
            </div>
            <% }) %>
          </div>
        </div>

        <div class="card" style="flex:1">
          <div class="card-hd">
            <h6>
              <i class="bi bi-pie-chart"></i> Rincian Pengeluaran 
              <% if (filterMonth) { %>
                (<%= mnsNames[filterMonth - 1] %> <%= filterYear %>)
              <% } else { %>
                (<%= filterYear %>)
              <% } %>
            </h6>
          </div>
          <div class="card-bd" style="padding:0">
            <% if (typeof expensesByCategory !== 'undefined' && expensesByCategory.length===0) { %>
              <div class="text-center text-muted" style="padding:24px;font-size:13px">Belum ada pengeluaran dicatat</div>
            <% } %>
            <% if(typeof expensesByCategory !== 'undefined') expensesByCategory.forEach(c=>{ %>
            <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
              <div style="font-size:13px;font-weight:600"><i class="bi bi-tag" style="color:var(--muted);margin-right:6px"></i> <%= c.category %></div>
              <span class="badge money-value" style="background:rgba(239, 68, 68, 0.1);color:#ef4444">Rp <%= c.total.toLocaleString('id-ID') %></span>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Monthly Breakdown Table -->
    <div class="card">
      <div class="card-hd"><h6><i class="bi bi-table"></i> <%= t('admin.reports.monthly_breakdown', 'Rincian Per Bulan') %> <%= filterYear %></h6></div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.reports.table.month', 'Bulan') %></th>
              <th class="num"><%= t('admin.reports.table.total_invoices', 'Total Tagihan') %></th>
              <th class="num"><%= t('admin.reports.table.paid', 'Sudah Bayar') %></th>
              <th class="num"><%= t('admin.reports.table.unpaid', 'Belum Bayar') %></th>
              <th class="num"><%= t('admin.reports.table.revenue', 'Pendapatan') %></th>
              <th><%= t('admin.reports.table.pct', 'Persentase') %></th>
            </tr>
          </thead>
          <tbody>
          <% const mns = (lang === 'en')
            ? ['January','February','March','April','May','June','July','August','September','October','November','December']
            : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
             let grandTotal=0, grandPaid=0;
             monthlyData.forEach(m=>{ grandTotal+=m.total_invoices; grandPaid+=m.paid_count; }); %>
          <% if(monthlyData.length===0){ %>
            <tr><td colspan="6" class="text-center text-muted" style="padding:24px"><%= t('admin.reports.no_data_year_prefix', 'Belum ada data untuk tahun') %> <%= filterYear %></td></tr>
          <% } %>
          <% monthlyData.forEach(m=>{ const pct=m.total_invoices>0?Math.round(m.paid_count/m.total_invoices*100):0; %>
            <tr <%= filterMonth === m.month ? 'style="background-color: rgba(99, 102, 241, 0.1); font-weight: bold;"' : '' %>>
              <td class="fw6"><%= mns[m.month-1] %></td>
              <td class="num"><%= m.total_invoices %></td>
              <td class="num" style="color:var(--success)"><%= m.paid_count %></td>
              <td class="num" style="color:var(--danger)"><%= m.unpaid_count %></td>
              <td class="num fw6 money-value" style="color:var(--success)">Rp <%= m.revenue.toLocaleString('id-ID') %></td>
              <td>
                <div style="display:flex;align-items:center;gap:8px">
                  <div style="flex:1;background:var(--bg3);border-radius:4px;height:6px;overflow:hidden">
                    <div <%- `style="width:${pct}%;height:100%;background:linear-gradient(90deg,#3fb950,#4ade80);border-radius:4px"` %>></div>
                  </div>
                  <span style="font-size:12px;color:var(--muted);width:32px"><%= pct %>%</span>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent Payments -->
    <div class="card">
      <div class="card-hd">
        <h6>
          <i class="bi bi-clock-history"></i> 
          <%= t('admin.reports.recent_payments', 'Pembayaran Terakhir') %>
          <% if (filterMonth) { %>
            - <%= mnsNames[filterMonth - 1] %> <%= filterYear %>
          <% } %>
        </h6>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.reports.table.customer', 'Pelanggan') %></th>
              <th><%= t('admin.reports.table.period', 'Periode') %></th>
              <th class="num"><%= t('admin.reports.table.amount', 'Jumlah') %></th>
              <th><%= t('admin.reports.table.recorded_by', 'Dicatat Oleh') %></th>
              <th><%= t('admin.reports.table.time', 'Waktu') %></th>
            </tr>
          </thead>
          <tbody>
          <% const mn2 = (lang === 'en')
            ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
            : ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des']; %>
          <% if(recentPayments.length===0){%><tr><td colspan="5" class="text-center text-muted" style="padding:24px"><%= t('admin.reports.no_payments', 'Belum ada pembayaran') %></td></tr><%}%>
          <% recentPayments.forEach(p=>{ %>
            <tr>
              <td class="fw6"><%= p.customer_name %></td>
              <td><span class="badge bm"><%= mn2[p.period_month-1] %> <%= p.period_year %></span></td>
              <td class="num fw6 money-value" style="color:var(--success)">Rp <%= p.amount.toLocaleString('id-ID') %></td>
              <td style="font-size:12px"><%= p.paid_by_name||'-' %></td>
              <td style="font-size:11px;color:var(--muted)"><%= p.paid_at ? new Date(p.paid_at).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
const monthLabels = JSON.parse(`<%- JSON.stringify((lang === 'en') 
  ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] 
  : ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des']) %>`);
const revenueData = JSON.parse(`<%- JSON.stringify(chartData) %>`);
const labels = monthLabels;
const values = Array(12).fill(0);
revenueData.forEach(d=>{ values[d.month-1] = d.revenue; });

new Chart(document.getElementById('revenueChart'), {
  type: 'bar',
  data: {
    labels,
    datasets: [{
      label: "<%= t('admin.reports.chart.revenue_label', 'Pendapatan (Rp)') %>",
      data: values,
      backgroundColor: 'rgba(99,102,241,0.5)',
      borderColor: '#6366f1',
      borderWidth: 2,
      borderRadius: 6,
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => 'Rp ' + ctx.raw.toLocaleString('id-ID') } } },
    scales: {
      x: { ticks: { color: '#7d8590' }, grid: { color: 'rgba(240,246,252,0.05)' } },
      y: { ticks: { color: '#7d8590', callback: v => 'Rp ' + (v/1000).toFixed(0)+'k' }, grid: { color: 'rgba(240,246,252,0.05)' } }
    }
  }
});
</script>
</body>
</html>
