<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    .backup-actions { display: flex; gap: 8px; }
    .badge-database { background: var(--sdim); color: var(--success); }
    .badge-settings { background: var(--wdim); color: var(--warning); }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'backup', company }) %>

<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-hdd-stack"></i>
      <span id="page-title">Backup & Recovery</span>
    </div>
    <div class="tb-right">
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> 
        <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %>
      </span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="page">
    <!-- HERO BANNER -->
    <div class="card mb-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); border: 1px solid rgba(99,102,241,0.5); border-radius: 20px; padding: 24px; position: relative; overflow: hidden; margin-bottom: 24px; box-shadow: 0 12px 36px rgba(79,70,229,0.25);">
      <div style="position: absolute; right: -20px; bottom: -25px; font-size: 160px; color: rgba(255,255,255,0.08); pointer-events: none;">
        <i class="bi bi-database-fill-gear"></i>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; position: relative; z-index: 1;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.35); color: #ffffff; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px;">
            <i class="bi bi-shield-check"></i> DISASTER RECOVERY & CADANGAN DATA
          </div>
          <h2 style="font-size: 24px; font-weight: 800; color: #ffffff; margin: 0 0 6px 0; letter-spacing: -0.5px;">
            Cadangan Database, Auto-Backup & Pemulihan Sistem
          </h2>
          <p style="font-size: 13px; color: rgba(255,255,255,0.92); margin: 0; max-width: 650px; line-height: 1.5; font-weight: 500;">
            Buat cadangan database JSON/SQLite secara instan, unduh berkas backup, jadwalkan auto-backup harian, dan lakukan restore data saat dibutuhkan.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/admin/backup/download-live" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: rgba(255,255,255,0.2); color: #ffffff; border: 1px solid rgba(255,255,255,0.35); text-decoration: none; display: inline-flex; align-items: center;">
            <i class="bi bi-download me-1"></i> Download DB Utama (Live)
          </a>
          <form action="/admin/backup/create" method="POST" style="display:inline">
            <button type="submit" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #ffffff; color: #4f46e5; border: none; box-shadow: 0 6px 20px rgba(0,0,0,0.15);">
              <i class="bi bi-plus-lg me-1"></i> Buat Backup Sekarang
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Alert Message -->
    <% if (msg) { %>
    <div class="alert alert-<%= msg.type === 'danger' ? 'd' : msg.type === 'success' ? 's' : msg.type === 'warning' ? 'w' : 'i' %>" style="margin-bottom:20px">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-triangle' %>"></i>
      <%= msg.text %>
    </div>
    <% } %>

    <!-- Stats Grid -->
    <div class="stat-grid">
      <div class="sc p">
        <i class="bi bi-files sc-icon"></i>
        <div class="sc-label">Total Backup</div>
        <div class="sc-val"><%= total %></div>
        <div class="sc-sub">File tersimpan</div>
      </div>
      <div class="sc s">
        <i class="bi bi-database sc-icon"></i>
        <div class="sc-label">Database</div>
        <div class="sc-val"><%= backups.filter(b => b.type === 'database').length %></div>
        <div class="sc-sub">Backup database</div>
      </div>
      <div class="sc w">
        <i class="bi bi-gear sc-icon"></i>
        <div class="sc-label">Settings</div>
        <div class="sc-val"><%= backups.filter(b => b.type === 'settings').length %></div>
        <div class="sc-sub">Backup pengaturan</div>
      </div>
      <div class="sc i">
        <i class="bi bi-hdd sc-icon"></i>
        <div class="sc-label">Total Size</div>
        <div class="sc-val"><%= (backups.reduce((sum, b) => sum + b.sizeKB, 0) / 1024).toFixed(1) %><span style="font-size:14px"> MB</span></div>
        <div class="sc-sub">Kapasitas digunakan</div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-bottom: 16px;">
      <!-- Create Backup -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-plus-circle"></i> Buat Backup Baru</h6></div>
        <div class="card-bd">
          <form action="/admin/backup/create" method="POST">
            <div class="fg">
              <label class="fl">Tipe Backup</label>
              <select class="fs" name="type">
                <option value="all">Semua (Database + Settings)</option>
                <option value="database">Database Saja</option>
                <option value="settings">Settings Saja</option>
              </select>
            </div>
            <button type="submit" class="btn btn-p w-100">
              <i class="bi bi-cloud-upload"></i> Mulai Backup
            </button>
          </form>
        </div>
      </div>

      <!-- Upload Database -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-upload"></i> Upload Database / File Backup</h6></div>
        <div class="card-bd">
          <form action="/admin/backup/upload" method="POST" enctype="multipart/form-data" id="uploadDbForm">
            <div class="fg">
              <label class="fl">Pilih File (.db / .sqlite / .json)</label>
              <input type="file" class="fc" name="backup_file" accept=".db,.sqlite,.sqlite3,.json" required>
            </div>
            <div class="fg">
              <label class="fl">Tindakan</label>
              <select class="fs" name="auto_restore" id="uploadAutoRestore">
                <option value="false">Simpan ke Riwayat Backup</option>
                <option value="true">Upload & Restore Langsung ke Sistem</option>
              </select>
            </div>
            <button type="submit" class="btn btn-s w-100" onclick="return confirmUploadSubmit(event)">
              <i class="bi bi-cloud-arrow-up"></i> Upload File
            </button>
          </form>
        </div>
      </div>

      <!-- Cleanup -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-trash"></i> Pembersihan Otomatis</h6></div>
        <div class="card-bd">
          <form action="/admin/backup/cleanup" method="POST">
            <div class="fg">
              <label class="fl">Retensi (Hari)</label>
              <input type="number" class="fc" name="retentionDays" value="30" min="1" max="365">
              <small class="text-muted" style="font-size: 10px; display: block; margin-top: 4px;">Backup lebih lama dari periode ini akan dihapus</small>
            </div>
            <button type="submit" class="btn btn-w w-100">
              <i class="bi bi-stars"></i> Bersihkan Sekarang
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Backup List -->
    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-ul"></i> Riwayat Backup</h6>
      </div>
      <div class="card-bd">
        <% if (backups.length === 0) { %>
          <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 40px; opacity: 0.3;"></i>
            <p class="text-muted mt-2">Belum ada file backup tersedia</p>
          </div>
        <% } else { %>
          <div class="tbl-wrap">
            <table class="dtbl">
              <thead>
                <tr>
                  <th>Nama File</th>
                  <th>Tipe</th>
                  <th class="num">Ukuran</th>
                  <th>Tanggal Dibuat</th>
                  <th class="text-right">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% backups.forEach(backup => { %>
                <tr>
                  <td>
                    <div class="flex ai-c gap">
                      <i class="bi bi-file-earmark-zip text-primary"></i>
                      <span><%= backup.fileName %></span>
                    </div>
                  </td>
                  <td>
                    <span class="badge <%= backup.type === 'database' ? 'bs' : 'bw' %>">
                      <%= backup.type === 'database' ? 'Database' : 'Settings' %>
                    </span>
                  </td>
                  <td class="num"><%= backup.sizeKB %> KB</td>
                  <td>
                    <% if (backup.createdDate) { %>
                      <%= backup.createdDate.toLocaleString('id-ID', { 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      }) %>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td>
                    <div class="backup-actions jc-fe">
                      <a href="/admin/backup/download/<%= encodeURIComponent(backup.fileName) %>" class="btn btn-g btn-sm text-primary" title="Download File">
                        <i class="bi bi-download"></i>
                      </a>
                      <button type="button" class="btn btn-g btn-sm text-success" onclick="restoreBackup('<%= backup.fileName %>', '<%= backup.type %>')" title="Restore">
                        <i class="bi bi-arrow-counterclockwise"></i>
                      </button>
                      <button type="button" class="btn btn-g btn-sm text-danger" onclick="deleteBackup('<%= backup.fileName %>')" title="Hapus">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
    <!-- DANGER ZONE: FACTORY RESET TOTAL (MODE 2) -->
    <div class="card mt-4" style="border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 16px; overflow: hidden; background: linear-gradient(180deg, rgba(239, 68, 68, 0.04) 0%, rgba(2, 6, 23, 0.6) 100%); margin-top: 24px;">
      <div class="card-hd" style="background: rgba(239, 68, 68, 0.12); border-bottom: 1px solid rgba(239, 68, 68, 0.25); display: flex; justify-content: space-between; align-items: center; padding: 14px 20px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <i class="bi bi-radioactive text-danger" style="font-size: 20px;"></i>
          <h6 style="color: #ef4444; margin: 0; font-weight: 800; letter-spacing: 0.2px;">Zona Bahaya: Factory Reset Total (Mode 2: Siap PT / Klien Baru)</h6>
        </div>
        <span class="badge" style="background: #dc2626; color: #ffffff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 6px; letter-spacing: 0.5px;">DANGER ZONE</span>
      </div>
      <div class="card-bd" style="padding: 20px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px;">
          <div style="max-width: 750px;">
            <p style="margin: 0 0 12px 0; font-size: 13px; line-height: 1.6; color: var(--text);">
              Gunakan fitur ini ketika sistem billing akan <b>dialihkan, dijual, atau diserahkan ke PT / Klien Baru</b> untuk tujuan komersil. Fitur ini akan menghapus seluruh data operasional, mereset identitas perusahaan ke nama umum, mengosongkan kredensial pihak ketiga, dan menyiapkan database bersih dengan master data awal.
            </p>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; margin-top: 12px;">
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-shield-check text-success" style="font-size: 16px;"></i>
                <span><b>Auto-Backup Terjamin:</b> Cadangan dibuat otomatis sebelum reset.</span>
              </div>
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-key-fill text-warning" style="font-size: 16px;"></i>
                <span><b>Lisensi Dipertahankan:</b> Lisensi default tetap aktif (opsi unbind tersedia).</span>
              </div>
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-person-check-fill text-info" style="font-size: 16px;"></i>
                <span><b>Akses Login Aman:</b> Akun Super Admin tetap bisa login seperti biasa.</span>
              </div>
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-eraser-fill text-danger" style="font-size: 16px;"></i>
                <span><b>Data Bersih:</b> Pelanggan, invoice, tiket, ODP, OLT, log direset ke nol.</span>
              </div>
            </div>
          </div>
          <div>
            <button type="button" class="btn btn-d" onclick="openModal('flushModal')" style="padding: 12px 20px; font-weight: 800; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 6px 20px rgba(220, 38, 38, 0.3);">
              <i class="bi bi-radioactive"></i> Flush Database (Mode 2)
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MODAL FLUSH DATABASE (MODE 2) -->
<div class="mo" id="flushModal">
  <div class="mb" style="max-width: 540px; border: 1px solid rgba(239, 68, 68, 0.4);">
    <div class="mh" style="background: rgba(239, 68, 68, 0.12); border-bottom: 1px solid rgba(239, 68, 68, 0.25);">
      <span class="mt" style="color: #ef4444; font-weight: 800;">
        <i class="bi bi-exclamation-octagon-fill text-danger me-1"></i> Konfirmasi Factory Reset Total (Mode 2)
      </span>
      <button class="mc" onclick="closeModal('flushModal')">&times;</button>
    </div>
    <form action="/admin/backup/flush" method="POST" id="flushForm">
      <div class="mbody" style="padding: 20px;">
        <div class="alert alert-d" style="margin-bottom: 16px; font-size: 12px; line-height: 1.5;">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <b>PERINGATAN KRUSIAL:</b> Seluruh data pelanggan, tagihan, router, ODP, tiket, log, dan pengaturan perusahaan akan dihapus. Sistem akan membuat berkas cadangan otomatis (pre-flush backup) sebelum penghapusan data dijalankan.
        </div>

        <!-- Checklist Kosongkan Lisensi (Unbind) -->
        <div style="background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 10px; padding: 12px 14px; margin-bottom: 16px;">
          <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; margin: 0;">
            <input type="checkbox" name="clear_license" value="true" id="clearLicenseCheck" style="margin-top: 3px; cursor: pointer; width: 16px; height: 16px;">
            <div>
              <span style="font-weight: 800; color: #ef4444; font-size: 13px;">Kosongkan Lisensi (Unbind Lisensi)</span>
              <p style="margin: 4px 0 0 0; font-size: 11px; color: var(--muted); line-height: 1.4;">
                <b>Default (tidak dicentang):</b> Lisensi tetap dipertahankan dan aktif di mesin ini.<br>
                <b>Centang opsi ini:</b> Jika Anda ingin melepas lisensi sepenuhnya dari sistem ini (misal untuk aktivasi di mesin baru).
              </p>
            </div>
          </label>
        </div>

        <div class="fg" style="margin-bottom: 14px;">
          <label class="fl" style="font-weight: 700;">Password Administrator <span class="text-danger">*</span></label>
          <input type="password" class="fc" name="password" id="flushAdminPassword" placeholder="Masukkan password admin Anda" required autocomplete="current-password">
        </div>

        <div class="fg" style="margin-bottom: 8px;">
          <label class="fl" style="font-weight: 700;">
            Ketik persis <span style="font-family: monospace; color: #ef4444; font-weight: 900; background: rgba(239,68,68,0.1); padding: 2px 6px; border-radius: 4px;">FLUSH DATABASE</span> di bawah ini: <span class="text-danger">*</span>
          </label>
          <input type="text" class="fc" name="confirm_text" id="flushConfirmText" placeholder="FLUSH DATABASE" required autocomplete="off">
        </div>
      </div>
      <div class="mf" style="border-top: 1px solid var(--border); padding: 14px 20px; display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="btn btn-g" onclick="closeModal('flushModal')">Batal</button>
        <button type="submit" class="btn btn-d" id="btnSubmitFlush" style="font-weight: 800;">
          <i class="bi bi-radioactive"></i> Ya, Flush Database Sekarang
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
  }

  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
  }

  const flushForm = document.getElementById('flushForm');
  if (flushForm) {
    flushForm.addEventListener('submit', function(e) {
      const confirmInput = document.getElementById('flushConfirmText');
      if (!confirmInput || confirmInput.value.trim() !== 'FLUSH DATABASE') {
        e.preventDefault();
        alert('Teks konfirmasi harus persis "FLUSH DATABASE"!');
        return false;
      }
      const clearLic = document.getElementById('clearLicenseCheck')?.checked;
      const licWarning = clearLic ? '\n- LISENSI AKAN DIKOSONGKAN (UNBOUND).' : '\n- Lisensi tetap dipertahankan.';
      if (!confirm('KONFIRMASI AKHIR:\nApakah Anda yakin 100% ingin menjalankan Factory Reset Total?' + licWarning + '\n\nAuto-backup akan dibuat secara instan.')) {
        e.preventDefault();
        return false;
      }
    });
  }

  function restoreBackup(fileName, type) {
    if (!confirm('Apakah Anda yakin ingin merestore backup ini? Data saat ini akan ditimpa.')) {
      return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/backup/restore';
    form.innerHTML = `
      <input type="hidden" name="fileName" value="${fileName}">
      <input type="hidden" name="type" value="${type}">
    `;
    document.body.appendChild(form);
    form.submit();
  }

  function deleteBackup(fileName) {
    if (!confirm('Apakah Anda yakin ingin menghapus backup ini?')) {
      return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/backup/delete';
    form.innerHTML = `
      <input type="hidden" name="fileName" value="${fileName}">
    `;
    document.body.appendChild(form);
    form.submit();
  }

  function confirmUploadSubmit(e) {
    const autoRestore = document.getElementById('uploadAutoRestore').value === 'true';
    if (autoRestore) {
      if (!confirm('PERHATIAN: Anda memilih opsi "Upload & Restore Langsung". Data saat ini akan ditimpa dengan berkas yang di-upload.\n\nLanjutkan?')) {
        if (e) e.preventDefault();
        return false;
      }
    }
    return true;
  }

  function toggleSidebar() {
    document.querySelector('.sidebar').classList.toggle('open');
  }
</script>
</body>
</html>
