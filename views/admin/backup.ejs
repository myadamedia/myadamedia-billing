<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    .backup-actions { display: flex; gap: 8px; }
    .badge-database { background: var(--sdim); color: var(--success); }
    .badge-settings { background: var(--wdim); color: var(--warning); }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'backup', company }) %>

<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-hdd-stack"></i>
      <span id="page-title">Backup & Recovery</span>
    </div>
    <div class="tb-right">
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> 
        <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %>
      </span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="page">
    <!-- HERO BANNER -->
    <div class="card mb-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); border: 1px solid rgba(99,102,241,0.5); border-radius: 20px; padding: 24px; position: relative; overflow: hidden; margin-bottom: 24px; box-shadow: 0 12px 36px rgba(79,70,229,0.25);">
      <div style="position: absolute; right: -20px; bottom: -25px; font-size: 160px; color: rgba(255,255,255,0.08); pointer-events: none;">
        <i class="bi bi-database-fill-gear"></i>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; position: relative; z-index: 1;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.35); color: #ffffff; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px;">
            <i class="bi bi-shield-check"></i> DISASTER RECOVERY & CADANGAN DATA
          </div>
          <h2 style="font-size: 24px; font-weight: 800; color: #ffffff; margin: 0 0 6px 0; letter-spacing: -0.5px;">
            Cadangan Database, Auto-Backup & Pemulihan Sistem
          </h2>
          <p style="font-size: 13px; color: rgba(255,255,255,0.92); margin: 0; max-width: 650px; line-height: 1.5; font-weight: 500;">
            Buat cadangan database JSON/SQLite secara instan, unduh berkas backup, jadwalkan auto-backup harian, dan lakukan restore data saat dibutuhkan.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/admin/backup/download-live" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: rgba(255,255,255,0.2); color: #ffffff; border: 1px solid rgba(255,255,255,0.35); text-decoration: none; display: inline-flex; align-items: center;">
            <i class="bi bi-download me-1"></i> Download DB Utama (Live)
          </a>
          <form action="/admin/backup/create" method="POST" style="display:inline">
            <button type="submit" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #ffffff; color: #4f46e5; border: none; box-shadow: 0 6px 20px rgba(0,0,0,0.15);">
              <i class="bi bi-plus-lg me-1"></i> Buat Backup Sekarang
            </button>
          </form>
          <form action="/admin/backup/create" method="POST" style="display:inline" onsubmit="return confirm('Buat backup database terbaru dan langsung kirimkan ke Telegram Admin?')">
            <input type="hidden" name="type" value="database">
            <input type="hidden" name="send_telegram" value="1">
            <button type="submit" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #0088cc; color: #ffffff; border: none; box-shadow: 0 6px 20px rgba(0,136,204,0.35); display: inline-flex; align-items: center;" title="Buat backup database terbaru dan langsung kirimkan ke Telegram Admin">
              <i class="bi bi-telegram me-1"></i> Backup & Kirim ke Telegram
            </button>
          </form>
          <form action="/admin/backup/create" method="POST" style="display:inline" onsubmit="return confirm('Buat backup database terbaru dan langsung unggah ke Multi-Cloud (Telegram & Google Drive)?')">
            <input type="hidden" name="type" value="database">
            <input type="hidden" name="send_cloud" value="both">
            <button type="submit" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #059669; color: #ffffff; border: none; box-shadow: 0 6px 20px rgba(5,150,105,0.35); display: inline-flex; align-items: center;" title="Buat cadangan database dan unggah ke Telegram & Google Drive secara paralel">
              <i class="bi bi-cloud-arrow-up-fill me-1"></i> Backup & Multi-Cloud
            </button>
          </form>
          <button type="button" class="btn btn-sm" onclick="openModal('cloudSettingsModal')" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: rgba(255,255,255,0.92); color: #1e293b; border: none; box-shadow: 0 6px 20px rgba(0,0,0,0.18); display: inline-flex; align-items: center;">
            <i class="bi bi-cloud-gear-fill me-1" style="color: #4f46e5;"></i> Konfigurasi Multi-Cloud
          </button>
        </div>
      </div>
    </div>

    <!-- Status Integrasi Multi-Cloud (Telegram & Google Drive) -->
    <% 
      const isTgActive = typeof getSetting === 'function' && getSetting('telegram_enabled', false);
      const tgBotToken = typeof getSetting === 'function' ? getSetting('telegram_bot_token', '') : '';
      const tgAdminId = typeof getSetting === 'function' ? getSetting('telegram_admin_id', '') : '';
      const isTgConfigured = isTgActive && tgBotToken && tgAdminId;
      const isDriveEnabled = typeof getSetting === 'function' && getSetting('gdrive_backup_enabled', false);
      const gdriveFolderId = typeof getSetting === 'function' ? getSetting('gdrive_folder_id', '') : '';
      const gdriveAuthType = typeof getSetting === 'function' ? getSetting('gdrive_auth_type', 'service_account') : 'service_account';
      const cloudDest = typeof getSetting === 'function' ? getSetting('backup_cloud_destination', 'both') : 'both';
    %>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:14px;margin-bottom:20px">
      <!-- Status Telegram -->
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;box-shadow:0 4px 15px rgba(0,0,0,0.06)">
        <div style="display:flex;align-items:center;gap:12px">
          <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,136,204,0.15);color:#0088cc;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">
            <i class="bi bi-telegram"></i>
          </div>
          <div>
            <div style="font-weight:700;font-size:13px;display:flex;align-items:center;gap:8px">
              Integrasi Pengiriman Telegram:
              <% if (isTgConfigured) { %>
                <span class="badge bs" style="font-size:10px;padding:3px 8px"><i class="bi bi-check-circle-fill"></i> AKTIF & SIAP</span>
              <% } else { %>
                <span class="badge bd" style="font-size:10px;padding:3px 8px"><i class="bi bi-exclamation-triangle-fill"></i> BELUM AKTIF</span>
              <% } %>
            </div>
            <div style="font-size:12px;color:var(--muted);margin-top:2px">
              <% if (isTgConfigured) { %>
                Penerima Chat ID Admin: <code style="color:var(--primary);font-weight:700"><%= tgAdminId %></code>
              <% } else { %>
                Bot belum aktif. Aktifkan di <a href="/admin/settings" style="color:var(--primary);font-weight:700;text-decoration:underline">Pengaturan Sistem</a>.
              <% } %>
            </div>
          </div>
        </div>
        <div>
          <a href="/admin/settings" class="btn btn-g btn-sm" style="font-size:11px;font-weight:600">
            <i class="bi bi-gear"></i> Set Bot
          </a>
        </div>
      </div>

      <!-- Status Google Drive -->
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;box-shadow:0 4px 15px rgba(0,0,0,0.06)">
        <div style="display:flex;align-items:center;gap:12px">
          <div style="width:40px;height:40px;border-radius:10px;background:rgba(15,157,88,0.15);color:#0f9d58;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">
            <i class="bi bi-google"></i>
          </div>
          <div>
            <div style="font-weight:700;font-size:13px;display:flex;align-items:center;gap:8px">
              Google Drive Cloud Backup:
              <% if (isDriveEnabled && isGdriveConfigured) { %>
                <span class="badge bs" style="font-size:10px;padding:3px 8px"><i class="bi bi-check-circle-fill"></i> TERHUBUNG</span>
              <% } else if (isDriveEnabled && !isGdriveConfigured) { %>
                <span class="badge bw" style="font-size:10px;padding:3px 8px"><i class="bi bi-exclamation-circle-fill"></i> KUNCI BELUM LENGKAP</span>
              <% } else { %>
                <span class="badge bd" style="font-size:10px;padding:3px 8px"><i class="bi bi-x-circle-fill"></i> NONAKTIF</span>
              <% } %>
            </div>
            <div style="font-size:12px;color:var(--muted);margin-top:2px">
              <% if (isDriveEnabled && isGdriveConfigured) { %>
                Folder: <code style="color:var(--success);font-weight:700"><%= gdriveFolderId || 'Root Drive' %></code> | Auth: <%= gdriveAuthType === 'service_account' ? 'Service Account' : 'OAuth2' %>
              <% } else { %>
                Simpan cadangan ke Google Drive secara otomatis via Service Account / OAuth2.
              <% } %>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:6px">
          <button type="button" class="btn btn-g btn-sm" onclick="testGdriveConnection(this)" style="font-size:11px;font-weight:600" title="Uji Koneksi Google Drive">
            <i class="bi bi-arrow-repeat"></i> Test
          </button>
          <button type="button" class="btn btn-g btn-sm" onclick="openModal('cloudSettingsModal')" style="font-size:11px;font-weight:600">
            <i class="bi bi-sliders"></i> Setting
          </button>
        </div>
      </div>
    </div>

    <!-- Alert Message -->
    <% if (msg) { %>
    <div class="alert alert-<%= msg.type === 'danger' ? 'd' : msg.type === 'success' ? 's' : msg.type === 'warning' ? 'w' : 'i' %>" style="margin-bottom:20px">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-triangle' %>"></i>
      <%- msg.text %>
    </div>
    <% } %>

    <!-- Stats Grid -->
    <div class="stat-grid">
      <div class="sc p">
        <i class="bi bi-files sc-icon"></i>
        <div class="sc-label">Total Backup</div>
        <div class="sc-val"><%= total %></div>
        <div class="sc-sub">File tersimpan</div>
      </div>
      <div class="sc s">
        <i class="bi bi-database sc-icon"></i>
        <div class="sc-label">Database</div>
        <div class="sc-val"><%= backups.filter(b => b.type === 'database').length %></div>
        <div class="sc-sub">Backup database</div>
      </div>
      <div class="sc w">
        <i class="bi bi-gear sc-icon"></i>
        <div class="sc-label">Settings</div>
        <div class="sc-val"><%= backups.filter(b => b.type === 'settings').length %></div>
        <div class="sc-sub">Backup pengaturan</div>
      </div>
      <div class="sc i">
        <i class="bi bi-hdd sc-icon"></i>
        <div class="sc-label">Total Size</div>
        <div class="sc-val"><%= (backups.reduce((sum, b) => sum + b.sizeKB, 0) / 1024).toFixed(1) %><span style="font-size:14px"> MB</span></div>
        <div class="sc-sub">Kapasitas digunakan</div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-bottom: 16px;">
      <!-- Create Backup -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-plus-circle"></i> Buat Backup Baru</h6></div>
        <div class="card-bd">
          <form action="/admin/backup/create" method="POST">
            <div class="fg">
              <label class="fl">Tipe Backup</label>
              <select class="fs" name="type">
                <option value="all">Semua (Database + Settings)</option>
                <option value="database">Database Saja</option>
                <option value="settings">Settings Saja</option>
              </select>
            </div>
            <div class="fg" style="margin-top:10px;margin-bottom:6px">
              <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;color:var(--text);font-weight:600">
                <input type="checkbox" name="send_telegram" value="1" style="width:16px;height:16px;accent-color:#0088cc" checked>
                <span><i class="bi bi-telegram" style="color:#0088cc"></i> Langsung kirim hasil backup ke Telegram Admin</span>
              </label>
            </div>
            <div class="fg" style="margin-top:0px;margin-bottom:14px">
              <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;color:var(--text);font-weight:600">
                <input type="checkbox" name="send_gdrive" value="1" style="width:16px;height:16px;accent-color:#0f9d58" <%= (typeof isGdriveConfigured !== 'undefined' && isGdriveConfigured) ? 'checked' : '' %>>
                <span><i class="bi bi-google" style="color:#0f9d58"></i> Langsung unggah hasil backup ke Google Drive</span>
              </label>
            </div>
            <button type="submit" class="btn btn-p w-100">
              <i class="bi bi-cloud-upload"></i> Mulai Backup
            </button>
          </form>
        </div>
      </div>

      <!-- Upload Database -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-upload"></i> Upload Database / File Backup</h6></div>
        <div class="card-bd">
          <form action="/admin/backup/upload" method="POST" enctype="multipart/form-data" id="uploadDbForm">
            <div class="fg">
              <label class="fl">Pilih File (.db / .sqlite / .json)</label>
              <input type="file" class="fc" name="backup_file" accept=".db,.sqlite,.sqlite3,.json" required>
            </div>
            <div class="fg">
              <label class="fl">Tindakan</label>
              <select class="fs" name="auto_restore" id="uploadAutoRestore">
                <option value="false">Simpan ke Riwayat Backup</option>
                <option value="true">Upload & Restore Langsung ke Sistem</option>
              </select>
            </div>
            <button type="submit" class="btn btn-s w-100" onclick="return confirmUploadSubmit(event)">
              <i class="bi bi-cloud-arrow-up"></i> Upload File
            </button>
          </form>
        </div>
      </div>

      <!-- Cleanup -->
      <div class="card">
        <div class="card-hd"><h6><i class="bi bi-trash"></i> Pembersihan Otomatis</h6></div>
        <div class="card-bd">
          <form action="/admin/backup/cleanup" method="POST">
            <div class="fg">
              <label class="fl">Retensi (Hari)</label>
              <input type="number" class="fc" name="retentionDays" value="30" min="1" max="365">
              <small class="text-muted" style="font-size: 10px; display: block; margin-top: 4px;">Backup lebih lama dari periode ini akan dihapus</small>
            </div>
            <button type="submit" class="btn btn-w w-100">
              <i class="bi bi-stars"></i> Bersihkan Sekarang
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Backup List -->
    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-ul"></i> Riwayat Backup</h6>
      </div>
      <div class="card-bd">
        <% if (backups.length === 0) { %>
          <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 40px; opacity: 0.3;"></i>
            <p class="text-muted mt-2">Belum ada file backup tersedia</p>
          </div>
        <% } else { %>
          <div class="tbl-wrap">
            <table class="dtbl">
              <thead>
                <tr>
                  <th>Nama File</th>
                  <th>Tipe</th>
                  <th class="num">Ukuran</th>
                  <th>Tanggal Dibuat</th>
                  <th class="text-right">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% backups.forEach(backup => { %>
                <tr>
                  <td>
                    <div class="flex ai-c gap">
                      <i class="bi bi-file-earmark-zip text-primary"></i>
                      <span><%= backup.fileName %></span>
                    </div>
                  </td>
                  <td>
                    <span class="badge <%= backup.type === 'database' ? 'bs' : 'bw' %>">
                      <%= backup.type === 'database' ? 'Database' : 'Settings' %>
                    </span>
                  </td>
                  <td class="num"><%= backup.sizeKB %> KB</td>
                  <td>
                    <% if (backup.createdDate) { %>
                      <%= backup.createdDate.toLocaleString('id-ID', { 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      }) %>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td>
                    <div class="backup-actions jc-fe">
                      <a href="/admin/backup/download/<%= encodeURIComponent(backup.fileName) %>" class="btn btn-g btn-sm text-primary" title="Download File">
                        <i class="bi bi-download"></i>
                      </a>
                      <form method="POST" action="/admin/backup/send-telegram" style="display:inline" onsubmit="return confirmSendTelegram(event, '<%= backup.fileName %>')">
                        <input type="hidden" name="fileName" value="<%= backup.fileName %>">
                        <button type="submit" class="btn btn-g btn-sm" style="color:#0088cc" title="Kirim file backup ini ke Telegram Admin">
                          <i class="bi bi-telegram"></i>
                        </button>
                      </form>
                      <form method="POST" action="/admin/backup/send-gdrive" style="display:inline" onsubmit="return confirmSendGdrive(event, '<%= backup.fileName %>')">
                        <input type="hidden" name="fileName" value="<%= backup.fileName %>">
                        <button type="submit" class="btn btn-g btn-sm" style="color:#0f9d58" title="Kirim file backup ini ke Google Drive">
                          <i class="bi bi-google"></i>
                        </button>
                      </form>
                      <button type="button" class="btn btn-g btn-sm text-success" onclick="restoreBackup('<%= backup.fileName %>', '<%= backup.type %>')" title="Restore">
                        <i class="bi bi-arrow-counterclockwise"></i>
                      </button>
                      <button type="button" class="btn btn-g btn-sm text-danger" onclick="deleteBackup('<%= backup.fileName %>')" title="Hapus">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
    <!-- DANGER ZONE: FACTORY RESET TOTAL (MODE 2) -->
    <div class="card mt-4" style="border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 16px; overflow: hidden; background: linear-gradient(180deg, rgba(239, 68, 68, 0.04) 0%, rgba(2, 6, 23, 0.6) 100%); margin-top: 24px;">
      <div class="card-hd" style="background: rgba(239, 68, 68, 0.12); border-bottom: 1px solid rgba(239, 68, 68, 0.25); display: flex; justify-content: space-between; align-items: center; padding: 14px 20px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <i class="bi bi-radioactive text-danger" style="font-size: 20px;"></i>
          <h6 style="color: #ef4444; margin: 0; font-weight: 800; letter-spacing: 0.2px;">Zona Bahaya: Factory Reset Total (Mode 2: Siap PT / Klien Baru)</h6>
        </div>
        <span class="badge" style="background: #dc2626; color: #ffffff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 6px; letter-spacing: 0.5px;">DANGER ZONE</span>
      </div>
      <div class="card-bd" style="padding: 20px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px;">
          <div style="max-width: 750px;">
            <p style="margin: 0 0 12px 0; font-size: 13px; line-height: 1.6; color: var(--text);">
              Gunakan fitur ini ketika sistem billing akan <b>dialihkan, dijual, atau diserahkan ke PT / Klien Baru</b> untuk tujuan komersil. Fitur ini akan menghapus seluruh data operasional, mereset identitas perusahaan ke nama umum, mengosongkan kredensial pihak ketiga, dan menyiapkan database bersih dengan master data awal.
            </p>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; margin-top: 12px;">
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-shield-check text-success" style="font-size: 16px;"></i>
                <span><b>Auto-Backup Terjamin:</b> Cadangan dibuat otomatis sebelum reset.</span>
              </div>
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-key-fill text-warning" style="font-size: 16px;"></i>
                <span><b>Lisensi Dipertahankan:</b> Lisensi default tetap aktif (opsi unbind tersedia).</span>
              </div>
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-person-check-fill text-info" style="font-size: 16px;"></i>
                <span><b>Akses Login Aman:</b> Akun Super Admin tetap bisa login seperti biasa.</span>
              </div>
              <div style="font-size: 12px; display: flex; align-items: center; gap: 8px; color: var(--text);">
                <i class="bi bi-eraser-fill text-danger" style="font-size: 16px;"></i>
                <span><b>Data Bersih:</b> Pelanggan, invoice, tiket, ODP, OLT, log direset ke nol.</span>
              </div>
            </div>
          </div>
          <div>
            <button type="button" class="btn btn-d" onclick="openModal('flushModal')" style="padding: 12px 20px; font-weight: 800; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 6px 20px rgba(220, 38, 38, 0.3);">
              <i class="bi bi-radioactive"></i> Flush Database (Mode 2)
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MODAL FLUSH DATABASE (MODE 2) -->
<div class="mo" id="flushModal">
  <div class="mb" style="max-width: 540px; border: 1px solid rgba(239, 68, 68, 0.4);">
    <div class="mh" style="background: rgba(239, 68, 68, 0.12); border-bottom: 1px solid rgba(239, 68, 68, 0.25);">
      <span class="mt" style="color: #ef4444; font-weight: 800;">
        <i class="bi bi-exclamation-octagon-fill text-danger me-1"></i> Konfirmasi Factory Reset Total (Mode 2)
      </span>
      <button class="mc" onclick="closeModal('flushModal')">&times;</button>
    </div>
    <form action="/admin/backup/flush" method="POST" id="flushForm">
      <div class="mbody" style="padding: 20px;">
        <div class="alert alert-d" style="margin-bottom: 16px; font-size: 12px; line-height: 1.5;">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <b>PERINGATAN KRUSIAL:</b> Seluruh data pelanggan, tagihan, router, ODP, tiket, log, dan pengaturan perusahaan akan dihapus. Sistem akan membuat berkas cadangan otomatis (pre-flush backup) sebelum penghapusan data dijalankan.
        </div>

        <!-- Checklist Kosongkan Lisensi (Unbind) -->
        <div style="background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 10px; padding: 12px 14px; margin-bottom: 16px;">
          <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; margin: 0;">
            <input type="checkbox" name="clear_license" value="true" id="clearLicenseCheck" style="margin-top: 3px; cursor: pointer; width: 16px; height: 16px;">
            <div>
              <span style="font-weight: 800; color: #ef4444; font-size: 13px;">Kosongkan Lisensi (Unbind Lisensi)</span>
              <p style="margin: 4px 0 0 0; font-size: 11px; color: var(--muted); line-height: 1.4;">
                <b>Default (tidak dicentang):</b> Lisensi tetap dipertahankan dan aktif di mesin ini.<br>
                <b>Centang opsi ini:</b> Jika Anda ingin melepas lisensi sepenuhnya dari sistem ini (misal untuk aktivasi di mesin baru).
              </p>
            </div>
          </label>
        </div>

        <div class="fg" style="margin-bottom: 14px;">
          <label class="fl" style="font-weight: 700;">Password Administrator <span class="text-danger">*</span></label>
          <input type="password" class="fc" name="password" id="flushAdminPassword" placeholder="Masukkan password admin Anda" required autocomplete="current-password">
        </div>

        <div class="fg" style="margin-bottom: 8px;">
          <label class="fl" style="font-weight: 700;">
            Ketik persis <span style="font-family: monospace; color: #ef4444; font-weight: 900; background: rgba(239,68,68,0.1); padding: 2px 6px; border-radius: 4px;">FLUSH DATABASE</span> di bawah ini: <span class="text-danger">*</span>
          </label>
          <input type="text" class="fc" name="confirm_text" id="flushConfirmText" placeholder="FLUSH DATABASE" required autocomplete="off">
        </div>
      </div>
      <div class="mf" style="border-top: 1px solid var(--border); padding: 14px 20px; display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="btn btn-g" onclick="closeModal('flushModal')">Batal</button>
        <button type="submit" class="btn btn-d" id="btnSubmitFlush" style="font-weight: 800;">
          <i class="bi bi-radioactive"></i> Ya, Flush Database Sekarang
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: PENGATURAN MULTI-CLOUD BACKUP (GOOGLE DRIVE & TELEGRAM) -->
<div class="modal" id="cloudSettingsModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:9999;backdrop-filter:blur(4px);align-items:center;justify-content:center;padding:16px">
  <div class="modal-box" style="background:var(--bg2);border:1px solid var(--border);border-radius:20px;max-width:680px;width:100%;max-height:90vh;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,0,0,0.35);overflow:hidden">
    <div class="mh" style="padding:18px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--bg3)">
      <div style="display:flex;align-items:center;gap:12px">
        <div style="width:40px;height:40px;border-radius:12px;background:rgba(79,70,229,0.12);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:22px">
          <i class="bi bi-cloud-arrow-up-fill"></i>
        </div>
        <div>
          <h5 style="margin:0;font-size:16px;font-weight:800;color:var(--text)">Konfigurasi Multi-Cloud Backup</h5>
          <p style="margin:2px 0 0 0;font-size:12px;color:var(--muted)">Cadangan otomatis ke Google Drive & Telegram Admin</p>
        </div>
      </div>
      <button type="button" class="btn btn-g btn-sm" onclick="closeModal('cloudSettingsModal')" style="border-radius:8px">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <form action="/admin/backup/save-gdrive-settings" method="POST" id="cloudSettingsForm" style="overflow-y:auto;padding:24px;display:flex;flex-direction:column;gap:18px">
      <!-- Live Test Result Banner -->
      <div id="driveTestAlert" style="display:none;padding:12px 16px;border-radius:12px;font-size:13px;line-height:1.5"></div>

      <!-- Section 1: Google Drive Toggle -->
      <div style="background:var(--bg3);border:1px solid var(--border);border-radius:14px;padding:16px">
        <label style="display:flex;align-items:center;justify-content:space-between;cursor:pointer;margin:0">
          <div style="display:flex;align-items:center;gap:12px">
            <div style="width:36px;height:36px;border-radius:10px;background:rgba(15,157,88,0.15);color:#0f9d58;display:flex;align-items:center;justify-content:center;font-size:20px">
              <i class="bi bi-google"></i>
            </div>
            <div>
              <div style="font-weight:700;font-size:14px;color:var(--text)">Aktifkan Cadangan Google Drive</div>
              <div style="font-size:12px;color:var(--muted)">Unggah berkas database (.db) dan pengaturan (.json) secara otomatis</div>
            </div>
          </div>
          <input type="checkbox" name="gdrive_backup_enabled" id="cfgGdriveEnabled" value="true" style="width:20px;height:20px;accent-color:#0f9d58" <%= (typeof getSetting === 'function' && getSetting('gdrive_backup_enabled', false)) ? 'checked' : '' %>>
        </label>
      </div>

      <!-- Section 2: Google Drive Authentication -->
      <div style="display:flex;flex-direction:column;gap:14px">
        <div class="fg">
          <label class="fl" style="font-weight:700">Metode Autentikasi Google Cloud</label>
          <select class="fs" name="gdrive_auth_type" id="cfgGdriveAuthType" onchange="toggleAuthFields()">
            <% const curAuthType = typeof getSetting === 'function' ? getSetting('gdrive_auth_type', 'service_account') : 'service_account'; %>
            <option value="service_account" <%= curAuthType === 'service_account' ? 'selected' : '' %>>Google Service Account (Direkomendasikan - Tanpa Kedaluwarsa)</option>
            <option value="oauth" <%= curAuthType === 'oauth' ? 'selected' : '' %>>OAuth 2.0 Client (Refresh Token)</option>
          </select>
        </div>

        <!-- Panel Service Account -->
        <div id="panelServiceAccount" style="display:<%= curAuthType === 'service_account' ? 'block' : 'none' %>">
          <div class="fg">
            <label class="fl" style="font-weight:700;display:flex;justify-content:space-between">
              <span>Service Account JSON Key <span class="text-danger">*</span></span>
              <small class="text-muted">Format: JSON dari GCP Console</small>
            </label>
            <textarea class="fc" name="gdrive_service_account_json" id="cfgGdriveSaJson" rows="5" style="font-family:monospace;font-size:11px;line-height:1.4" placeholder='{
  "type": "service_account",
  "project_id": "proyek-anda",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "billing-backup@proyek-anda.iam.gserviceaccount.com"
}'><%= (typeof getSetting === 'function' && getSetting('gdrive_service_account_json', '')) ? getSetting('gdrive_service_account_json', '') : '' %></textarea>
          </div>
          <div style="background:rgba(79,70,229,0.06);border:1px solid rgba(79,70,229,0.2);border-radius:10px;padding:10px 14px;font-size:11px;color:var(--text);line-height:1.5;margin-top:8px">
            <b><i class="bi bi-lightbulb text-warning"></i> Panduan Singkat Service Account:</b><br>
            1. Buka <b>console.cloud.google.com</b> &rarr; Menu <b>APIs & Services</b> &rarr; Aktifkan <b>Google Drive API</b>.<br>
            2. Menu <b>IAM & Admin &rarr; Service Accounts</b> &rarr; Buat Service Account &rarr; Tab <b>Keys &rarr; Add Key (JSON)</b>.<br>
            3. Buka folder tujuan di Google Drive Anda &rarr; <b>Bagikan (Share)</b> ke email Service Account sebagai <b>Editor</b>.
          </div>
        </div>

        <!-- Panel OAuth 2.0 -->
        <div id="panelOAuth" style="display:<%= curAuthType === 'oauth' ? 'block' : 'none' %>">
          <div class="fg" style="margin-bottom:10px">
            <label class="fl">OAuth Client ID</label>
            <input type="text" class="fc" name="gdrive_oauth_client_id" id="cfgGdriveClientId" value="<%= typeof getSetting === 'function' ? getSetting('gdrive_oauth_client_id', '') : '' %>" placeholder="xxx.apps.googleusercontent.com">
          </div>
          <div class="fg" style="margin-bottom:10px">
            <label class="fl">OAuth Client Secret</label>
            <input type="password" class="fc" name="gdrive_oauth_client_secret" id="cfgGdriveClientSecret" value="<%= typeof getSetting === 'function' ? getSetting('gdrive_oauth_client_secret', '') : '' %>" placeholder="••••••••">
          </div>
          <div class="fg">
            <label class="fl">OAuth Refresh Token</label>
            <input type="password" class="fc" name="gdrive_oauth_refresh_token" id="cfgGdriveRefreshToken" value="<%= typeof getSetting === 'function' ? getSetting('gdrive_oauth_refresh_token', '') : '' %>" placeholder="1//04xxx">
          </div>
        </div>

        <!-- Folder ID & Retention -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="fg">
            <label class="fl" style="font-weight:700">Target Folder ID Google Drive</label>
            <input type="text" class="fc" name="gdrive_folder_id" id="cfgGdriveFolderId" value="<%= typeof getSetting === 'function' ? getSetting('gdrive_folder_id', '') : '' %>" placeholder="Contoh: 1AbCdEfGhIjKlMnOpQrStUvWxYz">
            <small class="text-muted" style="font-size:11px">Kosongkan jika ingin menyimpan di root Drive</small>
          </div>
          <div class="fg">
            <label class="fl" style="font-weight:700">Retensi Backup di Cloud (Hari)</label>
            <input type="number" class="fc" name="gdrive_retention_days" id="cfgGdriveRetention" value="<%= typeof getSetting === 'function' ? getSetting('gdrive_retention_days', 30) : 30 %>" min="1" max="365">
            <small class="text-muted" style="font-size:11px">Backup lebih dari X hari otomatis dibersihkan</small>
          </div>
        </div>
      </div>

      <!-- Section 3: Destinasi Auto-Backup (Cron Jam 02:00) -->
      <div style="background:var(--bg3);border:1px solid var(--border);border-radius:14px;padding:16px">
        <h6 style="margin:0 0 10px 0;font-size:13px;font-weight:800;color:var(--text)"><i class="bi bi-clock-history text-primary"></i> Target Auto-Backup Terjadwal (Harian)</h6>
        <div class="fg" style="margin-bottom:10px">
          <label class="fl">Tujuan Pengiriman Cadangan Otomatis</label>
          <select class="fs" name="backup_cloud_destination" id="cfgCloudDest">
            <% const curDest = typeof getSetting === 'function' ? getSetting('backup_cloud_destination', 'both') : 'both'; %>
            <option value="both" <%= curDest === 'both' ? 'selected' : '' %>>Multi-Cloud: Google Drive + Telegram Admin (Direkomendasikan)</option>
            <option value="gdrive" <%= curDest === 'gdrive' ? 'selected' : '' %>>Google Drive Saja</option>
            <option value="telegram" <%= curDest === 'telegram' ? 'selected' : '' %>>Telegram Admin Saja</option>
            <option value="none" <%= curDest === 'none' ? 'selected' : '' %>>Lokal Server Saja (Tanpa Cloud)</option>
          </select>
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;color:var(--text);font-weight:600">
          <input type="checkbox" name="telegram_backup_auto_send" id="cfgTgAutoSend" value="true" style="width:16px;height:16px;accent-color:#0088cc" <%= (typeof getSetting === 'function' && getSetting('telegram_backup_auto_send', true)) ? 'checked' : '' %>>
          <span><i class="bi bi-telegram" style="color:#0088cc"></i> Izinkan bot Telegram mengirim file cadangan ke Admin Chat ID</span>
        </label>
      </div>

      <div class="mf" style="border-top:1px solid var(--border);padding-top:16px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
        <button type="button" class="btn btn-g btn-sm" id="btnTestDriveModal" onclick="testGdriveFromModal(this)" style="font-weight:700">
          <i class="bi bi-patch-check"></i> Uji Koneksi Google Drive
        </button>
        <div style="display:flex;gap:8px">
          <button type="button" class="btn btn-g" onclick="closeModal('cloudSettingsModal')">Batal</button>
          <button type="submit" class="btn btn-p" style="font-weight:800">
            <i class="bi bi-check2-circle"></i> Simpan Pengaturan
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal(id) {
    const el = document.getElementById(id);
    if (el) {
      el.style.display = 'flex';
      el.classList.add('show');
    }
  }

  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) {
      el.style.display = 'none';
      el.classList.remove('show');
    }
  }

  function toggleAuthFields() {
    const authType = document.getElementById('cfgGdriveAuthType').value;
    const panelSa = document.getElementById('panelServiceAccount');
    const panelOAuth = document.getElementById('panelOAuth');
    if (panelSa) panelSa.style.display = authType === 'service_account' ? 'block' : 'none';
    if (panelOAuth) panelOAuth.style.display = authType === 'oauth' ? 'block' : 'none';
  }

  async function testGdriveFromModal(btn) {
    const alertEl = document.getElementById('driveTestAlert');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menguji...';

    if (alertEl) {
      alertEl.style.display = 'block';
      alertEl.style.background = 'rgba(79,70,229,0.1)';
      alertEl.style.border = '1px solid rgba(79,70,229,0.3)';
      alertEl.style.color = 'var(--text)';
      alertEl.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menghubungi Google Drive API v3...';
    }

    try {
      const payload = {
        authType: document.getElementById('cfgGdriveAuthType')?.value || 'service_account',
        serviceAccountJson: document.getElementById('cfgGdriveSaJson')?.value || '',
        folderId: document.getElementById('cfgGdriveFolderId')?.value || '',
        clientId: document.getElementById('cfgGdriveClientId')?.value || '',
        clientSecret: document.getElementById('cfgGdriveClientSecret')?.value || '',
        refreshToken: document.getElementById('cfgGdriveRefreshToken')?.value || ''
      };

      const res = await fetch('/admin/backup/test-gdrive', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (data.ok) {
        alertEl.style.background = 'rgba(16,185,129,0.12)';
        alertEl.style.border = '1px solid rgba(16,185,129,0.4)';
        alertEl.style.color = '#047857';
        let folderMsg = data.folder ? ` | Folder: <b>${data.folder.name}</b> (${data.folder.canAddChildren ? 'Izin Tulis OK' : 'Hanya Baca'})` : ' | Target: <b>Root Drive</b>';
        let quotaMsg = data.storage ? ` | Kuota Digunakan: <b>${data.storage.usageMB} MB / ${data.storage.limitMB} MB (${data.storage.percent}%)</b>` : '';
        alertEl.innerHTML = `<i class="bi bi-check-circle-fill"></i> <b>Koneksi Google Drive Berhasil!</b><br>Akun: <b>${data.user}</b> (${data.email || ''})${folderMsg}${quotaMsg}`;
      } else {
        alertEl.style.background = 'rgba(239,68,68,0.12)';
        alertEl.style.border = '1px solid rgba(239,68,68,0.4)';
        alertEl.style.color = '#b91c1c';
        alertEl.innerHTML = `<i class="bi bi-x-circle-fill"></i> <b>Koneksi Gagal:</b> ${data.error || 'Tidak dapat terhubung'}`;
      }
    } catch (err) {
      if (alertEl) {
        alertEl.style.background = 'rgba(239,68,68,0.12)';
        alertEl.style.border = '1px solid rgba(239,68,68,0.4)';
        alertEl.style.color = '#b91c1c';
        alertEl.innerHTML = `<i class="bi bi-x-circle-fill"></i> <b>Error:</b> ${err.message}`;
      }
    } finally {
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  async function testGdriveConnection(btn) {
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> ...';
    try {
      const res = await fetch('/admin/backup/test-gdrive', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      const data = await res.json();
      if (data.ok) {
        alert(`KONEKSI GOOGLE DRIVE SUKSES!\n\nAkun: ${data.user} (${data.email || ''})\nFolder: ${data.folder ? data.folder.name : 'Root Drive'}\nStorage: ${data.storage ? data.storage.usageMB + ' MB / ' + data.storage.limitMB + ' MB' : '-'}`);
      } else {
        alert(`KONEKSI GOOGLE DRIVE GAGAL:\n\n${data.error || 'Periksa kembali kredensial'}`);
      }
    } catch (err) {
      alert(`Error uji koneksi: ${err.message}`);
    } finally {
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  function confirmSendGdrive(e, fileName) {
    if (!confirm(`Unggah file backup "${fileName}" ke Google Drive sekarang?`)) {
      if (e) e.preventDefault();
      return false;
    }
    return true;
  }

  const flushForm = document.getElementById('flushForm');
  if (flushForm) {
    flushForm.addEventListener('submit', function(e) {
      const confirmInput = document.getElementById('flushConfirmText');
      if (!confirmInput || confirmInput.value.trim() !== 'FLUSH DATABASE') {
        e.preventDefault();
        alert('Teks konfirmasi harus persis "FLUSH DATABASE"!');
        return false;
      }
      const clearLic = document.getElementById('clearLicenseCheck')?.checked;
      const licWarning = clearLic ? '\n- LISENSI AKAN DIKOSONGKAN (UNBOUND).' : '\n- Lisensi tetap dipertahankan.';
      if (!confirm('KONFIRMASI AKHIR:\nApakah Anda yakin 100% ingin menjalankan Factory Reset Total?' + licWarning + '\n\nAuto-backup akan dibuat secara instan.')) {
        e.preventDefault();
        return false;
      }
    });
  }

  function restoreBackup(fileName, type) {
    if (!confirm('Apakah Anda yakin ingin merestore backup ini? Data saat ini akan ditimpa.')) {
      return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/backup/restore';
    form.innerHTML = `
      <input type="hidden" name="fileName" value="${fileName}">
      <input type="hidden" name="type" value="${type}">
    `;
    document.body.appendChild(form);
    form.submit();
  }

  function deleteBackup(fileName) {
    if (!confirm('Apakah Anda yakin ingin menghapus backup ini?')) {
      return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/backup/delete';
    form.innerHTML = `
      <input type="hidden" name="fileName" value="${fileName}">
    `;
    document.body.appendChild(form);
    form.submit();
  }

  function confirmSendTelegram(e, fileName) {
    if (!confirm(`Kirim file backup "${fileName}" ke Telegram Admin sekarang?`)) {
      if (e) e.preventDefault();
      return false;
    }
    return true;
  }

  function confirmUploadSubmit(e) {
    const autoRestore = document.getElementById('uploadAutoRestore').value === 'true';
    if (autoRestore) {
      if (!confirm('PERHATIAN: Anda memilih opsi "Upload & Restore Langsung". Data saat ini akan ditimpa dengan berkas yang di-upload.\n\nLanjutkan?')) {
        if (e) e.preventDefault();
        return false;
      }
    }
    return true;
  }

  function toggleSidebar() {
    document.querySelector('.sidebar').classList.toggle('open');
  }
</script>
</body>
</html>
