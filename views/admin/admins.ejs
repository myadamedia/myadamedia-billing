<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.admins', 'Administrator') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    .role-badge {
      display: inline-block;
      padding: 2px 8px;
      font-size: 11px;
      font-weight: 600;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .role-superadmin { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
    .role-finance { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
    .role-teknisi { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .role-kolektor { background: rgba(20, 184, 166, 0.15); color: #2dd4bf; border: 1px solid rgba(20, 184, 166, 0.3); }
    .role-noc { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'admins', company }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-shield-lock"></i>
      <span><%= t('admin.nav.admins', 'Administrator') %></span>
    </div>
    <div class="tb-right">
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> 
        <%= (typeof session !== 'undefined' && session.adminRole) ? session.adminRole.toUpperCase() : 'ADMIN' %>
      </span>
      <button class="btn btn-p btn-sm" onclick="openModal('addAdminModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.admins.add', 'Tambah Admin') %></button>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'d':'s' %>"><%= msg.text %></div>
    <% } %>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-ul"></i> <%= t('admin.admins.list', 'Daftar Pengguna Administrator') %></h6>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.admins.table.name', 'Nama') %></th>
              <th><%= t('admin.admins.table.username', 'Username') %></th>
              <th><%= t('admin.admins.table.password', 'Password') %></th>
              <th><%= t('admin.admins.table.phone', 'No. HP') %></th>
              <th><%= t('admin.admins.table.role', 'Tingkatan Role') %></th>
              <th><%= t('admin.admins.table.status', 'Status') %></th>
              <th><%= t('admin.admins.table.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (admins.length === 0) { %>
              <tr><td colspan="7" class="text-center text-muted" style="padding:20px"><%= t('admin.admins.empty', 'Belum ada data admin.') %></td></tr>
            <% } else { %>
              <% admins.forEach(a => { %>
                <tr>
                  <td><strong><%= a.name %></strong></td>
                  <td><code><%= a.username %></code></td>
                  <td><span class="text-muted"><%= a.password %></span></td>
                  <td><%= a.phone || '-' %></td>
                  <td>
                    <span class="role-badge role-<%= a.role %>">
                      <%= a.role %>
                    </span>
                  </td>
                  <td>
                    <span class="badge <%= a.is_active ? 'bs' : 'bd' %>">
                      <%= a.is_active ? t('common.active', 'Aktif') : t('common.inactive', 'Nonaktif') %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-2">
                      <button class="btn btn-g btn-icon btn-sm" onclick='editAdmin(<%- JSON.stringify(a) %>)'><i class="bi bi-pencil"></i></button>
                      <form action="/admin/admins/<%= a.id %>/delete" method="POST" onsubmit="return confirm(I18N.confirmDeleteAdmin)">
                        <button type="submit" class="btn btn-d btn-icon btn-sm"><i class="bi bi-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class="mo" id="addAdminModal">
  <div class="mb">
    <form action="/admin/admins" method="POST">
      <div class="mh"><span class="mt"><%= t('admin.admins.modal.add_title', 'Tambah Admin Baru') %></span><button type="button" class="mc" onclick="closeModal('addAdminModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg"><label class="fl"><%= t('admin.admins.form.full_name', 'Nama Lengkap') %></label><input type="text" name="name" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.admins.form.login_username', 'Username Login') %></label><input type="text" name="username" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.admins.form.password', 'Password') %></label><input type="text" name="password" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.admins.form.phone', 'No. HP') %></label><input type="text" name="phone" class="fc" placeholder="Contoh: 08123456789"></div>
        <div class="fg">
          <label class="fl"><%= t('admin.admins.form.role', 'Tingkatan Role') %></label>
          <select name="role" class="fs" required>
            <option value="finance">Finance</option>
            <option value="teknisi">Teknisi</option>
            <option value="kolektor">Kolektor</option>
            <option value="noc">NOC</option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addAdminModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('common.save', 'Simpan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class="mo" id="editAdminModal">
  <div class="mb">
    <form id="editForm" method="POST">
      <div class="mh"><span class="mt"><%= t('admin.admins.modal.edit_title', 'Edit Data Admin') %></span><button type="button" class="mc" onclick="closeModal('editAdminModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg"><label class="fl"><%= t('admin.admins.form.full_name', 'Nama Lengkap') %></label><input type="text" name="name" id="e-name" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.admins.form.login_username', 'Username Login') %></label><input type="text" name="username" id="e-username" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.admins.form.password', 'Password') %></label><input type="text" name="password" id="e-password" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.admins.form.phone', 'No. HP') %></label><input type="text" name="phone" id="e-phone" class="fc"></div>
        <div class="fg">
          <label class="fl"><%= t('admin.admins.form.role', 'Tingkatan Role') %></label>
          <select name="role" id="e-role" class="fs" required>
            <option value="finance">Finance</option>
            <option value="teknisi">Teknisi</option>
            <option value="kolektor">Kolektor</option>
            <option value="noc">NOC</option>
          </select>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.admins.form.account_status', 'Status Akun') %></label>
          <select name="is_active" id="e-status" class="fs">
            <option value="1"><%= t('common.active', 'Aktif') %></option>
            <option value="0"><%= t('common.inactive', 'Nonaktif') %></option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editAdminModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('admin.admins.save_changes', 'Simpan Perubahan') %></button>
      </div>
    </form>
  </div>
</div>

<script>
const I18N = {
  confirmDeleteAdmin: "<%= t('admin.admins.confirm_delete', 'Hapus administrator ini?') %>"
};

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
function editAdmin(a) {
  document.getElementById('editForm').action = '/admin/admins/' + a.id + '/update';
  document.getElementById('e-name').value = a.name;
  document.getElementById('e-username').value = a.username;
  document.getElementById('e-password').value = a.password;
  document.getElementById('e-phone').value = a.phone || '';
  document.getElementById('e-role').value = a.role;
  document.getElementById('e-status').value = a.is_active;
  openModal('editAdminModal');
}
</script>
</body>
</html>
