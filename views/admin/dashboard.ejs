<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
  <style>
    /* ── ONU STATUS DOT ── */
    .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}
    .dot-on{background:var(--success);box-shadow:0 0 6px var(--success)}
    .dot-off{background:var(--danger)}

    /* ── PULSE ANIMATION (online) ── */
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
    .pulse{animation:pulse 2s infinite}

    /* ── MONITORING SECTION ── */
    #monitoring-section{display:none}
    #dashboard-section{display:block}

    /* ── NAV TABS ── */
    .tab-bar{display:flex;gap:4px;background:var(--bg3);padding:4px;border-radius:10px;margin-bottom:20px;width:fit-content}
    .tab-btn{padding:8px 20px;border-radius:7px;border:none;background:transparent;color:var(--muted);font-size:13px;font-weight:500;cursor:pointer;font-family:inherit;transition:all .2s}
    .tab-btn.active{background:var(--bg2);color:var(--text);box-shadow:0 2px 8px rgba(0,0,0,.3)}
    .tab-btn i{margin-right:6px}

    /* ── DEVICE STATUS BADGE ── */
    .ds-on{background:rgba(63,185,80,.15);color:#3fb950;border:1px solid rgba(63,185,80,.3)}
    .ds-off{background:rgba(248,81,73,.15);color:#f85149;border:1px solid rgba(248,81,73,.3)}

    /* ── LIVE INDICATOR ── */
    .live-dot{width:8px;height:8px;border-radius:50%;background:var(--success);display:inline-block;animation:pulse 1.5s infinite}
    .realtime-bar{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted)}

    /* ── CHART WRAPPER ── */
    #donut-wrap{position:relative;width:160px;height:160px;margin:0 auto}
    .donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
    .donut-num{font-size:28px;font-weight:700;line-height:1}
    .donut-lbl{font-size:11px;color:var(--muted);margin-top:2px}
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'dashboard', company }) %>

<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-speedometer2"></i>
      <span id="page-title"><%= t('admin.nav.dashboard', 'Dashboard') %></span>
    </div>
    <div class="tb-right">
      <div class="realtime-bar"><span class="live-dot"></span> <%= t('admin.dashboard.live_update', 'Live Update') %></div>
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> 
        <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %>
      </span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>

  <div class="page">
    <!-- HERO BANNER -->
    <div class="card mb-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); border: 1px solid rgba(99,102,241,0.5); border-radius: 20px; padding: 24px; position: relative; overflow: hidden; margin-bottom: 24px; box-shadow: 0 12px 36px rgba(79,70,229,0.25);">
      <div style="position: absolute; right: -20px; bottom: -25px; font-size: 160px; color: rgba(255,255,255,0.08); pointer-events: none;">
        <i class="bi bi-speedometer2"></i>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; position: relative; z-index: 1;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 20px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.35); color: #ffffff; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px;">
            <i class="bi bi-shield-check"></i> MONITORING & MANAJEMEN SISTEM REALTIME
          </div>
          <h2 style="font-size: 24px; font-weight: 800; color: #ffffff; margin: 0 0 6px 0; letter-spacing: -0.5px;">
            Selamat Datang, <%= (typeof session !== 'undefined' && session.isCashier) ? 'Kasir Operasional' : 'Administrator' %>!
          </h2>
          <p style="font-size: 13px; color: rgba(255,255,255,0.92); margin: 0; max-width: 650px; line-height: 1.5; font-weight: 500;">
            Pantau statistik jaringan, status ONU/OLT, penagihan pembayaran, mutasi E-Wallet, dan kelola seluruh fitur billing dalam satu dashboard terintegrasi.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/admin/customers" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #ffffff; color: #4f46e5; border: none; box-shadow: 0 6px 20px rgba(0,0,0,0.15);">
            <i class="bi bi-people-fill me-1"></i> Data Pelanggan
          </a>
          <a href="/admin/billing" class="btn btn-sm" style="border-radius: 12px; font-weight: 800; padding: 10px 18px; background: #10b981; color: #ffffff; border: none; box-shadow: 0 6px 20px rgba(16,185,129,0.4);">
            <i class="bi bi-receipt me-1"></i> Tagihan Billing
          </a>
          <a href="/admin/routers" class="btn btn-sm" style="border-radius: 12px; font-weight: 700; padding: 10px 18px; background: rgba(255,255,255,0.16); color: #ffffff; border: 1px solid rgba(255,255,255,0.35);">
            <i class="bi bi-hdd-network me-1"></i> Kelola Router
          </a>
        </div>
      </div>
    </div>

    <!-- QUICK MENU SHORTCUTS GRID -->
    <div style="margin-bottom: 24px;">
      <div style="font-size:11px; color:var(--muted); font-weight:800; text-transform:uppercase; letter-spacing:1.2px; margin-bottom:12px; display:flex; align-items:center; gap:8px;">
        <i class="bi bi-grid-fill" style="color:var(--primary); font-size:14px;"></i> PINTRASAN MENU UTAMA (QUICK ACTIONS)
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px;">
        <a href="/admin/customers" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(99,102,241,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(59,130,246,0.35);">
              <i class="bi bi-people-fill"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">Pelanggan</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">Kelola Data</div>
          </div>
        </a>

        <a href="/admin/billing" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(16,185,129,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #10b981 0%, #047857 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(16,185,129,0.35);">
              <i class="bi bi-receipt"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">Tagihan</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">Invoice & Bayar</div>
          </div>
        </a>

        <a href="/admin/mikrotik" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(99,102,241,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #6366f1 0%, #4338ca 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(99,102,241,0.35);">
              <i class="bi bi-router-fill"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">MikroTik</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">Router & Hotspot</div>
          </div>
        </a>

        <a href="/admin/map" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(139,92,246,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(139,92,246,0.35);">
              <i class="bi bi-map-fill"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">Peta Jaringan</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">ODP & ODC Map</div>
          </div>
        </a>

        <a href="/admin/acs" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(14,165,233,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(14,165,233,0.35);">
              <i class="bi bi-hdd-network-fill"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">GenieACS</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">Manajemen TR-069</div>
          </div>
        </a>

        <a href="/admin/reports" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(245,158,11,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #f59e0b 0%, #b45309 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(245,158,11,0.35);">
              <i class="bi bi-bar-chart-line-fill"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">Keuangan</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">Laporan & Kas</div>
          </div>
        </a>

        <a href="/admin/whatsapp/broadcast" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(34,197,94,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #22c55e 0%, #15803d 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(34,197,94,0.35);">
              <i class="bi bi-megaphone-fill"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">Broadcast WA</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">Pesan Masal</div>
          </div>
        </a>

        <a href="/admin/ewallet-logs" style="text-decoration:none; color:inherit;">
          <div style="background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:16px; text-align:center; transition:all 0.25s ease; box-shadow:0 6px 16px rgba(0,0,0,0.1);" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='rgba(236,72,153,0.5)';" onmouseout="this.style.transform='none';this.style.borderColor='var(--border)';">
            <div style="width:44px; height:44px; border-radius:14px; background:linear-gradient(135deg, #ec4899 0%, #be185d 100%); color:#fff; display:grid; place-items:center; margin:0 auto 10px auto; font-size:20px; box-shadow:0 6px 14px rgba(236,72,153,0.35);">
              <i class="bi bi-wallet2"></i>
            </div>
            <div style="font-weight:700; font-size:13px; color:var(--text);">Log E-Wallet</div>
            <div style="font-size:11px; color:var(--muted); margin-top:2px;">Webhook Notif</div>
          </div>
        </a>
      </div>
    </div>

    <!-- TAB NAVIGATION -->
    <div class="tab-bar">
      <button class="tab-btn active" id="tab-dash" onclick="showTab('dashboard')">
        <i class="bi bi-speedometer2"></i><%= t('admin.nav.dashboard', 'Dashboard') %>
      </button>
      <button class="tab-btn" id="tab-mon" onclick="showTab('monitoring')">
        <i class="bi bi-router"></i><%= t('admin.dashboard.monitoring_onu', 'Monitoring ONU') %>
      </button>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- DASHBOARD SECTION                                       -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div id="dashboard-section">

      <% const routerList = (typeof routers !== 'undefined' && Array.isArray(routers)) ? routers : []; %>

      <!-- ONU Stats (Moved to Top) -->
      <div style="font-size:12px;color:var(--text);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
        <i class="bi bi-router" style="color:var(--primary);font-size:16px;"></i> <%= t('admin.dashboard.onu_status_title', 'MONITORING ONU') %>
      </div>
      <div class="stat-grid" style="margin-bottom: 22px;">
        <div class="sc p">
          <i class="bi bi-router sc-icon"></i>
          <div class="sc-label"><%= t('admin.dashboard.total_onu', 'Total ONU') %></div>
          <div class="sc-val" id="stat-total"><span class="text-muted" style="font-size:16px">...</span></div>
          <div class="sc-sub"><%= t('admin.dashboard.onu_registered', 'Perangkat terdaftar') %></div>
        </div>
        <div class="sc s">
          <i class="bi bi-wifi sc-icon"></i>
          <div class="sc-label"><%= t('admin.dashboard.online', 'Online') %></div>
          <div class="sc-val" id="stat-online"><span class="text-muted" style="font-size:16px">...</span></div>
          <div class="sc-sub"><%= t('admin.dashboard.active_now', 'Aktif saat ini') %></div>
        </div>
        <div class="sc d">
          <i class="bi bi-wifi-off sc-icon"></i>
          <div class="sc-label"><%= t('admin.dashboard.offline', 'Offline') %></div>
          <div class="sc-val" id="stat-offline"><span class="text-muted" style="font-size:16px">...</span></div>
          <div class="sc-sub"><%= t('admin.dashboard.no_response', 'Tidak merespons') %></div>
        </div>
        <div class="sc w">
          <i class="bi bi-exclamation-triangle sc-icon"></i>
          <div class="sc-label"><%= t('admin.dashboard.warning', 'Warning') %></div>
          <div class="sc-val" id="stat-warning"><span class="text-muted" style="font-size:16px">...</span></div>
          <div class="sc-sub"><%= t('admin.dashboard.needs_attention', 'Perlu perhatian') %></div>
        </div>
      </div>

      <!-- Monitoring Pelanggan (Fitur Baru) -->
      <div style="font-size:12px;color:var(--text);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
        <i class="bi bi-people-fill" style="color:var(--primary);font-size:16px;"></i> Monitoring Pelanggan
      </div>
      <div class="stat-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 22px;">
        <!-- User Aktif (total pppoe aktif) -->
        <div class="sc p" style="cursor:pointer" onclick="location.href='/admin/customers?status=active'">
          <i class="bi bi-ethernet sc-icon"></i>
          <div class="sc-label">User Aktif</div>
          <div class="sc-val" id="stat-pppoe-active"><span class="text-muted" style="font-size:16px">...</span></div>
          <div class="sc-sub">Total PPPoE Active / Online</div>
        </div>

        <!-- User Suspend (total user dengan Profil suspend) -->
        <div class="sc w" style="cursor:pointer" onclick="location.href='/admin/customers?status=suspended'">
          <i class="bi bi-person-x-fill sc-icon"></i>
          <div class="sc-label">User Suspend</div>
          <div class="sc-val" id="stat-pppoe-suspended"><span class="text-muted" style="font-size:16px">...</span></div>
          <div class="sc-sub">Total Profil Suspend / Terisolir</div>
        </div>

        <!-- User Offline (pppoe offline) -->
        <div class="sc d" style="cursor:pointer" onclick="location.href='/admin/customers'">
          <i class="bi bi-plug-fill sc-icon"></i>
          <div class="sc-label">User Offline</div>
          <div class="sc-val" id="stat-pppoe-offline"><span class="text-muted" style="font-size:16px">...</span></div>
          <div class="sc-sub">PPPoE Offline / Terputus</div>
        </div>
      </div>

      <!-- Daftar Router MikroTik Table Card -->
      <div class="card" style="margin-bottom: 22px;">
        <div class="card-hd" style="display:flex; justify-content:space-between; align-items:center;">
          <h6><i class="bi bi-hdd-network"></i> <%= t('admin.dashboard.router_list_title', 'Daftar Router MikroTik') %> (<%= routerList.length %>)</h6>
          <a href="/admin/routers" class="btn btn-g btn-sm"><i class="bi bi-gear"></i> Kelola Router</a>
        </div>
        <div class="card-bd" style="padding:0">
          <% if (routerList.length === 0) { %>
            <div style="padding: 20px; text-align: center; color: var(--muted);">
              <i class="bi bi-info-circle" style="font-size: 24px;"></i>
              <p style="margin-top: 8px; font-size: 13px;">Belum ada router MikroTik yang terdaftar di sistem.</p>
              <a href="/admin/routers" class="btn btn-p btn-sm" style="margin-top: 8px;"><i class="bi bi-plus-lg"></i> Tambah Router</a>
            </div>
          <% } else { %>
            <div style="overflow-x:auto;">
              <table class="tbl" style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                  <tr style="border-bottom:1px solid var(--border); text-align:left; background:var(--bg2);">
                    <th style="padding:12px 16px; width:38%;">Nama Router</th>
                    <th style="padding:12px 16px; width:62%;">Detail & Monitoring Interface</th>
                  </tr>
                </thead>
                <tbody>
                  <% routerList.forEach(r => { %>
                    <tr style="border-bottom:1px solid var(--border); vertical-align:top;">
                      <!-- Kolom 1: Nama Router -->
                      <td style="padding:14px 16px;">
                        <div style="font-weight:700; font-size:14px; color:var(--text); display:flex; align-items:center; gap:8px;">
                          <i class="bi bi-hdd-network" style="color:var(--primary); font-size:18px;"></i>
                          <%= r.name %>
                        </div>
                        <div style="margin-top:6px; font-size:12px; color:var(--muted); display:flex; flex-direction:column; gap:4px;">
                          <div><i class="bi bi-hdd-stack" style="margin-right:4px;"></i> Host: <code><%= r.host %>:<%= r.port || 8728 %></code></div>
                          <div><i class="bi bi-person-lock" style="margin-right:4px;"></i> User: <code><%= r.user %></code></div>
                          <% if (r.description) { %>
                            <div><i class="bi bi-info-circle" style="margin-right:4px;"></i> <%= r.description %></div>
                          <% } %>
                        </div>
                        <div style="margin-top:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                          <% if (r.is_active) { %>
                            <span class="badge bg-s" style="padding:3px 8px; border-radius:4px; font-size:11px; background:rgba(16,185,129,0.15); color:var(--success); font-weight:600;"><i class="bi bi-check-circle"></i> Status Aktif</span>
                          <% } else { %>
                            <span class="badge bg-d" style="padding:3px 8px; border-radius:4px; font-size:11px; background:rgba(239,68,68,0.15); color:var(--danger); font-weight:600;"><i class="bi bi-dash-circle"></i> Status Nonaktif</span>
                          <% } %>
                          <button type="button" class="btn btn-g btn-sm" style="padding:2px 8px; font-size:11px;" onclick="testRouterConnDashboard(<%= r.id %>, this)">
                            <i class="bi bi-arrow-repeat"></i> Tes Koneksi
                          </button>
