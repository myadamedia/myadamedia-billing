          <div style="padding:14px 18px;border-bottom:1px solid var(--border);font-weight:700;color:var(--muted)"><i class="bi bi-info-circle"></i> Device Info</div>
          <div style="display:flex;justify-content:space-between;padding:8px 18px;border-bottom:1px solid rgba(51,65,85,.10)"><span style="color:var(--muted)">Tag / Pelanggan</span><span style="font-weight:800">${d.customerName && d.customerName !== '-' ? d.customerName + ' (' + (d.phone || d.customerTag || '-') + ')' : (d.phone || '-')}</span></div>
