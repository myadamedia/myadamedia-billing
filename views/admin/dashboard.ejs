async function testRouterConnDashboard(id, btn) {
  const badge = document.getElementById('badge-router-' + id);
  const origText = btn ? btn.innerHTML : '';
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menguji...';
  }
  if (badge) {
    badge.style.background = 'rgba(59,130,246,0.15)';
    badge.style.color = 'var(--info)';
    badge.innerHTML = '<i class="bi bi-hourglass-split spin"></i> Menghubungkan...';
  }

  try {
    const res = await fetch('/admin/api/routers/' + id + '/test');
    const d = await res.json();
    if (d.success) {
      if (badge) {
        badge.style.background = 'rgba(16,185,129,0.15)';
        badge.style.color = 'var(--success)';
        badge.innerHTML = '<i class="bi bi-wifi"></i> Connected';
      }
      if (typeof showToast === 'function') showToast(d.message || 'Koneksi Router Berhasil', 's');
    } else {
      if (badge) {
        badge.style.background = 'rgba(239,68,68,0.15)';
        badge.style.color = 'var(--danger)';
        badge.innerHTML = '<i class="bi bi-wifi-off"></i> Connection Error';
      }
      if (typeof showToast === 'function') showToast(d.error || 'Gagal terhubung ke router', 'd');
    }
  } catch (err) {
    if (badge) {
      badge.style.background = 'rgba(239,68,68,0.15)';
      badge.style.color = 'var(--danger)';
      badge.innerHTML = '<i class="bi bi-wifi-off"></i> Connection Failed';
    }
    if (typeof showToast === 'function') showToast('Error: ' + err.message, 'd');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = origText;
    }
  }
}

// ─── DASHBOARD MIKROTIK DROPDOWN INTERFACE MONITORING ───────────────────────
const dashIfaceDataMap = {};
const dashIfacePollMap = {};

document.addEventListener('DOMContentLoaded', () => {
  const routerSelects = document.querySelectorAll('[id^="dash-iface-select-"]');
  routerSelects.forEach(select => {
    const routerId = select.id.replace('dash-iface-select-', '');
    if (routerId) {
      loadDashRouterInterfaces(routerId);
    }
  });
});

async function loadDashRouterInterfaces(routerId, force = false) {
  const select = document.getElementById('dash-iface-select-' + routerId);
  if (!select) return;

  select.innerHTML = '<option value="">⏳ Memuat daftar interface...</option>';
  select.disabled = true;

  try {
    const res = await fetch('/admin/api/routers/' + routerId + '/interfaces');
    const d = await res.json();
    if (d.success && Array.isArray(d.interfaces)) {
      dashIfaceDataMap[routerId] = d.interfaces;
      select.innerHTML = '<option value="">-- Pilih Interface MikroTik untuk Monitoring --</option>';
      d.interfaces.forEach(iface => {
        const opt = document.createElement('option');
        opt.value = iface.name;
        const statusIcon = iface.disabled ? '🔴' : (iface.running ? '🟢' : '🟡');
        opt.textContent = `${statusIcon} ${iface.name} (${iface.type || 'ether'}) ${iface.comment ? '- ' + iface.comment : ''}`;
        select.appendChild(opt);
      });
      if (force && typeof showToast === 'function') {
        showToast('Daftar interface berhasil dimuat (' + d.interfaces.length + ' interface)', 's');
      }
    } else {
      select.innerHTML = '<option value="">❌ Gagal memuat interface (' + (d.error || 'Offline') + ')</option>';
    }
  } catch (err) {
    select.innerHTML = '<option value="">❌ Gagal terhubung ke router</option>';
  } finally {
    select.disabled = false;
  }
}

function onDashIfaceChange(routerId, ifaceName) {
  const panel = document.getElementById('dash-iface-panel-' + routerId);
  if (!panel) return;

  if (dashIfacePollMap[routerId]) {
    clearInterval(dashIfacePollMap[routerId]);
    delete dashIfacePollMap[routerId];
  }

  if (!ifaceName) {
    panel.style.display = 'none';
    panel.innerHTML = '';
    return;
  }

  const interfaces = dashIfaceDataMap[routerId] || [];
  const iface = interfaces.find(i => i.name === ifaceName);
  const statusBadge = iface ? (iface.disabled ? 
    '<span style="color:var(--danger); font-weight:700;"><i class="bi bi-dash-circle"></i> Disabled</span>' : 
    (iface.running ? 
      '<span style="color:var(--success); font-weight:700;"><i class="bi bi-check-circle-fill"></i> Running (Active)</span>' : 
      '<span style="color:var(--warning); font-weight:700;"><i class="bi bi-exclamation-circle"></i> Link Down</span>'
    )
  ) : '-';

  panel.style.display = 'block';
  panel.innerHTML = `
    <div style="display:flex; justify-space-between; align-items:center; margin-bottom:8px; border-bottom:1px solid var(--border); padding-bottom:6px;">
      <div style="font-weight:700; font-size:13px; color:var(--text); display:flex; align-items:center; gap:6px;">
        <i class="bi bi-ethernet" style="color:var(--primary);"></i> ${escapeHtmlDash(ifaceName)}
      </div>
      <div>${statusBadge}</div>
    </div>

    <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:8px; margin-bottom:10px;">
      <div><span style="color:var(--muted);">Tipe:</span> <b style="color:var(--text);">${iface ? escapeHtmlDash(iface.type) : '-'}</b></div>
      <div><span style="color:var(--muted);">MAC Address:</span> <code>${iface ? escapeHtmlDash(iface.macAddress) : '-'}</code></div>
      <div><span style="color:var(--muted);">MTU:</span> <b style="color:var(--text);">${iface ? escapeHtmlDash(iface.mtu) : '-'}</b></div>
      <div><span style="color:var(--muted);">Comment:</span> <b style="color:var(--text);">${iface && iface.comment ? escapeHtmlDash(iface.comment) : '-'}</b></div>
    </div>

    <div style="background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:8px 12px;">
      <div style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; margin-bottom:6px; display:flex; justify-content:space-between;">
        <span><i class="bi bi-speedometer2"></i> Live Bandwidth Monitoring</span>
        <span id="dash-traffic-live-indicator-${routerId}" style="color:var(--success); font-size:10px;"><i class="bi bi-broadcast spin"></i> Live</span>
      </div>
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; text-align:center;">
        <div style="background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.2); border-radius:6px; padding:6px;">
          <div style="font-size:10px; color:var(--success); font-weight:700;">DOWNLOAD (RX SPEED)</div>
          <div style="font-size:16px; font-weight:800; color:var(--success);" id="dash-rx-speed-${routerId}">0 Bps</div>
          <div style="font-size:10px; color:var(--muted);" id="dash-rx-total-${routerId}">Total: ${iface ? escapeHtmlDash(iface.rxBytesFormatted) : '0 B'}</div>
        </div>
        <div style="background:rgba(59,130,246,0.1); border:1px solid rgba(59,130,246,0.2); border-radius:6px; padding:6px;">
          <div style="font-size:10px; color:var(--info); font-weight:700;">UPLOAD (TX SPEED)</div>
          <div style="font-size:16px; font-weight:800; color:var(--info);" id="dash-tx-speed-${routerId}">0 Bps</div>
          <div style="font-size:10px; color:var(--muted);" id="dash-tx-total-${routerId}">Total: ${iface ? escapeHtmlDash(iface.txBytesFormatted) : '0 B'}</div>
        </div>
      </div>
    </div>
  `;

  fetchDashIfaceTraffic(routerId, ifaceName);
  dashIfacePollMap[routerId] = setInterval(() => {
    fetchDashIfaceTraffic(routerId, ifaceName);
  }, 2500);
}

async function fetchDashIfaceTraffic(routerId, ifaceName) {
  try {
    const res = await fetch(`/admin/api/routers/${routerId}/interfaces/${encodeURIComponent(ifaceName)}/traffic`);
    const d = await res.json();
    if (d.success && d.traffic) {
      const rxEl = document.getElementById('dash-rx-speed-' + routerId);
      const txEl = document.getElementById('dash-tx-speed-' + routerId);
      const liveEl = document.getElementById('dash-traffic-live-indicator-' + routerId);

      const rx = Number(d.traffic.rxBitsPerSecond ?? d.traffic['rx-bits-per-second'] ?? d.traffic.rx ?? 0);
      const tx = Number(d.traffic.txBitsPerSecond ?? d.traffic['tx-bits-per-second'] ?? d.traffic.tx ?? 0);

      if (rxEl) rxEl.textContent = formatBitsPerSecDash(rx);
      if (txEl) txEl.textContent = formatBitsPerSecDash(tx);
      if (liveEl) liveEl.style.opacity = liveEl.style.opacity === '0.4' ? '1' : '0.4';
    }
  } catch (e) {
    console.error('Error fetching traffic:', e);
  }
}

function formatBitsPerSecDash(bits) {
  if (!bits || isNaN(bits) || bits <= 0) return '0 Bps';
  const k = 1000;
  const sizes = ['Bps', 'Kbps', 'Mbps', 'Gbps'];
  const i = Math.floor(Math.log(bits) / Math.log(k));
  return parseFloat((bits / Math.pow(k, i)).toFixed(2)) + ' ' + (sizes[i] || 'Bps');
}

function escapeHtmlDash(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

