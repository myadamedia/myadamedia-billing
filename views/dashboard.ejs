<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang ? lang : 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof t === 'function' ? t('customer.dashboard_title', 'Dashboard Pelanggan') : 'Dashboard Pelanggan' %> | Portal ISP</title>
  
  <!-- CSS Dependencies -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0b0f19">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --bg-dark: #0b0f19;
      --card-bg: rgba(17, 24, 39, 0.85);
      --card-border: rgba(255, 255, 255, 0.12);
      --card-hover-border: rgba(99, 102, 241, 0.4);
      --primary-accent: #6366f1;
      --primary-glow: rgba(99, 102, 241, 0.35);
      --success-accent: #10b981;
      --warning-accent: #f59e0b;
      --danger-accent: #ef4444;
      --text-main: #f8fafc;
      --text-sub: #cbd5e1;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.15) 0%, transparent 45%),
        radial-gradient(circle at 85% 25%, rgba(16, 185, 129, 0.10) 0%, transparent 45%),
        radial-gradient(circle at 50% 80%, rgba(139, 92, 246, 0.12) 0%, transparent 50%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      padding-bottom: 95px;
    }

    /* Force high contrast for all text & Bootstrap overrides */
    .text-muted {
      color: var(--text-muted) !important;
    }
    .text-sub {
      color: var(--text-sub) !important;
    }
    .text-main {
      color: var(--text-main) !important;
    }

    /* Navbar Glassmorphism */
    .portal-nav {
      background: rgba(11, 15, 25, 0.90);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid var(--card-border);
      position: sticky;
      top: 0;
      z-index: 1040;
    }

    .brand-logo-img {
      height: 38px;
      width: auto;
      border-radius: 8px;
    }

    /* Glass Cards */
    .glass-card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }
    
    .glass-card:hover {
      border-color: var(--card-hover-border);
      box-shadow: 0 15px 35px rgba(99, 102, 241, 0.15);
    }

    /* Pill Badges */
    .pill-badge {
      padding: 5px 12px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .pill-active { background: rgba(16, 185, 129, 0.20); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
    .pill-suspended { background: rgba(239, 68, 68, 0.20); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }
    .pill-online { background: rgba(59, 130, 246, 0.20); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }

    /* Interactive Action Buttons */
    .btn-action-glow {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #fff !important;
      font-weight: 700;
      border-radius: 12px;
      padding: 10px 20px;
      border: none;
      box-shadow: 0 4px 15px var(--primary-glow);
      transition: all 0.25s ease;
    }
    .btn-action-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(99, 102, 241, 0.5);
      color: #fff !important;
    }

    .btn-self-service {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: var(--text-main) !important;
      border-radius: 14px;
      padding: 14px;
      text-align: center;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      width: 100%;
    }
    .btn-self-service:hover {
      background: rgba(99, 102, 241, 0.18);
      border-color: rgba(99, 102, 241, 0.5);
      transform: translateY(-3px);
      color: #fff !important;
    }
    .btn-self-service i {
      font-size: 24px;
    }

    /* Live Traffic Gauge Styles */
    .gauge-wrapper {
      position: relative;
      width: 100%;
      height: 130px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .gauge-canvas {
      display: block;
      width: 100%;
      height: 130px;
    }
    .gauge-center-info {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -40%);
      text-align: center;
      pointer-events: none;
    }
    .gauge-val-num {
      font-size: 26px;
      font-weight: 800;
      color: #ffffff !important;
      line-height: 1;
      letter-spacing: -0.5px;
    }
    .gauge-unit-label {
      font-size: 11px;
      font-weight: 700;
      color: #cbd5e1 !important;
      margin-top: 3px;
      text-transform: uppercase;
    }

    /* Navigation Floating Bar for Mobile */
    .bottom-nav-bar {
      position: fixed;
      bottom: 15px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 30px);
      max-width: 500px;
      background: rgba(17, 24, 39, 0.95);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 40px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 1050;
      box-shadow: 0 15px 35px rgba(0,0,0,0.6);
    }

    .nav-item-btn {
      color: #cbd5e1 !important;
      text-decoration: none;
      font-size: 11px;
      font-weight: 600;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      padding: 6px 10px;
      border-radius: 20px;
      transition: all 0.2s ease;
      min-width: 60px;
    }
    .nav-item-btn i {
      font-size: 19px;
      color: #cbd5e1;
      display: inline-block;
    }
    .nav-item-btn.active, .nav-item-btn:hover {
      color: #ffffff !important;
      background: rgba(99, 102, 241, 0.25);
    }
    .nav-item-btn.active i, .nav-item-btn:hover i {
      color: #818cf8;
    }

    /* Table Custom */
    .table-dark-custom {
      --bs-table-bg: transparent;
      color: var(--text-main);
    }
    .table-dark-custom th {
      color: #cbd5e1 !important;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--card-border);
    }
    .table-dark-custom td {
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      vertical-align: middle;
      font-size: 13px;
    }

    /* Modal Dark Theme */
    .modal-content-dark {
      background: #111827;
      border: 1px solid var(--card-border);
      border-radius: 20px;
      color: var(--text-main);
    }
  </style>
</head>

<body>

  <!-- Top Navbar -->
  <nav class="navbar portal-nav">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/customer/dashboard">
        <img src="/img/logo.png" alt="Logo" class="brand-logo-img" onerror="this.style.display='none'">
        <span class="fw-bold text-white fs-5"><%= (settings && settings.company_header) ? settings.company_header : 'ISP Portal' %></span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <% if (profile) { %>
          <span class="pill-badge <%= profile.status === 'active' ? 'pill-active' : 'pill-suspended' %> d-none d-sm-inline-flex">
            <i class="bi bi-shield-check"></i> <%= profile.status === 'active' ? 'AKTIF' : 'ISOLIR' %>
          </span>
        <% } %>

        <form method="POST" action="/customer/logout" class="m-0">
          <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 text-white" title="Keluar">
            <i class="bi bi-box-arrow-right me-1"></i> <span class="d-none d-sm-inline">Keluar</span>
          </button>
        </form>
      </div>
    </div>
  </nav>

  <div class="container mt-4">

    <!-- Flash Alert Notification -->
    <% if (typeof notif !== 'undefined' && notif) { %>
      <div class="alert alert-<%= notif.type === 'success' ? 'success' : (notif.type === 'warning' ? 'warning' : 'danger') %> glass-card border-0 mb-4 p-3 d-flex align-items-center justify-content-between" style="background: rgba(99, 102, 241, 0.2); color: #fff;">
        <div>
          <i class="bi bi-info-circle-fill me-2 text-primary"></i>
          <%- notif.message || notif.text %>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- HERO BANNER -->
    <div class="glass-card p-4 mb-4" style="background: linear-gradient(135deg, rgba(99,102,241,0.22) 0%, rgba(17,24,39,0.85) 100%);">
      <div class="row align-items-center g-3">
        <div class="col-12 col-md-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="pill-badge pill-online"><i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i> ONLINE</span>
            <span class="text-sub small">| IP: <strong class="text-white"><%= customer.pppoeIP || customer.ip || '-' %></strong></span>
          </div>
          <h2 class="fw-bold mb-1 text-white">Halo, <%= profile ? profile.name : (customer.phone || 'Pelanggan') %>!</h2>
          <p class="text-sub mb-0">ID Pelanggan: <strong class="text-white">MDE-<%= profile ? String(profile.id).padStart(4, '0') : '0000' %></strong> | Paket: <span class="text-primary fw-bold"><%= customer.package_name || (profile ? profile.package_name : 'Internet Fiber') %></span></p>
        </div>

        <div class="col-12 col-md-5 text-md-end">
          <%
            const unpaidList = (typeof invoices !== 'undefined' && invoices) ? invoices.filter(i => String(i.status).toLowerCase() !== 'paid') : [];
            const hasUnpaid = unpaidList.length > 0;
            const totalUnpaidAmount = unpaidList.reduce((sum, i) => sum + (Number(i.amount) || 0), 0);
          %>
          
          <% if (hasUnpaid) { %>
            <div class="p-3 rounded-4 mb-2" style="background: rgba(239,68,68,0.2); border: 1px solid rgba(239,68,68,0.4);">
              <div class="text-danger small font-monospace fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> TAGIHAN BELUM DIBAYAR</div>
              <div class="fs-4 fw-extrabold text-white">Rp <%= totalUnpaidAmount.toLocaleString('id-ID') %></div>
              <div class="small text-sub mb-2">(<%= unpaidList.length %> Tagihan PENDING)</div>
              <button class="btn btn-action-glow btn-sm w-100" data-bs-toggle="modal" data-bs-target="#payModal">
                <i class="bi bi-credit-card-fill me-1"></i> Bayar Sekarang
              </button>
            </div>
          <% } else { %>
            <div class="p-3 rounded-4" style="background: rgba(16,185,129,0.18); border: 1px solid rgba(16,185,129,0.4);">
              <div class="text-success small fw-bold"><i class="bi bi-check-circle-fill me-1"></i> STATUS TAGIHAN LUNAS</div>
              <div class="small text-sub mt-1">Layanan Anda berjalan lancar tanpa kendala tunggakan.</div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- MAIN DASHBOARD TABS CONTENT -->
    <div class="row g-4 mb-4">
      
      <!-- LEFT COLUMN: SPEED GAUGES & SIGNAL METRICS -->
      <div class="col-12 col-lg-7">
        <div class="glass-card p-4 h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-white"><i class="bi bi-speedometer2 text-primary me-2"></i> Pengukur Kecepatan (Live)</h5>
            <span class="badge bg-dark border border-secondary text-sub">Refresh 3s</span>
          </div>

          <div class="row g-3 text-center my-2">
            <!-- DOWNLOAD GAUGE -->
            <div class="col-6">
              <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--card-border);">
                <div class="fw-bold small mb-2" style="color: #34d399;"><i class="bi bi-arrow-down-circle-fill me-1"></i> Download</div>
                <div class="gauge-wrapper">
                  <canvas id="pppoe_rx_gauge" class="gauge-canvas" data-max="<%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %>"></canvas>
                  <div class="gauge-center-info">
                    <div class="gauge-val-num" id="pppoe_rx_value">0.0</div>
                    <div class="gauge-unit-label" id="pppoe_rx_unit">Mbps</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- UPLOAD GAUGE -->
            <div class="col-6">
              <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--card-border);">
                <div class="fw-bold small mb-2" style="color: #38bdf8;"><i class="bi bi-arrow-up-circle-fill me-1"></i> Upload</div>
                <div class="gauge-wrapper">
                  <canvas id="pppoe_tx_gauge" class="gauge-canvas" data-max="<%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %>"></canvas>
                  <div class="gauge-center-info">
                    <div class="gauge-val-num" id="pppoe_tx_value">0.0</div>
                    <div class="gauge-unit-label" id="pppoe_tx_unit">Mbps</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SIGNAL METRICS ROW -->
          <div class="row g-3 mt-2">
            <div class="col-6">
              <div class="p-3 rounded-4 d-flex align-items-center gap-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--card-border);">
                <div class="fs-3 text-warning"><i class="bi bi-activity"></i></div>
                <div>
                  <div class="fw-semibold small" style="color: #fbbf24;">Sinyal Optik (RX)</div>
                  <div class="fw-bold fs-6 text-white"><%= customer.rxPower || '-21.50' %> dBm</div>
                </div>
              </div>
            </div>

            <div class="col-6">
              <div class="p-3 rounded-4 d-flex align-items-center gap-3" style="background: rgba(255,255,255,0.04); border: 1px solid var(--card-border);">
                <div class="fs-3 text-info"><i class="bi bi-laptop"></i></div>
                <div>
                  <div class="fw-semibold small" style="color: #818cf8;">Perangkat Terhubung</div>
                  <div class="fw-bold fs-6 text-white"><%= (typeof connectedUsers !== 'undefined' && connectedUsers) ? connectedUsers.length : (customer.totalAssociations || 0) %> Perangkat</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: SELF-SERVICE TROUBLESHOOT & WI-FI QUICK TOOLS -->
      <div class="col-12 col-lg-5">
        <div class="glass-card p-4 h-100">
          <h5 class="fw-bold mb-3 text-white"><i class="bi bi-tools text-warning me-2"></i> Fitur Mandiri & Router</h5>
          
          <div class="row g-3">
            <div class="col-6">
              <a href="#wifi-modal" class="btn-self-service" data-bs-toggle="modal" data-bs-target="#wifiModal">
                <i class="bi bi-wifi text-primary"></i>
                <span class="fw-bold small text-white">Ganti Wi-Fi</span>
                <span class="text-sub" style="font-size: 10px;">Nama & Password</span>
              </a>
            </div>

            <div class="col-6">
              <button type="button" class="btn-self-service" data-bs-toggle="modal" data-bs-target="#rebootModal">
                <i class="bi bi-arrow-repeat text-danger"></i>
                <span class="fw-bold small text-white">Reboot Router</span>
                <span class="text-sub" style="font-size: 10px;">Restart Perangkat</span>
              </button>
            </div>

            <div class="col-6">
              <button type="button" class="btn-self-service" data-bs-toggle="modal" data-bs-target="#ticketModal">
                <i class="bi bi-headset text-success"></i>
                <span class="fw-bold small text-white">Lapor Gangguan</span>
                <span class="text-sub" style="font-size: 10px;">Buka Tiket CS</span>
              </button>
            </div>

            <div class="col-6">
              <button type="button" class="btn-self-service" onclick="runDiagnosticTest()">
                <i class="bi bi-lightning-charge-fill text-warning"></i>
                <span class="fw-bold small text-white">Cek Koneksi</span>
                <span class="text-sub" style="font-size: 10px;">Tes Latensi Live</span>
              </button>
            </div>
          </div>

          <!-- DIAGNOSTIC RESULT BOX -->
          <div id="diagnosticBox" class="mt-3 p-3 rounded-4 d-none" style="background: rgba(15, 23, 42, 0.95); border: 1px solid var(--card-border);">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="fw-bold small text-white"><i class="bi bi-shield-check me-1 text-success"></i> Hasil Diagnostik:</span>
              <span id="diagStatus" class="badge bg-success">NORMAL</span>
            </div>
            <div class="small text-sub" id="diagDetails">Sinyal optik & jalur routing ONT berfungsi dengan baik.</div>
          </div>
        </div>
      </div>

    </div>

    <!-- CONNECTED CLIENTS & BILLING HISTORY SECTION -->
    <div class="row g-4 mb-4">
      
      <!-- CONNECTED DEVICES TABLE -->
      <div class="col-12 col-lg-6" id="devices-section">
        <div class="glass-card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-white"><i class="bi bi-router text-info me-2"></i> Perangkat Terhubung (Live)</h5>
            <span class="badge bg-primary rounded-pill"><%= (typeof connectedUsers !== 'undefined' && connectedUsers) ? connectedUsers.length : 0 %> Active</span>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom">
              <thead>
                <tr>
                  <th>Host / Perangkat</th>
                  <th>IP & MAC</th>
                  <th>Status</th>
                  <th class="text-end">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof connectedUsers !== 'undefined' && connectedUsers && connectedUsers.length > 0) { %>
                  <% connectedUsers.forEach(function(dev) {
                      const iface = String(dev.iface || '');
                      const isWiFi = iface.toLowerCase().includes('wifi') || iface.toLowerCase().includes('wlan') || iface.toLowerCase().includes('802.11');
                      const isDevOnline = String(dev.status || '').toLowerCase() === 'online' || String(dev.status || '').toLowerCase() === 'active' || String(dev.status || '') === '1' || dev.active === true;
                  %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background: rgba(99,102,241,0.2); color: var(--primary-accent); width: 34px; height: 34px;">
                            <i class="bi bi-<%= isWiFi ? 'wifi' : 'ethernet' %> fs-5"></i>
                          </div>
                          <div>
                            <div class="fw-bold text-white"><%= dev.hostname || 'Device' %></div>
                            <div class="small text-sub"><%= iface || 'LAN/WLAN' %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="small text-white fw-semibold"><%= dev.ip || '-' %></div>
                        <div class="small text-sub font-monospace" style="font-size: 10px;"><%= dev.mac || '-' %></div>
                      </td>
                      <td>
                        <span class="pill-badge <%= isDevOnline ? 'pill-active' : 'pill-suspended' %>" style="font-size: 9px;">
                          <%= isDevOnline ? 'ONLINE' : 'OFFLINE' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <button class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 28px; height: 28px; line-height: 1;" onclick="deleteCustomerConnectedClient('<%= dev.mac || '' %>', '<%= dev.ip || '' %>', '<%= dev.hostname || 'Perangkat' %>')" title="Hapus Perangkat Terhubung">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-sub">
                      <i class="bi bi-info-circle fs-4 d-block mb-1"></i>
                      Tidak ada perangkat LAN/Wi-Fi yang terdeteksi aktif.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- INVOICE BILLING HISTORY TABLE -->
      <div class="col-12 col-lg-6" id="billing-section">
        <div class="glass-card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-white"><i class="bi bi-receipt text-warning me-2"></i> Riwayat Tagihan</h5>
            <% if (hasUnpaid) { %>
              <button class="btn btn-sm btn-danger rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#payModal">Bayar Tagihan</button>
            <% } %>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom">
              <thead>
                <tr>
                  <th>Periode</th>
                  <th>Nominal</th>
                  <th>Status</th>
                  <th class="text-end">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <%
                  const monthNamesIndo = ['', 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
                %>
                <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
                  <% invoices.forEach(function(inv) {
                      const isInvPaid = String(inv.status).toLowerCase() === 'paid';
                  %>
                    <tr>
                      <td>
                        <div class="fw-bold text-white"><%= monthNamesIndo[inv.period_month] || inv.period_month %> <%= inv.period_year %></div>
                        <div class="small text-sub font-monospace" style="font-size: 10px;">#INV-<%= inv.id %></div>
                      </td>
                      <td>
                        <div class="fw-bold text-white">Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %></div>
                      </td>
                      <td>
                        <span class="pill-badge <%= isInvPaid ? 'pill-active' : 'pill-suspended' %>" style="font-size: 9px;">
                          <%= isInvPaid ? 'LUNAS' : 'PENDING' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <% if (isInvPaid) { %>
                          <a href="/customer/billing/<%= inv.id %>/print" target="_blank" class="btn btn-sm btn-outline-light rounded-circle text-white" title="Cetak Struk/Invoice">
                            <i class="bi bi-printer"></i>
                          </a>
                        <% } else { %>
                          <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#payModal" onclick="selectPayInvoice('<%= inv.id %>')">Bayar</button>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-sub">
                      Belum ada catatan tagihan untuk akun Anda.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>

  </div> <!-- End Container -->

  <!-- FLOATING NAVIGATION BAR FOR MOBILE -->
  <div class="bottom-nav-bar">
    <a href="/customer/dashboard" class="nav-item-btn active">
      <i class="bi bi-house-door-fill"></i>
      <span>Beranda</span>
    </a>
    <a href="#billing-section" class="nav-item-btn" onclick="scrollToSection('billing-section'); return false;">
      <i class="bi bi-receipt"></i>
      <span>Tagihan</span>
    </a>
    <a href="#wifiModal" data-bs-toggle="modal" data-bs-target="#wifiModal" class="nav-item-btn">
      <i class="bi bi-wifi"></i>
      <span>Wi-Fi</span>
    </a>
    <a href="#devices-section" class="nav-item-btn" onclick="scrollToSection('devices-section'); return false;">
      <i class="bi bi-router"></i>
      <span>Perangkat</span>
    </a>
    <a href="#ticketModal" data-bs-toggle="modal" data-bs-target="#ticketModal" class="nav-item-btn">
      <i class="bi bi-headset"></i>
      <span>Bantuan</span>
    </a>
  </div>

  <!-- MODAL: GANTI SSID & PASSWORD WI-FI -->
  <div class="modal fade" id="wifiModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-white"><i class="bi bi-wifi text-primary me-2"></i> Pengaturan Wi-Fi Mandiri</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <form method="POST" action="/customer/change-ssid" class="mb-4">
            <label class="form-label text-sub small fw-semibold">Nama Wi-Fi (SSID) Baru</label>
            <div class="input-group mb-2">
              <input type="text" class="form-control bg-dark border-secondary text-white rounded-start-3" name="ssid" value="<%= customer.ssid && customer.ssid !== '-' ? customer.ssid : '' %>" placeholder="Masukkan SSID Wi-Fi baru" required maxlength="32">
              <button class="btn btn-primary" type="submit">Simpan SSID</button>
            </div>
            <div class="form-text text-sub" style="font-size: 11px;">Perubahan SSID akan memutus koneksi sementara sampai Anda menyambungkan kembali HP ke nama Wi-Fi baru.</div>
          </form>

          <hr class="border-secondary opacity-25">

          <form method="POST" action="/customer/change-password">
            <label class="form-label text-sub small fw-semibold">Password Wi-Fi Baru</label>
            <div class="input-group mb-2">
              <input type="password" id="wifiPassInput" class="form-control bg-dark border-secondary text-white rounded-start-3" name="password" placeholder="Minimal 8 karakter" required minlength="8" maxlength="32">
              <button type="button" class="btn btn-outline-secondary text-white" onclick="togglePassVisibility()"><i class="bi bi-eye" id="passEyeIcon"></i></button>
              <button class="btn btn-success" type="submit">Simpan Password</button>
            </div>
            <div class="form-text text-sub" style="font-size: 11px;">Gunakan minimal 8 karakter kombinasi huruf & angka.</div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: REBOOT ROUTER -->
  <div class="modal fade" id="rebootModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark text-center p-4">
        <div class="fs-1 text-danger mb-2"><i class="bi bi-arrow-repeat"></i></div>
        <h4 class="fw-bold text-white">Reboot Router Wi-Fi?</h4>
        <p class="text-sub small">Perangkat ONT/ONU Anda akan dinyalakan ulang (*restart*). Koneksi internet akan terputus sekitar 1-2 menit hingga router menyala kembali secara sempurna.</p>
        <div class="d-flex gap-2 justify-content-center mt-3">
          <button type="button" class="btn btn-outline-secondary px-4 rounded-pill text-white" data-bs-dismiss="modal">Batal</button>
          <form method="POST" action="/customer/reboot" class="m-0">
            <button type="submit" class="btn btn-danger px-4 rounded-pill fw-bold">Ya, Reboot Sekarang</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: PEMBAYARAN TAGIHAN -->
  <div class="modal fade" id="payModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-white"><i class="bi bi-wallet2 text-success me-2"></i> Pembayaran Tagihan</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="p-3 rounded-4 mb-3" style="background: rgba(99,102,241,0.18); border: 1px solid rgba(99,102,241,0.4);">
            <div class="text-sub small">Total Tagihan Yang Harus Dibayar</div>
            <div class="fs-3 fw-bold text-white">Rp <%= totalUnpaidAmount.toLocaleString('id-ID') %></div>
          </div>

          <form method="POST" action="/customer/payment/create">
            <% if (typeof invoices !== 'undefined' && invoices && invoices.filter(i => String(i.status).toLowerCase() !== 'paid').length > 0) { %>
              <div class="mb-3">
                <label class="form-label text-sub small fw-semibold">Pilih Tagihan</label>
                <select name="invoiceId" class="form-select bg-dark border-secondary text-white" required>
                  <% invoices.filter(i => String(i.status).toLowerCase() !== 'paid').forEach(function(inv) { %>
                    <option value="<%= inv.id %>">#INV-<%= inv.id %> (Periode <%= monthNamesIndo[inv.period_month] || inv.period_month %> <%= inv.period_year %>) - Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %></option>
                  <% }); %>
                </select>
              </div>
            <% } %>

            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Pilih Metode Pembayaran</label>
              <select name="channel_code" class="form-select bg-dark border-secondary text-white" required>
                <% if (typeof paymentChannels !== 'undefined' && paymentChannels && paymentChannels.length > 0) { %>
                  <% paymentChannels.forEach(function(ch) { %>
                    <option value="<%= ch.code %>"><%= ch.name %> (<%= ch.group %>)</option>
                  <% }); %>
                <% } else { %>
                  <option value="QRIS">QRIS Instant (All E-Wallet & Mobile Banking)</option>
                  <option value="BCAVA">BCA Virtual Account</option>
                  <option value="BNIVA">BNI Virtual Account</option>
                  <option value="BRIVA">BRI Virtual Account</option>
                  <option value="MANDIRIVA">Mandiri Virtual Account</option>
                <% } %>
              </select>
            </div>

            <button type="submit" class="btn btn-action-glow w-100 py-2">
              <i class="bi bi-qr-code-scan me-2"></i> Lanjutkan Pembayaran
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: LAPOR GANGGUAN / TIKET CS -->
  <div class="modal fade" id="ticketModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-white"><i class="bi bi-headset text-success me-2"></i> Lapor Kendala / Tiket Bantuan</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <form method="POST" action="/customer/tickets/create" enctype="multipart/form-data">
            <input type="hidden" name="customerId" value="<%= profile ? profile.id : '' %>">
            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Subjek Laporan / Kendala</label>
              <input type="text" name="subject" class="form-control bg-dark border-secondary text-white" placeholder="Contoh: Lampu Los Merah / Internet Lambat" required>
            </div>

            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Deskripsi Rinci Kendala</label>
              <textarea name="message" rows="3" class="form-control bg-dark border-secondary text-white" placeholder="Jelaskan kendala yang Anda alami..." required></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Lampiran Foto (Opsional)</label>
              <input type="file" name="photos" class="form-control bg-dark border-secondary text-white" accept="image/*" multiple>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
              <i class="bi bi-send-fill me-2"></i> Kirim Tiket Laporan
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- JS Dependencies & Gauge Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Auto-select invoice in payModal when clicking Bayar button in table
    function selectPayInvoice(invId) {
      const select = document.querySelector('#payModal select[name="invoiceId"]');
      if (select && invId) {
        select.value = invId;
      }
    }

    // Smooth scroll helper for bottom nav bar links
    function scrollToSection(sectionId) {
      const el = document.getElementById(sectionId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Visibility toggle for Wi-Fi password input
    function togglePassVisibility() {
      const passInput = document.getElementById('wifiPassInput');
      const eyeIcon = document.getElementById('passEyeIcon');
      if (passInput.type === 'password') {
        passInput.type = 'text';
        eyeIcon.className = 'bi bi-eye-slash';
      } else {
        passInput.type = 'password';
        eyeIcon.className = 'bi bi-eye';
      }
    }

    // Diagnostic Test Simulator
    function runDiagnosticTest() {
      const box = document.getElementById('diagnosticBox');
      const status = document.getElementById('diagStatus');
      const details = document.getElementById('diagDetails');
      box.classList.remove('d-none');
      status.className = 'badge bg-warning text-dark fw-bold';
      status.innerText = 'MEMERIKSA...';
      details.innerText = 'Memeriksa sinyal optic, ping latensi, dan status port ONT...';

      setTimeout(() => {
        status.className = 'badge bg-success';
        status.innerText = 'ONLINE NORMAL';
        details.innerText = 'Koneksi ONT stabil. Latensi: 12ms. Sinyal Optik: Bagus. Tidak ditemukan gangguan fisik.';
      }, 1500);
    }

    // Canvas Speed Gauge Drawing Helper with High DPR & Perfect Alignment
    function drawSpeedGauge(canvasId, value, maxVal, colorHex) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      
      const rect = canvas.getBoundingClientRect();
      const width = rect.width || 180;
      const height = 130;
      
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height - 18;
      const radius = Math.min(width / 2 - 15, 68);
      const startAngle = Math.PI * 0.82;
      const endAngle = Math.PI * 2.18;

      // Background Arc
      ctx.beginPath();
      ctx.arc(cx, cy, radius, startAngle, endAngle, false);
      ctx.lineWidth = 12;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
      ctx.lineCap = 'round';
      ctx.stroke();

      // Progress Arc
      const pct = Math.min(1, Math.max(0, value / maxVal));
      if (pct > 0) {
        const valAngle = startAngle + (pct * (endAngle - startAngle));
        ctx.beginPath();
        ctx.arc(cx, cy, radius, startAngle, valAngle, false);
        ctx.lineWidth = 12;
        ctx.strokeStyle = colorHex;
        ctx.lineCap = 'round';
        ctx.shadowColor = colorHex;
        ctx.shadowBlur = 10;
        ctx.stroke();
      }
    }

    // Real-Time Traffic Polling
    function fetchTrafficData() {
      fetch('/customer/api/pppoe-traffic')
        .then(res => res.json())
        .then(data => {
          if (data && data.ok) {
            const rxNum = parseFloat(data.rxMbps || 0);
            const txNum = parseFloat(data.txMbps || 0);
            
            const rxVal = rxNum.toFixed(1);
            const txVal = txNum.toFixed(1);

            document.getElementById('pppoe_rx_value').innerText = rxVal;
            document.getElementById('pppoe_tx_value').innerText = txVal;

            let rxMax = parseFloat(document.getElementById('pppoe_rx_gauge').dataset.max || 10);
            let txMax = parseFloat(document.getElementById('pppoe_tx_gauge').dataset.max || 10);

            if (rxNum > rxMax) rxMax = Math.ceil(rxNum * 1.2);
            if (txNum > txMax) txMax = Math.ceil(txNum * 1.2);

            drawSpeedGauge('pppoe_rx_gauge', rxNum, rxMax, '#10b981');
            drawSpeedGauge('pppoe_tx_gauge', txNum, txMax, '#3b82f6');
          }
        })
        .catch(() => {});
    }

    async function deleteCustomerConnectedClient(mac, ip, hostname) {
      if (!confirm(`Apakah Anda yakin ingin menghapus perangkat "${hostname}" (${mac || ip}) dari daftar terhubung?`)) return;
      try {
        const res = await fetch('/customer/delete-connected-client', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ mac, ip })
        });
        const data = await res.json();
        if (data.ok) {
          alert(data.message || 'Perangkat berhasil dihapus dari daftar terhubung.');
          window.location.reload();
        } else {
          alert('Gagal: ' + (data.message || 'Gagal menghapus perangkat terhubung.'));
        }
      } catch (e) {
        alert('Error: ' + e.message);
      }
    }

    window.onload = function() {
      drawSpeedGauge('pppoe_rx_gauge', 0, 10, '#10b981');
      drawSpeedGauge('pppoe_tx_gauge', 0, 10, '#3b82f6');
      fetchTrafficData();
      setInterval(fetchTrafficData, 2000);
    };

    window.onresize = function() {
      fetchTrafficData();
    };
  </script>
</body>
</html>
