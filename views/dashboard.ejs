<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang ? lang : 'id' %>" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof t === 'function' ? t('customer.dashboard_title', 'Dashboard Pelanggan') : 'Dashboard Pelanggan' %> | Portal ISP</title>
  
  <!-- CSS Dependencies -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0b0f19">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <script>
    (function () {
      try {
        const savedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <style>
    :root, [data-theme="dark"] {
      --bg-dark: #0b0f19;
      --bg-mesh-1: rgba(99, 102, 241, 0.15);
      --bg-mesh-2: rgba(16, 185, 129, 0.10);
      --bg-mesh-3: rgba(139, 92, 246, 0.12);
      --card-bg: rgba(17, 24, 39, 0.85);
      --card-border: rgba(255, 255, 255, 0.12);
      --card-hover-border: rgba(99, 102, 241, 0.4);
      --hero-bg: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
      --hero-border: rgba(99, 102, 241, 0.35);
      --hero-text: #ffffff;
      --hero-sub: #cbd5e1;
      --primary-accent: #6366f1;
      --primary-glow: rgba(99, 102, 241, 0.35);
      --success-accent: #10b981;
      --warning-accent: #f59e0b;
      --danger-accent: #ef4444;
      --text-main: #f8fafc;
      --text-sub: #cbd5e1;
      --text-muted: #94a3b8;
      --nav-bg: rgba(11, 15, 25, 0.90);
      --btn-secondary-bg: rgba(255, 255, 255, 0.05);
      --btn-secondary-hover: rgba(99, 102, 241, 0.18);
      --btn-secondary-border: rgba(255, 255, 255, 0.12);
      --box-inner-bg: rgba(255, 255, 255, 0.04);
      --modal-bg: #111827;
      --table-border: rgba(255, 255, 255, 0.06);
      --input-bg: rgba(15, 23, 42, 0.75);
      --input-border: rgba(255, 255, 255, 0.14);
      --input-color: #ffffff;
      --icon-sun: inline-block;
      --icon-moon: none;
    }

    [data-theme="light"] {
      --bg-dark: #f1f5f9;
      --bg-mesh-1: rgba(99, 102, 241, 0.10);
      --bg-mesh-2: rgba(16, 185, 129, 0.06);
      --bg-mesh-3: rgba(139, 92, 246, 0.08);
      --card-bg: rgba(255, 255, 255, 0.94);
      --card-border: rgba(226, 232, 240, 0.9);
      --card-hover-border: rgba(79, 70, 229, 0.3);
      --hero-bg: linear-gradient(135deg, #3730a3 0%, #1e293b 100%);
      --hero-border: rgba(99, 102, 241, 0.3);
      --hero-text: #ffffff;
      --hero-sub: #e2e8f0;
      --primary-accent: #4f46e5;
      --primary-glow: rgba(79, 70, 229, 0.25);
      --success-accent: #059669;
      --warning-accent: #d97706;
      --danger-accent: #dc2626;
      --text-main: #0f172a;
      --text-sub: #334155;
      --text-muted: #64748b;
      --nav-bg: rgba(255, 255, 255, 0.94);
      --btn-secondary-bg: #e2e8f0;
      --btn-secondary-hover: rgba(79, 70, 229, 0.12);
      --btn-secondary-border: #cbd5e1;
      --box-inner-bg: rgba(241, 245, 249, 0.9);
      --modal-bg: #ffffff;
      --table-border: #e2e8f0;
      --input-bg: #ffffff;
      --input-border: #cbd5e1;
      --input-color: #0f172a;
      --icon-sun: none;
      --icon-moon: inline-block;
    }

    .btn-theme-toggle {
      border: 1px solid var(--btn-secondary-border);
      color: var(--text-main);
      background: var(--btn-secondary-bg);
      border-radius: 12px;
      padding: 5px 12px;
      font-weight: 600;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-theme-toggle:hover {
      background: var(--btn-secondary-hover);
    }

    .btn-outline-custom {
      border: 1px solid var(--btn-secondary-border);
      color: var(--text-main) !important;
      background: var(--btn-secondary-bg);
      border-radius: 12px;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-outline-custom:hover {
      background: var(--btn-secondary-hover);
      color: var(--text-main) !important;
    }

    .sun-icon { display: var(--icon-sun); color: #f59e0b; }
    .moon-icon { display: var(--icon-moon); color: #818cf8; }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 15% 15%, var(--bg-mesh-1) 0%, transparent 45%),
        radial-gradient(circle at 85% 25%, var(--bg-mesh-2) 0%, transparent 45%),
        radial-gradient(circle at 50% 80%, var(--bg-mesh-3) 0%, transparent 50%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      padding-bottom: 95px;
    }

    /* Force high contrast for all text & Bootstrap overrides */
    .text-muted {
      color: var(--text-muted) !important;
    }
    .text-sub {
      color: var(--text-sub) !important;
    }
    .text-main {
      color: var(--text-main) !important;
    }

    /* Navbar Glassmorphism */
    .portal-nav {
      background: var(--nav-bg);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid var(--card-border);
      position: sticky;
      top: 0;
      z-index: 1040;
    }

    .brand-logo-img {
      height: 38px;
      width: auto;
      border-radius: 8px;
    }

    /* Glass Cards */
    .glass-card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }
    
    .glass-card:hover {
      border-color: var(--card-hover-border);
      box-shadow: 0 15px 35px rgba(99, 102, 241, 0.15);
    }

    /* Pill Badges */
    .pill-badge {
      padding: 5px 12px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .pill-active { background: rgba(16, 185, 129, 0.20); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
    .pill-suspended { background: rgba(239, 68, 68, 0.20); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }
    .pill-online { background: rgba(59, 130, 246, 0.20); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }

    /* Interactive Action Buttons */
    .btn-action-glow {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #fff !important;
      font-weight: 700;
      border-radius: 12px;
      padding: 10px 20px;
      border: none;
      box-shadow: 0 4px 15px var(--primary-glow);
      transition: all 0.25s ease;
    }
    .btn-action-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(99, 102, 241, 0.5);
      color: #fff !important;
    }

    .btn-self-service {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: var(--text-main) !important;
      border-radius: 14px;
      padding: 14px;
      text-align: center;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      width: 100%;
    }
    .btn-self-service:hover {
      background: rgba(99, 102, 241, 0.18);
      border-color: rgba(99, 102, 241, 0.5);
      transform: translateY(-3px);
      color: #fff !important;
    }
    .btn-self-service i {
      font-size: 24px;
    }

    /* Live Traffic Gauge Styles */
    .gauge-wrapper {
      position: relative;
      width: 100%;
      height: 130px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .gauge-canvas {
      display: block;
      width: 100%;
      height: 130px;
    }
    .gauge-center-info {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -40%);
      text-align: center;
      pointer-events: none;
    }
    .gauge-val-num {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-main) !important;
      line-height: 1;
      letter-spacing: -0.5px;
    }
    .gauge-unit-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-sub) !important;
      margin-top: 3px;
      text-transform: none;
    }

    .hero-banner-card {
      background: var(--hero-bg) !important;
      border: 1px solid var(--hero-border) !important;
      color: var(--hero-text) !important;
      border-radius: 24px;
    }

    .hero-title {
      color: var(--hero-text) !important;
    }

    .hero-sub {
      color: var(--hero-sub) !important;
    }

    .section-title {
      color: var(--text-main) !important;
    }

    .box-inner {
      background: var(--box-inner-bg) !important;
      border: 1px solid var(--card-border) !important;
      border-radius: 16px;
    }

    .btn-self-service {
      background: var(--btn-secondary-bg);
      border: 1px solid var(--btn-secondary-border);
      color: var(--text-main) !important;
      border-radius: 16px;
      padding: 14px;
      text-align: center;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      width: 100%;
    }
    .btn-self-service:hover {
      background: var(--btn-secondary-hover);
      border-color: var(--primary-accent);
      transform: translateY(-3px);
      color: var(--text-main) !important;
    }
    .btn-self-service i {
      font-size: 24px;
    }

    /* ─── WI-FI SELF-SERVICE & QR ENHANCEMENTS ─── */
    .wifi-tab-nav {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 4px;
      display: flex;
      gap: 4px;
      margin-bottom: 16px;
    }
    .wifi-tab-btn {
      flex: 1;
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-sub);
      background: transparent;
      border: none;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none;
    }
    .wifi-tab-btn:hover {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.05);
    }
    .wifi-tab-btn.active {
      color: #ffffff !important;
      background: var(--primary-accent);
      box-shadow: 0 4px 12px var(--primary-glow);
    }
    .pw-strength-meter {
      height: 5px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.1);
      margin-top: 6px;
      overflow: hidden;
    }
    .pw-strength-bar {
      height: 100%;
      width: 0%;
      transition: all 0.3s ease;
      border-radius: 6px;
    }
    .pw-strength-weak { width: 33%; background: #ef4444; }
    .pw-strength-medium { width: 66%; background: #f59e0b; }
    .pw-strength-strong { width: 100%; background: #10b981; }
    .qr-standee-card {
      background: linear-gradient(145deg, rgba(30, 41, 59, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      padding: 24px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      position: relative;
      overflow: hidden;
    }
    .qr-frame {
      background: #ffffff;
      padding: 14px;
      border-radius: 16px;
      display: inline-block;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
      margin: 12px 0;
    }
    .qr-frame img {
      width: 200px;
      height: 200px;
      display: block;
      image-rendering: pixelated;
    }
    .pulse-dot-online {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulseGreen 2s infinite;
    }
    .pulse-dot-offline {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #ef4444;
      display: inline-block;
    }
    @keyframes pulseGreen {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 7px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* Navigation Floating Bar for Mobile */
    .bottom-nav-bar {
      position: fixed;
      bottom: 15px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 30px);
      max-width: 500px;
      background: var(--nav-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--card-border);
      border-radius: 40px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 1050;
      box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

    .nav-item-btn {
      color: var(--text-sub) !important;
      text-decoration: none;
      font-size: 11px;
      font-weight: 600;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      padding: 6px 10px;
      border-radius: 20px;
      transition: all 0.2s ease;
      min-width: 60px;
    }
    .nav-item-btn i {
      font-size: 19px;
      color: var(--text-sub);
      display: inline-block;
    }
    .nav-item-btn.active, .nav-item-btn:hover {
      color: var(--text-main) !important;
      background: var(--btn-secondary-hover);
    }
    .nav-item-btn.active i, .nav-item-btn:hover i {
      color: var(--primary-accent);
    }

    /* Table Custom */
    .table-dark-custom {
      --bs-table-bg: transparent;
      color: var(--text-main);
    }
    .table-dark-custom th {
      color: var(--text-sub) !important;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--card-border);
    }
    .table-dark-custom td {
      border-bottom: 1px solid var(--table-border);
      vertical-align: middle;
      font-size: 13px;
      color: var(--text-main);
    }

    /* Modal Dynamic Theme */
    .modal-content-dark {
      background: var(--modal-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      color: var(--text-main);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
    }

    .modal-content-dark .form-control,
    .modal-content-dark .form-select {
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      color: var(--input-color);
      border-radius: 14px;
    }

    .modal-content-dark .form-control:focus,
    .modal-content-dark .form-select:focus {
      background: var(--input-bg);
      border-color: var(--primary-accent);
      color: var(--input-color);
    }

    /* ── PROMO BANNER SLIDER STYLING ── */
    .promo-slider-section {
      position: relative;
    }
    .promo-carousel {
      border-radius: 22px;
      overflow: hidden;
      border: 1px solid var(--card-border);
      background: #020617;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28), 0 0 24px rgba(99, 102, 241, 0.12);
    }
    .promo-carousel-inner {
      border-radius: 22px;
    }
    .promo-slide-link {
      display: block;
      text-decoration: none;
      color: inherit;
      position: relative;
    }
    .promo-img-container {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 6;
      max-height: 290px;
      background: #020617;
      overflow: hidden;
    }
    @media (max-width: 768px) {
      .promo-img-container {
        aspect-ratio: 16 / 8;
        max-height: 220px;
      }
    }
    .promo-banner-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s ease;
    }
    .promo-slide-link:hover .promo-banner-img {
      transform: scale(1.025);
    }
    .promo-gradient-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(2, 6, 23, 0.88) 0%, rgba(2, 6, 23, 0.35) 45%, rgba(2, 6, 23, 0.05) 100%);
      pointer-events: none;
    }
    .promo-caption-box {
      position: absolute;
      bottom: 16px;
      left: 20px;
      right: 160px;
      z-index: 2;
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .promo-caption-box {
        bottom: 12px;
        left: 14px;
        right: 14px;
      }
    }
    .promo-badge {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #ffffff;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.6px;
      padding: 4px 8px;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
      display: inline-flex;
      align-items: center;
    }
    .promo-caption-title {
      color: #ffffff;
      font-weight: 800;
      font-size: 18px;
      margin: 4px 0 0 0;
      text-shadow: 0 2px 8px rgba(0,0,0,0.7);
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    @media (max-width: 768px) {
      .promo-caption-title {
        font-size: 14px;
      }
    }
    .promo-caption-desc {
      color: #e2e8f0;
      font-size: 12px;
      margin-top: 3px;
      text-shadow: 0 1px 4px rgba(0,0,0,0.8);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    @media (max-width: 768px) {
      .promo-caption-desc {
        display: none;
      }
    }
    .promo-cta-wrap {
      position: absolute;
      bottom: 18px;
      right: 20px;
      z-index: 2;
    }
    @media (max-width: 768px) {
      .promo-cta-wrap {
        display: none;
      }
    }
    .btn-promo-cta {
      background: rgba(255, 255, 255, 0.95);
      color: #0f172a !important;
      font-weight: 700;
      font-size: 12px;
      border-radius: 12px;
      padding: 6px 14px;
      backdrop-filter: blur(8px);
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
      border: none;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
    }
    .promo-slide-link:hover .btn-promo-cta {
      background: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    }
    .promo-indicators {
      bottom: 8px;
      margin-bottom: 0;
      z-index: 3;
    }
    .promo-indicators button {
      width: 22px;
      height: 4px;
      border-radius: 4px;
      border: none;
      background-color: rgba(255, 255, 255, 0.45);
      transition: all 0.25s ease;
    }
    .promo-indicators button.active {
      width: 32px;
      background-color: #6366f1;
    }
    .promo-ctrl-btn {
      width: 44px;
      opacity: 0;
      transition: opacity 0.25s ease;
      z-index: 4;
    }
    .promo-carousel:hover .promo-ctrl-btn {
      opacity: 0.9;
    }
    .promo-ctrl-icon {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      display: grid;
      place-items: center;
      color: #ffffff;
      font-size: 14px;
      transition: all 0.2s ease;
    }
    .promo-ctrl-btn:hover .promo-ctrl-icon {
      background: #6366f1;
      transform: scale(1.1);
    }
  </style>
</head>

<body>

  <!-- Top Navbar -->
  <nav class="navbar portal-nav">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/customer/dashboard">
        <img src="/img/logo.png" alt="Logo" class="brand-logo-img" onerror="this.style.display='none'">
        <span class="fw-bold nav-brand-text fs-5"><%= (settings && settings.company_header) ? settings.company_header : 'ISP Portal' %></span>
      </a>

      <div class="d-flex align-items-center gap-2">
        <button id="themeToggleBtn" type="button" class="btn-theme-toggle" aria-label="Pilih Tema">
          <i class="bi bi-sun-fill sun-icon"></i>
          <i class="bi bi-moon-stars-fill moon-icon"></i>
          <span class="d-none d-sm-inline ms-1">Tema</span>
        </button>

        <% if (profile) { %>
          <span class="pill-badge <%= profile.status === 'active' ? 'pill-active' : 'pill-suspended' %> d-none d-sm-inline-flex">
            <i class="bi bi-shield-check"></i> <%= profile.status === 'active' ? 'AKTIF' : 'ISOLIR' %>
          </span>
        <% } %>

        <form method="POST" action="/customer/logout" class="m-0">
          <button type="submit" class="btn btn-sm btn-outline-custom rounded-pill px-3" title="Keluar">
            <i class="bi bi-box-arrow-right me-1"></i> <span class="d-none d-sm-inline">Keluar</span>
          </button>
        </form>
      </div>
    </div>
  </nav>

  <div class="container mt-4">

    <!-- Flash Alert Notification -->
    <% if (typeof notif !== 'undefined' && notif) { %>
      <div class="alert alert-<%= notif.type === 'success' ? 'success' : (notif.type === 'warning' ? 'warning' : 'danger') %> glass-card border-0 mb-4 p-3 d-flex align-items-center justify-content-between" style="background: rgba(99, 102, 241, 0.2); color: var(--text-main);">
        <div>
          <i class="bi bi-info-circle-fill me-2 text-primary"></i>
          <%- notif.message || notif.text %>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- HERO BANNER -->
    <div class="glass-card hero-banner-card p-4 mb-4">
      <div class="row align-items-center g-3">
        <div class="col-12 col-md-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="pill-badge pill-online"><i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i> ONLINE</span>
            <span class="hero-sub small">| IP: <strong class="text-white"><%= customer.pppoeIP || customer.ip || '-' %></strong></span>
          </div>
          <h2 class="fw-bold mb-1 hero-title">Halo, <%= profile ? profile.name : (customer.phone || 'Pelanggan') %>!</h2>
          <p class="hero-sub mb-0">ID Pelanggan: <strong class="text-white">MDE-<%= profile ? String(profile.id).padStart(4, '0') : '0000' %></strong> | Paket: <span class="text-info fw-bold"><%= customer.package_name || (profile ? profile.package_name : 'Internet Fiber') %></span></p>
        </div>

        <div class="col-12 col-md-5 text-md-end">
          <%
            const unpaidList = (typeof invoices !== 'undefined' && invoices) ? invoices.filter(i => String(i.status).toLowerCase() !== 'paid') : [];
            const hasUnpaid = unpaidList.length > 0;
            const totalUnpaidAmount = unpaidList.reduce((sum, i) => sum + (Number(i.amount) || 0), 0);
          %>
          
          <% if (hasUnpaid) { %>
            <div class="p-3 rounded-4 mb-2" style="background: rgba(239,68,68,0.25); border: 1px solid rgba(239,68,68,0.4);">
              <div class="text-warning small font-monospace fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> TAGIHAN BELUM DIBAYAR</div>
              <div class="fs-4 fw-extrabold text-white">Rp <%= totalUnpaidAmount.toLocaleString('id-ID') %></div>
              <div class="small hero-sub mb-2">(<%= unpaidList.length %> Tagihan PENDING)</div>
              <button class="btn btn-action-glow btn-sm w-100" data-bs-toggle="modal" data-bs-target="#payModal">
                <i class="bi bi-credit-card-fill me-1"></i> Bayar Sekarang
              </button>
            </div>
          <% } else { %>
            <div class="p-3 rounded-4" style="background: rgba(16,185,129,0.22); border: 1px solid rgba(16,185,129,0.4);">
              <div class="text-success small fw-bold"><i class="bi bi-check-circle-fill me-1"></i> STATUS TAGIHAN LUNAS</div>
              <div class="small hero-sub mt-1">Layanan Anda berjalan lancar tanpa kendala tunggakan.</div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- PROMO BANNER SLIDER -->
    <% if (typeof promoBanners !== 'undefined' && promoBanners && promoBanners.length > 0) { %>
      <div class="promo-slider-section mb-4">
        <div id="promoCarouselDashboard" class="carousel slide promo-carousel shadow-lg" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="hover">
          <!-- Indicators -->
          <% if (promoBanners.length > 1) { %>
            <div class="carousel-indicators promo-indicators">
              <% promoBanners.forEach((banner, idx) => { %>
                <button type="button" data-bs-target="#promoCarouselDashboard" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>" aria-current="<%= idx === 0 ? 'true' : 'false' %>" aria-label="Promo Slide <%= idx + 1 %>"></button>
              <% }) %>
            </div>
          <% } %>

          <!-- Slides -->
          <div class="carousel-inner promo-carousel-inner">
            <% promoBanners.forEach((banner, idx) => { %>
              <div class="carousel-item promo-carousel-item <%= idx === 0 ? 'active' : '' %>">
                <% if (banner.target_url) { %>
                  <a href="<%= banner.target_url %>" class="promo-slide-link" target="<%= banner.target_url.startsWith('http') ? '_blank' : '_self' %>">
                <% } else { %>
                  <div class="promo-slide-link">
                <% } %>
                  <div class="promo-img-container">
                    <img src="<%= banner.image_url %>" class="promo-banner-img" alt="<%= banner.title %>" loading="lazy">
                    <div class="promo-gradient-scrim"></div>
                    <% if (banner.title || banner.description) { %>
                      <div class="promo-caption-box">
                        <span class="badge promo-badge mb-1"><i class="bi bi-tag-fill me-1"></i> PROMO</span>
                        <h4 class="promo-caption-title"><%= banner.title %></h4>
                        <% if (banner.description) { %>
                          <p class="promo-caption-desc mb-0"><%= banner.description %></p>
                        <% } %>
                      </div>
                    <% } %>
                    <% if (banner.target_url) { %>
                      <div class="promo-cta-wrap">
                        <span class="btn btn-sm btn-promo-cta">
                          Lihat Promo <i class="bi bi-arrow-right-short ms-1"></i>
                        </span>
                      </div>
                    <% } %>
                  </div>
                <% if (banner.target_url) { %>
                  </a>
                <% } else { %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>

          <!-- Controls (only if > 1 banner) -->
          <% if (promoBanners.length > 1) { %>
            <button class="carousel-control-prev promo-ctrl-btn prev" type="button" data-bs-target="#promoCarouselDashboard" data-bs-slide="prev">
              <span class="promo-ctrl-icon"><i class="bi bi-chevron-left"></i></span>
              <span class="visually-hidden">Sebelumnya</span>
            </button>
            <button class="carousel-control-next promo-ctrl-btn next" type="button" data-bs-target="#promoCarouselDashboard" data-bs-slide="next">
              <span class="promo-ctrl-icon"><i class="bi bi-chevron-right"></i></span>
              <span class="visually-hidden">Berikutnya</span>
            </button>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- MAIN DASHBOARD TABS CONTENT -->
    <div class="row g-4 mb-4">
      
      <!-- LEFT COLUMN: SPEED GAUGES & SIGNAL METRICS -->
      <div class="col-12 col-lg-7">
        <div class="glass-card p-4 h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 section-title"><i class="bi bi-speedometer2 text-primary me-2"></i> Pengukur Kecepatan (Live)</h5>
            <span class="badge bg-secondary bg-opacity-25 border border-secondary text-sub">Refresh 3s</span>
          </div>

          <div class="row g-3 text-center my-2">
            <!-- DOWNLOAD GAUGE -->
            <div class="col-6">
              <div class="p-3 box-inner">
                <div class="fw-bold small mb-2" style="color: #34d399;"><i class="bi bi-arrow-down-circle-fill me-1"></i> Download</div>
                <div class="gauge-wrapper">
                  <canvas id="pppoe_rx_gauge" class="gauge-canvas" data-max="<%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %>"></canvas>
                  <div class="gauge-center-info">
                    <div class="gauge-val-num" id="pppoe_rx_value">0.0</div>
                    <div class="gauge-unit-label" id="pppoe_rx_unit">Mbps</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- UPLOAD GAUGE -->
            <div class="col-6">
              <div class="p-3 box-inner">
                <div class="fw-bold small mb-2" style="color: #38bdf8;"><i class="bi bi-arrow-up-circle-fill me-1"></i> Upload</div>
                <div class="gauge-wrapper">
                  <canvas id="pppoe_tx_gauge" class="gauge-canvas" data-max="<%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %>"></canvas>
                  <div class="gauge-center-info">
                    <div class="gauge-val-num" id="pppoe_tx_value">0.0</div>
                    <div class="gauge-unit-label" id="pppoe_tx_unit">Mbps</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SIGNAL METRICS ROW -->
          <div class="row g-3 mt-2">
            <div class="col-6">
              <div class="p-3 box-inner d-flex align-items-center gap-3">
                <div class="fs-3 text-warning"><i class="bi bi-activity"></i></div>
                <div>
                  <div class="fw-semibold small text-warning">Sinyal Optik (RX)</div>
                  <% 
                    const rxVal = (customer && customer.rxPower && customer.rxPower !== '-' && customer.rxPower !== 'N/A') ? customer.rxPower : null;
                    const optQuality = customer && customer.opticalQuality ? customer.opticalQuality : null;
                    const isEst = customer && customer.isEstimatedRx;
                  %>
                  <div class="fw-bold fs-6 text-main" id="liveRxPowerContainer">
                    <% if (rxVal) { %>
                      <span id="liveRxPowerValue"><%= rxVal %> dBm</span>
                      <% if (isEst) { %>
                        <span class="badge bg-secondary-subtle text-light rounded-pill px-2 py-0 ms-1" style="font-size: 9px;" id="liveRxEstBadge" title="Estimasi Teoretis Link Budget ODP">Estimasi</span>
                      <% } else if (optQuality && optQuality.statusLabel) { %>
                        <span class="badge rounded-pill px-2 py-0 ms-1" style="font-size: 9px; background-color: <%= optQuality.color || '#10b981' %>22; color: <%= optQuality.color || '#10b981' %>; border: 1px solid <%= optQuality.color || '#10b981' %>44;" id="liveRxStatusBadge" title="<%= optQuality.diagnosis || '' %>"><%= optQuality.statusLabel %></span>
                      <% } %>
                    <% } else { %>
                      <span class="text-muted small" id="liveRxPowerValue">Belum Terdeteksi</span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-6">
              <div class="p-3 box-inner d-flex align-items-center gap-3">
                <div class="fs-3 text-info"><i class="bi bi-laptop"></i></div>
                <div>
                  <div class="fw-semibold small text-primary">Perangkat Terhubung</div>
                  <% 
                    const userList = (typeof connectedUsers !== 'undefined' && Array.isArray(connectedUsers)) ? connectedUsers : [];
                    const activeClientCount = userList.length > 0 ? userList.length : (customer && Number.isFinite(customer.totalAssociations) ? customer.totalAssociations : 0);
                  %>
                  <div class="fw-bold fs-6 text-main"><span id="liveConnectedCount"><%= activeClientCount %></span> Perangkat</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: SELF-SERVICE TROUBLESHOOT & WI-FI QUICK TOOLS -->
      <div class="col-12 col-lg-5">
        <div class="glass-card p-4 h-100">
          <h5 class="fw-bold mb-3 section-title"><i class="bi bi-tools text-warning me-2"></i> Fitur Mandiri & Router</h5>
          
          <div class="row g-2 mb-2">
            <div class="col-6">
              <a href="#wifi-modal" class="btn-self-service h-100" data-bs-toggle="modal" data-bs-target="#wifiModal" onclick="loadLiveWifiInfo()">
                <i class="bi bi-wifi text-primary fs-3"></i>
                <span class="fw-bold small text-main">Ganti Wi-Fi</span>
                <span class="text-sub text-truncate px-1" style="font-size: 10px; max-width: 100%;" id="btnWifiSsidLabel" title="<%= (customer && customer.ssid && customer.ssid !== '-' && customer.ssid !== 'N/A') ? customer.ssid : 'Nama & Password' %>"><%= (customer && customer.ssid && customer.ssid !== '-' && customer.ssid !== 'N/A') ? customer.ssid : 'Nama & Password' %></span>
              </a>
            </div>

            <div class="col-6">
              <button type="button" class="btn-self-service h-100" data-bs-toggle="modal" data-bs-target="#wifiQrModal" onclick="openWifiQrModal()">
                <i class="bi bi-qr-code-scan text-info fs-3"></i>
                <span class="fw-bold small text-main">QR Wi-Fi Tamu</span>
                <span class="text-sub" style="font-size: 10px;">Scan Auto-Connect</span>
              </button>
            </div>

            <div class="col-4">
              <button type="button" class="btn-self-service h-100 py-2" data-bs-toggle="modal" data-bs-target="#rebootModal">
                <i class="bi bi-arrow-repeat text-danger fs-5"></i>
                <span class="fw-bold text-main" style="font-size: 11px;">Reboot</span>
                <span class="text-sub" style="font-size: 9px;">Restart ONT</span>
              </button>
            </div>

            <div class="col-4">
              <button type="button" class="btn-self-service h-100 py-2" data-bs-toggle="modal" data-bs-target="#ticketModal">
                <i class="bi bi-headset text-success fs-5"></i>
                <span class="fw-bold text-main" style="font-size: 11px;">Bantuan</span>
                <span class="text-sub" style="font-size: 9px;">Tiket CS</span>
              </button>
            </div>

            <div class="col-4">
              <button type="button" class="btn-self-service h-100 py-2" onclick="runDiagnosticTest()">
                <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                <span class="fw-bold text-main" style="font-size: 11px;">Latensi</span>
                <span class="text-sub" style="font-size: 9px;">Tes Live</span>
              </button>
            </div>
          </div>

          <!-- DIAGNOSTIC RESULT BOX -->
          <div id="diagnosticBox" class="mt-3 p-3 box-inner d-none">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="fw-bold small text-main"><i class="bi bi-shield-check me-1 text-success"></i> Hasil Diagnostik:</span>
              <span id="diagStatus" class="badge bg-success">NORMAL</span>
            </div>
            <div class="small text-sub" id="diagDetails">Sinyal optik & jalur routing ONT berfungsi dengan baik.</div>
          </div>
        </div>
      </div>

    </div>

    <!-- CONNECTED CLIENTS & BILLING HISTORY SECTION -->
    <div class="row g-4 mb-4">
      
      <!-- CONNECTED DEVICES TABLE -->
      <div class="col-12 col-lg-6" id="devices-section">
        <div class="glass-card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 section-title"><i class="bi bi-router text-info me-2"></i> Perangkat Terhubung (Live)</h5>
            <div>
              <% 
                const tblUsers = (typeof connectedUsers !== 'undefined' && Array.isArray(connectedUsers)) ? connectedUsers : [];
                const activeAssocCount = tblUsers.length > 0 ? tblUsers.length : (customer && Number.isFinite(customer.totalAssociations) ? customer.totalAssociations : 0);
              %>
              <span class="badge bg-primary rounded-pill" id="liveClientsBadge"><%= activeAssocCount %> Active</span>
              <a href="/customer/web-proxy/" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 ms-2" style="font-size: 11px;"><i class="bi bi-box-arrow-up-right me-1"></i> Web Router</a>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom">
              <thead>
                <tr>
                  <th>Host / Perangkat</th>
                  <th>IP & MAC</th>
                  <th>Status</th>
                  <th class="text-end">Aksi</th>
                </tr>
              </thead>
              <tbody id="liveConnectedClientsTbody">
                <% if (tblUsers.length > 0) { %>
                  <% tblUsers.forEach(function(dev) {
                      const iface = String(dev.iface || '');
                      const isWiFi = iface.toLowerCase().includes('wifi') || iface.toLowerCase().includes('wlan') || iface.toLowerCase().includes('802.11');
                      const isDevOnline = String(dev.status || '').toLowerCase() === 'online' || String(dev.status || '').toLowerCase() === 'active' || String(dev.status || '') === '1' || dev.active === true;
                  %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background: rgba(99,102,241,0.2); color: var(--primary-accent); width: 34px; height: 34px;">
                            <i class="bi bi-<%= isWiFi ? 'wifi' : 'ethernet' %> fs-5"></i>
                          </div>
                          <div>
                            <div class="fw-bold text-main"><%= dev.hostname || 'Device' %></div>
                            <div class="small text-sub"><%= iface || 'LAN/WLAN' %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="small text-main fw-semibold"><%= dev.ip || '-' %></div>
                        <div class="small text-sub font-monospace" style="font-size: 10px;"><%= dev.mac || '-' %></div>
                      </td>
                      <td>
                        <span class="pill-badge <%= isDevOnline ? 'pill-active' : 'pill-suspended' %>" style="font-size: 9px;">
                          <%= isDevOnline ? 'ONLINE' : 'OFFLINE' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <button class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 28px; height: 28px; line-height: 1;" onclick="deleteCustomerConnectedClient('<%= dev.mac || '' %>', '<%= dev.ip || '' %>', '<%= dev.hostname || 'Perangkat' %>')" title="Hapus Perangkat Terhubung">
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else if (activeAssocCount > 0) { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-sub">
                      <div class="d-inline-flex p-2 rounded-circle bg-primary-subtle text-primary mb-2">
                        <i class="bi bi-wifi fs-4"></i>
                      </div>
                      <div class="fw-bold text-main mb-1"><%= activeAssocCount %> Perangkat Terhubung Aktif</div>
                      <div class="small text-sub">Perangkat terhubung ke jaringan Wi-Fi router Anda. Informasi rincian nama/MAC host sedang disinkronkan oleh modem.</div>
                    </td>
                  </tr>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-sub">
                      <i class="bi bi-info-circle fs-4 d-block mb-1"></i>
                      Tidak ada perangkat LAN/Wi-Fi yang terdeteksi aktif saat ini.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- INVOICE BILLING HISTORY TABLE -->
      <div class="col-12 col-lg-6" id="billing-section">
        <div class="glass-card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 section-title"><i class="bi bi-receipt text-warning me-2"></i> Riwayat Tagihan</h5>
            <% if (hasUnpaid) { %>
              <button class="btn btn-sm btn-danger rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#payModal">Bayar Tagihan</button>
            <% } %>
          </div>

          <div class="table-responsive">
            <table class="table table-dark-custom">
              <thead>
                <tr>
                  <th>Periode</th>
                  <th>Nominal</th>
                  <th>Status</th>
                  <th class="text-end">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <%
                  const monthNamesIndo = ['', 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
                %>
                <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
                  <% invoices.forEach(function(inv) {
                      const isInvPaid = String(inv.status).toLowerCase() === 'paid';
                  %>
                    <tr>
                      <td>
                        <div class="fw-bold text-main"><%= monthNamesIndo[inv.period_month] || inv.period_month %> <%= inv.period_year %></div>
                        <div class="small text-sub font-monospace" style="font-size: 10px;">#INV-<%= inv.id %></div>
                      </td>
                      <td>
                        <div class="fw-bold text-main">Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %></div>
                      </td>
                      <td>
                        <span class="pill-badge <%= isInvPaid ? 'pill-active' : 'pill-suspended' %>" style="font-size: 9px;">
                          <%= isInvPaid ? 'LUNAS' : 'PENDING' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <% if (isInvPaid) { %>
                          <a href="/customer/billing/<%= inv.id %>/print" target="_blank" class="btn btn-sm btn-outline-custom rounded-circle" title="Cetak Struk/Invoice">
                            <i class="bi bi-printer"></i>
                          </a>
                        <% } else { %>
                          <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#payModal" onclick="selectPayInvoice('<%= inv.id %>')">Bayar</button>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-sub">
                      Belum ada catatan tagihan untuk akun Anda.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>

  </div> <!-- End Container -->

  <!-- FLOATING NAVIGATION BAR FOR MOBILE -->
  <div class="bottom-nav-bar">
    <a href="/customer/dashboard" class="nav-item-btn active">
      <i class="bi bi-house-door-fill"></i>
      <span>Beranda</span>
    </a>
    <a href="#billing-section" class="nav-item-btn" onclick="scrollToSection('billing-section'); return false;">
      <i class="bi bi-receipt"></i>
      <span>Tagihan</span>
    </a>
    <a href="#wifiModal" data-bs-toggle="modal" data-bs-target="#wifiModal" class="nav-item-btn">
      <i class="bi bi-wifi"></i>
      <span>Wi-Fi</span>
    </a>
    <a href="#devices-section" class="nav-item-btn" onclick="scrollToSection('devices-section'); return false;">
      <i class="bi bi-router"></i>
      <span>Perangkat</span>
    </a>
    <a href="#ticketModal" data-bs-toggle="modal" data-bs-target="#ticketModal" class="nav-item-btn">
      <i class="bi bi-headset"></i>
      <span>Bantuan</span>
    </a>
  </div>

  <!-- MODAL: GANTI SSID & PASSWORD WI-FI LENGKAP -->
  <div class="modal fade" id="wifiModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0">
          <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded-circle" style="background: rgba(99, 102, 241, 0.15); color: var(--primary-accent);">
              <i class="bi bi-wifi fs-4"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold text-main mb-0">Pengaturan Wi-Fi Mandiri</h5>
              <span class="small text-sub" style="font-size: 11px;">Konfigurasi Nama (SSID) & Password Router Rumah</span>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <!-- Banner Status Router Live -->
          <div class="p-3 rounded-4 mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2" style="background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.25);">
            <div>
              <div class="small text-sub" style="font-size: 11px;"><i class="bi bi-router me-1"></i> Status Router & Nama Wi-Fi Saat Ini:</div>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span id="wifiRouterPulseDot" class="pulse-dot-online"></span>
                <span id="wifiRouterStatusText" class="fw-bold small text-main">Router Terhubung</span>
                <span class="text-sub">|</span>
                <span class="fw-bold fs-6 text-info"><i class="bi bi-wifi me-1"></i><span id="liveCurrentSsid"><%= (customer && customer.ssid && customer.ssid !== '-' && customer.ssid !== 'N/A') ? customer.ssid : 'Belum Terdeteksi' %></span></span>
                <button type="button" class="btn btn-sm btn-outline-custom py-0 px-2 rounded-pill" onclick="copyCurrentSsid()" title="Salin SSID" style="font-size: 10px;">
                  <i class="bi bi-clipboard"></i> Salin
                </button>
              </div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#wifiQrModal" onclick="openWifiQrModal()">
                <i class="bi bi-qr-code-scan me-1"></i> Tampilkan QR Code
              </button>
            </div>
          </div>

          <!-- Alert Feedback Container -->
          <div id="wifiAlertBox" class="alert d-none mb-3 py-2 px-3 small rounded-3" role="alert"></div>

          <!-- Tab Navigation -->
          <div class="wifi-tab-nav">
            <button type="button" class="wifi-tab-btn active" id="tabBtnBoth" onclick="switchWifiTab('both')">
              <i class="bi bi-gear-wide-connected"></i> Ganti Sekaligus
            </button>
            <button type="button" class="wifi-tab-btn" id="tabBtnSsid" onclick="switchWifiTab('ssid')">
              <i class="bi bi-tag-fill"></i> Ganti Nama Saja
            </button>
            <button type="button" class="wifi-tab-btn" id="tabBtnPw" onclick="switchWifiTab('password')">
              <i class="bi bi-key-fill"></i> Ganti Password Saja
            </button>
          </div>

          <!-- Form Tab 1: Ganti Sekaligus (SSID + Password) -->
          <form id="formWifiBoth" method="POST" action="/customer/change-wifi" onsubmit="handleWifiSubmit(event, 'both')">
            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Nama Wi-Fi (SSID) Baru</label>
              <div class="input-group">
                <span class="input-group-text bg-transparent border-secondary text-sub"><i class="bi bi-wifi"></i></span>
                <input type="text" class="form-control" id="inputBothSsid" name="ssid" value="<%= (customer && customer.ssid && customer.ssid !== '-' && customer.ssid !== 'N/A') ? customer.ssid : '' %>" placeholder="Contoh: Rumah-Keluarga" maxlength="32">
              </div>
              <div class="form-text text-sub" style="font-size: 11px;">Maksimal 32 karakter. Disarankan tidak menggunakan spasi atau karakter khusus.</div>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label text-sub small fw-semibold mb-0">Password Wi-Fi Baru</label>
                <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-info" style="font-size: 11px;" onclick="generateSafePassword('inputBothPw')">
                  <i class="bi bi-shuffle me-1"></i> Acak Password Aman
                </button>
              </div>
              <div class="input-group">
                <span class="input-group-text bg-transparent border-secondary text-sub"><i class="bi bi-lock"></i></span>
                <input type="password" id="inputBothPw" class="form-control" name="password" placeholder="Minimal 8 karakter" minlength="8" maxlength="32" oninput="updateStrengthMeter(this.value, 'meterBothBar', 'meterBothText')">
                <button type="button" class="btn btn-outline-custom" onclick="togglePasswordVisibility('inputBothPw', this)"><i class="bi bi-eye"></i></button>
              </div>
              <div class="pw-strength-meter">
                <div id="meterBothBar" class="pw-strength-bar"></div>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <span class="text-sub" style="font-size: 10px;">Kekuatan Password: <strong id="meterBothText" class="text-warning">Belum Diisi</strong></span>
                <span class="text-sub" style="font-size: 10px;">Min. 8 karakter</span>
              </div>
            </div>

            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="sync5gBoth" name="sync5g" value="true" checked>
              <label class="form-check-label text-sub small" for="sync5gBoth">
                Otomatis sinkronkan frekuensi 5 GHz (Nama SSID ditambah <code>-5G</code>)
              </label>
            </div>

            <div class="p-2 rounded-3 mb-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25);">
              <div class="small text-warning" style="font-size: 11px;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Perhatian:</strong> Setelah disimpan, semua perangkat (HP, Laptop, TV) akan terputus dari Wi-Fi. Anda harus menghubungkan kembali perangkat menggunakan nama/password baru.
              </div>
            </div>

            <button type="submit" id="btnSubmitBoth" class="btn btn-action-glow w-100 py-2">
              <i class="bi bi-check2-circle me-1"></i> Simpan Nama & Password Wi-Fi
            </button>
          </form>

          <!-- Form Tab 2: Ganti Nama SSID Saja -->
          <form id="formWifiSsid" method="POST" action="/customer/change-ssid" class="d-none" onsubmit="handleWifiSubmit(event, 'ssid')">
            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Nama Wi-Fi (SSID) Baru</label>
              <div class="input-group">
                <span class="input-group-text bg-transparent border-secondary text-sub"><i class="bi bi-wifi"></i></span>
                <input type="text" class="form-control" id="inputSsidOnly" name="ssid" value="<%= (customer && customer.ssid && customer.ssid !== '-' && customer.ssid !== 'N/A') ? customer.ssid : '' %>" placeholder="Masukkan nama Wi-Fi baru" required maxlength="32">
              </div>
              <div class="form-text text-sub" style="font-size: 11px;">Password Wi-Fi Anda tidak akan berubah, hanya nama sinyal Wi-Fi yang diperbarui.</div>
            </div>

            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="sync5gSsid" name="sync5g" value="true" checked>
              <label class="form-check-label text-sub small" for="sync5gSsid">
                Otomatis perbarui nama Wi-Fi 5 GHz (Nama-5G)
              </label>
            </div>

            <button type="submit" id="btnSubmitSsid" class="btn btn-primary w-100 py-2 rounded-3 fw-bold">
              <i class="bi bi-check-lg me-1"></i> Simpan Nama Wi-Fi (SSID)
            </button>
          </form>

          <!-- Form Tab 3: Ganti Password Saja -->
          <form id="formWifiPw" method="POST" action="/customer/change-password" class="d-none" onsubmit="handleWifiSubmit(event, 'password')">
            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label text-sub small fw-semibold mb-0">Password Wi-Fi Baru</label>
                <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-info" style="font-size: 11px;" onclick="generateSafePassword('inputPwOnly')">
                  <i class="bi bi-shuffle me-1"></i> Acak Password Aman
                </button>
              </div>
              <div class="input-group">
                <span class="input-group-text bg-transparent border-secondary text-sub"><i class="bi bi-lock"></i></span>
                <input type="password" id="inputPwOnly" class="form-control" name="password" placeholder="Minimal 8 karakter" required minlength="8" maxlength="32" oninput="updateStrengthMeter(this.value, 'meterPwBar', 'meterPwText')">
                <button type="button" class="btn btn-outline-custom" onclick="togglePasswordVisibility('inputPwOnly', this)"><i class="bi bi-eye"></i></button>
              </div>
              <div class="pw-strength-meter">
                <div id="meterPwBar" class="pw-strength-bar"></div>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <span class="text-sub" style="font-size: 10px;">Kekuatan Password: <strong id="meterPwText" class="text-warning">Belum Diisi</strong></span>
                <span class="text-sub" style="font-size: 10px;">Min. 8 karakter</span>
              </div>
            </div>

            <button type="submit" id="btnSubmitPw" class="btn btn-success w-100 py-2 rounded-3 fw-bold">
              <i class="bi bi-key-fill me-1"></i> Simpan Password Baru
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: QR CODE WI-FI RUMAH (SIAP SCAN & CETAK) -->
  <div class="modal fade" id="wifiQrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0">
          <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded-circle" style="background: rgba(59, 130, 246, 0.15); color: #38bdf8;">
              <i class="bi bi-qr-code-scan fs-4"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold text-main mb-0">QR Code Wi-Fi Rumah</h5>
              <span class="small text-sub" style="font-size: 11px;">Scan kamera untuk otomatis terhubung tanpa ketik password</span>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4 text-center">
          <div class="qr-standee-card">
            <div class="small text-uppercase tracking-wider text-muted fw-bold mb-1" style="font-size: 10px; letter-spacing: 1px;">Wi-Fi Tamu & Keluarga</div>
            <h5 class="fw-bold text-white mb-2" id="qrCardSsidTitle"><%= (customer && customer.ssid && customer.ssid !== '-' && customer.ssid !== 'N/A') ? customer.ssid : 'MyAdamedia-WiFi' %></h5>
            
            <div class="qr-frame">
              <img id="wifiQrImage" src="" alt="QR Code Wi-Fi" class="img-fluid" style="display: none;">
              <div id="wifiQrLoading" class="py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="small text-muted mt-2">Membuat kode QR...</div>
              </div>
            </div>

            <p class="small text-sub mb-3" style="font-size: 11px;">
              Arahkan kamera smartphone (iPhone / Android) ke kode QR ini untuk langsung tersambung ke internet rumah Anda.
            </p>

            <div class="d-flex gap-2 justify-content-center">
              <button type="button" class="btn btn-sm btn-outline-custom rounded-pill px-3" onclick="downloadWifiQrPng()">
                <i class="bi bi-download me-1"></i> Simpan Gambar QR
              </button>
              <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" onclick="copyCurrentSsid()">
                <i class="bi bi-clipboard me-1"></i> Salin Nama Wi-Fi
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: REBOOT ROUTER -->
  <div class="modal fade" id="rebootModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark text-center p-4">
        <div class="fs-1 text-danger mb-2"><i class="bi bi-arrow-repeat"></i></div>
        <h4 class="fw-bold text-main">Reboot Router Wi-Fi?</h4>
        <p class="text-sub small">Perangkat ONT/ONU Anda akan dinyalakan ulang (*restart*). Koneksi internet akan terputus sekitar 1-2 menit hingga router menyala kembali secara sempurna.</p>
        <div class="d-flex gap-2 justify-content-center mt-3">
          <button type="button" class="btn btn-outline-custom px-4 rounded-pill" data-bs-dismiss="modal">Batal</button>
          <form method="POST" action="/customer/reboot" class="m-0">
            <button type="submit" class="btn btn-danger px-4 rounded-pill fw-bold">Ya, Reboot Sekarang</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: PEMBAYARAN TAGIHAN -->
  <div class="modal fade" id="payModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-main"><i class="bi bi-wallet2 text-success me-2"></i> Pembayaran Tagihan</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="p-3 rounded-4 mb-3" style="background: rgba(99,102,241,0.18); border: 1px solid rgba(99,102,241,0.4);">
            <div class="text-sub small">Total Tagihan Yang Harus Dibayar</div>
            <div class="fs-3 fw-bold text-main">Rp <%= totalUnpaidAmount.toLocaleString('id-ID') %></div>
          </div>

          <form method="POST" action="/customer/payment/create">
            <% if (typeof invoices !== 'undefined' && invoices && invoices.filter(i => String(i.status).toLowerCase() !== 'paid').length > 0) { %>
              <div class="mb-3">
                <label class="form-label text-sub small fw-semibold">Pilih Tagihan</label>
                <select name="invoiceId" class="form-select" required>
                  <% invoices.filter(i => String(i.status).toLowerCase() !== 'paid').forEach(function(inv) { %>
                    <option value="<%= inv.id %>">#INV-<%= inv.id %> (Periode <%= monthNamesIndo[inv.period_month] || inv.period_month %> <%= inv.period_year %>) - Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %></option>
                  <% }); %>
                </select>
              </div>
            <% } %>

            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Pilih Metode Pembayaran</label>
              <select name="channel_code" class="form-select" required>
                <% if (typeof paymentChannels !== 'undefined' && paymentChannels && paymentChannels.length > 0) { %>
                  <% paymentChannels.forEach(function(ch) { %>
                    <option value="<%= ch.code %>"><%= ch.name %> (<%= ch.group %>)</option>
                  <% }); %>
                <% } else { %>
                  <option value="QRIS">QRIS Instant (All E-Wallet & Mobile Banking)</option>
                  <option value="BCAVA">BCA Virtual Account</option>
                  <option value="BNIVA">BNI Virtual Account</option>
                  <option value="BRIVA">BRI Virtual Account</option>
                  <option value="MANDIRIVA">Mandiri Virtual Account</option>
                <% } %>
              </select>
            </div>

            <button type="submit" class="btn btn-action-glow w-100 py-2">
              <i class="bi bi-qr-code-scan me-2"></i> Lanjutkan Pembayaran
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: LAPOR GANGGUAN / TIKET CS -->
  <div class="modal fade" id="ticketModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-main"><i class="bi bi-headset text-success me-2"></i> Lapor Kendala / Tiket Bantuan</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <form method="POST" action="/customer/tickets/create" enctype="multipart/form-data">
            <input type="hidden" name="customerId" value="<%= profile ? profile.id : '' %>">
            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Subjek Laporan / Kendala</label>
              <input type="text" name="subject" class="form-control" placeholder="Contoh: Lampu Los Merah / Internet Lambat" required>
            </div>

            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Deskripsi Rinci Kendala</label>
              <textarea name="message" rows="3" class="form-control" placeholder="Jelaskan kendala yang Anda alami..." required></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label text-sub small fw-semibold">Lampiran Foto (Opsional)</label>
              <input type="file" name="photos" class="form-control" accept="image/*" multiple>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
              <i class="bi bi-send-fill me-2"></i> Kirim Tiket Laporan
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- JS Dependencies & Gauge Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Auto-select invoice in payModal when clicking Bayar button in table
    function selectPayInvoice(invId) {
      const select = document.querySelector('#payModal select[name="invoiceId"]');
      if (select && invId) {
        select.value = invId;
      }
    }

    // Smooth scroll helper for bottom nav bar links
    function scrollToSection(sectionId) {
      const el = document.getElementById(sectionId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Visibility toggle for Wi-Fi password input (Legacy support)
    function togglePassVisibility() {
      const passInput = document.getElementById('wifiPassInput');
      const eyeIcon = document.getElementById('passEyeIcon');
      if (!passInput) return;
      if (passInput.type === 'password') {
        passInput.type = 'text';
        if (eyeIcon) eyeIcon.className = 'bi bi-eye-slash';
      } else {
        passInput.type = 'password';
        if (eyeIcon) eyeIcon.className = 'bi bi-eye';
      }
    }

    // ==========================================
    // WI-FI SELF SERVICE CLIENT CONTROLLERS
    // ==========================================
    function switchWifiTab(tab) {
      const formBoth = document.getElementById('formWifiBoth');
      const formSsid = document.getElementById('formWifiSsid');
      const formPw = document.getElementById('formWifiPw');
      const btnBoth = document.getElementById('tabBtnBoth');
      const btnSsid = document.getElementById('tabBtnSsid');
      const btnPw = document.getElementById('tabBtnPw');
      const alertBox = document.getElementById('wifiAlertBox');
      if (alertBox) alertBox.classList.add('d-none');

      if (tab === 'both') {
        if (formBoth) formBoth.classList.remove('d-none');
        if (formSsid) formSsid.classList.add('d-none');
        if (formPw) formPw.classList.add('d-none');
        if (btnBoth) btnBoth.classList.add('active');
        if (btnSsid) btnSsid.classList.remove('active');
        if (btnPw) btnPw.classList.remove('active');
      } else if (tab === 'ssid') {
        if (formBoth) formBoth.classList.add('d-none');
        if (formSsid) formSsid.classList.remove('d-none');
        if (formPw) formPw.classList.add('d-none');
        if (btnBoth) btnBoth.classList.remove('active');
        if (btnSsid) btnSsid.classList.add('active');
        if (btnPw) btnPw.classList.remove('active');
      } else if (tab === 'password') {
        if (formBoth) formBoth.classList.add('d-none');
        if (formSsid) formSsid.classList.remove('d-none');
        if (formPw) formPw.classList.remove('d-none');
        if (btnBoth) btnBoth.classList.remove('active');
        if (btnSsid) btnSsid.classList.remove('active');
        if (btnPw) btnPw.classList.add('active');
      }
    }

    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const icon = btn ? btn.querySelector('i') : null;
      if (input.type === 'password') {
        input.type = 'text';
        if (icon) {
          icon.classList.remove('bi-eye');
          icon.classList.add('bi-eye-slash');
        }
      } else {
        input.type = 'password';
        if (icon) {
          icon.classList.remove('bi-eye-slash');
          icon.classList.add('bi-eye');
        }
      }
    }

    function updateStrengthMeter(val, barId, textId) {
      const bar = document.getElementById(barId);
      const text = document.getElementById(textId);
      if (!bar || !text) return;

      const password = String(val || '');
      if (!password) {
        bar.style.width = '0%';
        bar.style.backgroundColor = 'transparent';
        text.innerText = 'Belum Diisi';
        text.className = 'text-warning';
        return;
      }

      let score = 0;
      if (password.length >= 8) score += 1;
      if (password.length >= 10) score += 1;
      if (/[a-z]/.test(password) && /[A-Z]/.test(password)) score += 1;
      if (/\d/.test(password)) score += 1;
      if (/[^a-zA-Z0-9]/.test(password)) score += 1;

      if (password.length < 8) {
        bar.style.width = '25%';
        bar.style.backgroundColor = '#ef4444';
        text.innerText = 'Terlalu Pendek (Min 8 Karakter)';
        text.className = 'text-danger';
      } else if (score <= 2) {
        bar.style.width = '45%';
        bar.style.backgroundColor = '#f97316';
        text.innerText = 'Cukup Lemah';
        text.className = 'text-warning';
      } else if (score <= 4) {
        bar.style.width = '75%';
        bar.style.backgroundColor = '#eab308';
        text.innerText = 'Kuat & Aman';
        text.className = 'text-info';
      } else {
        bar.style.width = '100%';
        bar.style.backgroundColor = '#10b981';
        text.innerText = 'Sangat Kuat!';
        text.className = 'text-success';
      }
    }

    function generateSafePassword(inputId) {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%&*';
      const uppers = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
      const lowers = 'abcdefghijkmnopqrstuvwxyz';
      const digits = '23456789';
      const symbols = '!@#$%&*';

      let password = '';
      password += uppers.charAt(Math.floor(Math.random() * uppers.length));
      password += lowers.charAt(Math.floor(Math.random() * lowers.length));
      password += digits.charAt(Math.floor(Math.random() * digits.length));
      password += symbols.charAt(Math.floor(Math.random() * symbols.length));

      for (let i = 4; i < 11; i++) {
        password += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      password = password.split('').sort(() => 0.5 - Math.random()).join('');

      const input = document.getElementById(inputId);
      if (input) {
        input.value = password;
        input.type = 'text';
        const btn = input.nextElementSibling;
        if (btn) {
          const icon = btn.querySelector('i');
          if (icon) {
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
          }
        }
        if (inputId === 'inputBothPw') {
          updateStrengthMeter(password, 'meterBothBar', 'meterBothText');
        } else if (inputId === 'inputPwOnly') {
          updateStrengthMeter(password, 'meterPwBar', 'meterPwText');
        }
      }
    }

    function copyCurrentSsid() {
      const ssidEl = document.getElementById('liveCurrentSsid');
      const ssid = ssidEl ? ssidEl.innerText.trim() : '';
      if (!ssid || ssid === 'Belum Terdeteksi' || ssid === '-') {
        alert('Nama Wi-Fi belum terdeteksi.');
        return;
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(ssid).then(() => {
          alert(`Nama Wi-Fi "${ssid}" berhasil disalin ke clipboard!`);
        }).catch(() => {
          prompt('Salin nama Wi-Fi ini:', ssid);
        });
      } else {
        prompt('Salin nama Wi-Fi ini:', ssid);
      }
    }

    async function loadLiveWifiInfo() {
      try {
        const res = await fetch('/customer/api/wifi/info');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.ok && data.data) {
          const ssid = data.data.ssid24 || data.data.ssid5g || '';
          if (ssid && ssid !== '-') {
            const ssidEl = document.getElementById('liveCurrentSsid');
            if (ssidEl) ssidEl.innerText = ssid;
            const btnLabel = document.getElementById('btnWifiSsidLabel');
            if (btnLabel) {
              btnLabel.innerText = ssid;
              btnLabel.title = ssid;
            }
            const qrTitle = document.getElementById('qrCardSsidTitle');
            if (qrTitle) qrTitle.innerText = ssid;

            const inputBothSsid = document.getElementById('inputBothSsid');
            if (inputBothSsid && !inputBothSsid.value) inputBothSsid.value = ssid;
            const inputSsidOnly = document.getElementById('inputSsidOnly');
            if (inputSsidOnly && !inputSsidOnly.value) inputSsidOnly.value = ssid;
          }
          const dot = document.getElementById('wifiRouterPulseDot');
          const statusText = document.getElementById('wifiRouterStatusText');
          if (dot && statusText) {
            if (data.data.online) {
              dot.className = 'pulse-dot-online';
              statusText.innerText = 'Router Online (' + (data.data.model || 'ONT') + ')';
            } else {
              dot.className = 'pulse-dot-offline';
              statusText.innerText = 'Router Offline / Standby';
            }
          }
        }
      } catch (e) {
        console.debug('loadLiveWifiInfo error', e);
      }
    }

    async function openWifiQrModal() {
      const loading = document.getElementById('wifiQrLoading');
      const img = document.getElementById('wifiQrImage');
      const cardTitle = document.getElementById('qrCardSsidTitle');

      if (loading) loading.style.display = 'block';
      if (img) img.style.display = 'none';

      const currentSsid = (document.getElementById('liveCurrentSsid')?.innerText || '').trim();
      const validSsid = (currentSsid && currentSsid !== 'Belum Terdeteksi' && currentSsid !== '-') ? currentSsid : '';
      if (cardTitle && validSsid) cardTitle.innerText = validSsid;

      try {
        const url = '/customer/api/wifi/qr' + (validSsid ? `?ssid=${encodeURIComponent(validSsid)}` : '');
        const res = await fetch(url);
        const data = await res.json();
        if (data && data.ok && data.qrDataUrl) {
          if (img) {
            img.src = data.qrDataUrl;
            img.style.display = 'inline-block';
          }
          if (cardTitle && data.ssid) cardTitle.innerText = data.ssid;
          if (loading) loading.style.display = 'none';
        } else {
          if (loading) loading.innerHTML = `<span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i> ${data?.error || 'Gagal memuat QR Code'}</span>`;
        }
      } catch (err) {
        if (loading) loading.innerHTML = `<span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i> Terjadi kesalahan memuat QR</span>`;
      }
    }

    function downloadWifiQrPng() {
      const img = document.getElementById('wifiQrImage');
      if (!img || !img.src) {
        alert('QR Code belum selesai dimuat.');
        return;
      }
      const currentSsid = document.getElementById('qrCardSsidTitle')?.innerText || 'WiFi';
      const a = document.createElement('a');
      a.href = img.src;
      a.download = `WiFi-QR-${currentSsid.replace(/\s+/g, '_')}.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    async function handleWifiSubmit(event, mode) {
      event.preventDefault();
      const alertBox = document.getElementById('wifiAlertBox');
      if (alertBox) alertBox.classList.add('d-none');

      let ssid = '';
      let password = '';
      let sync5g = true;
      let btn = null;
      let originalBtnHtml = '';

      if (mode === 'both') {
        ssid = (document.getElementById('inputBothSsid')?.value || '').trim();
        password = (document.getElementById('inputBothPw')?.value || '').trim();
        sync5g = document.getElementById('sync5gBoth')?.checked ?? true;
        btn = document.getElementById('btnSubmitBoth');
      } else if (mode === 'ssid') {
        ssid = (document.getElementById('inputSsidOnly')?.value || '').trim();
        sync5g = document.getElementById('sync5gSsid')?.checked ?? true;
        btn = document.getElementById('btnSubmitSsid');
      } else if (mode === 'password') {
        password = (document.getElementById('inputPwOnly')?.value || '').trim();
        btn = document.getElementById('btnSubmitPw');
      }

      if (mode === 'both' && !ssid && !password) {
        showAlert('danger', 'Mohon isi Nama Wi-Fi (SSID) atau Password baru.');
        return;
      }
      if (mode === 'ssid' && !ssid) {
        showAlert('danger', 'Nama Wi-Fi (SSID) tidak boleh kosong.');
        return;
      }
      if (mode === 'password' && (!password || password.length < 8)) {
        showAlert('danger', 'Password Wi-Fi baru minimal 8 karakter.');
        return;
      }
      if (password && password.length < 8) {
        showAlert('danger', 'Password Wi-Fi baru minimal 8 karakter.');
        return;
      }

      const confirmMsg = "Perhatian: Semua perangkat yang terhubung (HP/Laptop) akan terputus dari Wi-Fi setelah perubahan ini disimpan.\\n\\nApakah Anda yakin ingin melanjutkan?";
      if (!confirm(confirmMsg)) return;

      if (btn) {
        originalBtnHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Menyimpan ke Router...';
      }

      try {
        const res = await fetch('/customer/api/wifi/update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ ssid, password, sync5g })
        });

        const data = await res.json();

        if (res.ok && data.ok) {
          showAlert('success', `<i class="bi bi-check-circle-fill me-1"></i> <strong>Berhasil!</strong> ${data.message || 'Konfigurasi Wi-Fi berhasil diperbarui.'} Silakan sambungkan kembali perangkat Anda.`);
          if (ssid) {
            const ssidEl = document.getElementById('liveCurrentSsid');
            if (ssidEl) ssidEl.innerText = ssid;
            const btnLabel = document.getElementById('btnWifiSsidLabel');
            if (btnLabel) {
              btnLabel.innerText = ssid;
              btnLabel.title = ssid;
            }
          }
          if (document.getElementById('inputBothPw')) document.getElementById('inputBothPw').value = '';
          if (document.getElementById('inputPwOnly')) document.getElementById('inputPwOnly').value = '';
          updateStrengthMeter('', 'meterBothBar', 'meterBothText');
          updateStrengthMeter('', 'meterPwBar', 'meterPwText');
        } else {
          showAlert('danger', `<i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Gagal:</strong> ${data.error || 'Gagal mengubah konfigurasi Wi-Fi. Silakan coba lagi.'}`);
        }
      } catch (err) {
        showAlert('danger', `<i class="bi bi-exclamation-triangle-fill me-1"></i> Terjadi kesalahan koneksi: ${err.message}`);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalBtnHtml;
        }
      }

      function showAlert(type, html) {
        if (!alertBox) return;
        alertBox.className = `alert alert-${type} mb-3 py-2 px-3 small rounded-3`;
        alertBox.innerHTML = html;
        alertBox.classList.remove('d-none');
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // Diagnostic Test Simulator
    function runDiagnosticTest() {
      const box = document.getElementById('diagnosticBox');
      const status = document.getElementById('diagStatus');
      const details = document.getElementById('diagDetails');
      box.classList.remove('d-none');
      status.className = 'badge bg-warning text-dark fw-bold';
      status.innerText = 'MEMERIKSA...';
      details.innerText = 'Memeriksa sinyal optic, ping latensi, dan status port ONT...';

      setTimeout(() => {
        status.className = 'badge bg-success';
        status.innerText = 'ONLINE NORMAL';
        details.innerText = 'Koneksi ONT stabil. Latensi: 12ms. Sinyal Optik: Bagus. Tidak ditemukan gangguan fisik.';
      }, 1500);
    }

    // Canvas Speed Gauge Drawing Helper with High DPR & Perfect Alignment
    function drawSpeedGauge(canvasId, value, maxVal, colorHex) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      
      const rect = canvas.getBoundingClientRect();
      const width = rect.width || 180;
      const height = 130;
      
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height - 18;
      const radius = Math.min(width / 2 - 15, 68);
      const startAngle = Math.PI * 0.82;
      const endAngle = Math.PI * 2.18;

      // Background Arc
      ctx.beginPath();
      ctx.arc(cx, cy, radius, startAngle, endAngle, false);
      ctx.lineWidth = 12;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
      ctx.lineCap = 'round';
      ctx.stroke();

      // Progress Arc
      const pct = Math.min(1, Math.max(0, value / maxVal));
      if (pct > 0) {
        const valAngle = startAngle + (pct * (endAngle - startAngle));
        ctx.beginPath();
        ctx.arc(cx, cy, radius, startAngle, valAngle, false);
        ctx.lineWidth = 12;
        ctx.strokeStyle = colorHex;
        ctx.lineCap = 'round';
        ctx.shadowColor = colorHex;
        ctx.shadowBlur = 10;
        ctx.stroke();
      }
    }

    // Real-Time Traffic Polling
    function fetchTrafficData() {
      fetch('/customer/api/pppoe-traffic')
        .then(res => res.json())
        .then(data => {
          if (data && data.ok) {
            const rxNum = parseFloat(data.rxMbps || 0);
            const txNum = parseFloat(data.txMbps || 0);
            
            const rxVal = rxNum.toFixed(1);
            const txVal = txNum.toFixed(1);

            document.getElementById('pppoe_rx_value').innerText = rxVal;
            document.getElementById('pppoe_tx_value').innerText = txVal;

            const rxUnit = document.getElementById('pppoe_rx_unit');
            if (rxUnit && rxUnit.innerText !== 'Mbps') rxUnit.innerText = 'Mbps';
            const txUnit = document.getElementById('pppoe_tx_unit');
            if (txUnit && txUnit.innerText !== 'Mbps') txUnit.innerText = 'Mbps';

            let rxMax = parseFloat(document.getElementById('pppoe_rx_gauge').dataset.max || 10);
            let txMax = parseFloat(document.getElementById('pppoe_tx_gauge').dataset.max || 10);

            if (rxNum > rxMax) rxMax = Math.ceil(rxNum * 1.2);
            if (txNum > txMax) txMax = Math.ceil(txNum * 1.2);

            drawSpeedGauge('pppoe_rx_gauge', rxNum, rxMax, '#10b981');
            drawSpeedGauge('pppoe_tx_gauge', txNum, txMax, '#3b82f6');
          }
        })
        .catch(() => {});
    }

    function togglePassVisibility() {
      const input = document.getElementById('wifiPassInput');
      const icon = document.getElementById('passEyeIcon');
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        if (icon) {
          icon.classList.remove('bi-eye');
          icon.classList.add('bi-eye-slash');
        }
      } else {
        input.type = 'password';
        if (icon) {
          icon.classList.remove('bi-eye-slash');
          icon.classList.add('bi-eye');
        }
      }
    }

    async function deleteCustomerConnectedClient(mac, ip, hostname) {
      if (!confirm(`Apakah Anda yakin ingin menghapus perangkat "${hostname}" (${mac || ip}) dari daftar terhubung?`)) return;
      try {
        const res = await fetch('/customer/delete-connected-client', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ mac, ip })
        });
        const data = await res.json();
        if (data.ok) {
          alert(data.message || 'Perangkat berhasil dihapus dari daftar terhubung.');
          window.location.reload();
        } else {
          alert('Gagal: ' + (data.message || 'Gagal menghapus perangkat terhubung.'));
        }
      } catch (e) {
        alert('Error: ' + e.message);
      }
    }

    async function fetchDeviceMetrics() {
      try {
        const res = await fetch('/customer/api/device-metrics');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.ok) {
          // 1. Update Optical RX Power
          const rxContainer = document.getElementById('liveRxPowerContainer');
          if (rxContainer) {
            if (data.rxPower && data.rxPower !== '-' && data.rxPower !== 'N/A') {
              let html = `<span id="liveRxPowerValue">${data.rxPower} dBm</span>`;
              if (data.isEstimatedRx) {
                html += ` <span class="badge bg-secondary-subtle text-light rounded-pill px-2 py-0 ms-1" style="font-size: 9px;" id="liveRxEstBadge" title="Estimasi Teoretis Link Budget ODP">Estimasi</span>`;
              } else if (data.opticalQuality && data.opticalQuality.statusLabel) {
                const col = data.opticalQuality.color || '#10b981';
                html += ` <span class="badge rounded-pill px-2 py-0 ms-1" style="font-size: 9px; background-color: ${col}22; color: ${col}; border: 1px solid ${col}44;" id="liveRxStatusBadge" title="${data.opticalQuality.diagnosis || ''}">${data.opticalQuality.statusLabel}</span>`;
              }
              rxContainer.innerHTML = html;
            } else {
              rxContainer.innerHTML = `<span class="text-muted small" id="liveRxPowerValue">Belum Terdeteksi</span>`;
            }
          }

          // 2. Update Connected Count & Badge
          const countEl = document.getElementById('liveConnectedCount');
          const badgeEl = document.getElementById('liveClientsBadge');
          const users = Array.isArray(data.connectedUsers) ? data.connectedUsers : [];
          const totalAssoc = typeof data.totalAssociations === 'number' ? data.totalAssociations : 0;
          const displayCount = users.length > 0 ? users.length : totalAssoc;

          if (countEl) countEl.innerText = displayCount;
          if (badgeEl) badgeEl.innerText = `${displayCount} Active`;

          const tbody = document.getElementById('liveConnectedClientsTbody');
          if (tbody && users.length > 0) {
            let rowsHtml = '';
            users.forEach(function(dev) {
              const iface = String(dev.iface || '');
              const isWiFi = iface.toLowerCase().includes('wifi') || iface.toLowerCase().includes('wlan') || iface.toLowerCase().includes('802.11');
              const isDevOnline = String(dev.status || '').toLowerCase() === 'online' || String(dev.status || '').toLowerCase() === 'active' || String(dev.status || '') === '1' || dev.active === true;
              rowsHtml += `<tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background: rgba(99,102,241,0.2); color: var(--primary-accent); width: 34px; height: 34px;">
                      <i class="bi bi-${isWiFi ? 'wifi' : 'ethernet'} fs-5"></i>
                    </div>
                    <div>
                      <div class="fw-bold text-main">${dev.hostname || 'Device'}</div>
                      <div class="small text-sub">${iface || 'LAN/WLAN'}</div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="small text-main fw-semibold">${dev.ip || '-'}</div>
                  <div class="small text-sub font-monospace" style="font-size: 10px;">${dev.mac || '-'}</div>
                </td>
                <td>
                  <span class="pill-badge ${isDevOnline ? 'pill-active' : 'pill-suspended'}" style="font-size: 9px;">
                    ${isDevOnline ? 'ONLINE' : 'OFFLINE'}
                  </span>
                </td>
                <td class="text-end">
                  <button class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 28px; height: 28px; line-height: 1;" onclick="deleteCustomerConnectedClient('${dev.mac || ''}', '${dev.ip || ''}', '${dev.hostname || 'Perangkat'}')" title="Hapus Perangkat Terhubung">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>`;
            });
            tbody.innerHTML = rowsHtml;
          }

          // 3. Update SSID if available
          if (data.ssid && data.ssid !== '-' && data.ssid !== 'N/A') {
            const btnSsid = document.getElementById('btnWifiSsidLabel');
            if (btnSsid) {
              btnSsid.innerText = data.ssid;
              btnSsid.title = data.ssid;
            }
          }
        }
      } catch (e) {
        console.debug('fetchDeviceMetrics error', e);
      }
    }

    window.onload = function() {
      drawSpeedGauge('pppoe_rx_gauge', 0, 10, '#10b981');
      drawSpeedGauge('pppoe_tx_gauge', 0, 10, '#3b82f6');
      fetchTrafficData();
      setInterval(fetchTrafficData, 2000);
      fetchDeviceMetrics();
      setInterval(fetchDeviceMetrics, 12000);
    };

    window.onresize = function() {
      fetchTrafficData();
    };

    (function () {
      const themeToggleBtn = document.getElementById('themeToggleBtn');
      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', function () {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', newTheme);
          try {
            localStorage.setItem('theme', newTheme);
          } catch (e) {}
        });
      }
    })();
  </script>
</body>
</html>
