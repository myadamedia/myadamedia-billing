<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= company %></title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="/img/logo.png">
  <!-- PWA Meta tags -->
  <link rel="manifest" href="/sso.webmanifest">
  <meta name="theme-color" content="#0f172a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="<%= company %> SSO">
  <link rel="apple-touch-icon" href="/img/pwa-icon-192.png">
  <style>
    body {
      background: radial-gradient(1200px 600px at 10% 0%, rgba(99, 102, 241, 0.22) 0%, rgba(15, 23, 42, 0) 60%),
        radial-gradient(900px 450px at 100% 0%, rgba(59, 130, 246, 0.18) 0%, rgba(15, 23, 42, 0) 55%),
        #0f172a;
      color: #e2e8f0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
    }

    .sso-wrapper {
      max-width: 900px;
      width: 100%;
    }

    .sso-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .logo-container {
      background: #ffffff;
      padding: 10px 24px;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logo-container img {
      height: 48px;
      width: auto;
      object-fit: contain;
    }

    .company-title {
      font-size: 26px;
      font-weight: 800;
      background: linear-gradient(135deg, #f8fafc 30%, #94a3b8 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 5px;
    }

    .sso-subtitle {
      color: #64748b;
      font-size: 15px;
      font-weight: 600;
    }

    .sso-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    @media (max-width: 768px) {
      .sso-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
    }

    .portal-card {
      background: rgba(30, 41, 59, 0.6);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
      display: flex;
      align-items: flex-start;
      gap: 20px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
    }

    .portal-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .portal-card:hover {
      transform: translateY(-5px);
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
      color: #fff;
    }

    .portal-card:hover::before {
      opacity: 1;
    }

    .portal-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: white;
      flex-shrink: 0;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.35);
    }

    .icon-admin {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    }

    .icon-tech {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .icon-collector {
      background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
    }

    .icon-agent {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    }

    .icon-investor {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    }

    .portal-info {
      flex: 1;
      min-width: 0;
    }

    .portal-name {
      font-size: 18px;
      font-weight: 800;
      margin-bottom: 8px;
      color: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .portal-desc {
      font-size: 13px;
      color: #94a3b8;
      line-height: 1.5;
      font-weight: 500;
    }

    .portal-arrow {
      font-size: 16px;
      color: #475569;
      transition: transform 0.3s ease, color 0.3s ease;
    }

    .portal-card:hover .portal-arrow {
      transform: translateX(4px);
      color: #f8fafc;
    }

    .sso-footer {
      text-align: center;
      margin-top: 50px;
      color: #475569;
      font-size: 12px;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="sso-wrapper">
    <div class="sso-header">
      <div class="logo-container">
        <img src="/img/logo.png" alt="Company Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/10061/10061739.png'">
      </div>
      <h1 class="company-title"><%= company %></h1>
      <p class="sso-subtitle"><i class="bi bi-shield-check me-1"></i> Single Sign-On (SSO) Portal Gateway</p>
    </div>

    <div class="sso-grid">
      <!-- Portal Admin -->
      <a href="/admin/login" class="portal-card">
        <div class="portal-icon icon-admin">
          <i class="bi bi-shield-lock-fill"></i>
        </div>
        <div class="portal-info">
          <div class="portal-name">
            <span>Portal Administrator</span>
            <i class="bi bi-arrow-right portal-arrow"></i>
          </div>
          <p class="portal-desc">Mengelola tagihan pelanggan, pemantauan sistem OLT/ONU, paket internet, payroll, dan konfigurasi utama aplikasi.</p>
        </div>
      </a>

      <!-- Portal Teknisi -->
      <a href="/tech/login" class="portal-card">
        <div class="portal-icon icon-tech">
          <i class="bi bi-wrench-adjustable-circle-fill"></i>
        </div>
        <div class="portal-info">
          <div class="portal-name">
            <span>Portal Teknisi</span>
            <i class="bi bi-arrow-right portal-arrow"></i>
          </div>
          <p class="portal-desc">Mengelola tiket gangguan/keluhan pelanggan, provisioning ONU baru, peta jaringan, dan detail ODP.</p>
        </div>
      </a>

      <!-- Portal Kolektor -->
      <a href="/collector/login" class="portal-card">
        <div class="portal-icon icon-collector">
          <i class="bi bi-cash-coin"></i>
        </div>
        <div class="portal-info">
          <div class="portal-name">
            <span>Portal Kolektor</span>
            <i class="bi bi-arrow-right portal-arrow"></i>
          </div>
          <p class="portal-desc">Mencatat pembayaran tagihan pelanggan secara langsung di lapangan dan pengajuan setoran harian.</p>
        </div>
      </a>

      <!-- Portal Investor -->
      <a href="/investor/login" class="portal-card">
        <div class="portal-icon icon-investor">
          <i class="bi bi-graph-up-arrow"></i>
        </div>
        <div class="portal-info">
          <div class="portal-name">
            <span>Portal Investor</span>
            <i class="bi bi-arrow-right portal-arrow"></i>
          </div>
          <p class="portal-desc">Pantau statistik performa bisnis, laporan keuangan, pembagian dividen/laba bersih, dan peta jaringan infrastruktur.</p>
        </div>
      </a>
    </div>

    <div class="sso-footer">
      <span><%= company %> &copy; 2026 | Version <%= version %></span>
    </div>
  </div>

  <!-- PWA Install Banner UI -->
  <div id="pwa-install-container" class="position-fixed bottom-0 start-50 translate-middle-x mb-4 z-3" style="display: none; max-width: 90%; width: 400px;">
    <div class="card border-0 shadow-lg text-white" style="background: rgba(30, 41, 59, 0.95); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px;">
      <div class="card-body p-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary bg-gradient rounded-3 p-2 text-white d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);">
            <i class="bi bi-phone-vibrate-fill fs-5"></i>
          </div>
          <div>
            <h6 class="card-title mb-0 fw-bold" style="font-size: 14px; background: linear-gradient(135deg, #f8fafc 30%, #cbd5e1 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">Install Aplikasi SSO</h6>
            <p class="card-text mb-0 text-muted" style="font-size: 11px;">Akses cepat & lebih hemat kuota</p>
          </div>
        </div>
        <div class="d-flex gap-2">
          <button id="pwa-install-btn" class="btn btn-primary btn-sm px-3 rounded-pill fw-bold" style="font-size: 12px; box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);">
            Install
          </button>
          <button id="pwa-close-btn" class="btn btn-link btn-sm text-muted text-decoration-none p-0 px-1" style="font-size: 18px;">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Register Service Worker for SSO PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw-sso.js')
          .then((reg) => {
            console.log('SSO Service Worker registered with scope:', reg.scope);
          })
          .catch((err) => {
            console.error('SSO Service Worker registration failed:', err);
          });
      });
    }

    // PWA Install Prompt handling
    let deferredPrompt;
    const installContainer = document.getElementById('pwa-install-container');
    const installBtn = document.getElementById('pwa-install-btn');
    const closeBtn = document.getElementById('pwa-close-btn');

    // Only show if user has not dismissed it in this session
    const isDismissed = sessionStorage.getItem('pwa-install-dismissed');

    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent Chrome 67 and earlier from automatically showing the prompt
      e.preventDefault();
      // Stash the event so it can be triggered later.
      deferredPrompt = e;
      
      // Update UI to notify the user they can install the PWA
      if (!isDismissed && installContainer) {
        installContainer.style.display = 'block';
        // Add fade-in animation
        installContainer.animate([
          { opacity: 0, transform: 'translate(-50%, 20px)' },
          { opacity: 1, transform: 'translate(-50%, 0)' }
        ], {
          duration: 400,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'forwards'
        });
      }
    });

    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        // Show the install prompt
        deferredPrompt.prompt();
        // Wait for the user to respond to the prompt
        const { outcome } = await deferredPrompt.userChoice;
        console.log(`User response to the install prompt: ${outcome}`);
        // We've used the prompt, and can't use it again
        deferredPrompt = null;
        // Hide the install button
        if (installContainer) {
          installContainer.style.display = 'none';
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        sessionStorage.setItem('pwa-install-dismissed', 'true');
        if (installContainer) {
          // Fade-out animation
          const anim = installContainer.animate([
            { opacity: 1, transform: 'translate(-50%, 0)' },
            { opacity: 0, transform: 'translate(-50%, 20px)' }
          ], {
            duration: 300,
            easing: 'ease-in',
            fill: 'forwards'
          });
          anim.onfinish = () => {
            installContainer.style.display = 'none';
          };
        }
      });
    }

    // Hide if already installed (appinstalled event)
    window.addEventListener('appinstalled', (evt) => {
      console.log('SSO App was successfully installed');
      if (installContainer) {
        installContainer.style.display = 'none';
      }
    });
  </script>
</body>
</html>
