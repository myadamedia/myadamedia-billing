<% const bottomNavOffset = (typeof hasBottomNav !== 'undefined' && hasBottomNav) ? '85px' : '20px'; %>
<style>
  .pwa-install-banner {
    position: fixed;
    bottom: var(--pwa-bottom-offset, 20px);
    left: 16px;
    right: 16px;
    z-index: 9999;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.98) 0%, rgba(15, 23, 42, 0.99) 100%) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(99, 102, 241, 0.25) !important;
    border-radius: 16px !important;
    display: none;
    max-width: 480px;
    margin: 0 auto;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6) !important;
    transition: transform 0.3s ease, opacity 0.3s ease;
    opacity: 0;
    box-sizing: border-box !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
  }
  .pwa-install-banner *, .pwa-install-banner *::before, .pwa-install-banner *::after {
    box-sizing: border-box !important;
  }
  .pwa-install-body {
    padding: 12px 16px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
    width: 100% !important;
  }
  .pwa-install-info {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    flex: 1 !important;
    min-width: 0 !important;
  }
  .pwa-install-icon-wrapper {
    flex-shrink: 0 !important;
    width: 44px !important;
    height: 44px !important;
    background: linear-gradient(135deg, #6366f1 0%, #3b82f6 100%) !important;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35) !important;
    border-radius: 10px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .pwa-install-icon {
    width: 28px !important;
    height: 28px !important;
    object-fit: contain !important;
    display: block !important;
  }
  .pwa-install-text {
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
    text-align: left !important;
  }
  .pwa-install-title {
    margin: 0 !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    line-height: 1.3 !important;
  }
  .pwa-install-desc {
    margin: 0 !important;
    font-size: 11px !important;
    color: #94a3b8 !important;
    line-height: 1.3 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
  .pwa-install-actions {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    flex-shrink: 0 !important;
  }
  .pwa-install-btn-action {
    background: linear-gradient(135deg, #6366f1 0%, #3b82f6 100%) !important;
    color: #ffffff !important;
    border: none !important;
    padding: 8px 16px !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    border-radius: 20px !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.4) !important;
    line-height: 1.2 !important;
    text-decoration: none !important;
  }
  .pwa-install-btn-action:hover {
    transform: translateY(-1px) !important;
    box-shadow: 0 6px 14px rgba(99, 102, 241, 0.5) !important;
  }
  .pwa-install-btn-action:active {
    transform: translateY(0) !important;
  }
  .pwa-install-btn-close {
    background: none !important;
    border: none !important;
    color: #94a3b8 !important;
    padding: 6px !important;
    cursor: pointer !important;
    font-size: 14px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: color 0.2s ease !important;
  }
  .pwa-install-btn-close:hover {
    color: #f1f5f9 !important;
  }
  
  @media (max-width: 480px) {
    .pwa-install-banner {
      left: 12px !important;
      right: 12px !important;
      border-radius: 12px !important;
    }
    .pwa-install-body {
      padding: 10px 12px !important;
      gap: 8px !important;
    }
    .pwa-install-info {
      gap: 10px !important;
    }
    .pwa-install-icon-wrapper {
      width: 38px !important;
      height: 38px !important;
      border-radius: 8px !important;
    }
    .pwa-install-icon {
      width: 24px !important;
      height: 24px !important;
    }
    .pwa-install-title {
      font-size: 12px !important;
    }
    .pwa-install-desc {
      font-size: 10px !important;
      max-width: 160px !important;
    }
    .pwa-install-btn-action {
      padding: 6px 12px !important;
      font-size: 11px !important;
    }
  }
</style>

<!-- Floating PWA Install Banner -->
<div id="pwa-install-banner" class="pwa-install-banner" style="--pwa-bottom-offset: <%= bottomNavOffset %>;">
  <div class="pwa-install-body">
    <div class="pwa-install-info">
      <div class="pwa-install-icon-wrapper">
        <img src="/img/pwa-icon.svg" alt="App Icon" class="pwa-install-icon">
      </div>
      <div class="pwa-install-text">
        <h6 class="pwa-install-title"><%= t('customer.pwa.install_title', 'Install Aplikasi Portal') %></h6>
        <p class="pwa-install-desc"><%= t('customer.pwa.install_desc', 'Akses cepat & hemat kuota di HP Anda') %></p>
      </div>
    </div>
    <div class="pwa-install-actions">
      <button id="pwa-install-btn" class="pwa-install-btn-action">
        <%= t('customer.pwa.install_btn', 'Install') %>
      </button>
      <button id="pwa-close-btn" class="pwa-install-btn-close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    let deferredPrompt;
    const installBanner = document.getElementById('pwa-install-banner');
    const installBtn = document.getElementById('pwa-install-btn');
    const closeBtn = document.getElementById('pwa-close-btn');

    if (!installBanner || !installBtn || !closeBtn) return;

    // Check if user dismissed the banner previously (valid for 7 days)
    const isDismissed = () => {
      const dismissedTime = localStorage.getItem('pwa-prompt-dismissed');
      if (!dismissedTime) return false;
      const days = (Date.now() - parseInt(dismissedTime, 10)) / (1000 * 60 * 60 * 24);
      return days < 7; // Show again after 7 days
    };

    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent the mini-infobar from appearing on mobile
      e.preventDefault();
      // Stash the event so it can be triggered later.
      deferredPrompt = e;
      
      // Update UI notify the user they can install the PWA
      if (!isDismissed()) {
        setTimeout(() => {
          installBanner.style.display = 'block';
          installBanner.style.transform = 'translateY(20px)';
          // Simple animation
          requestAnimationFrame(() => {
            setTimeout(() => {
              installBanner.style.transform = 'translateY(0)';
              installBanner.style.opacity = '1';
            }, 50);
          });
        }, 1500); // Slight delay for better UX
      }
    });

    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      // Show the install prompt
      deferredPrompt.prompt();
      // Wait for the user to respond to the prompt
      const { outcome } = await deferredPrompt.userChoice;
      console.log(`PWA install choice: ${outcome}`);
      // We've used the prompt, and can't use it again
      deferredPrompt = null;
      // Hide the install banner
      installBanner.style.display = 'none';
    });

    closeBtn.addEventListener('click', () => {
      // Hide banner and save dismissed timestamp
      installBanner.style.display = 'none';
      localStorage.setItem('pwa-prompt-dismissed', Date.now().toString());
    });

    window.addEventListener('appinstalled', (evt) => {
      console.log('PWA was installed');
      installBanner.style.display = 'none';
      deferredPrompt = null;
    });
  })();
</script>
