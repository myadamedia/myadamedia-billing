<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang ? lang : 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof t === 'function' ? t('customer.login_title', 'Login Pelanggan') : 'Login Pelanggan' %> | <%= (settings && settings.company_header) ? settings.company_header : 'Portal ISP' %></title>
  
  <!-- CSS Dependencies -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0b0f19">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root {
      --bg-dark: #0b0f19;
      --card-bg: rgba(17, 24, 39, 0.82);
      --card-border: rgba(255, 255, 255, 0.12);
      --card-hover: rgba(99, 102, 241, 0.4);
      --primary-accent: #6366f1;
      --primary-glow: rgba(99, 102, 241, 0.4);
      --text-main: #f8fafc;
      --text-sub: #cbd5e1;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.20) 0%, transparent 50%),
        radial-gradient(circle at 85% 20%, rgba(16, 185, 129, 0.12) 0%, transparent 50%),
        radial-gradient(circle at 50% 85%, rgba(139, 92, 246, 0.15) 0%, transparent 55%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px 15px;
    }

    .text-muted { color: var(--text-muted) !important; }
    .text-sub { color: var(--text-sub) !important; }

    /* Login Card Glassmorphism */
    .login-wrapper {
      width: 100%;
      max-width: 440px;
      margin: 0 auto;
    }

    .login-card {
      background: var(--card-bg);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      border: 1px solid var(--card-border);
      border-radius: 28px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(99, 102, 241, 0.08);
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .login-header-box {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.20) 0%, rgba(17, 24, 39, 0.6) 100%);
      border-bottom: 1px solid var(--card-border);
      padding: 32px 24px 24px;
      text-align: center;
    }

    .brand-logo-container {
      background: #ffffff;
      padding: 8px 18px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .brand-logo-container img {
      height: 42px;
      width: auto;
      object-fit: contain;
    }

    .login-body-box {
      padding: 30px 24px 24px;
    }

    /* Custom Input Control */
    .input-group-modern {
      position: relative;
      margin-bottom: 20px;
    }

    .input-modern {
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid var(--card-border);
      color: #ffffff !important;
      border-radius: 16px;
      padding: 16px 20px 16px 48px;
      font-size: 15px;
      font-weight: 500;
      width: 100%;
      transition: all 0.25s ease;
    }

    .input-modern::placeholder {
      color: #94a3b8;
    }

    .input-modern:focus {
      background: rgba(15, 23, 42, 0.90);
      border-color: var(--primary-accent);
      box-shadow: 0 0 0 4px var(--primary-glow);
      outline: none;
      color: #ffffff !important;
    }

    .input-icon-left {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--primary-accent);
      font-size: 20px;
      pointer-events: none;
    }

    /* Modern Primary Button */
    .btn-login-glow {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff !important;
      font-weight: 700;
      font-size: 16px;
      border-radius: 16px;
      padding: 15px;
      border: none;
      width: 100%;
      box-shadow: 0 6px 20px var(--primary-glow);
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-login-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(99, 102, 241, 0.6);
      color: #ffffff !important;
    }

    /* Secondary Action Button */
    .btn-secondary-action {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: var(--text-main) !important;
      border-radius: 14px;
      padding: 12px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      margin-top: 12px;
    }

    .btn-secondary-action:hover {
      background: rgba(99, 102, 241, 0.15);
      border-color: rgba(99, 102, 241, 0.4);
      color: #ffffff !important;
      transform: translateY(-1px);
    }

    /* Info Accordions */
    .info-card-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 12px 16px;
      margin-top: 10px;
    }

    .info-header-title {
      font-size: 12px;
      font-weight: 700;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 2px;
    }

    .info-body-text {
      font-size: 11px;
      color: #94a3b8;
      margin: 0;
      line-height: 1.4;
    }
  </style>
</head>

<body>

  <div class="login-wrapper">
    
    <!-- MAIN LOGIN CARD -->
    <div class="login-card">
      
      <!-- HEADER -->
      <div class="login-header-box">
        <div class="brand-logo-container">
          <img src="/img/logo.png" alt="Logo" onerror="this.style.display='none'">
        </div>
        <h4 class="fw-bold text-white mb-1"><%= typeof t === 'function' ? t('customer.portal_title', 'Portal Pelanggan') : 'Portal Pelanggan' %></h4>
        <p class="text-sub small mb-0"><%= (settings && settings.company_header) ? settings.company_header : 'Layanan Internet Fiber Tercepat' %></p>
      </div>

      <!-- FORM BODY -->
      <div class="login-body-box">

        <!-- Error Flash Alert -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger glass-card border-0 mb-4 p-3 text-center small" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4);">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= error === 'Nomor HP tidak valid atau belum terdaftar.' ? 'ID / Nomor HP tidak terdaftar di sistem.' : error %>
          </div>
        <% } %>

        <form method="POST" action="/customer/login">
          
          <div class="mb-3">
            <label class="form-label text-sub small fw-semibold">ID Pelanggan / Nomor HP</label>
            <div class="input-group-modern">
              <i class="bi bi-person-badge input-icon-left"></i>
              <input type="text" class="input-modern" id="phone" name="phone" placeholder="Contoh: 08123456789 / MDE-0001" required autofocus autocomplete="username">
            </div>
          </div>

          <% if (settings && settings.login_otp_enabled) { %>
            <div class="p-2 px-3 rounded-3 mb-3 d-flex align-items-center gap-2" style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3);">
              <i class="bi bi-whatsapp text-success fs-5"></i>
              <span class="small text-sub" style="font-size: 11px;">Kode OTP verifikasi akan dikirim otomatis ke WhatsApp Anda.</span>
            </div>
          <% } %>

          <button type="submit" class="btn-login-glow mb-2">
            <i class="bi bi-box-arrow-in-right"></i>
            <span><%= typeof t === 'function' ? t('customer.sign_in', 'Masuk ke Portal') : 'Masuk ke Portal' %></span>
          </button>

          <!-- QUICK CHECK BILLING BUTTON -->
          <a href="/customer/check-billing" class="btn-secondary-action">
            <i class="bi bi-search text-info"></i>
            <span>Cek Tagihan Instan (Tanpa Login)</span>
          </a>
        </form>

        <!-- INFO CARDS -->
        <div class="mt-4 pt-2 border-top border-secondary border-opacity-25">
          
          <div class="info-card-item">
            <div class="info-header-title"><i class="bi bi-clock text-warning"></i> Jam Operasional Support</div>
            <p class="info-body-text"><%= (settings && settings.operational_hours) ? settings.operational_hours : '24 Jam Setiap Hari (Senin - Minggu)' %></p>
          </div>

          <% if (settings && settings.company_phone) { %>
            <div class="info-card-item">
              <div class="info-header-title"><i class="bi bi-headset text-success"></i> Customer Care & WA Support</div>
              <p class="info-body-text">
                WhatsApp: <a href="https://wa.me/<%= String(settings.company_phone).replace(/\D/g,'') %>" target="_blank" class="fw-bold text-info text-decoration-none"><%= settings.company_phone %></a>
                <% if (settings.company_email) { %>
                  | Email: <a href="mailto:<%= settings.company_email %>" class="fw-bold text-info text-decoration-none"><%= settings.company_email %></a>
                <% } %>
              </p>
            </div>
          <% } %>

        </div>

        <!-- FOOTER LINKS -->
        <div class="text-center mt-4">
          <p class="small text-sub mb-3">
            <%= typeof t === 'function' ? t('customer.not_subscribed', 'Belum berlangganan?') : 'Belum berlangganan?' %> 
            <a href="/customer/register" class="fw-bold text-primary text-decoration-none"><%= typeof t === 'function' ? t('customer.register_new', 'Daftar Pasang Baru') : 'Daftar Pasang Baru' %></a>
          </p>

          <div class="d-flex flex-wrap justify-content-center gap-2" style="font-size: 11px;">
            <a href="/customer/about" class="text-sub text-decoration-none hover-white">Tentang Kami</a>
            <span class="text-muted">•</span>
            <a href="/customer/contact" class="text-sub text-decoration-none hover-white">Kontak</a>
            <span class="text-muted">•</span>
            <a href="/customer/tos" class="text-sub text-decoration-none hover-white">Syarat & Ketentuan</a>
            <span class="text-muted">•</span>
            <a href="/customer/privacy" class="text-sub text-decoration-none hover-white">Privasi</a>
          </div>

          <div class="text-muted small mt-3" style="font-size: 10px;">
            &copy; <%= new Date().getFullYear() %> <%= (settings && settings.company_header) ? settings.company_header : 'ISP Provider' %>. All rights reserved.
          </div>
        </div>

      </div> <!-- End Login Body -->
    </div> <!-- End Login Card -->

  </div> <!-- End Wrapper -->

  <% if (typeof pwa_install !== 'undefined') { %>
    <%- include('partials/pwa_install', { hasBottomNav: false }) %>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-focus input phone on load
    window.addEventListener('load', () => {
      document.getElementById('phone')?.focus();
    });

    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      }, 2000);
    }
  </script>
</body>
</html>
