<!DOCTYPE html>
<html lang="id" data-template="<%= (typeof config !== 'undefined' && config.template) ? config.template : 'default' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof config !== 'undefined' && config.custom_title) ? config.custom_title : 'Layanan Terisolir' %> | <%= company %></title>
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <style>
    :root {
      --bg: #0b1329;
      --card: rgba(21, 31, 56, 0.95);
      --card-border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --danger: #ef4444;
      --success: #22c55e;
      --badge-bg: rgba(239, 68, 68, 0.15);
      --badge-border: rgba(239, 68, 68, 0.3);
      --badge-color: #f87171;
      --icon-bg: rgba(239, 68, 68, 0.15);
      --icon-color: #ef4444;
      --info-bg: rgba(11, 19, 41, 0.7);
      --btn-wa-bg: linear-gradient(135deg, #25d366, #128c7e);
      --btn-wa-shadow: rgba(37, 211, 102, 0.4);
      --banner-display: none;
    }

    /* Template 2: Red Alert */
    [data-template="red_alert"] {
      --bg: #110505;
      --card: rgba(28, 12, 12, 0.95);
      --card-border: rgba(239, 68, 68, 0.3);
      --text: #fef2f2;
      --muted: #fca5a5;
      --primary: #ef4444;
      --badge-bg: #dc2626;
      --badge-border: #ef4444;
      --badge-color: #ffffff;
      --icon-bg: rgba(220, 38, 38, 0.25);
      --icon-color: #f87171;
      --info-bg: rgba(36, 12, 12, 0.8);
      --btn-wa-bg: linear-gradient(135deg, #dc2626, #991b1b);
      --btn-wa-shadow: rgba(220, 38, 38, 0.5);
      --banner-display: flex;
    }

    /* Template 3: Clean Light */
    [data-template="clean_light"] {
      --bg: #f8fafc;
      --card: rgba(255, 255, 255, 0.98);
      --card-border: rgba(203, 213, 225, 0.8);
      --text: #0f172a;
      --muted: #64748b;
      --primary: #2563eb;
      --badge-bg: rgba(239, 68, 68, 0.1);
      --badge-border: rgba(239, 68, 68, 0.25);
      --badge-color: #dc2626;
      --icon-bg: rgba(37, 99, 235, 0.1);
      --icon-color: #2563eb;
      --info-bg: rgba(241, 245, 249, 0.8);
      --btn-wa-bg: linear-gradient(135deg, #16a34a, #15803d);
      --btn-wa-shadow: rgba(22, 163, 74, 0.3);
      --banner-display: none;
    }

    /* Template 4: Corporate Navy */
    [data-template="corporate_navy"] {
      --bg: #0a192f;
      --card: rgba(15, 30, 56, 0.96);
      --card-border: rgba(245, 158, 11, 0.3);
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #f59e0b;
      --badge-bg: rgba(245, 158, 11, 0.15);
      --badge-border: rgba(245, 158, 11, 0.35);
      --badge-color: #fbbf24;
      --icon-bg: rgba(245, 158, 11, 0.15);
      --icon-color: #f59e0b;
      --info-bg: rgba(10, 20, 38, 0.8);
      --btn-wa-bg: linear-gradient(135deg, #d97706, #b45309);
      --btn-wa-shadow: rgba(217, 119, 6, 0.4);
      --banner-display: none;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 24px 14px;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg);
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(239, 68, 68, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.08) 0%, transparent 45%);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      transition: all 0.3s ease;
    }

    /* Emergency Banner Header for Red Alert Template */
    .top-alert-banner {
      display: var(--banner-display);
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      max-width: 480px;
      background: #dc2626;
      color: #ffffff;
      padding: 10px 16px;
      border-radius: 16px;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 16px;
      box-shadow: 0 8px 20px rgba(220, 38, 38, 0.35);
      animation: pulseAlert 2s infinite ease-in-out;
    }

    @keyframes pulseAlert {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.92; transform: scale(0.99); }
    }

    .container {
      max-width: 480px;
      width: 100%;
      text-align: center;
      padding: 36px 24px;
      background: var(--card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 28px;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.4);
      border: 1px solid var(--card-border);
      transition: all 0.3s ease;
    }

    .icon-header {
      width: 72px;
      height: 72px;
      margin: 0 auto 18px;
      background: var(--icon-bg);
      color: var(--icon-color);
      border: 1px solid var(--badge-border);
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 16px;
      background: var(--badge-bg);
      color: var(--badge-color);
      border: 1px solid var(--badge-border);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 24px;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.5px;
    }

    .description {
      color: var(--muted);
      line-height: 1.6;
      margin-bottom: 24px;
      font-size: 14px;
    }

    .info-grid {
      display: grid;
      gap: 10px;
      margin-bottom: 24px;
    }

    .info-item {
      background: var(--info-bg);
      border-radius: 14px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      text-align: left;
      border: 1px solid var(--card-border);
    }

    .info-icon {
      width: 38px;
      height: 38px;
      background: rgba(59, 130, 246, 0.12);
      color: var(--primary);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }

    .info-content { min-width: 0; flex: 1; }
    .info-label { font-size: 10.5px; color: var(--muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 2px; }
    .info-value { font-weight: 700; font-size: 13.5px; color: var(--text); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .btn-wa {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: var(--btn-wa-bg);
      color: #ffffff;
      text-decoration: none;
      padding: 15px;
      border-radius: 16px;
      font-weight: 800;
      font-size: 14.5px;
      transition: all 0.2s ease;
      box-shadow: 0 8px 20px -4px var(--btn-wa-shadow);
      margin-bottom: 12px;
    }
    .btn-wa:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
    }

    .btn-secondary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 13.5px 15px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 13.5px;
      text-decoration: none;
      border: 1px solid var(--card-border);
      background: var(--info-bg);
      color: var(--text);
      cursor: pointer;
      transition: all 0.2s ease;
      margin-bottom: 10px;
    }
    .btn-secondary:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .footer {
      margin-top: 24px;
      font-size: 11.5px;
      color: var(--muted);
    }
    .company-name {
      color: var(--primary);
      font-weight: 700;
    }
  </style>
</head>
<body>

  <!-- Top Emergency Alert Banner (Red Alert Theme) -->
  <div class="top-alert-banner">
    <i class="bi bi-exclamation-triangle-fill"></i> PERINGATAN DARURAT: AKSES DIBATASI
  </div>

  <div class="container">
    <div class="icon-header">
      <i class="bi bi-shield-slash-fill"></i>
    </div>

    <div class="status-badge">
      <i class="bi bi-exclamation-circle-fill me-1"></i> Layanan Terisolir
    </div>
    
    <h1><%= typeof config !== 'undefined' && config.custom_title ? config.custom_title : 'Layanan Terisolir' %></h1>
    
    <p class="description">
      <%= typeof config !== 'undefined' && config.custom_message ? config.custom_message : 'Layanan internet Anda sementara dinonaktifkan. Silakan selesaikan administrasi tagihan untuk mengaktifkan kembali layanan.' %>
    </p>
    
    <div class="info-grid">
      <div class="info-item">
        <div class="info-icon">
          <i class="bi bi-building"></i>
        </div>
        <div class="info-content">
          <span class="info-label">Penyedia Layanan</span>
          <span class="info-value"><%= company %></span>
        </div>
      </div>
      
      <% if (adminPhone) { %>
      <div class="info-item">
        <div class="info-icon">
          <i class="bi bi-headset"></i>
        </div>
        <div class="info-content">
          <span class="info-label">Pusat Bantuan</span>
          <span class="info-value"><%= adminPhone %></span>
        </div>
      </div>
      <% } %>

      <% if (address) { %>
      <div class="info-item">
        <div class="info-icon">
          <i class="bi bi-geo-alt"></i>
        </div>
        <div class="info-content">
          <span class="info-label">Kantor Layanan</span>
          <span class="info-value"><%= address %></span>
        </div>
      </div>
      <% } %>
    </div>

    <% const waMsg = typeof config !== 'undefined' && config.custom_wa_message ? config.custom_wa_message : 'Halo Admin, akun internet saya terisolir. Mohon bantuan pembayaran.'; %>
    <% if (adminPhone) { %>
      <a href="https://wa.me/<%= adminPhone.replace(/\D/g, '') %>?text=<%= encodeURIComponent(waMsg) %>" target="_blank" class="btn-wa">
        <i class="bi bi-whatsapp fs-5"></i> Konfirmasi via WhatsApp
      </a>
    <% } %>

    <a href="/customer/check-billing" class="btn-secondary">
      <i class="bi bi-receipt me-1"></i> Cek &amp; Bayar Tagihan Sekarang
    </a>

    <div class="footer">
      &copy; <%= new Date().getFullYear() %> <span class="company-name"><%= company %></span>. Seluruh hak cipta dilindungi.
    </div>
  </div>

</body>
</html>