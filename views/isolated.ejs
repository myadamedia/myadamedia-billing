<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof config !== 'undefined' && config.custom_title ? config.custom_title : 'Layanan Terisolir' %> | <%= company %></title>
  <style>
    :root {
      --bg: #0b1329;
      --card: #151f38;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --danger: #ef4444;
      --success: #22c55e;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 20px 12px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
      background-color: var(--bg);
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(239, 68, 68, 0.1) 0%, transparent 45%),
        radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.1) 0%, transparent 45%);
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    .container {
      max-width: 480px;
      width: 100%;
      text-align: center;
      padding: 36px 22px;
      background: rgba(21, 31, 56, 0.95);
      border-radius: 26px;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .icon-header {
      width: 72px;
      height: 72px;
      margin: 0 auto 18px;
      background: rgba(239, 68, 68, 0.15);
      color: var(--danger);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 14px;
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    h1 {
      margin: 0 0 10px;
      font-size: 24px;
      font-weight: 800;
      color: #ffffff;
    }
    .description {
      color: var(--muted);
      line-height: 1.55;
      margin-bottom: 24px;
      font-size: 14px;
    }
    .info-grid {
      display: grid;
      gap: 10px;
      margin-bottom: 24px;
    }
    .info-item {
      background: rgba(11, 19, 41, 0.7);
      border-radius: 14px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      text-align: left;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .info-icon {
      width: 38px;
      height: 38px;
      background: rgba(59, 130, 246, 0.15);
      color: var(--primary);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .info-content { min-width: 0; flex: 1; }
    .info-label { font-size: 10.5px; color: var(--muted); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 2px; }
    .info-value { font-weight: 700; font-size: 13.5px; color: #f1f5f9; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .btn-wa {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: linear-gradient(135deg, #25d366, #128c7e);
      color: #ffffff;
      text-decoration: none;
      padding: 15px;
      border-radius: 16px;
      font-weight: 800;
      font-size: 14.5px;
      transition: all 0.2s ease;
      box-shadow: 0 8px 20px -6px rgba(37, 211, 102, 0.5);
      margin-bottom: 12px;
    }
    .btn-wa:hover {
      filter: brightness(1.06);
    }

    .btn-secondary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 13px 15px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 13.5px;
      text-decoration: none;
      border: 1px solid rgba(148, 163, 184, 0.2);
      background: rgba(15, 23, 42, 0.7);
      color: var(--text);
      cursor: pointer;
      transition: all 0.2s ease;
      margin-bottom: 10px;
    }
    .btn-secondary:hover {
      background: rgba(30, 41, 59, 0.95);
      border-color: rgba(59, 130, 246, 0.5);
    }

    .footer {
      margin-top: 26px;
      font-size: 11.5px;
      color: var(--muted);
    }
    .company-name {
      color: var(--primary);
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="icon-header">
      <!-- Shield Lock SVG -->
      <svg width="34" height="34" viewBox="0 0 16 16" fill="currentColor">
        <path d="M5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56zM8 5a1.5 1.5 0 0 0-1.5 1.5v.5h-1a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h5a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-1v-.5A1.5 1.5 0 0 0 8 5zm1 2v-.5a1 1 0 0 0-2 0V7z"/>
      </svg>
    </div>

    <div class="status-badge">
      <!-- Triangle Alert SVG -->
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
      </svg>
      Layanan Terisolir
    </div>
    
    <h1><%= typeof config !== 'undefined' && config.custom_title ? config.custom_title : 'Layanan Terisolir' %></h1>
    
    <p class="description">
      <%= typeof config !== 'undefined' && config.custom_message ? config.custom_message : 'Layanan internet Anda sementara dinonaktifkan. Silakan selesaikan administrasi tagihan untuk mengaktifkan kembali layanan.' %>
    </p>
    
    <div class="info-grid">
      <div class="info-item">
        <div class="info-icon">
          <!-- Building SVG -->
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
            <path d="M4 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zM7.5 5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zm2.5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zM4.5 8a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zm2.5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5z"/><path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1zm11 0H3v14h3v-2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V15h3z"/>
          </svg>
        </div>
        <div class="info-content">
          <span class="info-label">Penyedia Layanan</span>
          <span class="info-value"><%= company %></span>
        </div>
      </div>
      
      <% if (adminPhone) { %>
      <div class="info-item">
        <div class="info-icon">
          <!-- Headset SVG -->
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v6a2.5 2.5 0 0 1-2.5 2.5H9.366a1 1 0 0 1-.866.5h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 .866.5H11.5A1.5 1.5 0 0 0 13 12h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V6a5 5 0 0 0-5-5"/>
          </svg>
        </div>
        <div class="info-content">
          <span class="info-label">Pusat Bantuan</span>
          <span class="info-value"><%= adminPhone %></span>
        </div>
      </div>
      <% } %>

      <% if (address) { %>
      <div class="info-item">
        <div class="info-icon">
          <!-- Geo Alt SVG -->
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
          </svg>
        </div>
        <div class="info-content">
          <span class="info-label">Kantor Layanan</span>
          <span class="info-value"><%= address %></span>
        </div>
      </div>
      <% } %>
    </div>

    <% const waMsg = typeof config !== 'undefined' && config.custom_wa_message ? config.custom_wa_message : 'Halo Admin, akun internet saya terisolir. Mohon bantuan pembayaran.'; %>
    <% if (adminPhone) { %>
      <a href="https://wa.me/<%= adminPhone.replace(/\D/g, '') %>?text=<%= encodeURIComponent(waMsg) %>" target="_blank" class="btn-wa">
        <!-- WhatsApp SVG -->
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
          <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.655.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.596-6.592 6.596m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.916.807 2.05c.099.133 1.39 2.123 3.366 2.977.47.203.837.324 1.122.416.471.15.9.129 1.238.078.378-.057 1.17-.478 1.336-.94.166-.462.166-.857.117-.94-.048-.083-.18-.133-.377-.233"/>
        </svg>
        Konfirmasi via WhatsApp
      </a>
    <% } %>

    <a href="/customer/check-billing" class="btn-secondary">
      <!-- Receipt SVG -->
      <svg width="18" height="18" viewBox="0 0 16 16" fill="var(--primary)">
        <path d="M3 4.5a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h4a.5.5 0 1 1 0 1h-4a.5.5 0 0 1-.5-.5"/><path d="M1.5 0A1.5 1.5 0 0 0 0 1.5v13A1.5 1.5 0 0 0 1.5 16h13a1.5 1.5 0 0 0 1.5-1.5V2.914a1.5 1.5 0 0 0-.44-1.06L14.147.439A1.5 1.5 0 0 0 13.086 0zM1 1.5a.5.5 0 0 1 .5-.5h11.586a.5.5 0 0 1 .354.146l1.414 1.415a.5.5 0 0 1 .146.353V14.5a.5.5 0 0 1-.5.5H1.5a.5.5 0 0 1-.5-.5z"/>
      </svg>
      Cek &amp; Bayar Tagihan Sekarang
    </a>

    <a href="/customer/login" class="btn-secondary">
      <!-- Person SVG -->
      <svg width="18" height="18" viewBox="0 0 16 16" fill="#38bdf8">
        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/><path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
      </svg>
      Login Customer Portal
    </a>

    <div class="footer">
      Sistem Billing <span class="company-name"><%= company %></span> &copy; <%= new Date().getFullYear() %>
    </div>
  </div>
</body>
</html>