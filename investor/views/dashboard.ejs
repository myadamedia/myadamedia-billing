<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Investor - Executive Financial Analytics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <style>
    :root {
      --bg-dark: #090d16;
      --card-bg: #0f172a;
      --card-border: rgba(255, 255, 255, 0.08);
      --primary: #6366f1;
      --accent-green: #10b981;
      --accent-red: #ef4444;
      --accent-blue: #3b82f6;
      --accent-yellow: #f59e0b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Navigation Header */
    .top-header {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--card-border);
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #fff;
    }

    .brand-logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #6366f1 0%, #3b82f6 100%);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      box-shadow: 0 6px 12px rgba(99, 102, 241, 0.3);
    }

    .brand-logo-text {
      font-family: 'Outfit', sans-serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .brand-badge {
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.3);
      color: #a5b4fc;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.05);
      padding: 6px 14px;
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 700;
      color: #fff;
    }

    .btn-logout {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.25);
      color: #fca5a5;
      padding: 8px 14px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .btn-logout:hover {
      background: rgba(239, 68, 68, 0.25);
      color: #fff;
    }

    /* Main Container */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 32px 24px;
      width: 100%;
    }

    /* Page Header Controls */
    .dashboard-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .page-title {
      font-family: 'Outfit', sans-serif;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .filter-wrapper {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 6px;
      border-radius: 14px;
    }

    .filter-btn {
      padding: 8px 16px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      transition: all 0.2s;
    }

    .filter-btn.active {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .filter-btn:hover:not(.active) {
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
    }

    /* Grid Layouts */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }

    .kpi-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 24px;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s, border-color 0.25s;
    }

    .kpi-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.18);
    }

    .kpi-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .kpi-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .kpi-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .kpi-icon.blue { background: rgba(59, 130, 246, 0.12); color: #60a5fa; }
    .kpi-icon.green { background: rgba(16, 185, 129, 0.12); color: #34d399; }
    .kpi-icon.red { background: rgba(239, 68, 68, 0.12); color: #f87171; }
    .kpi-icon.purple { background: rgba(99, 102, 241, 0.12); color: #a5b4fc; }
    .kpi-icon.yellow { background: rgba(245, 158, 11, 0.12); color: #fbbf24; }

    .kpi-value {
      font-family: 'Outfit', sans-serif;
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 8px;
    }

    .kpi-footer {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--text-muted);
    }

    .badge-tag {
      padding: 3px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .badge-tag.green { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .badge-tag.purple { background: rgba(99, 102, 241, 0.15); color: #a5b4fc; }

    /* Highlight Dividend Card */
    .kpi-card.highlight {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(15, 23, 42, 0.9) 100%);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    /* Analytics Grid */
    .charts-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 24px;
      margin-bottom: 32px;
    }

    @media (max-width: 992px) {
      .charts-grid { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 28px;
    }

    .chart-title {
      font-family: 'Outfit', sans-serif;
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .chart-container {
      position: relative;
      width: 100%;
      height: 320px;
    }

    /* Tables & Breakdown Cards */
    .details-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    @media (max-width: 992px) {
      .details-grid { grid-template-columns: 1fr; }
    }

    .table-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 28px;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
    }

    .data-table th {
      text-align: left;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      padding: 12px 16px;
      border-bottom: 1px solid var(--card-border);
    }

    .data-table td {
      padding: 14px 16px;
      font-size: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .data-table tr:last-child td { border-bottom: none; }

    .tx-badge {
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
    }

    .tx-badge.in { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .tx-badge.out { background: rgba(239, 68, 68, 0.15); color: #f87171; }

    .footer-note {
      text-align: center;
      color: var(--text-muted);
      font-size: 13px;
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid var(--card-border);
    }

    /* Investor Map Styles */
    .map-section {
      margin-top: 24px;
      margin-bottom: 24px;
    }
    .map-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }
    .map-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .map-title {
      font-family: 'Outfit', sans-serif;
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #34d399;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .live-dot {
      width: 8px;
      height: 8px;
      background-color: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 8px #10b981;
      animation: pulse-dot 1.8s infinite;
    }
    @keyframes pulse-dot {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1.2); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .map-stats-bar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }
    .map-stat-chip {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 10px 14px;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
    }
    .map-stat-chip .lbl {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
    }
    .map-stat-chip .val {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
      margin-top: 2px;
    }
    #investor-map {
      height: 480px;
      width: 100%;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      z-index: 1;
    }
    .map-legend-bar {
      display: flex;
      gap: 16px;
      margin-top: 14px;
      flex-wrap: wrap;
      font-size: 12px;
      color: var(--text-muted);
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 500;
    }
    .legend-icon {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      display: inline-block;
    }
    .leaflet-popup-content-wrapper {
      background: #0f172a !important;
      color: #f8fafc !important;
      border: 1px solid rgba(255, 255, 255, 0.15) !important;
      border-radius: 10px !important;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5) !important;
    }
    .leaflet-popup-tip {
      background: #0f172a !important;
    }
    .inv-popup {
      font-size: 12px;
      line-height: 1.5;
    }
    .inv-popup h4 {
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 6px;
      color: #6366f1;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      padding-bottom: 4px;
    }

    /* Flowing animated dash line for customer drop cables */
    @keyframes flow {
      from { stroke-dashoffset: 20; }
      to { stroke-dashoffset: 0; }
    }
    .flowing-line {
      animation: flow 1.2s linear infinite;
    }
  </style>

</head>
<body>

  <!-- Top Header Nav -->
  <header class="top-header">
    <a href="/investor/dashboard" class="brand-logo">
      <div class="brand-logo-icon">
        <i class="bi bi-graph-up-arrow"></i>
      </div>
      <div>
        <div class="brand-logo-text">Investor Analytics</div>
      </div>
      <span class="brand-badge">Read-Only</span>
    </a>

    <div class="header-actions">
      <div class="user-profile">
        <div class="user-avatar">
          <%= investor.name ? investor.name.charAt(0).toUpperCase() : 'I' %>
        </div>
        <div style="font-size:14px;font-weight:600"><%= investor.name %></div>
      </div>
      <a href="/investor/logout" class="btn-logout">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
      </a>
    </div>
  </header>

  <!-- Main Dashboard Content -->
  <main class="container">

    <!-- Toolbar & Period Selector -->
    <div class="dashboard-toolbar">
      <div>
        <h1 class="page-title">Ringkasan Eksekutif Keuangan</h1>
        <p class="page-subtitle">Laporan real-time omset, pengeluaran, laba bersih, dan bagi hasil saham investor</p>
      </div>

      <div class="filter-wrapper">
        <a href="/investor/dashboard?period=this_month" class="filter-btn <%= period === 'this_month' ? 'active' : '' %>">Bulan Ini</a>
        <a href="/investor/dashboard?period=last_month" class="filter-btn <%= period === 'last_month' ? 'active' : '' %>">Bulan Lalu</a>
        <a href="/investor/dashboard?period=this_year" class="filter-btn <%= period === 'this_year' ? 'active' : '' %>">Tahun Ini</a>
        <a href="/investor/dashboard?period=all" class="filter-btn <%= period === 'all' ? 'active' : '' %>">Semua</a>
      </div>
    </div>

    <!-- Key Performance Indicators Cards -->
    <div class="kpi-grid">

      <!-- Omset / Gross Revenue -->
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Total Omset (Gross)</span>
          <div class="kpi-icon blue"><i class="bi bi-wallet2"></i></div>
        </div>
        <div class="kpi-value"><%= summary.formattedRevenue %></div>
        <div class="kpi-footer">
          <i class="bi bi-arrow-up-right-circle-fill" style="color:#34d399"></i>
          <span>Pemasukan pembayaran tagihan & cash in</span>
        </div>
      </div>

      <!-- Pengeluaran / Expenses -->
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Total Pengeluaran (OpEx)</span>
          <div class="kpi-icon red"><i class="bi bi-receipt-cutoff"></i></div>
        </div>
        <div class="kpi-value"><%= summary.formattedExpenses %></div>
        <div class="kpi-footer">
          <span>Operasional, Bandwidth, Gaji, & Sarana</span>
        </div>
      </div>

      <!-- Net Profit -->
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Laba Bersih (Net Profit)</span>
          <div class="kpi-icon purple"><i class="bi bi-piggy-bank-fill"></i></div>
        </div>
        <div class="kpi-value" style="color: <%= summary.netProfit >= 0 ? '#34d399' : '#f87171' %>">
          <%= summary.formattedNetProfit %>
        </div>
        <div class="kpi-footer">
          <span class="badge-tag purple">Margin: <%= summary.profitMargin %>%</span>
          <span>(Revenue - Expense)</span>
        </div>
      </div>

      <!-- Hak Bagi Hasil Investor (Dividen) -->
      <div class="kpi-card highlight">
        <div class="kpi-header">
          <span class="kpi-title" style="color:#34d399">Bagi Hasil Dividen Anda</span>
          <div class="kpi-icon green"><i class="bi bi-gem"></i></div>
        </div>
        <div class="kpi-value" style="color:#34d399">
          <%= dividendInfo ? dividendInfo.formattedDividend : 'Rp 0' %>
        </div>
        <div class="kpi-footer">
          <% if (dividendInfo && dividendInfo.shareType === 'fixed') { %>
            <span class="badge-tag green"><i class="bi bi-cash-stack"></i> Nominal Fix</span>
            <span>Nilai Tetap <%= dividendInfo.formattedFixedAmount %> / Bulan</span>
          <% } else { %>
            <span class="badge-tag green"><i class="bi bi-pie-chart-fill"></i> Saham: <%= investor.share_percentage %>%</span>
            <span>Berdasarkan <%= investor.share_percentage %>% dari Net Profit</span>
          <% } %>
        </div>

      </div>

      <!-- MRR & ARPU -->
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">MRR (Recurring Revenue)</span>
          <div class="kpi-icon yellow"><i class="bi bi-arrow-repeat"></i></div>
        </div>
        <div class="kpi-value"><%= summary.formattedMrr %></div>
        <div class="kpi-footer">
          <span>ARPU (Avg per user): <strong><%= summary.formattedArpu %></strong></span>
        </div>
      </div>

      <!-- Pelanggan & PSB -->
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Pelanggan Aktif</span>
          <div class="kpi-icon blue"><i class="bi bi-people-fill"></i></div>
        </div>
        <div class="kpi-value"><%= summary.activeCustomers %> <span style="font-size:16px;color:var(--text-muted);font-weight:400">/ <%= summary.totalCustomers %></span></div>
        <div class="kpi-footer">
          <span class="badge-tag green">+<%= summary.psbThisMonth %> PSB</span>
          <span>Pelanggan baru bulan ini</span>
        </div>
      </div>

      <!-- Pelanggan Free -->
      <div class="kpi-card">
        <div class="kpi-header">
          <span class="kpi-title">Pelanggan Free</span>
          <div class="kpi-icon yellow"><i class="bi bi-gift-fill"></i></div>
        </div>
        <div class="kpi-value"><%= summary.freeCustomers %> <span style="font-size:16px;color:var(--text-muted);font-weight:400">/ <%= summary.totalCustomers %></span></div>
        <div class="kpi-footer">
          <span class="badge-tag purple">+<%= summary.freePsbThisMonth %> PSB</span>
          <span>Pelanggan baru bulan ini</span>
        </div>
      </div>

    </div>

    <!-- Analytics Charts Section -->
    <div class="charts-grid">

      <!-- Chart 1: Financial Trend Line Chart -->
      <div class="chart-card">
        <div class="chart-title">
          <span><i class="bi bi-graph-up-arrow" style="color:var(--primary);margin-right:8px"></i> Tren Keuangan 6 Bulan Terakhir</span>
        </div>
        <div class="chart-container">
          <canvas id="financialTrendChart"></canvas>
        </div>
      </div>

      <!-- Chart 2: Package Distribution Doughnut Chart -->
      <div class="chart-card">
        <div class="chart-title">
          <span><i class="bi bi-pie-chart-fill" style="color:var(--accent-green);margin-right:8px"></i> Distribusi Paket Internet</span>
        </div>
        <div class="chart-container">
          <canvas id="packageChart"></canvas>
        </div>
      </div>

    </div>

    <!-- Real-time Read-Only Network Map Section -->
    <div class="map-section">
      <div class="map-card">
        <div class="map-header">
          <div class="map-title">
            <i class="bi bi-geo-alt-fill" style="color: var(--primary);"></i>
            <span>Peta Jaringan & Infrastruktur Pelanggan (Read-Only)</span>
          </div>
          <div class="live-badge">
            <span class="live-dot"></span>
            <span>Auto-Sync Realtime</span>
          </div>
        </div>

        <!-- Quick Stats Bar -->
        <div class="map-stats-bar">
          <div class="map-stat-chip">
            <span class="lbl">Total ODP</span>
            <span class="val" id="st-odp" style="color: #f59e0b;">0</span>
          </div>
          <div class="map-stat-chip">
            <span class="lbl">Pelanggan di Peta</span>
            <span class="val" id="st-cust" style="color: #3b82f6;">0</span>
          </div>
          <div class="map-stat-chip">
            <span class="lbl">Aktif</span>
            <span class="val" id="st-active" style="color: #10b981;">0</span>
          </div>
          <div class="map-stat-chip">
            <span class="lbl">Pelanggan Free</span>
            <span class="val" id="st-free" style="color: #a855f7;">0</span>
          </div>
          <div class="map-stat-chip">
            <span class="lbl">Terisolir / Suspended</span>
            <span class="val" id="st-suspended" style="color: #ef4444;">0</span>
          </div>
        </div>

        <!-- Leaflet Map Container -->
        <div id="investor-map"></div>

        <!-- Legend Bar -->
        <div class="map-legend-bar">
          <div class="legend-item"><span class="legend-icon" style="background:#f59e0b"></span> ODP (Optic Distribution Point)</div>
          <div class="legend-item"><span class="legend-icon" style="background:#3b82f6"></span> Pelanggan Aktif</div>
          <div class="legend-item"><span class="legend-icon" style="background:#10b981"></span> Pelanggan Gratis / Demo</div>
          <div class="legend-item"><span class="legend-icon" style="background:#ef4444"></span> Pelanggan Terisolir</div>
          <div class="legend-item"><span class="legend-icon" style="background:#a855f7; height:3px; border-radius:1px; width:16px;"></span> Jalur Kabel Fiber</div>
        </div>
      </div>
    </div>

    <!-- Details Grid: Top Expense Categories & Recent Transactions -->
    <div class="details-grid">


      <!-- Top Expense Categories -->
      <div class="table-card">
        <div class="chart-title">
          <span><i class="bi bi-tags-fill" style="color:var(--accent-red);margin-right:8px"></i> Breakdown Pengeluaran Terbesar</span>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Kategori Pengeluaran</th>
              <th>Jumlah Transaksi</th>
              <th style="text-align:right">Total Nominal</th>
            </tr>
          </thead>
          <tbody>
            <% if (expBreakdown && expBreakdown.length > 0) { %>
              <% expBreakdown.forEach(exp => { %>
                <tr>
                  <td style="font-weight:600;color:#f1f5f9"><%= exp.category %></td>
                  <td><%= exp.txCount %> Transaksi</td>
                  <td style="text-align:right;font-weight:700;color:#f87171"><%= exp.formattedAmount %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3" style="text-align:center;color:var(--text-muted)">Belum ada pengeluaran dicatat pada periode ini.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Recent Financial Feed -->
      <div class="table-card">
        <div class="chart-title">
          <span><i class="bi bi-clock-history" style="color:var(--accent-yellow);margin-right:8px"></i> Transaksi Keuangan Terbaru</span>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Tipe</th>
              <th>Keterangan</th>
              <th style="text-align:right">Nominal</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentTx && recentTx.length > 0) { %>
              <% recentTx.forEach(tx => { %>
                <tr>
                  <td>
                    <span class="tx-badge <%= tx.type === 'IN' ? 'in' : 'out' %>">
                      <%= tx.type === 'IN' ? 'MASUK' : 'KELUAR' %>
                    </span>
                  </td>
                  <td style="font-weight:500;color:#cbd5e1"><%= tx.title %></td>
                  <td style="text-align:right;font-weight:700;color: <%= tx.type === 'IN' ? '#34d399' : '#f87171' %>">
                    <%= tx.type === 'IN' ? '+' : '-' %> <%= tx.formattedAmount %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3" style="text-align:center;color:var(--text-muted)">Belum ada riwayat transaksi.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>

    <!-- Footer Note -->
    <div class="footer-note">
      <p>&copy; <%= new Date().getFullYear() %> <%= (typeof company !== 'undefined' && company) ? company : (typeof settings !== 'undefined' && settings && settings.company_header ? settings.company_header : 'Billing System') %> • Executed Standalone Investor Portal</p>
    </div>

  </main>

  <script>
    // Inisialisasi Chart.js real-time dari API Server
    document.addEventListener('DOMContentLoaded', async () => {
      try {
        const res = await fetch('/investor/api/chart-data?months=6');
        const data = await res.json();

        if (data.success && data.trends) {
          const labels = data.trends.map(t => t.label);
          const revenues = data.trends.map(t => t.revenue);
          const expenses = data.trends.map(t => t.expense);
          const profits = data.trends.map(t => t.netProfit);

          // 1. Line Chart: Financial Trends
          const ctxLine = document.getElementById('financialTrendChart').getContext('2d');
          new Chart(ctxLine, {
            type: 'line',
            data: {
              labels: labels,
              datasets: [
                {
                  label: 'Omset (Revenue)',
                  data: revenues,
                  borderColor: '#3b82f6',
                  backgroundColor: 'rgba(59, 130, 246, 0.1)',
                  fill: true,
                  tension: 0.35,
                  borderWidth: 3
                },
                {
                  label: 'Pengeluaran (Expense)',
                  data: expenses,
                  borderColor: '#ef4444',
                  backgroundColor: 'transparent',
                  borderDash: [5, 5],
                  tension: 0.35,
                  borderWidth: 2
                },
                {
                  label: 'Net Profit',
                  data: profits,
                  borderColor: '#10b981',
                  backgroundColor: 'rgba(16, 185, 129, 0.15)',
                  fill: true,
                  tension: 0.35,
                  borderWidth: 3
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { labels: { color: '#94a3b8', font: { family: 'Inter', size: 12 } } }
              },
              scales: {
                x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#94a3b8' } },
                y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#94a3b8' } }
              }
            }
          });
        }

        if (data.success && data.packages) {
          const pkgNames = data.packages.map(p => p.package_name);
          const pkgTotals = data.packages.map(p => p.total_potential);

          // 2. Doughnut Chart: Package Distribution
          const ctxPie = document.getElementById('packageChart').getContext('2d');
          new Chart(ctxPie, {
            type: 'doughnut',
            data: {
              labels: pkgNames,
              datasets: [{
                data: pkgTotals,
                backgroundColor: [
                  '#6366f1', '#10b981', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6'
                ],
                borderWidth: 0
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { position: 'bottom', labels: { color: '#94a3b8', font: { family: 'Inter', size: 12 } } }
              }
            }
          });
        }

        // 3. Initialize Read-Only Network Map for Investor Dashboard
        try {
          const defaultLat = -6.200000;
          const defaultLng = 106.816666;
          const map = L.map('investor-map', {
            zoomControl: true,
            attributionControl: false
          }).setView([defaultLat, defaultLng], 13);

          const streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19
          });
          const darkLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            maxZoom: 19
          });
          darkLayer.addTo(map);

          L.control.layers({
            "Dark Theme": darkLayer,
            "Street View": streetLayer
          }).addTo(map);

          const markersLayer = L.layerGroup().addTo(map);
          const linesLayer = L.layerGroup().addTo(map);

          let initialCentered = false;

          const ponColors = [
            '#f59e0b', '#10b981', '#3b82f6', '#ec4899',
            '#8b5cf6', '#ef4444', '#06b6d4', '#f97316',
            '#14b8a6', '#a855f7', '#6366f1', '#84cc16'
          ];

          async function loadInvestorMapData() {
            try {
              const res = await fetch('/investor/api/map-data');
              const data = await res.json();
              if (!data.success) return;

              // Update Quick Stats Bar
              if (data.stats) {
                document.getElementById('st-odp').textContent = data.stats.totalOdps || 0;
                document.getElementById('st-cust').textContent = data.stats.totalMappedCustomers || 0;
                document.getElementById('st-active').textContent = data.stats.activeCustomers || 0;
                if (document.getElementById('st-free')) document.getElementById('st-free').textContent = data.stats.freeCustomers || 0;
                document.getElementById('st-suspended').textContent = data.stats.suspendedCustomers || 0;
              }

              markersLayer.clearLayers();
              linesLayer.clearLayers();

              const bounds = [];
              const odpMarkers = {};

              // Render Office NOC Marker if coordinates available
              const officeCoords = data.office || { lat: -6.200000, lng: 106.816666 };
              if (officeCoords.lat && officeCoords.lng) {
                bounds.push([officeCoords.lat, officeCoords.lng]);
                const officeIcon = L.divIcon({
                  className: 'custom-office-icon',
                  html: `<div style="background:#6366f1; color:#fff; width:30px; height:30px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:16px; border:2px solid #fff; box-shadow:0 0 12px rgba(99,102,241,0.8);"><i class="bi bi-building-fill"></i></div>`,
                  iconSize: [30, 30],
                  iconAnchor: [15, 15]
                });
                L.marker([officeCoords.lat, officeCoords.lng], { icon: officeIcon })
                  .bindPopup(`<div class="inv-popup"><h4><i class="bi bi-building-fill"></i> Kantor Pusat / NOC</h4><div>Pusat jaringan &amp; distribusi fiber optik</div></div>`)
                  .addTo(markersLayer);
              }

              // Build PON Port Color Map
              const ponColorMap = {};
              let colorIdx = 0;
              (data.odps || []).forEach(odp => {
                if (odp.olt_id && odp.pon_port && String(odp.pon_port).trim() !== '') {
                  const key = `${odp.olt_id}_${String(odp.pon_port).trim()}`;
                  if (!ponColorMap[key]) {
                    ponColorMap[key] = ponColors[colorIdx % ponColors.length];
                    colorIdx++;
                  }
                }
              });

              // 1. Render ODP Markers & Index Locations
              (data.odps || []).forEach(odp => {
                const lat = parseFloat(odp.lat);
                const lng = parseFloat(odp.lng);
                if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
                  odpMarkers[odp.id] = [lat, lng];
                  bounds.push([lat, lng]);

                  const odpIcon = L.divIcon({
                    className: 'custom-odp-icon',
                    html: `<div style="background:#f59e0b; color:#0f172a; width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:12px; border:2px solid #fff; box-shadow:0 0 10px rgba(245,158,11,0.6);"><i class="bi bi-box-seam"></i></div>`,
                    iconSize: [26, 26],
                    iconAnchor: [13, 13]
                  });

                  const popupHtml = `
                    <div class="inv-popup">
                      <h4><i class="bi bi-box-seam"></i> ODP: ${odp.name || 'ODP'}</h4>
                      <div><strong>OLT:</strong> ${odp.olt_name || '-'}</div>
                      <div><strong>PON Port:</strong> ${odp.pon_port || '-'}</div>
                      <div><strong>Kapasitas Port:</strong> ${odp.used_ports || 0} / ${odp.capacity || 16} Port</div>
                      <div><strong>Keterangan:</strong> ${odp.description || '-'}</div>
                      <div style="margin-top:4px; font-size:11px; color:#94a3b8">Koordinat: ${lat.toFixed(6)}, ${lng.toFixed(6)}</div>
                    </div>
                  `;

                  L.marker([lat, lng], { icon: odpIcon })
                    .bindPopup(popupHtml)
                    .addTo(markersLayer);
                }
              });

              // 2. Render ODP Feeder / Uplink Lines (ODP -> Parent ODP or ODP -> NOC)
              (data.odps || []).forEach(odp => {
                const lat = parseFloat(odp.lat);
                const lng = parseFloat(odp.lng);
                if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
                  let pathCoords;
                  let lineLabel;

                  if (odp.parent_odp_id && odpMarkers[odp.parent_odp_id]) {
                    pathCoords = [[lat, lng], odpMarkers[odp.parent_odp_id]];
                    lineLabel = `Kabel Uplink ODP: ${odp.name} ↔ ${odp.parent_name || 'Uplink'}`;
                  } else if (officeCoords.lat && officeCoords.lng) {
                    pathCoords = [[lat, lng], [officeCoords.lat, officeCoords.lng]];
                    lineLabel = `Kabel Utama (Feeder): NOC ↔ ${odp.name}`;
                  }

                  if (odp.cable_path && String(odp.cable_path).trim().length > 2) {
                    try {
                      const parsed = JSON.parse(odp.cable_path);
                      if (Array.isArray(parsed) && parsed.length >= 2) {
                        pathCoords = parsed.map(pt => Array.isArray(pt) ? [pt[0], pt[1]] : [pt.lat, pt.lng]);
                      }
                    } catch (e) {}
                  }

                  if (pathCoords) {
                    let ponColor = '#94a3b8';
                    if (odp.olt_id && odp.pon_port && String(odp.pon_port).trim() !== '') {
                      const key = `${odp.olt_id}_${String(odp.pon_port).trim()}`;
                      ponColor = ponColorMap[key] || '#94a3b8';
                    }

                    L.polyline(pathCoords, {
                      color: ponColor,
                      weight: 4,
                      opacity: 0.9
                    }).bindTooltip(lineLabel, { sticky: true }).addTo(linesLayer);
                  }
                }
              });

              // 3. Render Customer Markers & Lines to ODP
              (data.customers || []).forEach(cust => {
                const cLat = parseFloat(cust.lat);
                const cLng = parseFloat(cust.lng);

                if (!isNaN(cLat) && !isNaN(cLng) && cLat !== 0 && cLng !== 0) {
                  bounds.push([cLat, cLng]);

                  const statusStr = String(cust.status || '').toLowerCase();
                  const isFree = statusStr === 'free' || String(cust.package_name || '').toLowerCase().includes('free') || Number(cust.package_price || 0) === 0;
                  const isActive = statusStr === 'active' || isFree;

                  let color = '#3b82f6'; // Active
                  if (isFree) color = '#10b981';
                  else if (!isActive) color = '#ef4444'; // Suspended / Isolir

                  const custIcon = L.divIcon({
                    className: 'custom-cust-icon',
                    html: `<div style="background:${color}; color:#fff; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; border:2px solid #fff; box-shadow:0 0 8px ${color};"><i class="bi bi-person-fill"></i></div>`,
                    iconSize: [22, 22],
                    iconAnchor: [11, 11]
                  });

                  const popupHtml = `
                    <div class="inv-popup">
                      <h4><i class="bi bi-person-fill"></i> ${cust.name || 'Pelanggan'}</h4>
                      <div><strong>Paket:</strong> ${cust.package_name || '-'}</div>
                      <div><strong>Status:</strong> <span style="color:${color}; font-weight:700; text-transform:uppercase">${isFree ? 'FREE' : (isActive ? 'AKTIF' : 'ISOLIR')}</span></div>
                      <div><strong>Username PPPoE:</strong> ${cust.pppoe_username || '-'}</div>
                      <div><strong>Alamat:</strong> ${cust.address || '-'}</div>
                    </div>
                  `;

                  L.marker([cLat, cLng], { icon: custIcon })
                    .bindPopup(popupHtml)
                    .addTo(markersLayer);

                  // Connect line to ODP
                  if (cust.odp_id && odpMarkers[cust.odp_id]) {
                    let pathCoords = [[cLat, cLng], odpMarkers[cust.odp_id]];

                    if (cust.cable_path && String(cust.cable_path).trim().length > 2) {
                      try {
                        const parsed = JSON.parse(cust.cable_path);
                        if (Array.isArray(parsed) && parsed.length >= 2) {
                          pathCoords = parsed.map(pt => Array.isArray(pt) ? [pt[0], pt[1]] : [pt.lat, pt.lng]);
                        }
                      } catch (e) {}
                    }

                    L.polyline(pathCoords, {
                      color: color,
                      weight: 3,
                      opacity: 0.8,
                      dashArray: '10, 10',
                      className: 'flowing-line'
                    }).addTo(linesLayer);
                  }
                }
              });

              // Auto fit bounds on initial load
              if (!initialCentered && bounds.length > 0) {
                map.fitBounds(bounds, { padding: [30, 30] });
                initialCentered = true;
              }
            } catch (err) {
              console.error('Error fetching investor map data:', err);
            }
          }

          // Initial Load
          loadInvestorMapData();

          // Real-time Auto-polling every 10 seconds
          setInterval(loadInvestorMapData, 10000);

        } catch (err) {
          console.error('Gagal inisialisasi investor map:', err);
        }

      } catch (e) {
        console.error('Gagal memuat chart data:', e);
      }

    });
  </script>

</body>
</html>
