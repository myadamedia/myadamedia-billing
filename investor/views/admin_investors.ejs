<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manajemen Akun Investor | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
</head>
<body>
<%- include('../../views/admin/partials/sidebar', { activePage: 'investors' }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-person-workspace" style="color: var(--primary);"></i>
      <span>Manajemen Akun Investor & Saham</span>
    </div>
  </div>

  <div class="page">

    <% if (error) { %>
      <div class="alert alert-d"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-s"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
    <% } %>

    <!-- STAT GRID -->
    <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 20px;">
      <div class="sc p">
        <i class="bi bi-people-fill sc-icon"></i>
        <div class="sc-label">Total Akun Investor</div>
        <div class="sc-val"><%= investors.length %></div>
      </div>
      <div class="sc s">
        <i class="bi bi-pie-chart-fill sc-icon"></i>
        <div class="sc-label">Total Saham Teralokasi</div>
        <div class="sc-val"><%= totalSharePercent.toFixed(1) %>%</div>
      </div>
      <div class="sc i">
        <i class="bi bi-box-arrow-up-right sc-icon"></i>
        <div class="sc-label">URL Portal Investor</div>
        <div class="sc-val" style="font-size: 14px; font-weight: 600;">
          <a href="/investor/login" target="_blank" style="color: var(--info); text-decoration: none;">/investor/login <i class="bi bi-external-link"></i></a>
        </div>
      </div>
    </div>

    <!-- MAIN CARD & TABLE -->
    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-person-badge"></i> Daftar Investor Terdaftar</h6>
        <button class="btn btn-p btn-sm" onclick="openAddModal()">
          <i class="bi bi-plus-lg"></i> Tambah Investor
        </button>
      </div>

      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nama Investor</th>
              <th>Username</th>
              <th>Skema Bagi Hasil</th>
              <th>Status</th>
              <th>Tgl Dibuat</th>
              <th style="text-align: right;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (!investors || investors.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center text-muted" style="padding: 24px;">
                  <i class="bi bi-info-circle"></i> Belum ada akun investor terdaftar. Klik <strong>Tambah Investor</strong> untuk membuat baru.
                </td>
              </tr>
            <% } else { %>
              <% investors.forEach(inv => { %>
                <tr>
                  <td><strong>#<%= inv.id %></strong></td>
                  <td><strong><%= inv.name %></strong></td>
                  <td><code><%= inv.username %></code></td>
                  <td>
                    <% if (inv.share_type === 'fixed') { %>
                      <span class="badge bs" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">
                        <i class="bi bi-cash-stack"></i> Rp <%= new Intl.NumberFormat('id-ID').format(inv.fixed_dividend_amount || 0) %> / Bulan (Fix)
                      </span>
                    <% } else { %>
                      <span class="badge bp">
                        <i class="bi bi-pie-chart-fill"></i> <%= inv.share_percentage %>% (Profit Share)
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <% if (inv.is_active) { %>
                      <span class="badge bs"><i class="bi bi-check-circle-fill"></i> Aktif</span>
                    <% } else { %>
                      <span class="badge bd"><i class="bi bi-x-circle-fill"></i> Non-Aktif</span>
                    <% } %>
                  </td>
                  <td><%= new Date(inv.created_at).toLocaleDateString('id-ID') %></td>
                  <td style="text-align: right; white-space: nowrap;">
                    <button class="btn btn-g btn-sm" 
                      data-id="<%= inv.id %>" 
                      data-name="<%= inv.name %>" 
                      data-username="<%= inv.username %>" 
                      data-share="<%= inv.share_percentage %>" 
                      data-type="<%= inv.share_type || 'percentage' %>"
                      data-fixed="<%= inv.fixed_dividend_amount || 0 %>"
                      data-active="<%= inv.is_active %>" 
                      onclick="editInvBtn(this)">
                      <i class="bi bi-pencil"></i> Edit
                    </button>
                    <form action="/admin/investors/<%= inv.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Hapus akun investor ini?')">
                      <button type="submit" class="btn btn-d btn-sm">
                        <i class="bi bi-trash"></i> Hapus
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<!-- MODAL ADD INVESTOR -->
<div class="mo" id="addModal">
  <div class="mb">
    <div class="mh">
      <span class="mt"><i class="bi bi-person-plus-fill" style="color: var(--primary);"></i> Tambah Investor Baru</span>
      <button class="mc" onclick="closeAddModal()">&times;</button>
    </div>
    <form action="/admin/investors" method="POST">
      <div class="mbody">
        <div class="fg">
          <label class="fl">Nama Lengkap Investor</label>
          <input type="text" name="name" class="fc" placeholder="Contoh: Pak Hendra" required>
        </div>

        <div class="fg">
          <label class="fl">Username Login</label>
          <input type="text" name="username" class="fc" placeholder="Contoh: investor_hendra" required>
        </div>

        <div class="fg">
          <label class="fl">Password Login</label>
          <input type="password" name="password" class="fc" placeholder="Password rahasia" required>
        </div>

        <div class="fg">
          <label class="fl">Skema / Tipe Bagi Hasil</label>
          <select name="share_type" id="add_share_type" class="fs" onchange="toggleAddShareType()">
            <option value="percentage">Persentase Saham (%) dari Net Profit</option>
            <option value="fixed">Nominal Fix / Tetap (Rp per Bulan)</option>
          </select>
        </div>

        <div class="fg" id="add_perc_group">
          <label class="fl">Persentase Saham / Bagi Hasil (%)</label>
          <input type="number" step="0.1" name="share_percentage" class="fc" placeholder="Contoh: 15.0" value="0.0">
          <small class="text-muted" style="font-size: 11px; margin-top: 4px; display: block;">Investor menerima hasil sebesar X% dari Laba Bersih (Net Profit) per bulan.</small>
        </div>

        <div class="fg" id="add_fixed_group" style="display: none;">
          <label class="fl">Nominal Fix Bagi Hasil (Rp / Bulan)</label>
          <input type="number" name="fixed_dividend_amount" class="fc" placeholder="Contoh: 1500000" value="0">
          <small class="text-muted" style="font-size: 11px; margin-top: 4px; display: block;">Investor menerima jumlah dana tetap dalam Rupiah setiap bulan tanpa tergantung laba bersih.</small>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeAddModal()">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Simpan Akun</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL EDIT INVESTOR -->
<div class="mo" id="editModal">
  <div class="mb">
    <div class="mh">
      <span class="mt"><i class="bi bi-pencil-square" style="color: var(--primary);"></i> Edit Investor</span>
      <button class="mc" onclick="closeEditModal()">&times;</button>
    </div>
    <form id="editForm" method="POST">
      <div class="mbody">
        <div class="fg">
          <label class="fl">Nama Lengkap Investor</label>
          <input type="text" id="edit_name" name="name" class="fc" required>
        </div>

        <div class="fg">
          <label class="fl">Username Login</label>
          <input type="text" id="edit_username" name="username" class="fc" required>
        </div>

        <div class="fg">
          <label class="fl">Password Baru (Kosongkan jika tidak diubah)</label>
          <input type="password" name="password" class="fc" placeholder="Kosongkan jika tidak diganti">
        </div>

        <div class="fg">
          <label class="fl">Skema / Tipe Bagi Hasil</label>
          <select id="edit_share_type" name="share_type" class="fs" onchange="toggleEditShareType()">
            <option value="percentage">Persentase Saham (%) dari Net Profit</option>
            <option value="fixed">Nominal Fix / Tetap (Rp per Bulan)</option>
          </select>
        </div>

        <div class="fg" id="edit_perc_group">
          <label class="fl">Persentase Saham / Bagi Hasil (%)</label>
          <input type="number" step="0.1" id="edit_share" name="share_percentage" class="fc">
          <small class="text-muted" style="font-size: 11px; margin-top: 4px; display: block;">Investor menerima hasil sebesar X% dari Laba Bersih (Net Profit) per bulan.</small>
        </div>

        <div class="fg" id="edit_fixed_group" style="display: none;">
          <label class="fl">Nominal Fix Bagi Hasil (Rp / Bulan)</label>
          <input type="number" id="edit_fixed_amount" name="fixed_dividend_amount" class="fc" placeholder="Contoh: 1500000">
          <small class="text-muted" style="font-size: 11px; margin-top: 4px; display: block;">Investor menerima jumlah dana tetap dalam Rupiah setiap bulan tanpa tergantung laba bersih.</small>
        </div>

        <div class="fg">
          <label class="fl">Status Akun</label>
          <select id="edit_active" name="is_active" class="fs">
            <option value="1">Aktif</option>
            <option value="0">Non-Aktif</option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeEditModal()">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Update Investor</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleAddShareType() {
    const val = document.getElementById('add_share_type').value;
    if (val === 'fixed') {
      document.getElementById('add_perc_group').style.display = 'none';
      document.getElementById('add_fixed_group').style.display = 'block';
    } else {
      document.getElementById('add_perc_group').style.display = 'block';
      document.getElementById('add_fixed_group').style.display = 'none';
    }
  }

  function toggleEditShareType() {
    const val = document.getElementById('edit_share_type').value;
    if (val === 'fixed') {
      document.getElementById('edit_perc_group').style.display = 'none';
      document.getElementById('edit_fixed_group').style.display = 'block';
    } else {
      document.getElementById('edit_perc_group').style.display = 'block';
      document.getElementById('edit_fixed_group').style.display = 'none';
    }
  }

  function openAddModal() { 
    toggleAddShareType();
    document.getElementById('addModal').classList.add('show'); 
  }
  function closeAddModal() { document.getElementById('addModal').classList.remove('show'); }

  function editInvBtn(btn) {
    const d = btn.dataset;
    openEditModal(d.id, d.name, d.username, d.share, d.type, d.fixed, d.active === '1' || d.active === 'true');
  }

  function openEditModal(id, name, username, share, type, fixed, active) {
    document.getElementById('editForm').action = '/admin/investors/' + id + '/update';
    document.getElementById('edit_name').value = name;
    document.getElementById('edit_username').value = username;
    document.getElementById('edit_share').value = share || 0;
    document.getElementById('edit_share_type').value = type || 'percentage';
    document.getElementById('edit_fixed_amount').value = fixed || 0;
    document.getElementById('edit_active').value = active ? "1" : "0";
    toggleEditShareType();
    document.getElementById('editModal').classList.add('show');
  }
  function closeEditModal() { document.getElementById('editModal').classList.remove('show'); }
</script>

</body>
</html>

